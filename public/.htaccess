  RewriteRule ^answers/smart-home-cost/?$ /smart-home-price/ [R=301,L]
  RewriteRule ^hubitat/?$ /brands-and-technologies/ [R=301,L]

  # GSC 404-report URLs missed by the refined map (2026-07-03).
