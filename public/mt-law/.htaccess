Options -Indexes
DirectoryIndex gate.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Apache may not apply DirectoryIndex to POST requests on shared hosting.
  # Route only the empty-directory POST target to the secure gate; GET keeps
  # using DirectoryIndex, avoiding an internal redirect loop.
  RewriteCond %{REQUEST_METHOD} ^POST$ [NC]
  RewriteRule ^$ gate.php [L,QSA]

  RewriteCond %{THE_REQUEST} \s/+mt-law/index\.php(?:[?\s]) [NC]
  RewriteRule ^index\.php$ /mt-law/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Cache-Control "no-store, private, max-age=0, must-revalidate"
</IfModule>

<FilesMatch "^(?:_bootstrap|_gate_data|_gate_view)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.b64(?:\.part[0-9]+)?$">
  Require all denied
</FilesMatch>