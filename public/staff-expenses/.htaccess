DirectoryIndex index.php

# HTTPS is enforced by the main site. Do not redirect again in this directory:
# reverse-proxy TLS termination can otherwise create a redirect loop.

<IfModule mod_authz_core.c>
  <FilesMatch "^(?:_|\.).*|.*\.(?:json|log|sqlite|bak|ini|env)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(?:_|\.).*|.*\.(?:json|log|sqlite|bak|ini|env)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Cache-Control "no-store, private, max-age=0, must-revalidate"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

LimitRequestBody 67108864


# php -- portal handler: keep the portal on modern PHP even if the
# site-root .htaccess handler block is stripped by a main-site deploy.
<IfModule mime_module>
AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
