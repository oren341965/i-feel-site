Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Cache-Control "no-store, private, max-age=0, must-revalidate"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<FilesMatch "^_(bootstrap|lead)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "^residents\.txt$">
  Require all denied
</FilesMatch>

