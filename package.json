{
  "name": "ifeel-astro-rebuilt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check:content-freshness": "node scripts/check-content-freshness.mjs",
    "check:build": "node scripts/validate-build.mjs",
    "test:youtube": "node --test tests/youtube-uploader.test.mjs",
    "test:lead-conversion": "node --test tests/lead-conversion-proof.test.mjs",
    "test:ai-managers": "node --test tests/ai-sales-manager.test.mjs tests/ai-service-manager.test.mjs tests/ai-manager-cli-security.test.mjs tests/ai-sales-system-v2.test.mjs",
    "youtube:verify": "node --use-system-ca scripts/youtube-uploader.mjs --verify-channel",
    "youtube:upload": "node --use-system-ca scripts/youtube-uploader.mjs --upload",
    "build": "node scripts/check-content-freshness.mjs && astro build && node scripts/generate-og-images.mjs && node scripts/validate-build.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^4.16.18",
    "basic-ftp": "^6.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19"
  }
}
