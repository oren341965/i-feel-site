{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i-feel.co.il/schemas/ai-sales-state-v1.json",
  "title": "I Feel AI Sales local runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_morning_run",
    "maturity",
    "vault_status",
    "google_ads_status",
    "meta_ads_status",
    "attribution_status",
    "capacity_status",
    "last_request_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "last_morning_run": { "type": "string", "format": "date-time" },
    "maturity": { "const": 0 },
    "vault_status": { "enum": ["READY", "MISSING", "INVALID"] },
    "google_ads_status": { "enum": ["CONNECTED_READ_ONLY", "CONNECTION_MISSING"] },
    "meta_ads_status": { "enum": ["CONNECTED_READ_ONLY", "CONNECTION_MISSING"] },
    "attribution_status": { "enum": ["LOCAL_SNAPSHOT_READ_ONLY", "CONNECTION_MISSING"] },
    "capacity_status": {
      "enum": [
        "CAPACITY_OK",
        "CAPACITY_BLOCKED",
        "CAPACITY_THRESHOLD_MISSING",
        "CAPACITY_INPUT_MISSING"
      ]
    },
    "last_request_id": { "type": "string", "minLength": 8, "maxLength": 128 }
  }
}
