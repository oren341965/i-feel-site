{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i-feel.co.il/schemas/ai-sales-bus-message-v1.json",
  "title": "I Feel AI Sales file-bridge message",
  "oneOf": [
    { "$ref": "#/$defs/morningJudgmentRequest" },
    { "$ref": "#/$defs/legacyBridgeMessage" },
    { "$ref": "#/$defs/mayaTask" },
    { "$ref": "#/$defs/mayaTaskAck" },
    { "$ref": "#/$defs/mayaTaskResult" }
  ],
  "$defs": {
    "mayaTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "task_id", "generated_at", "source", "target", "type", "execution_state", "monday_board_id", "monday_item_id", "instruction", "max_age_hours", "dry_run", "maturity"],
      "properties": {
        "schema_version": { "const": 1 },
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "source": { "const": "ai-sales-manager" },
        "target": { "const": "maya-agent" },
        "type": { "const": "MAYA_TASK" },
        "execution_state": { "const": "ASSIGNED_TO_MAYA" },
        "monday_board_id": { "type": "string", "pattern": "^[0-9]+$" },
        "monday_item_id": { "type": "string", "pattern": "^[0-9]+$" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "approval_required": { "type": "boolean" },
        "approval_status": { "enum": ["not_required", "pending", "approved", "rejected"] },
        "max_age_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 168 },
        "dry_run": { "const": true },
        "maturity": { "const": 0 }
      }
    },
    "mayaTaskAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "task_id", "monday_item_id", "source", "target", "type", "state", "received_at", "dry_run", "maturity"],
      "properties": {
        "schema_version": { "const": 1 }, "task_id": { "type": "string" }, "monday_item_id": { "type": "string" },
        "source": { "const": "maya-agent" }, "target": { "const": "ai-sales-manager" }, "type": { "const": "MAYA_TASK_ACK" },
        "state": { "const": "MAYA_ACKNOWLEDGED" }, "received_at": { "type": "string", "format": "date-time" },
        "dry_run": { "const": true }, "maturity": { "const": 0 }
      }
    },
    "mayaTaskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "task_id", "monday_item_id", "customer_name", "source", "target", "type", "state", "action_performed", "communication_checked", "message_sent", "message_id", "result_summary", "monday_updated", "next_action", "next_treatment_date", "blocked_reason", "needs_oren_decision", "completed_at", "dry_run", "maturity"],
      "properties": {
        "schema_version": { "const": 1 }, "task_id": { "type": "string" }, "monday_item_id": { "type": "string" },
        "customer_name": { "type": ["string", "null"], "maxLength": 250 }, "source": { "const": "maya-agent" },
        "target": { "const": "ai-sales-manager" }, "type": { "const": "MAYA_TASK_RESULT" },
        "state": { "enum": ["MAYA_EXECUTED", "WAITING_FOR_CUSTOMER", "RESPONSE_RECEIVED_AND_MONDAY_UPDATED", "BLOCKED", "NEEDS_APPROVAL", "NEEDS_OREN_DECISION"] },
        "action_performed": { "type": "string", "maxLength": 500 }, "communication_checked": { "type": "boolean" },
        "message_sent": { "enum": ["yes", "no"] }, "message_id": { "type": ["string", "null"], "maxLength": 250 },
        "result_summary": { "type": "string", "maxLength": 2000 }, "monday_updated": { "enum": ["yes", "no"] },
        "next_action": { "type": ["string", "null"], "maxLength": 500 }, "next_treatment_date": { "type": ["string", "null"], "maxLength": 64 },
        "blocked_reason": { "type": ["string", "null"], "maxLength": 500 }, "needs_oren_decision": { "enum": ["yes", "no"] },
        "completed_at": { "type": "string", "format": "date-time" }, "dry_run": { "const": true }, "maturity": { "const": 0 }
      }
    },
    "morningJudgmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "generated_at",
        "max_age_hours",
        "source",
        "type",
        "dry_run",
        "approval_required",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "request_id": { "type": "string", "pattern": "^morning-sales-judgment-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "max_age_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 168 },
        "source": { "const": "codex" },
        "type": { "const": "MORNING_SALES_JUDGMENT_REQUEST" },
        "dry_run": { "const": true },
        "approval_required": { "const": false },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_target_status",
            "google_status",
            "meta_status",
            "capacity_status",
            "website_improvement_status",
            "judgment_items"
          ],
          "properties": {
            "current_target_status": { "type": "string", "maxLength": 128 },
            "google_status": { "type": "string", "maxLength": 128 },
            "meta_status": { "type": "string", "maxLength": 128 },
            "capacity_status": { "type": "string", "maxLength": 128 },
            "website_improvement_status": { "type": "string", "maxLength": 128 },
            "judgment_items": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reference", "question", "facts"],
                "properties": {
                  "reference": { "type": "string", "maxLength": 128 },
                  "question": { "type": "string", "maxLength": 1000 },
                  "facts": {
                    "type": "array",
                    "maxItems": 25,
                    "items": { "type": "string", "maxLength": 500 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "legacyBridgeMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "createdAt", "source", "target", "type", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "schemaVersion": { "const": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "correlationId": { "type": ["string", "null"], "maxLength": 128 },
        "source": { "enum": ["codex", "claude", "maya-agent", "ai-sales-manager"] },
        "target": { "enum": ["codex", "claude", "maya-agent", "ai-sales-manager"] },
        "type": { "enum": ["judgment_request", "judgment_response", "task", "result", "approval"] },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caseReference": { "type": ["string", "null"], "maxLength": 128 },
            "question": { "type": ["string", "null"], "maxLength": 2000 },
            "facts": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "maxLength": 500 }
            },
            "decision": { "type": ["string", "null"], "maxLength": 1000 },
            "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "rationale": { "type": ["string", "null"], "maxLength": 2000 },
            "proposedAction": { "type": ["string", "null"], "maxLength": 1000 },
            "approvalRequired": { "type": "boolean" },
            "approvalStatus": { "enum": ["not_required", "pending", "approved", "rejected"] }
          }
        }
      }
    }
  }
}
