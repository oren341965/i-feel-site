{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i-feel.co.il/schemas/ai-sales-bus-message-v1.json",
  "title": "I Feel AI Sales file-bridge message",
  "oneOf": [
    { "$ref": "#/$defs/morningJudgmentRequest" },
    { "$ref": "#/$defs/mayaSalesTaskMessage" },
    { "$ref": "#/$defs/legacyBridgeMessage" }
  ],
  "$defs": {
    "morningJudgmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "generated_at",
        "max_age_hours",
        "source",
        "type",
        "dry_run",
        "approval_required",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "request_id": { "type": "string", "pattern": "^morning-sales-judgment-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "max_age_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 168 },
        "source": { "const": "codex" },
        "type": { "const": "MORNING_SALES_JUDGMENT_REQUEST" },
        "dry_run": { "const": true },
        "approval_required": { "const": false },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_target_status",
            "google_status",
            "meta_status",
            "capacity_status",
            "website_improvement_status",
            "judgment_items"
          ],
          "properties": {
            "current_target_status": { "type": "string", "maxLength": 128 },
            "google_status": { "type": "string", "maxLength": 128 },
            "meta_status": { "type": "string", "maxLength": 128 },
            "capacity_status": { "type": "string", "maxLength": 128 },
            "website_improvement_status": { "type": "string", "maxLength": 128 },
            "judgment_items": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reference", "question", "facts"],
                "properties": {
                  "reference": { "type": "string", "maxLength": 128 },
                  "question": { "type": "string", "maxLength": 1000 },
                  "facts": {
                    "type": "array",
                    "maxItems": 25,
                    "items": { "type": "string", "maxLength": 500 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "mayaSalesTaskMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_id",
        "message_type",
        "source",
        "target",
        "task_id",
        "monday_board_id",
        "monday_item_id",
        "customer_name",
        "current_sales_status",
        "instruction",
        "required_action",
        "created_at",
        "due_date",
        "priority",
        "requested_by",
        "execution_state",
        "result",
        "next_action",
        "next_treatment_date",
        "event_at",
        "monday_item_source",
        "monday_item_verified_at",
        "test_task",
        "execution_origin",
        "execution_gate",
        "external_actions_performed",
        "monday_writes_performed",
        "service_identity_verified",
        "service_identity_id",
        "maya_machine_id"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "message_id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "message_type": {
          "enum": [
            "MAYA_SALES_TASK_ASSIGNMENT",
            "MAYA_SALES_TASK_ACK",
            "MAYA_SALES_TASK_RESULT"
          ]
        },
        "source": { "enum": ["ai-sales-manager", "maya-agent"] },
        "target": { "enum": ["ai-sales-manager", "maya-agent"] },
        "task_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
        "monday_board_id": { "const": "2732725332" },
        "monday_item_id": { "type": "string", "pattern": "^[0-9]{1,20}$" },
        "customer_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "current_sales_status": { "type": "string", "minLength": 1, "maxLength": 250 },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "required_action": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "created_at": { "type": "string", "format": "date-time" },
        "due_date": { "type": ["string", "null"] },
        "priority": { "enum": ["LOW", "NORMAL", "HIGH", "URGENT"] },
        "requested_by": { "const": "ai-sales-manager" },
        "execution_state": {
          "enum": [
            "ASSIGNED_TO_MAYA",
            "MAYA_ACKNOWLEDGED",
            "MAYA_EXECUTED",
            "WAITING_FOR_CUSTOMER",
            "RESPONSE_RECEIVED_AND_MONDAY_UPDATED",
            "BLOCKED",
            "NEEDS_OREN_DECISION"
          ]
        },
        "result": { "type": ["string", "null"], "maxLength": 4000 },
        "next_action": { "type": ["string", "null"], "maxLength": 1000 },
        "next_treatment_date": { "type": ["string", "null"] },
        "event_at": { "type": "string", "format": "date-time" },
        "monday_item_source": { "enum": ["MONDAY_LIVE", "ISOLATED_TEST"] },
        "monday_item_verified_at": { "type": "string", "format": "date-time" },
        "test_task": { "type": "boolean" },
        "execution_origin": { "enum": ["MANAGER", "MAYA_WORKSTATION", "ISOLATED_TEST"] },
        "execution_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "status", "blockers"],
          "properties": {
            "ready": { "type": "boolean" },
            "status": { "enum": ["MAYA_PRODUCTION_READY", "MAYA_PRODUCTION_BLOCKED"] },
            "blockers": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "pattern": "^[A-Z0-9_]{3,80}$" }
            }
          }
        },
        "external_actions_performed": { "type": "boolean" },
        "monday_writes_performed": { "type": "boolean" },
        "service_identity_verified": { "type": "boolean" },
        "service_identity_id": { "type": ["string", "null"], "maxLength": 128 },
        "maya_machine_id": { "type": ["string", "null"], "maxLength": 63 }
      }
    },
    "legacyBridgeMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "createdAt", "source", "target", "type", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "schemaVersion": { "const": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "correlationId": { "type": ["string", "null"], "maxLength": 128 },
        "source": { "enum": ["codex", "claude", "maya-agent", "ai-sales-manager"] },
        "target": { "enum": ["codex", "claude", "maya-agent", "ai-sales-manager"] },
        "type": { "enum": ["judgment_request", "judgment_response", "task", "result", "approval"] },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caseReference": { "type": ["string", "null"], "maxLength": 128 },
            "question": { "type": ["string", "null"], "maxLength": 2000 },
            "facts": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "maxLength": 500 }
            },
            "decision": { "type": ["string", "null"], "maxLength": 1000 },
            "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "rationale": { "type": ["string", "null"], "maxLength": 2000 },
            "proposedAction": { "type": ["string", "null"], "maxLength": 1000 },
            "approvalRequired": { "type": "boolean" },
            "approvalStatus": { "enum": ["not_required", "pending", "approved", "rejected"] }
          }
        }
      }
    }
  }
}
