---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SiteSearch from '../components/SiteSearch.astro';
import Footer from '../components/Footer.astro';
import LeadAttributionCapture from '../components/LeadAttributionCapture.astro';
import SiemensDwgDownload from '../components/SiemensDwgDownload.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  jsonLd?: string;
  robots?: string;
  lang?: string;
  dir?: string;
}

const {
  title,
  description = '',
  canonical = 'https://i-feel.co.il/',
  ogTitle = title,
  ogDescription = description,
  ogUrl = canonical,
  ogImage: requestedOgImage = '',
  jsonLd = '',
  robots = '',
  lang = 'he',
  dir = 'rtl'
} = Astro.props;

const canonicalPath = decodeURIComponent(new URL(canonical).pathname);

const siemensKnxProducts: Record<string, string> = {
  '/articles/siemens-n12522-knx-power-supply-640ma/': '5WG1125-1AB22',
  '/articles/siemens-n262d51-knx-8-dry-contact-input/': '5WG1262-1DB51',
  '/articles/siemens-n263d51-knx-8-binary-input/': '5WG1263-1DB51',
  '/articles/siemens-n14103-knx-dali-gateway-plus/': '5WG1141-1AB03',
  '/articles/siemens-n14121-knx-dali-gateway-twin-plus/': '5WG1141-1AB21',
  '/articles/siemens-n554d31-knx-4-channel-dimmer/': '5WG1554-1DB31',
  '/articles/siemens-n56881-knx-24-output/': '5WG1568-1AB81',
  '/articles/siemens-n56722-knx-16-output/': '5WG1567-1AB22',
  '/articles/siemens-n532d51-knx-8-switch-output/': '5WG1532-1DB51',
  '/articles/siemens-n532d31-knx-4-switch-output/': '5WG1532-1DB31',
  '/articles/siemens-n543d51-knx-8-blind-actuator/': '5WG1543-1DB51',
  '/articles/siemens-n543d31-knx-4-blind-actuator/': '5WG1543-1DB31',
};

const productSku = siemensKnxProducts[canonicalPath] || '';
const isSiemensKnxProduct = Boolean(productSku);

function stablePathHash(value: string) {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index += 1) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return (hash >>> 0).toString(16).padStart(8, '0');
}

function generatedOgImageUrl(pathname: string) {
  const readable = pathname
    .toLowerCase()
    .replace(/[^a-z0-9/]+/g, '-')
    .split('/')
    .filter(Boolean)
    .join('-')
    .replace(/-+/g, '-')
    .slice(0, 54) || 'page';
  return `https://i-feel.co.il/assets/og/pages/${readable}-${stablePathHash(pathname)}.jpg`;
}

const usesLegacyGenericImage = !requestedOgImage || /\/assets\/og-cover\.jpg(?:$|\?)/.test(requestedOgImage);
const ogImage = usesLegacyGenericImage ? generatedOgImageUrl(canonicalPath) : requestedOgImage;
const ogType = canonicalPath.startsWith('/articles/') && canonicalPath !== '/articles/' && !isSiemensKnxProduct ? 'article' : 'website';

const effectiveJsonLd = isSiemensKnxProduct
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: title.replace(/\s*\|\s*i-feel$/i, ''),
      description,
      sku: productSku,
      brand: { '@type': 'Brand', name: 'Siemens' },
      url: canonical,
      category: 'Siemens KNX',
    })
  : jsonLd;

const siteIdentityJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness', 'HomeAndConstructionBusiness', 'ProfessionalService'],
  '@id': 'https://i-feel.co.il/#business',
  name: 'i-feel',
  alternateName: ['I FEEL', 'i-feel', 'איי פיל', 'i-feel מערכות בקרת מבנה ובית חכם'],
  url: 'https://i-feel.co.il/',
  description: 'Israeli smart home and building management systems integrator specializing in KNX, Siemens Desigo, DALI and related building-control technologies.',
  telephone: '+972-3-508-9553',
  email: 'sales@i-feel.co.il',
  foundingDate: '2008',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Imber 14',
    addressLocality: 'Petah Tikva',
    postalCode: '4951148',
    addressCountry: 'IL'
  },
  areaServed: {
    '@type': 'Country',
    name: 'Israel'
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      areaServed: 'IL',
      availableLanguage: ['he', 'en']
    },
    {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: 'support@i-feel.co.il',
      areaServed: 'IL',
      availableLanguage: ['he', 'en']
    }
  ],
  sameAs: [
    'https://www.facebook.com/SmarthomeIsrael',
    'https://www.instagram.com/ifeelisrael',
    'https://www.linkedin.com/company/i-feel-smart-home-systems',
    'https://www.youtube.com/@ifeelsmarthome',
    'https://www.wikidata.org/wiki/Q140383633'
  ]
});
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={siteIdentityJsonLd} />
    {effectiveJsonLd && <script type="application/ld+json" set:html={effectiveJsonLd} />}

    <!-- Google tag (gtag.js) — Google Ads + GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18038181913"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18038181913');
      gtag('config', 'G-6MHSG7Z8DV');

      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (href.indexOf('tel:') === 0) {
          gtag('event', 'phone_click', { link_url: href, page_path: location.pathname });
        } else if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
          gtag('event', 'whatsapp_click', { link_url: href, page_path: location.pathname });
        }
      });

      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-ga-event]');
        if (!el) return;
        var params = {};
        try { params = JSON.parse(el.getAttribute('data-ga-params') || '{}'); } catch (err) {}
        params.page_path = location.pathname;
        gtag('event', el.getAttribute('data-ga-event'), params);
      });
    </script>
  </head>
  <body class="bg-white text-brand-900 antialiased">
    <Header />
    <SiteSearch />
    <main id="main-content">
      <slot />
      <SiemensDwgDownload />
    </main>
    {isSiemensKnxProduct && (
      <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
          var legacyArticleLink = document.querySelector('main article header a[href="/articles/"]');
          if (legacyArticleLink) {
            legacyArticleLink.setAttribute('href', '/siemens-knx-products/');
            legacyArticleLink.textContent = 'מוצרים ומפרטים טכניים';
          }
        });
      </script>
    )}
    <Footer />
    <LeadAttributionCapture />
  </body>
</html>
