---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  jsonLd?: string;
  robots?: string;
  lang?: string;
  dir?: string;
}

const {
  title,
  description = '',
  canonical = 'https://i-feel.co.il/',
  ogTitle = title,
  ogDescription = description,
  ogUrl = canonical,
  ogImage = 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd = '',
  robots = '',
  lang = 'he',
  dir = 'rtl'
} = Astro.props;

const siteIdentityJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness', 'HomeAndConstructionBusiness', 'ProfessionalService'],
  '@id': 'https://i-feel.co.il/#business',
  name: 'i-feel',
  alternateName: ['I FEEL', 'i-feel', 'איי פיל', 'i-feel מערכות בקרת מבנה ובית חכם'],
  url: 'https://i-feel.co.il/',
  sameAs: [
    'https://www.facebook.com/SmarthomeIsrael',
    'https://www.instagram.com/ifeelisrael',
    'https://www.linkedin.com/company/200156',
    'https://www.youtube.com/@ifeelsmarthome',
    'https://www.wikidata.org/wiki/Q140383633'
  ]
});
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={siteIdentityJsonLd} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <!-- Google tag (gtag.js) — Google Ads + GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18038181913"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18038181913');           /* ← Google Ads conversion ID */
      gtag('config', 'G-XXXXXXXXXX');               /* ← GA4 Measurement ID (create property, then fill) */

      // Site-wide click conversions: phone + WhatsApp
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (href.indexOf('tel:') === 0) {
          gtag('event', 'conversion', { send_to: 'AW-18038181913/CALL_LABEL' });
        } else if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
          gtag('event', 'conversion', { send_to: 'AW-18038181913/WA_LABEL' });
        }
      });
    </script>
  </head>
  <body class="bg-white text-brand-900 antialiased">
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
