---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={["bg-brand-900 text-white", compact ? "py-8" : "py-12"]} aria-labelledby="knx-advisor-cta-title">
  <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <p class="text-accent-500 font-bold mb-2">כלי תכנון חינמי</p>
      <h2 id="knx-advisor-cta-title" class="text-2xl md:text-3xl font-extrabold mb-2">לא בטוחים איזה מפסק מתאים?</h2>
      <p class="text-brand-200 max-w-2xl">עברו ליועץ המפסקים וקבלו המלצה לפי חדר, פעולות, מיזוג, גמר ומיקום.</p>
    </div>
    <a href="/knx-switch-advisor/" class="inline-flex items-center justify-center bg-accent-500 hover:bg-accent-600 text-white px-6 py-3.5 rounded-lg font-bold whitespace-nowrap shadow-lg">ליועץ מפסקי KNX ←</a>
  </div>
</aside>
