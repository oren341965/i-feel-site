<script is:inline>
  (function () {
    var attributionKeys = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'gclid',
      'fbclid',
      'ttclid'
    ];
    var params = new URLSearchParams(window.location.search);
    var values = {};

    attributionKeys.forEach(function (key) {
      var storageKey = 'ifeel_' + key;
      var stored = '';
      try { stored = sessionStorage.getItem(storageKey) || ''; } catch (error) {}

      // Keep the first known touch for the browser session. A later visit must
      // not silently replace the campaign that originally generated the lead.
      if (!stored) {
        var current = (params.get(key) || '').trim().slice(0, 200);
        if (current) {
          stored = current;
          try { sessionStorage.setItem(storageKey, current); } catch (error) {}
        }
      }

      values[key] = stored;
    });

    function firstSessionValue(storageKey, current, maxLength) {
      var stored = '';
      try { stored = sessionStorage.getItem(storageKey) || ''; } catch (error) {}
      if (!stored && current) {
        stored = String(current).trim().slice(0, maxLength);
        if (stored) {
          try { sessionStorage.setItem(storageKey, stored); } catch (error) {}
        }
      }
      return stored;
    }

    function safeUrlEvidence(value, maxLength) {
      if (!value) return '';
      try {
        var parsed = new URL(value, window.location.origin);
        if (parsed.origin === window.location.origin) return parsed.pathname.slice(0, maxLength);
        return (parsed.origin + parsed.pathname).slice(0, maxLength);
      } catch (error) {
        return String(value).split(/[?#]/, 1)[0].slice(0, maxLength);
      }
    }

    var firstReferrer = firstSessionValue(
      'ifeel_first_referrer',
      safeUrlEvidence(document.referrer || '', 500),
      500
    );
    var entryPage = firstSessionValue(
      'ifeel_entry_page',
      window.location.pathname,
      500
    );
    var lastReferrer = safeUrlEvidence(document.referrer || '', 500);
    var lastPage = window.location.pathname.slice(0, 500);

    function setHiddenValue(form, name, value) {
      if (!value) return;
      var input = form.querySelector('input[name="' + name + '"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        form.appendChild(input);
      }
      input.value = value;
    }

    function directFormChild(form, element) {
      var child = element;
      while (child && child.parentNode && child.parentNode !== form) {
        child = child.parentNode;
      }
      return child && child.parentNode === form ? child : null;
    }

    function createQualificationFields(form) {
      var city = form.querySelector('[name="city"]');
      var heardFrom = form.querySelector('[name="heard_from"]');

      if (city) city.required = true;
      if (heardFrom) heardFrom.required = true;
      if (city && heardFrom) return;

      var wrapper = form.querySelector('[data-ifeel-lead-qualification]');
      if (!wrapper) {
        wrapper = document.createElement('div');
        wrapper.setAttribute('data-ifeel-lead-qualification', 'true');
        wrapper.className = 'grid md:grid-cols-2 gap-4';

        var submit = form.querySelector('button[type="submit"], input[type="submit"]');
        var submitBlock = directFormChild(form, submit);
        if (submitBlock) {
          form.insertBefore(wrapper, submitBlock);
        } else {
          form.appendChild(wrapper);
        }
      }

      if (!city) {
        var cityLabel = document.createElement('label');
        cityLabel.className = 'block';
        cityLabel.innerHTML = '<span class="block text-sm font-bold text-brand-900 mb-1">עיר / יישוב בישראל <span class="text-accent-600">*</span></span>' +
          '<input required name="city" type="text" autocomplete="address-level2" class="w-full rounded-lg border border-brand-200 px-4 py-3 text-brand-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20" placeholder="לדוגמה: ראשון לציון">';
        wrapper.appendChild(cityLabel);
      }

      if (!heardFrom) {
        var sourceLabel = document.createElement('label');
        sourceLabel.className = 'block';
        sourceLabel.innerHTML = '<span class="block text-sm font-bold text-brand-900 mb-1">איך שמעתם עלינו? <span class="text-accent-600">*</span></span>' +
          '<select required name="heard_from" class="w-full rounded-lg border border-brand-200 px-4 py-3 text-brand-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20">' +
          '<option value="">בחרו מקור</option>' +
          '<option value="Google">Google</option>' +
          '<option value="Facebook / Instagram">Facebook / Instagram</option>' +
          '<option value="המלצה מלקוח">המלצה מלקוח</option>' +
          '<option value="אדריכל / מעצב">אדריכל / מעצב</option>' +
          '<option value="קבלן / חשמלאי / מפקח">קבלן / חשמלאי / מפקח</option>' +
          '<option value="YouTube">YouTube</option>' +
          '<option value="ChatGPT">ChatGPT</option>' +
          '<option value="Gemini">Gemini</option>' +
          '<option value="Claude">Claude</option>' +
          '<option value="כלי AI אחר">כלי AI אחר</option>' +
          '<option value="כבר לקוח של i-feel">כבר לקוח של i-feel</option>' +
          '<option value="אחר">אחר</option>' +
          '</select>';
        wrapper.appendChild(sourceLabel);
      }
    }

    function fillLeadForm(form) {
      attributionKeys.forEach(function (key) {
        setHiddenValue(form, key, values[key]);
      });
      setHiddenValue(form, 'first_referrer', firstReferrer);
      setHiddenValue(form, 'entry_page', entryPage);
      setHiddenValue(form, 'last_referrer', lastReferrer);
      setHiddenValue(form, 'last_page', lastPage);
      createQualificationFields(form);
    }

    function fillNewsletterForm(form) {
      attributionKeys.forEach(function (key) {
        setHiddenValue(form, key, values[key]);
      });
      setHiddenValue(form, 'first_referrer', firstReferrer);
      setHiddenValue(form, 'entry_page', entryPage);
      setHiddenValue(form, 'last_referrer', lastReferrer);
      setHiddenValue(form, 'last_page', lastPage);
    }

    function fillAllLeadForms() {
      document.querySelectorAll('form[action="/api/lead.php"]').forEach(fillLeadForm);
      document.querySelectorAll('form[action="/api/newsletter.php"]').forEach(fillNewsletterForm);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fillAllLeadForms, { once: true });
    } else {
      fillAllLeadForms();
    }

    // Also cover a lead form that is rendered dynamically after page load.
    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (form && form.matches && form.matches('form[action="/api/lead.php"]')) {
        fillLeadForm(form);
        if (!form.checkValidity()) {
          event.preventDefault();
          form.reportValidity();
        }
      } else if (form && form.matches && form.matches('form[action="/api/newsletter.php"]')) {
        fillNewsletterForm(form);
      }
    }, true);
  })();
</script>
