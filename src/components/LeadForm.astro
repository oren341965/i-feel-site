---
export interface Props {
  leadType: string;      // value for lead.php lead_type (must match the contact form options)
  subject: string;       // internal subject so Monday shows which LP produced the lead
  sourcePage: string;    // LP path, e.g. /lp/smart-home/
  heading?: string;
  buttonText?: string;
}

const {
  leadType,
  subject,
  sourcePage,
  heading = 'השאירו פרטים ונחזור אליכם עוד היום*',
  buttonText = 'קבלו שיחת ייעוץ חינם'
} = Astro.props;
---
<div id="lead-form" class="bg-white rounded-2xl shadow-xl border border-brand-100 p-6 md:p-8 scroll-mt-24">
  <h2 class="text-xl md:text-2xl font-extrabold text-brand-900 mb-1">{heading}</h2>
  <p class="text-sm text-brand-600 mb-5">ללא עלות וללא התחייבות</p>

  <form
    action="/api/lead.php"
    method="post"
    accept-charset="UTF-8"
    class="grid gap-4"
    toolname="request-ifeel-project-consultation"
    tooldescription="Request a professional consultation from I Feel about a smart home, KNX, BMS, security, audio or building-controls project. The user must review and submit the form."
  >
    <input type="hidden" name="lead_type" value={leadType}>
    <input type="hidden" name="subject" value={subject}>
    <input type="hidden" name="source_page" value={sourcePage}>
    <input type="hidden" name="redirect_to" value={sourcePage}>
    <input type="hidden" name="utm_source" value="">
    <input type="hidden" name="utm_medium" value="">
    <input type="hidden" name="utm_campaign" value="">
    <input type="hidden" name="utm_term" value="">
    <input type="hidden" name="utm_content" value="">
    <input type="hidden" name="gclid" value="">
    <div class="hidden" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>

    <label class="block">
      <span class="block text-sm font-bold text-brand-900 mb-1">שם מלא <span class="text-accent-600">*</span></span>
      <input required name="name" type="text" autocomplete="name" toolparamdescription="The full name of the person requesting the consultation." class="w-full rounded-lg border border-brand-200 px-4 py-3 text-brand-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20" placeholder="שם פרטי ומשפחה">
    </label>

    <label class="block">
      <span class="block text-sm font-bold text-brand-900 mb-1">טלפון <span class="text-accent-600">*</span></span>
      <input required name="phone" type="tel" autocomplete="tel" inputmode="tel" dir="ltr" toolparamdescription="A phone number where the I Feel team can return the call." class="w-full rounded-lg border border-brand-200 px-4 py-3 text-brand-900 text-right focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20" placeholder="050-0000000">
    </label>

    <label class="block">
      <span class="block text-sm font-bold text-brand-900 mb-1">כמה מילים על הפרויקט <span class="text-brand-400 font-normal">(לא חובה)</span></span>
      <textarea name="message" rows="2" toolparamdescription="Optional project details such as city, building stage, plans, specification or systems of interest." class="w-full rounded-lg border border-brand-200 px-4 py-3 text-brand-900 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20" placeholder="עיר, שלב הבנייה, מה מעניין אתכם"></textarea>
    </label>

    <label class="block">
      <span class="block text-sm font-bold text-brand-900 mb-1">אימייל (לא חובה)</span>
      <input name="email" type="email" autocomplete="email" maxlength="254" dir="ltr" class="w-full rounded-lg border border-brand-200 px-4 py-3 text-brand-900" placeholder="name@example.com">
    </label>
    <label class="flex items-start gap-2 text-xs text-brand-600">
      <input type="checkbox" name="measurement_consent" value="1" class="mt-1">
      <span>אני מאשר/ת שימוש באימייל לצורך מדידת יעילות הפרסום ב־Google. לא חובה לקבלת מענה. <a href="/privacy-policy/" class="underline">מדיניות פרטיות</a></span>
    </label>
    <button type="submit" class="inline-flex items-center justify-center bg-accent-500 hover:bg-accent-600 text-white px-8 py-4 rounded-lg font-extrabold text-lg transition shadow-md w-full">
      {buttonText}
    </button>

    <p class="text-xs text-brand-500 text-center">
      *פניות שמתקבלות בשעות הפעילות נענות בדרך כלל באותו יום עסקים. הפרטים משמשים למענה לפנייה; שימוש באימייל למדידת פרסום ייעשה בהתאם לאישור שלמעלה.
    </p>
  </form>
</div>
