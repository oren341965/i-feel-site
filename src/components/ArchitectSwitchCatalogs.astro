---
import catalogs from '../data/switch-catalogs.json';
---

<section id="switch-catalogs" class="bg-brand-50 py-12 scroll-mt-28" dir="rtl" aria-labelledby="switch-catalogs-title">
  <div class="max-w-7xl mx-auto px-4">
    <h2 id="switch-catalogs-title" class="text-3xl font-extrabold text-brand-900 mb-3">קטלוגי מפסקים לאדריכלים ולמעצבים</h2>
    <p class="text-brand-700 mb-6">השוו לחצנים, גימורים וממשקי מגע, והורידו את הקטלוג המתאים לתשתית בפרויקט.</p>
    <nav class="flex flex-wrap gap-3 mb-8" aria-label="הורדת קטלוגי מפסקים">
      {catalogs.map(({ id, pdf }) => (
        <a href={pdf} download class="rounded-lg bg-brand-800 px-5 py-3 text-white font-bold hover:bg-brand-900">
          {id === 'knx' ? 'הורדת קטלוג מפסקי KNX (PDF)' : 'הורדת קטלוג מפסקים אלחוטיים (PDF)'}
        </a>
      ))}
    </nav>
    {catalogs.map(({ title, note, products }) => (
      <section class="mt-8">
        <h3 class="text-xl font-bold text-brand-900 mb-3">{title}</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {products.map(({ name, description, image, href }) => (
            <article class="rounded-xl border border-brand-100 bg-white p-4">
              <img src={image} alt={name} class="w-full h-36 object-contain mb-3" loading="lazy" decoding="async" />
              <h4 class="font-bold text-brand-900"><bdi>{name}</bdi></h4>
              <p class="text-sm text-brand-700 mt-1 mb-2">{description}</p>
              <a href={href} class="text-brand-800 font-semibold underline">מידע על <bdi>{name}</bdi></a>
            </article>
          ))}
        </div>
        <p class="text-sm text-brand-700 mt-3">{note}</p>
      </section>
    ))}
  </div>
</section>
