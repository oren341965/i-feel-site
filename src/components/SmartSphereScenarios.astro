---
import { smartSphereScenarios, scenarioSchema } from '../data/smartsphere-scenarios.mjs';
const { kinds = smartSphereScenarios.map(v => v.id) } = Astro.props;
const videos = smartSphereScenarios.filter(v => kinds.includes(v.id));
const schema = JSON.stringify({ '@context': 'https://schema.org', '@graph': videos.map(v => scenarioSchema(v, `https://i-feel.co.il${Astro.url.pathname}`)) });
---
<section id="smartsphere-scenarios" class="smartsphere-scenarios" dir="rtl" aria-label="SmartSphere בפעולה">
  <header>
    <h2><bdi dir="ltr">SmartSphere</bdi> בפעולה: מערכות הבית מגיבות יחד</h2>
    <p>SmartSphere היא מערכת של I FEEL שמחברת בין מערכות הבית ומאפשרת לתכנן פעולה משותפת. הסרטונים מציגים תרחישים לדוגמה; כל חיבור ורצף פעולות מותאמים לציוד, לתשתית ולצרכים שלכם.</p>
  </header>
  {videos.map(video => (
    <article id={`smartsphere-${video.id}`} class="scenario">
      <div>
        <h3>{video.title}</h3>
        <p>{video.description}</p>
        <p>{video.explanation}</p>
        {video.note && <p class="scenario-note">{video.note}</p>}
        <p><a href={`${video.page}#smartsphere-${video.id}`}>להסבר בדף הנושא</a></p>
      </div>
      <video controls playsinline preload="none" poster={`/assets/smartsphere/${video.id}.jpg`} width="720" height="1280" aria-label={video.title}>
        <source src={`/assets/smartsphere/${video.id}.webm?v=20261011-2`} type="video/webm" />
        <a href={`/assets/smartsphere/${video.id}.webm?v=20261011-2`}>לצפייה: {video.title}</a>
      </video>
    </article>
  ))}
  <p class="scenario-contact"><a href="/contactus/">לתכנון התרחישים בבית שלכם</a> · <a href="tel:+97235089553"><bdi dir="ltr">03-508-9553</bdi></a></p>
</section>
<script type="application/ld+json" set:html={schema} />
<style>
  .smartsphere-scenarios { max-width: 72rem; margin: 3rem auto; padding: 1.5rem; color: #17395b; }
  h2 { font-size: 2rem; font-weight: 800; line-height: 1.4; margin-bottom: 1rem; }
  h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; }
  p { line-height: 1.85; margin-bottom: 1rem; }
  .scenario { display: grid; gap: 1.5rem; align-items: center; margin-top: 2rem; padding: 1.5rem; border: 1px solid #dae6f2; border-radius: 1.25rem; background: #f7fafc; scroll-margin-top: 6rem; }
  video { display: block; width: 100%; max-width: 320px; height: auto; aspect-ratio: 9 / 16; margin: auto; border-radius: .75rem; background: #101820; }
  a { color: #087f9c; text-decoration: underline; font-weight: 700; }
  .scenario-note { border-right: 3px solid #087f9c; padding-right: 1rem; font-weight: 700; }
  .scenario-contact { margin-top: 2rem; }
  @media (min-width: 768px) { .scenario { grid-template-columns: 1.5fr 1fr; padding: 2rem; } }
</style>
