<script is:inline>
  (function () {
    function consumeVerifiedLeadConversion() {
      var params = new URLSearchParams(window.location.search);
      var leadStatus = params.get('lead') || params.get('sent') || '';
      var proof = params.get('conversion_proof') || '';

      if (leadStatus !== 'sent' || !proof || window.__ifeelVerifiedLeadConversionRequested === true) return;
      window.__ifeelVerifiedLeadConversionRequested = true;

      fetch('/api/consume-conversion.php', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
        body: new URLSearchParams({ proof: proof }).toString()
      }).then(function (response) {
        return response.ok ? response.json() : { eligible: false };
      }).then(function (result) {
        if (result && result.eligible === true
          && typeof window.ifeelSendVerifiedLeadConversion === 'function') {
          window.ifeelSendVerifiedLeadConversion(result);
        }
      }).catch(function () {});
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', consumeVerifiedLeadConversion, { once: true });
    } else {
      consumeVerifiedLeadConversion();
    }
  })();
</script>
