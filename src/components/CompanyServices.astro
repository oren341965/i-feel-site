---
import profile from '../data/agent-profile.json';
const schema = {
  '@context': 'https://schema.org',
  '@graph': profile.serviceGroups.map(group => ({
    '@type': 'Service',
    '@id': `${group.url}#service`,
    name: group.name,
    description: group.description,
    url: group.url,
    provider: { '@id': 'https://i-feel.co.il/#business' },
    areaServed: { '@type': 'Country', name: 'Israel' },
    ...(group.services.length ? {
      hasOfferCatalog: {
        '@type': 'OfferCatalog', name: group.name,
        itemListElement: group.services.map(service => ({
          '@type': 'Offer', itemOffered: {
            '@type': 'Service', name: service.name, url: service.url,
            provider: { '@id': 'https://i-feel.co.il/#business' }
          }
        }))
      }
    } : {})
  }))
};
---
<section id="services-israel" class="scroll-mt-28 bg-brand-50 py-12 border-y border-brand-100">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-3xl font-bold mb-4">I FEEL — Smart Home &amp; KNX Israel</h2>
    <p class="text-brand-700 mb-4 leading-relaxed">{profile.description}</p>
    <p class="text-brand-700 mb-6"><strong>אזורי שירות:</strong> {profile.areaServed}. המשרד: {profile.address}. שעות פעילות: {profile.contact.hours}.</p>
    <div class="grid md:grid-cols-2 gap-6">
      {profile.serviceGroups.map(group => (
        <article class="bg-white p-6 rounded-xl border border-brand-200">
          <h3 class="text-xl font-bold mb-3"><a class="text-accent-700 underline" href={group.url}>{group.name}</a></h3>
          <p class="text-brand-700 mb-3">{group.description}</p>
          <ul class="space-y-2">{group.services.map(service => <li><a class="text-accent-700 underline" href={service.url}>{service.name}</a></li>)}</ul>
        </article>
      ))}
    </div>
    <p class="mt-6"><a class="text-accent-700 font-bold underline" href="/contactus/#project-enquiry">בקשת הצעה, שליחת תכניות ותיאום פגישה</a> · <a href={`tel:${profile.contact.phone}`} class="underline" dir="ltr">{profile.contact.displayPhone}</a></p>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
