<dialog
  id="site-search-dialog"
  class="site-search-dialog fixed inset-0 m-auto w-[min(94vw,760px)] max-h-[min(88vh,760px)] overflow-hidden rounded-2xl bg-white p-0 text-right text-brand-900 shadow-2xl"
  aria-labelledby="site-search-title"
>
    <div class="flex max-h-[min(88vh,760px)] flex-col">
      <div class="border-b border-brand-100 bg-brand-50 px-4 py-4 sm:px-6">
        <div class="mb-3 flex items-center justify-between gap-4">
          <div>
            <h2 id="site-search-title" class="text-xl font-extrabold text-brand-900">חיפוש באתר</h2>
            <p class="mt-1 text-sm text-brand-600">אפשר לחפש מוצר, מק״ט, מפרט טכני, מערכת, מדריך או פרויקט</p>
          </div>
          <button
            id="site-search-close"
            type="button"
            class="shrink-0 rounded-lg p-2 text-brand-600 hover:bg-white hover:text-brand-900"
            aria-label="סגירת החיפוש"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </div>

        <form id="site-search-form" role="search" class="relative">
          <label for="site-search-input" class="sr-only">מה תרצו למצוא?</label>
          <input
            id="site-search-input"
            type="search"
            inputmode="search"
            enterkeyhint="search"
            autocomplete="off"
            placeholder="לדוגמה: בקר 8 יציאות או 5WG1532-1DB51"
            class="w-full rounded-xl border border-brand-200 bg-white py-3.5 pe-14 ps-4 text-base outline-none transition placeholder:text-brand-400 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
          />
          <button
            type="submit"
            class="absolute inset-y-1.5 end-1.5 grid w-11 place-items-center rounded-lg bg-accent-500 text-white transition hover:bg-accent-600"
            aria-label="חיפוש"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.35-5.4A6.75 6.75 0 1 1 4.5 11.25a6.75 6.75 0 0 1 13.5 0Z" />
            </svg>
          </button>
        </form>
      </div>

      <div class="min-h-48 flex-1 overflow-y-auto px-4 py-5 sm:px-6">
        <p id="site-search-status" class="text-sm text-brand-600" role="status" aria-live="polite">
          הקלידו לפחות שתי אותיות כדי להתחיל לחפש.
        </p>
        <ol id="site-search-results" class="mt-4 space-y-3" aria-label="תוצאות חיפוש"></ol>
        <button id="site-search-more" type="button" hidden class="mt-4 rounded-lg border border-brand-200 px-4 py-2 text-sm font-bold hover:bg-brand-50">הצגת תוצאות נוספות</button>
      </div>
    </div>
</dialog>

<style>
  .site-search-dialog::backdrop {
    background: rgb(15 31 54 / 72%);
    backdrop-filter: blur(3px);
  }

  .site-search-dialog[open] { animation: search-dialog-in 160ms ease-out; }
  .site-search-dialog mark {
    border-radius: 0.2rem;
    background: #f7e7bb;
    color: inherit;
    padding-inline: 0.08rem;
  }

  @keyframes search-dialog-in {
    from { opacity: 0; transform: translateY(-0.5rem) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-search-dialog[open] { animation: none; }
  }
</style>

<script>
  type SearchRecord = {
    url: string;
    title: string;
    description: string;
    headings: string;
    body: string;
    type?: 'pdf';
    identifiers?: string;
  };

  type PreparedRecord = SearchRecord & {
    normalizedTitle: string;
    normalizedDescription: string;
    normalizedHeadings: string;
    normalizedBody: string;
    normalizedUrl: string;
    normalizedIdentifiers: string;
    headlineWords: string[];
  };

  const openButton = document.querySelector<HTMLButtonElement>('#site-search-open');
  const closeButton = document.querySelector<HTMLButtonElement>('#site-search-close');
  const dialog = document.querySelector<HTMLDialogElement>('#site-search-dialog');
  const form = document.querySelector<HTMLFormElement>('#site-search-form');
  const input = document.querySelector<HTMLInputElement>('#site-search-input');
  const status = document.querySelector<HTMLElement>('#site-search-status');
  const results = document.querySelector<HTMLOListElement>('#site-search-results');
  const moreButton = document.querySelector<HTMLButtonElement>('#site-search-more');

  let indexPromise: Promise<PreparedRecord[]> | undefined;
  let debounceTimer: number | undefined;
  const resultsPerPage = 10;

  const normalize = (value: string) => value
    .normalize('NFKD')
    .toLocaleLowerCase('he')
    .replace(/[\u0591-\u05c7]/g, '')
    .replace(/[ךםןףץ]/g, (letter) => ({ ך: 'כ', ם: 'מ', ן: 'נ', ף: 'פ', ץ: 'צ' })[letter] || letter)
    .replace(/([\u05d0-\u05ea])["'׳״“”‘’]+(?=[\u05d0-\u05ea])/g, '$1')
    .replace(/[^\p{L}\p{N}]+/gu, ' ')
    .trim()
    .replace(/\bz wave\b/g, 'zwave')
    .replace(/(^| )זי וו?יי?ב(?= |$)/g, '$1zwave')
    .replace(/(^| )קיי אנ אקס(?= |$)/g, '$1knx')
    .replace(/(^| )(?:micro module|מיקרו מודול)(?= |$)/g, '$1micromodule')
    .replace(/\bwi fi\b/g, 'wifi')
    .replace(/\b(?:9025 ?eelectron|eelectron ?9025)\b/g, 'eelectron 9025')
    .replace(/\b(os|tc|gp|pxc|ap|mega) (\d+[a-z]?)\b/g, '$1$2');

  const TERM_SYNONYMS: Record<string, string[]> = {
    'מרלוג': ['מרלוגימ', 'מרכז לוגיסטי', 'מרכזימ לוגיסטיימ'],
    'מרלוגימ': ['מרלוג', 'מרכז לוגיסטי', 'מרכזימ לוגיסטיימ'],
    'חניונ': ['חניונימ'],
    'חניונימ': ['חניונ'],
    'מוצא': ['יציאה', 'יציאות'],
    'מוצאימ': ['יציאה', 'יציאות'],
    'יציאה': ['יציאות', 'מוצא', 'מוצאימ'],
    'יציאות': ['יציאה', 'מוצא', 'מוצאימ'],
    'פלט': ['יציאה', 'יציאות'],
    'פלטימ': ['יציאה', 'יציאות'],
    'כניסה': ['כניסות'],
    'כניסות': ['כניסה'],
    'אקטואטור': ['בקר'],
    'actuator': ['בקר'],
    'מפסק': ['מפסקי', 'מפסקים', 'מתג', 'מתגים', 'לחצן', 'לחצנים'],
    'מפסקי': ['מפסק', 'מפסקים', 'מתג', 'מתגים'],
    'מפסקים': ['מפסק', 'מפסקי', 'מתג', 'מתגים'],
    'מתג': ['מפסק', 'מפסקים', 'מתגים'],
    'מתגים': ['מפסק', 'מפסקי', 'מפסקים'],
    'מערכת': ['מערכות'],
    'מערכות': ['מערכת'],
    'אודיו': ['שמע', 'סאונד', 'audio'],
    'שמע': ['אודיו', 'סאונד', 'audio'],
    'סאונד': ['אודיו', 'שמע', 'audio'],
    'audio': ['אודיו', 'שמע'],
    'רמקולי': ['רמקול', 'רמקולימ', 'speaker', 'speakers'],
    'speakers': ['רמקול', 'רמקולימ', 'speaker'],
    'קולנוע': ['הום תיאטר', 'home theater'],
    'knx': ['קנקס', 'קיי אנ אקס'],
    'קנקס': ['knx'],
    'zwave': ['זיוויב', 'זי וייב', 'זי וויב'],
    'זיוויב': ['zwave'],
    'דימר': ['דימור', 'עמעומ', 'עמעמ', 'dimmer', 'dimming'],
    'דימור': ['דימר', 'עמעומ', 'dimming'],
    'עמעומ': ['דימר', 'דימור', 'dimmer'],
    'dimmer': ['דימר', 'דימור', 'עמעומ', 'dimming'],
    'dimming': ['דימר', 'דימור', 'dimmer'],
    'זכוכית': ['glass'],
    'glass': ['זכוכית'],
    'switch': ['מפסק', 'מתג', 'לחצנ'],
    'מסמכ': ['מפרט', 'קטלוג', 'pdf'],
    'מפרט': ['spec', 'specification', 'datasheet'],
    'spec': ['מפרט', 'specification', 'datasheet'],
    'datasheet': ['מפרט', 'spec', 'specification'],
    'סכמת': ['סכמה', 'סכמות', 'תרשימ', 'diagram'],
    'סכמה': ['סכמת', 'סכמות', 'תרשימ', 'diagram'],
    'סכמות': ['סכמה', 'סכמת', 'תרשימ', 'diagram'],
    'diagram': ['סכמת', 'סכמות', 'תרשימ'],
    'רמקול': ['רמקולימ', 'רמקולי', 'speaker', 'speakers'],
    'רמקולימ': ['רמקול', 'רמקולי', 'speaker', 'speakers'],
    'speaker': ['רמקול', 'רמקולימ', 'speakers'],
    'אינטרקומ': ['intercom'],
    'intercom': ['אינטרקומ'],
    'סימנס': ['siemens'],
    'siemens': ['סימנס'],
    'gewiss': ['גוויס', 'גויס'],
    'גוויס': ['gewiss', 'גויס'],
    'גויס': ['gewiss', 'גוויס'],
    'eelectron': ['איאלקטרונ', 'אי אלקטרונ'],
    'איאלקטרונ': ['eelectron'],
    'אלקטרונ': ['eelectron'],
  };

  const getTermVariants = (term: string) => {
    const variants = new Set([term]);
    for (const synonym of TERM_SYNONYMS[term] || []) variants.add(synonym);
    if (!/[\u0590-\u05ff]/.test(term)) return [...variants];

    if (term.length > 3 && /^[ובכלמשה]/.test(term)) variants.add(term.slice(1));
    for (const variant of [...variants]) {
      for (const synonym of TERM_SYNONYMS[variant] || []) variants.add(synonym);
      if (variant.length > 4 && variant.endsWith('ימ')) variants.add(variant.slice(0, -2));
      if (variant.length > 4 && variant.endsWith('ות')) variants.add(variant.slice(0, -2));
      if (variant.length > 3 && variant.endsWith('ת')) variants.add(`${variant.slice(0, -1)}ה`);
      if (variant.length > 3 && variant.endsWith('ה')) variants.add(`${variant.slice(0, -1)}ת`);
    }
    return [...variants].map(normalize).filter((variant) => variant.length > 1);
  };

  const isProductUrl = (url: string) =>
    url === '/siemens-knx-products/' ||
    url === '/equipment/' ||
    url === '/gp9/' ||
    url.startsWith('/equipment/') ||
    url.startsWith('/articles/siemens-') ||
    url.startsWith('/av/') ||
    url === '/knx-switch-advisor/' ||
    url === '/knx-switch-configurator/';

  const isProductHubUrl = (url: string) =>
    url === '/siemens-knx-products/' || url === '/equipment/' ||
    url === '/audio-and-sound-systems/' || url === '/knx-switch-advisor/';

  const hasPhrase = (text: string, phrase: string) => (` ${text} `).includes(` ${phrase} `);

  const containsTerm = (text: string, term: string) => {
    if (hasPhrase(text, term)) return true;
    if (term.length < 3 || /\d| /.test(term)) return false;
    const padded = ` ${text}`;
    if (padded.includes(` ${term}`)) return true;
    return /^[א-ת]{4,}$/.test(term) && [...'ובלכמשה'].some((prefix) => padded.includes(` ${prefix}${term}`));
  };

  const fillerWords = new Set(['את', 'של', 'על', 'עם', 'כל', 'יש', 'איפה', 'מחפש', 'מחפשת', 'תמצא', 'הראה', 'the', 'for', 'with', 'please', 'find', 'show', 'me']);
  const getQueryTerms = (query: string) => {
    const terms = [...new Set(query.split(' ').filter((term) => term.length > 1 || /^\d$/.test(term)))];
    const meaningful = terms.filter((term) => !fillerWords.has(term));
    return meaningful.length ? meaningful : terms;
  };

  const getModelPattern = (query: string) => {
    const compact = query.replace(/ /g, '');
    if (!/^[a-z0-9]{3,36}$/.test(compact) || !/[a-z]/.test(compact) || !/\d/.test(compact)) return null;
    return new RegExp(`(?:^| )${[...compact].join(' ?')}(?= |$)`);
  };

  const isNearMatch = (word: string, term: string) => {
    if (Math.abs(word.length - term.length) > 1) return false;
    let mismatch = 0;
    while (mismatch < term.length && word[mismatch] === term[mismatch]) mismatch += 1;
    if (mismatch === term.length) return word.length === term.length + 1;
    if (word.length !== term.length) {
      const [longer, shorter] = word.length > term.length ? [word, term] : [term, word];
      return longer.slice(mismatch + 1) === shorter.slice(mismatch);
    }
    return word.slice(mismatch + 1) === term.slice(mismatch + 1) ||
      (word[mismatch] === term[mismatch + 1] && word[mismatch + 1] === term[mismatch] &&
        word.slice(mismatch + 2) === term.slice(mismatch + 2));
  };

  const prepareRecord = (record: SearchRecord): PreparedRecord => {
    const normalizedTitle = normalize(record.title);
    const normalizedDescription = normalize(record.description);
    const normalizedHeadings = normalize(record.headings);
    return {
      ...record,
      normalizedTitle,
      normalizedDescription,
      normalizedHeadings,
      normalizedBody: normalize(record.body),
      normalizedUrl: normalize(record.url),
      normalizedIdentifiers: normalize(record.identifiers || ''),
      headlineWords: [...new Set(`${normalizedTitle} ${normalizedDescription} ${normalizedHeadings}`.split(' '))],
    };
  };

  const loadIndex = () => {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json', { cache: 'no-cache' })
        .then((response) => {
          if (!response.ok) throw new Error(`Search index returned ${response.status}`);
          return response.json() as Promise<SearchRecord[]>;
        })
        .then((records) => records.map(prepareRecord))
        .catch((error) => {
          indexPromise = undefined;
          throw error;
        });
    }
    return indexPromise;
  };

  const appendHighlighted = (element: HTMLElement, text: string, terms: string[]) => {
    if (!terms.length) {
      element.textContent = text;
      return;
    }

    const escaped = terms
      .filter(Boolean)
      .sort((a, b) => b.length - a.length)
      .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    if (!escaped.length) {
      element.textContent = text;
      return;
    }
    const matcher = new RegExp(`(${escaped.join('|')})`, 'giu');
    let cursor = 0;

    for (const match of text.matchAll(matcher)) {
      const position = match.index ?? 0;
      element.append(document.createTextNode(text.slice(cursor, position)));
      const mark = document.createElement('mark');
      mark.textContent = match[0];
      element.append(mark);
      cursor = position + match[0].length;
    }

    element.append(document.createTextNode(text.slice(cursor)));
  };

  const makeSnippet = (record: SearchRecord, query: string, terms: string[]) => {
    const text = record.body || record.description;
    const lowerText = text.toLocaleLowerCase('he');
    const candidates = [query, ...terms].filter(Boolean).map((term) => term.toLocaleLowerCase('he'));
    let position = candidates.reduce((best, term) => {
      const found = lowerText.indexOf(term);
      return found >= 0 && (best < 0 || found < best) ? found : best;
    }, -1);

    if (position < 0) position = 0;
    const start = Math.max(0, position - 90);
    const end = Math.min(text.length, position + 210);
    return `${start ? '…' : ''}${text.slice(start, end).trim()}${end < text.length ? '…' : ''}`;
  };

  const scoreRecord = (
    record: PreparedRecord,
    normalizedQuery: string,
    modelPattern: RegExp | null,
    termGroups: string[][],
  ) => {
    const fields = [
      [record.normalizedIdentifiers, 56],
      [record.normalizedTitle, 48],
      [record.normalizedHeadings, 24],
      [record.normalizedDescription, 18],
      [record.normalizedUrl, 16],
      [record.normalizedBody, 5],
    ] as const;
    const modelScore = modelPattern && fields.find(([value]) => modelPattern.test(value))?.[1];
    let score = fields.reduce((sum, [value, weight]) => sum + (hasPhrase(value, normalizedQuery) ? weight * 2 : 0), 0);
    let matchedTerms = 0;
    let strongMatches = 0;
    let usedTypo = false;
    for (const alternatives of termGroups) {
      const [term] = alternatives;
      const termModel = /\d/.test(term) ? getModelPattern(term) : null;
      const field = fields.find(([value]) => alternatives.some((variant) => containsTerm(value, variant)) || termModel?.test(value));
      if (field) {
        const [value, weight] = field;
        score += hasPhrase(value, term) ? weight : weight * 0.72;
        matchedTerms += 1;
        if (weight >= 18) strongMatches += 1;
      } else if (!usedTypo && !/\d/.test(term) && term.length >= (/^[a-z]+$/.test(term) ? 5 : 4) &&
        record.headlineWords.some((word) => isNearMatch(word, term))) {
        matchedTerms += 1;
        usedTypo = true;
        score += 8;
      } else if (/\d/.test(term) && !modelScore) {
        return 0;
      }
    }

    if (modelScore) score += 180 + modelScore * 2;
    else if (matchedTerms < termGroups.length) {
      if (termGroups.length < 3 || matchedTerms !== termGroups.length - 1 || !strongMatches) return 0;
      score *= 0.32;
    }
    if (usedTypo) score *= 0.65;
    if (record.type === 'pdf' && matchedTerms === termGroups.length && /(?:מפרט|סכמ|קטלוג|pdf|spec|diagram)/.test(normalizedQuery)) score += 18;

    const asksAudio = /(?:אודיו|שמע|סאונד|רמקול|קולנוע|audio|speaker)/.test(normalizedQuery);
    const asksSwitches = /(?:מפסק|מתג|לחצנ|knx|קנקס)/.test(normalizedQuery);
    if (asksAudio && record.url.startsWith('/av/')) score += 16;
    if (asksSwitches && (record.url === '/knx-switch-advisor/' || record.url === '/knx-switch-configurator/')) score += 8;
    if (isProductUrl(record.url) && !isProductHubUrl(record.url)) score += 10;
    return score;
  };

  const renderResults = (matches: Array<{ record: SearchRecord; score: number }>, query: string, terms: string[]) => {
    if (!results || !status) return;
    results.replaceChildren();
    if (moreButton) moreButton.hidden = true;

    if (!matches.length) {
      status.textContent = `לא נמצאו תוצאות עבור „${query}”. נסו מונח קצר, מק״ט או מספר יציאות.`;
      return;
    }

    const appendResults = (start: number) => {
      const end = Math.min(start + resultsPerPage, matches.length);
      status.textContent = `מוצגות ${end} מתוך ${matches.length} תוצאות עבור „${query}”.`;
      if (moreButton) {
        moreButton.hidden = end === matches.length;
        moreButton.onclick = () => appendResults(end);
      }
      for (const { record } of matches.slice(start, end)) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = record.url;
        link.className = 'group block rounded-xl border border-brand-100 p-4 transition hover:border-accent-400 hover:bg-brand-50 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-accent-500';

        if (record.type === 'pdf' || isProductUrl(record.url)) {
          const type = document.createElement('span');
          type.className = 'mb-1.5 inline-flex rounded-full bg-accent-50 px-2.5 py-1 text-xs font-bold text-accent-800';
          type.textContent = record.type === 'pdf' ? 'מסמך PDF' : isProductHubUrl(record.url) ? 'מרכז מוצרים ומפרטים' : 'מוצר / מפרט טכני';
          link.append(type);
        }

        const title = document.createElement('h3');
        title.className = 'text-lg font-bold text-brand-900 transition group-hover:text-accent-700';
        appendHighlighted(title, record.title, terms);

        const snippet = document.createElement('p');
        snippet.className = 'mt-1.5 line-clamp-2 text-sm leading-6 text-brand-600';
        appendHighlighted(snippet, makeSnippet(record, query, terms), terms);

        const path = document.createElement('span');
        path.className = 'mt-2 block text-xs font-medium text-accent-700';
        path.dir = 'ltr';
        path.textContent = record.url;

        link.append(title, snippet, path);
        item.append(link);
        results.append(item);
      }
      if (start > 0) results.children[start]?.querySelector('a')?.focus();
    };
    appendResults(0);
  };

  const search = async () => {
    if (!input || !status || !results) return;
    const query = input.value.trim();
    const normalizedQuery = normalize(query);
    const modelPattern = getModelPattern(normalizedQuery);
    const terms = getQueryTerms(normalizedQuery);
    const termGroups = terms.map(getTermVariants);

    if (normalizedQuery.length < 2 || !terms.length) {
      results.replaceChildren();
      if (moreButton) moreButton.hidden = true;
      status.textContent = 'הקלידו לפחות שתי אותיות כדי להתחיל לחפש.';
      return;
    }

    if (moreButton) moreButton.hidden = true;
    status.textContent = 'מחפש…';
    try {
      const records = await loadIndex();
      if (input.value.trim() !== query) return;
      const matches = records
        .map((record) => ({ record, score: scoreRecord(record, normalizedQuery, modelPattern, termGroups) }))
        .filter(({ score }) => score > 0)
        .sort((left, right) => right.score - left.score || left.record.title.localeCompare(right.record.title, 'he'));
      renderResults(matches, query, query.split(/\s+/).filter((term) => term.length > 1 || /^\d+$/.test(term)));
    } catch (error) {
      if (input.value.trim() !== query) return;
      console.error(error);
      status.textContent = 'לא הצלחנו לטעון את החיפוש. נסו שוב בעוד רגע.';
    }
  };

  openButton?.addEventListener('click', () => {
    if (!dialog) return;
    dialog.showModal();
    loadIndex().catch(() => undefined);
    window.requestAnimationFrame(() => input?.focus());
  });

  closeButton?.addEventListener('click', () => dialog?.close());
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    search();
  });
  input?.addEventListener('input', () => {
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(search, 140);
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
