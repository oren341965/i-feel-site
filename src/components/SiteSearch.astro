<dialog
  id="site-search-dialog"
  data-pagefind-ignore
  class="site-search-dialog fixed inset-0 m-auto w-[min(94vw,760px)] max-h-[min(88vh,760px)] overflow-hidden rounded-2xl bg-white p-0 text-right text-brand-900 shadow-2xl"
  aria-labelledby="site-search-title"
>
  <div class="flex max-h-[min(88vh,760px)] flex-col">
    <div class="border-b border-brand-100 bg-brand-50 px-4 py-4 sm:px-6">
      <div class="mb-3 flex items-center justify-between gap-4">
        <div>
          <h2 id="site-search-title" class="text-xl font-extrabold text-brand-900">חיפוש באתר</h2>
          <p class="mt-1 text-sm text-brand-600">חפשו פתרונות לבית חכם, לבקרת מבנה, למוצרים ולפרויקטים</p>
        </div>
        <button
          id="site-search-close"
          type="button"
          class="shrink-0 rounded-lg p-2 text-brand-600 hover:bg-white hover:text-brand-900"
          aria-label="סגירת החיפוש"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <form id="site-search-form" role="search" class="relative">
        <label for="site-search-input" class="sr-only">מה תרצו למצוא?</label>
        <input
          id="site-search-input"
          type="search"
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          placeholder="לדוגמה: בית חכם, בקרת מבנה, תריסים או אינטרקום"
          class="w-full rounded-xl border border-brand-200 bg-white py-3.5 pe-14 ps-4 text-base outline-none transition placeholder:text-brand-400 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
        />
        <button
          type="submit"
          class="absolute inset-y-1.5 end-1.5 grid w-11 place-items-center rounded-lg bg-accent-500 text-white transition hover:bg-accent-600"
          aria-label="חיפוש"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.35-5.4A6.75 6.75 0 1 1 4.5 11.25a6.75 6.75 0 0 1 13.5 0Z" />
          </svg>
        </button>
      </form>
    </div>

    <div class="min-h-48 flex-1 overflow-y-auto px-4 py-5 sm:px-6">
      <p id="site-search-status" class="text-sm text-brand-600" role="status" aria-live="polite">
        הקלידו לפחות שתי אותיות כדי להתחיל לחפש.
      </p>
      <ol id="site-search-results" class="mt-4 space-y-3" aria-label="תוצאות חיפוש"></ol>
      <p id="site-search-no-results" class="mt-5 hidden rounded-xl bg-brand-50 p-4 text-sm leading-6 text-brand-700">
        לא מצאתם את מה שחיפשתם?
        <a
          id="site-search-whatsapp"
          href="https://wa.me/972533450205"
          target="_blank"
          rel="noopener noreferrer"
          class="ms-1 inline-flex font-bold text-accent-700 underline underline-offset-2"
        >כתבו לנו בוואטסאפ</a>
      </p>
    </div>
  </div>
</dialog>

<style>
  .site-search-dialog::backdrop {
    background: rgb(15 31 54 / 72%);
    backdrop-filter: blur(3px);
  }

  .site-search-dialog[open] { animation: search-dialog-in 160ms ease-out; }
  .site-search-dialog mark {
    border-radius: 0.2rem;
    background: #f7e7bb;
    color: inherit;
    padding-inline: 0.08rem;
  }

  @keyframes search-dialog-in {
    from { opacity: 0; transform: translateY(-0.5rem) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-search-dialog[open] { animation: none; }
  }
</style>

<script is:inline>
  (() => {
    const openButton = document.querySelector('#site-search-open');
    const closeButton = document.querySelector('#site-search-close');
    const dialog = document.querySelector('#site-search-dialog');
    const form = document.querySelector('#site-search-form');
    const input = document.querySelector('#site-search-input');
    const status = document.querySelector('#site-search-status');
    const results = document.querySelector('#site-search-results');
    const noResults = document.querySelector('#site-search-no-results');
    const whatsapp = document.querySelector('#site-search-whatsapp');

    if (!dialog || !form || !input || !status || !results || !noResults || !whatsapp) return;

    const synonyms = {
      'בית חכם': ['מערכת בית חכם', 'בקרה לבית'],
      'בקרה': ['בית חכם', 'בקרת מבנה'],
      'bms': ['בקרת מבנה'],
      'בקרת מבנה': ['bms', 'מערכת בקרת מבנה'],
      'תריסים': ['הצללה', 'מנועי תריס'],
      'אינטרקום': ['אינטרפון', 'מערכת אינטרקום'],
    };

    const normalize = (value) => value
      .normalize('NFKD')
      .toLocaleLowerCase('he')
      .replace(/[\u0591-\u05c7]/g, '')
      .replace(/[ךםןףץ]/g, (letter) => ({ 'ך': 'כ', 'ם': 'מ', 'ן': 'נ', 'ף': 'פ', 'ץ': 'צ' })[letter] || letter)
      .replace(/[^\p{L}\p{N}]+/gu, ' ')
      .trim();

    let pagefindPromise;
    let debounceTimer;
    let analyticsTimer;
    let searchSequence = 0;
    let lastTrackedQuery = '';

    const loadPagefind = () => {
      if (!pagefindPromise) {
        pagefindPromise = import('/pagefind/pagefind.js').then(async (pagefind) => {
          await pagefind.init();
          return pagefind;
        });
      }
      return pagefindPromise;
    };

    const trackSearch = (query, count) => {
      if (query === lastTrackedQuery) return;
      lastTrackedQuery = query;
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'view_search_results', {
          search_term: query,
          results_count: count,
          page_path: window.location.pathname,
        });
      }
    };

    const renderResults = (items, query) => {
      results.replaceChildren();
      noResults.classList.toggle('hidden', items.length > 0);

      if (!items.length) {
        status.textContent = 'לא נמצאו תוצאות עבור „' + query + '”. אפשר לנסות מילה אחרת או לפנות אלינו.';
        return;
      }

      status.textContent = 'נמצאו ' + items.length + ' תוצאות עבור „' + query + '”.';
      for (const result of items) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = result.url;
        link.className = 'group block rounded-xl border border-brand-100 p-4 transition hover:border-accent-400 hover:bg-brand-50 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-accent-500';

        const title = document.createElement('h3');
        title.className = 'text-lg font-bold text-brand-900 transition group-hover:text-accent-700';
        title.textContent = result.meta?.title || 'לצפייה בעמוד';

        const snippet = document.createElement('p');
        snippet.className = 'mt-1.5 line-clamp-2 text-sm leading-6 text-brand-600';
        // Pagefind's excerpt is HTML-escaped and only includes its own <mark> highlights.
        snippet.innerHTML = result.excerpt || result.plain_excerpt || '';

        const path = document.createElement('span');
        path.className = 'mt-2 block text-xs font-medium text-accent-700';
        path.dir = 'ltr';
        path.textContent = result.url;

        link.append(title, snippet, path);
        item.append(link);
        results.append(item);
      }
    };

    const search = async () => {
      const query = input.value.trim();
      const normalizedQuery = normalize(query);
      const sequence = ++searchSequence;

      if (normalizedQuery.length < 2) {
        results.replaceChildren();
        noResults.classList.add('hidden');
        status.textContent = 'הקלידו לפחות שתי אותיות כדי להתחיל לחפש.';
        return;
      }

      status.textContent = 'מחפש…';
      try {
        const pagefind = await loadPagefind();
        const alternatives = synonyms[normalizedQuery] || [];
        const searches = await Promise.all([query, ...alternatives].map((term) => pagefind.search(term)));
        const found = new Map();

        for (const searchResult of searches) {
          for (const result of searchResult.results.slice(0, 8)) {
            if (found.has(result.id)) continue;
            found.set(result.id, await result.data());
          }
        }

        if (sequence !== searchSequence) return;
        const items = [...found.values()].slice(0, 10);
        renderResults(items, query);
        window.clearTimeout(analyticsTimer);
        analyticsTimer = window.setTimeout(() => trackSearch(normalizedQuery, items.length), 700);
      } catch (error) {
        if (sequence !== searchSequence) return;
        console.error('Pagefind search failed', error);
        results.replaceChildren();
        noResults.classList.remove('hidden');
        status.textContent = 'לא הצלחנו לטעון את החיפוש כרגע. אפשר לפנות אלינו בוואטסאפ.';
      }
    };

    openButton?.addEventListener('click', () => {
      dialog.showModal();
      loadPagefind().catch(() => undefined);
      window.requestAnimationFrame(() => input.focus());
    });

    closeButton?.addEventListener('click', () => dialog.close());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(debounceTimer);
      search();
    });
    input.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(search, 220);
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
