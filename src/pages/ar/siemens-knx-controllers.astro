---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/ar/siemens-knx-controllers/';
const title = 'وحدات تحكم Siemens KNX: أدلة المنتجات | i-feel';
const description = 'شروحات عربية لوحدات Siemens KNX للتبديل والتحكم بالستائر والتعتيم والتحكم متعدد الوظائف.';
const items = [
  { id: 'n532d31', model: 'Siemens N 532D31', name: 'وحدة تبديل بأربع مخارج', summary: 'وحدة KNX مدمجة لتبديل أربعة دوائر مستقلة للإضاءة أو لأحمال مناسبة.', specs: '4 مخارج مرحل · 10AX · تبديل 230 فولت · 4 وحدات DIN · حمل سعوي حتى 140 ميكروفاراد', sections: [
    ['مخارج مستقلة بملامسات حرة الجهد', 'تقوم أربعة مرحلات ثنائية الاستقرار بتبديل دوائر كهربائية منفصلة. تتيح الملامسات الحرة الجهد اختيار ترتيب التغذية المناسب للوحة، وفق التصميم الكهربائي. يجب أن تبقى الأحمال المقاومة والحثية والسعوية ضمن تصنيفات Siemens والتصميم المعتمد.'],
    ['الفحص المحلي ووظائف ETS', 'تُظهر المؤشرات الميكانيكية حالة المرحل وتتيح تغيير الملامس محلياً أثناء التشغيل الأولي أو في حالات الطوارئ. هذا التغيير الميكانيكي لا يرسل إشارة إلى ناقل KNX. تشمل وظائف ETS تغذية راجعة للحالة، والتحكم المركزي والمنطقي، والتأخيرات، والتشغيل المحدد زمنياً، والوضع الليلي، والتنبيه قبل الإيقاف، وما يصل إلى 8 مشاهد لكل قناة، ووظائف التجاوز، وعدادات ساعات التشغيل وعدد مرات التبديل، وضبط الحالة بعد عودة التغذية أو الناقل.'],
    ['حدود الاستخدام', 'هذه وحدة تشغيل وإيقاف. لا تحتوي على مخفّت إضاءة ولا تتحكم مباشرة بمحركات الستائر. يجب فحص تيار البدء الفعلي وحدود الشركة المصنّعة لمشغلات LED والأحمال الأخرى قبل تحديد عدد الأجهزة على كل قناة.']
  ], datasheet: 'https://sid.siemens.com/v/u/A6V11252209', he: '/articles/siemens-n532d31-knx-4-switch-output/' },
  { id: 'n532d51', model: 'Siemens N 532D51', name: 'وحدة تبديل بثمانية مخارج', summary: 'ثمانية مخارج مرحل KNX قابلة للبرمجة بشكل مستقل للإضاءة والمقابس والأحمال المتوافقة.', specs: '8 مخارج مرحل · 10AX · تبديل 230 فولت · 8 وحدات DIN · حمل سعوي حتى 140 ميكروفاراد', sections: [
    ['ثماني دوائر مستقلة', 'يمكن لكل مرحل ثنائي الاستقرار ذي الملامس الحر الجهد تبديل دائرة مستقلة. صُممت الوحدة للأحمال المقاومة والحثية والسعوية، بما في ذلك أنظمة الإضاءة الحديثة المناسبة، مع الالتزام بحدود Siemens والتصميم الكهربائي المهني.'],
    ['التشغيل الأولي ووظائف ETS', 'تساعد المؤشرات الميكانيكية والتشغيل المحلي في فحص التوصيلات. لا يرسل التشغيل الميكانيكي المحلي إشارة إلى KNX. توفر ETS تغذية راجعة لكل قناة، ووظائف منطقية ومركزية، وتأخيرات، وتشغيلاً زمنياً وليلياً، وتنبيهاً قبل الإيقاف، وما يصل إلى 8 مشاهد لكل مخرج، ووظائف تجاوز، وعدادات ساعات التشغيل ومرات التبديل، وإعدادات عودة التغذية والناقل.'],
    ['فحص الأحمال', 'لا يغني تصنيف 10AX أو حد الحمل السعوي البالغ 140 ميكروفاراد عن حساب تيار البدء. تحقق من بيانات مشغّل LED أو مزود الطاقة الفعلي، وأجهزة الحماية والأسلاك وظروف التركيب. الوحدة للتبديل ولا تخفّف الإضاءة ولا تشغّل محركات الستائر مباشرة.']
  ], datasheet: 'https://sid.siemens.com/v/u/A6V11252209', he: '/articles/siemens-n532d51-knx-8-switch-output/' },
  { id: 'n543d31', model: 'Siemens N 543D31', name: 'وحدة ستائر AC بأربع قنوات', summary: 'تحكم KNX لما يصل إلى أربعة محركات ستائر أو مظلات متوافقة بجهد 230 فولت AC.', specs: '4 قنوات لمحركات AC · 230 فولت AC · كشف النهايات · قياس تلقائي لزمن الحركة', sections: [
    ['التحكم بالموضع والتظليل', 'تتحكم الوحدة بمحركات AC المتوافقة للرفع والخفض والإيقاف. يمكن لوظائف KNX توفير ضبط الموضع والشرائح والمشاهد وتغذية راجعة للحالة وقياس زمن الحركة تلقائياً، حسب تطبيق ETS وتوصيلات المحرك.'],
    ['التشغيل الأولي والسلامة', 'اضبط كل محرك وحدود حركته وفق تعليمات Siemens. يمنع التعشيق إصدار أوامر متزامنة باتجاهين متعاكسين. استخدم مخطط التوصيل والحماية الكهربائية المناسبة؛ ولا توصل محركات بمدخل تحكم غير متوافق.'],
    ['حدود الاستخدام', 'هذا الطراز مخصص لمحركات التظليل AC. ليس مفتاح إضاءة أو مخفّتاً. تحقق من تيار المحرك وطريقة التوصيل وعمل حدود الحركة قبل التركيب.']
  ], datasheet: 'https://sid.siemens.com/v/u/A6V13264591', he: '/articles/siemens-n543d31-knx-4-blind-actuator/' },
  { id: 'n543d51', model: 'Siemens N 543D51', name: 'وحدة ستائر AC بثماني قنوات', summary: 'وحدة KNX بسعة أكبر للتحكم بما يصل إلى ثمانية محركات تظليل متوافقة بجهد 230 فولت AC.', specs: '8 قنوات لمحركات AC · 230 فولت AC · تحكم بالموضع والشرائح · وظائف الحالة والسلامة', sections: [
    ['التحكم بثمانية محركات تظليل', 'تدير الوحدة ما يصل إلى ثمانية محركات AC متوافقة للستائر أو الستائر القماشية أو المظلات أو الشرائح. قد تشمل الأوامر الصعود والنزول والإيقاف والموضع وضبط الشرائح والمشاهد وتغذية راجعة للحالة، وفق تطبيق ETS المختار.'],
    ['أزمنة الحركة والتشغيل الأولي', 'اضبط أزمنة حركة المحرك وسلوكه عند تحديد الموضع أثناء التشغيل الأولي، ثم تحقق من اتجاه الحركة وحدودها عند المحرك. تعتمد وظائف التعشيق والسلامة على التوصيل والبرمجة الصحيحين. اتبع تعليمات Siemens الرسمية.'],
    ['حدود الاستخدام', 'تتحكم هذه الوحدة بمحركات التظليل AC ولا توفر تعتيماً للإضاءة. تحقق من القيم الكهربائية ومتطلبات الشركة المصنّعة لكل محرك.']
  ], datasheet: 'https://sid.siemens.com/v/u/A6V13264591', he: '/articles/siemens-n543d51-knx-8-blind-actuator/' },
  { id: 'n554d31', model: 'Siemens N 554D31', name: 'مخفّت KNX شامل بأربع قنوات', summary: 'أربع قنوات تعتيم بالتحكم في طور التيار، مع تعرف تلقائي على نوع الحمل وحماية إلكترونية.', specs: '4 قنوات · حتى 300 فولت-أمبير للقناة · حتى 1,000 فولت-أمبير للقنوات المتجاورة · تعتيم بالطور', sections: [
    ['تعتيم مرن', 'صُمم المخفّت الشامل للأحمال المقاومة والحثية والسعوية المتوافقة. يتعرف تلقائياً على نوع الحمل المتصل ويدعم التعتيم بالتحكم في طور التيار. تعتمد السعة الفعلية على إعداد القنوات والحمل المتصل.'],
    ['سعة الحمل والحماية', 'تصل السعة الاسمية إلى 300 فولت-أمبير لكل قناة، أو إلى 1,000 فولت-أمبير عند دمج القنوات المتجاورة وفق مواصفات Siemens. تساعد الحماية الإلكترونية في التعامل مع الحمل الزائد والقصر وارتفاع الحرارة. يجب التحقق أيضاً من تخفيض القدرة وتوافق الحمل.'],
    ['حدود الاستخدام', 'استخدم المصابيح ومشغلات LED المتوافقة صراحةً مع طريقة قطع الطور المختارة. لا يكفي أن يذكر على المصباح أنه قابل للتعتيم؛ اختبر تركيبة المصباح والمشغّل المحددة واتبع حدود Siemens.']
  ], datasheet: 'https://sid.siemens.com/v/u/A6V15749829', he: '/articles/siemens-n554d31-knx-4-channel-dimmer/' },
  { id: 'n56722', model: 'Siemens N 567/22', name: 'وحدة تبديل بستة عشر مخرجاً', summary: 'تبديل مركزي عبر KNX لما يصل إلى 16 دائرة إضاءة أو حمل مناسب، مع زر ومؤشر حالة لكل مخرج.', specs: '16 مخرج مرحل · حتى 10 أمبير للأحمال المقاومة · 8 وحدات DIN · 8 مشاهد لكل مخرج · تغذية إلكترونية 230 فولت', sections: [
    ['ستة عشر مخرجاً قابلاً للبرمجة بشكل مستقل', 'يمكن لكل مخرج تبديل دائرة إضاءة أو مقبس أو مروحة أو مضخة أو حمل آخر مناسب، إذا كان نوع الحمل وتيار البدء والحماية والأسلاك متوافقاً مع تعليمات Siemens والتصميم الكهربائي. قيمة 10 أمبير تخص الأحمال المقاومة ولا ينبغي تطبيقها تلقائياً على مشغلات LED أو المحركات.'],
    ['تشغيل مباشر من اللوحة', 'يوجد زر ومؤشر حالة لكل قناة. يساعد الوضع المباشر في فحص التركيب والصيانة. تستخدم الإلكترونيات تغذية داخلية 230 فولت AC، لذلك يتاح التشغيل المباشر عند وجود الكهرباء حتى إذا لم يكن اتصال ناقل KNX متاحاً.'],
    ['وظائف ETS وحدود الاستخدام', 'تدعم ETS إعدادات مستقلة لكل قناة، ومنها ملامسات مفتوحة أو مغلقة عادةً، وتأخير التشغيل والإيقاف، والمنطق، وتغذية راجعة للحالة، والوضع الليلي، والتنبيه قبل الإيقاف التلقائي، وما يصل إلى 8 مشاهد لكل مخرج، وضبط السلوك بعد عودة الكهرباء. هذه وحدة تشغيل وإيقاف وليست مخفّتاً ولا وحدة مباشرة لمحركات الستائر.']
  ], datasheet: 'https://sid.siemens.com/api/khub/documents/iYsEFlCM~23xEGwvrDHQvw/content', he: '/articles/siemens-n56722-knx-16-output/' },
  { id: 'n56881', model: 'Siemens N 568/81', name: 'وحدة KNX متعددة الوظائف بـ24 مخرجاً', summary: 'وحدة متعددة الوظائف تجمع تبديل الأحمال والتحكم بمظلات AC وDC وسرعات المراوح وصمامات التدفئة والتبريد.', specs: '24 مخرج مرحل · تبديل حتى 10 أمبير · حتى 12 محرك AC · حتى محركين DC · 3 سرعات للمروحة', sections: [
    ['التبديل والتظليل', 'يمكن إعداد مخارج المرحل الـ24 لأحمال تبديل مناسبة. تتحكم الوحدة بما يصل إلى 12 محرك تظليل AC باستخدام مخرجين لكل محرك، أو حتى محركين DC باستخدام أربعة مخارج لكل محرك لعكس القطبية. وقد تشمل الوظائف الحركة والإيقاف والموضع وضبط الشرائح والمشاهد وتغذية راجعة للحالة وفق تطبيق Siemens والتوصيلات.'],
    ['وظائف الغرفة', 'يمكن للجهاز التحكم بمروحة أحادية الطور ذات ما يصل إلى ثلاث سرعات وبصمامات تدفئة وتبريد متوافقة في أنظمة ثنائية أو رباعية الأنابيب. تشمل أوضاع تحكم الصمام التشغيل والإيقاف أو PWM أو التحكم بثلاث نقاط، حسب التطبيق.'],
    ['تمييز مهم', 'مخارج محركات DC مخصصة لمحركات التظليل وليست قنوات تعتيم للإضاءة. كما أن تحكم PWM مخصص لصمامات التدفئة والتبريد وليس لتعتيم المصابيح. تحقق من تصنيف كل حمل وتجميع المخارج ونوع المحرك والتوصيلات في وثائق Siemens الرسمية.']
  ], datasheet: 'https://sid.siemens.com/api/khub/documents/QHpaRe5AzLTfZHRTZ9gDqg/content', he: '/articles/siemens-n56881-knx-24-output/' }
];
const jsonLd = JSON.stringify({ '@context':'https://schema.org', '@type':'CollectionPage', name:title, description, inLanguage:'ar', url:canonical });
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl={canonical} jsonLd={jsonLd}>
  <main lang="ar" dir="rtl" class="bg-white text-brand-900">
    <header class="bg-brand-900 text-white py-12 md:py-16">
      <div class="max-w-5xl mx-auto px-4">
        <nav aria-label="اختيار اللغة" class="flex gap-3 text-sm font-bold mb-7">
          <a class="rounded-full border border-white/30 px-4 py-2 hover:bg-white/10" href="/siemens-knx-products/">עברית</a>
          <a class="rounded-full border border-white/30 px-4 py-2 hover:bg-white/10" href="/en/siemens-knx-controllers/">English</a>
          <a class="rounded-full bg-accent-500 px-4 py-2" href="/ar/siemens-knx-controllers/" aria-current="page">العربية</a>
        </nav>
        <p class="text-accent-300 font-bold">Siemens GAMMA / KNX · أدلة المنتجات</p>
        <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">وحدات تحكم Siemens KNX</h1>
        <p class="mt-5 max-w-4xl text-lg text-brand-100 leading-relaxed">شروحات باللغة العربية لوحدات Siemens KNX للتبديل والتحكم بالتظليل والتعتيم والوظائف المتعددة المستخدمة في مشاريعنا. يجب التحقق من التصنيفات الفنية وتوافق الأحمال وفق أحدث نشرة Siemens والتصميم المعتمد للمشروع.</p>
      </div>
    </header>
    <div class="max-w-5xl mx-auto px-4 py-10">
      <nav class="rounded-2xl border border-brand-100 bg-brand-50 p-5 mb-10" aria-label="قائمة وحدات التحكم">
        <h2 class="font-extrabold text-xl mb-3">اختر وحدة التحكم</h2>
        <div class="flex flex-wrap gap-2">{items.map((item) => <a class="rounded-full bg-white border border-brand-100 px-3 py-2 text-sm font-semibold hover:border-accent-500" href={'#' + item.id}>{item.model}</a>)}</div>
      </nav>
      {items.map((item) => <article id={item.id} class="scroll-mt-6 border-b border-brand-100 py-9">
        <p class="text-sm uppercase tracking-wide text-accent-700 font-bold">Siemens GAMMA / KNX</p>
        <h2 class="mt-2 text-3xl font-extrabold">{item.model}: {item.name}</h2>
        <p class="mt-3 text-lg text-brand-700 leading-relaxed">{item.summary}</p>
        <p class="mt-4 rounded-xl bg-brand-50 p-4 font-semibold text-brand-800">{item.specs}</p>
        {item.sections.map(([heading, body]) => <section class="mt-6"><h3 class="text-xl font-extrabold">{heading}</h3><p class="mt-2 text-brand-700 leading-7">{body}</p></section>)}
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="rounded-lg bg-accent-600 px-4 py-3 font-bold text-white hover:bg-accent-700" href={item.datasheet} target="_blank" rel="noopener noreferrer">نشرة Siemens الرسمية</a>
          <a class="rounded-lg border border-brand-200 px-4 py-3 font-bold text-brand-800 hover:border-accent-500" href={item.he}>الصفحة بالعبرية</a>
        </div>
      </article>)}
      <p class="mt-8 text-sm leading-6 text-brand-600">هذا الدليل ملخص لقدرات المنتجات. يجب التحقق من الاختيار النهائي والأسلاك وتصنيفات الأحمال وأجهزة الحماية وفق أحدث وثائق Siemens ومتطلبات الكهرباء المعمول بها.</p>
    </div>
  </main>
</BaseLayout>