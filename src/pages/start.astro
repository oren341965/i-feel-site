---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingCta from '../components/FloatingCta.astro';
import content from '../page-html/start.html?raw';

const meta = {
  title: "תכנון פרויקט חדש — בית חכם, פרויקט יזמי או בקרת מבנה | i-feel",
  description: "מתכננים פרויקט חדש? נכוון אתכם למסלול הנכון: בית חכם ללקוחות פרטיים, פתרונות ליזמים ודיירים, או בקרת מבנה BMS. ייעוץ ראשוני חינם: 03-508-9553.",
  canonical: "https://i-feel.co.il/start/",
  ogTitle: "תכנון פרויקט חדש — בית חכם, פרויקט יזמי או בקרת מבנה | i-feel",
  ogDescription: "ספרו לנו מי אתם — ונכוון אתכם למסלול, למפרט ולאיש הנכון. תכנון, אינטגרציה ושירות תחת אחריות אחת.",
  ogUrl: "https://i-feel.co.il/start/",
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://i-feel.co.il/" },
          { "@type": "ListItem", "position": 2, "name": "תכנון פרויקט חדש", "item": "https://i-feel.co.il/start/" }
        ]
      },
      {
        "@type": "WebPage",
        "@id": "https://i-feel.co.il/start/",
        "url": "https://i-feel.co.il/start/",
        "name": "תכנון פרויקט חדש — בית חכם, פרויקט יזמי או בקרת מבנה",
        "inLanguage": "he-IL",
        "isPartOf": { "@id": "https://i-feel.co.il/#website" },
        "about": { "@id": "https://i-feel.co.il/#business" }
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
  <FloatingCta label="קבלת ייעוץ" href="#consult" event="consultation_click" params={{ source_page: '/start/', trigger: 'floating_cta' }} />
</BaseLayout>
