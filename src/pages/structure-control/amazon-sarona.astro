---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'משרדי Amazon שרונה, תל אביב | מקרה בוחן BMS | i-feel', description: 'משרדי Amazon במתחם שרונה — מערכת KNX מרכזית לניהול אלפי צלונים ממונעים ותאורה: ניצול אור טבעי, חיסכון באנרגיה ושליטה מרכזית.', canonical: 'https://i-feel.co.il/structure-control/amazon-sarona/', ogTitle: 'משרדי Amazon שרונה | מקרה בוחן | i-feel', ogDescription: 'ניהול חכם של תאורה ואלפי צלונים ממונעים — KNX, חיסכון אנרגטי ושליטה מרכזית.', ogUrl: 'https://i-feel.co.il/structure-control/amazon-sarona/', ogImage: 'https://i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">משרדי Amazon – שרונה</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <p class="text-accent-600 font-bold mb-1">מקרה בוחן · אוטומציה ותאורה חכמה</p>
    <h1>משרדי Amazon – שרונה, תל אביב</h1>
    <p class="text-xl text-brand-700"><strong>סוג מבנה:</strong> משרדי הייטק / תאגיד בינלאומי. <strong>טכנולוגיה:</strong> KNX · בקרת תאורה והצללה.</p>
    <h2>האתגר</h2>
    <p>הקמת מערכת אוטומציה מתקדמת עבור משרדי החברה במתחם שרונה, תוך ניהול חכם של מערכות התאורה והצלונים בקנה מידה גדול. הפרויקט דרש שילוב בין נוחות המשתמשים, ניצול מיטבי של אור טבעי, חיסכון באנרגיה ויכולת שליטה מרכזית על אלפי רכיבי הצללה ותאורה ברחבי המתחם.</p>
    <h2>הפתרון שבוצע</h2>
    <p>תכנון והטמעה של מערכת KNX מרכזית המנהלת את מערכות התאורה והצלונים במבנה. המערכת מאפשרת שליטה אוטומטית וידנית, תרחישים מותאמים לאזורי עבודה שונים, וניהול חכם של חדירת אור השמש בהתאם לשעות היום ולתנאי הסביבה.</p>
    <h2>המערכת והטכנולוגיה</h2>
    <p>מערכת KNX מתקדמת לניהול ושליטה על מערכות התאורה וההצללה, כולל אינטגרציה בין מערכות הבקרה השונות במבנה.</p>
    <h2>היקף הפרויקט</h2>
    <ul>
      <li>שליטה ובקרה על מערכות התאורה</li>
      <li>ניהול אלפי צלונים ממונעים ברחבי המבנה</li>
      <li>תרחישי תאורה והצללה אוטומטיים</li>
      <li>שליטה לפי אזורים, קומות וחללי עבודה</li>
      <li>תזמון אוטומטי בהתאם לשעות הפעילות</li>
      <li>ממשקי שליטה למשתמשים ולצוותי האחזקה</li>
    </ul>
    <h2>יתרונות ותוצאות</h2>
    <ul>
      <li>שיפור משמעותי בנוחות העובדים ובסביבת העבודה</li>
      <li>ניצול מיטבי של תאורה טבעית והפחתת עומסי חום</li>
      <li>חיסכון באנרגיה באמצעות בקרה חכמה על תאורה והצללה</li>
      <li>שליטה מרכזית על אלפי רכיבי מערכת מממשק אחד</li>
      <li>גמישות מלאה בהתאמת סביבת העבודה לצרכים משתנים</li>
      <li>מערכת אמינה ויציבה המתאימה למתחמי משרדים גדולים ומורכבים</li>
    </ul>
    <p class="mt-8 flex flex-wrap gap-3 not-prose">
      <a href="/structure-control/projects/" class="inline-flex items-center bg-accent-500 hover:bg-accent-600 text-white px-5 py-2.5 rounded-lg font-bold">← לכל פרויקטי בקרת המבנה</a>
      <a href="/contactus/" class="inline-flex items-center bg-brand-100 hover:bg-brand-200 text-brand-900 px-5 py-2.5 rounded-lg font-bold">לפרויקט דומה אצלכם — צרו קשר</a>
    </p>
  </article>
</BaseLayout>
