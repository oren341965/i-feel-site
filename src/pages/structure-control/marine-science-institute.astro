---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'מכון מדעי הים | מקרה בוחן בקרת מבנה | i-feel', description: 'מכון מדעי הים — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/marine-science-institute/', ogTitle: 'מכון מדעי הים | i-feel', ogDescription: 'חיסכון משמעותי בחשמל, נוחות בלימוד ובמחקר ותפעול קל.', ogUrl: 'https://www.i-feel.co.il/structure-control/marine-science-institute/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">מכון מדעי הים</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>מכון מדעי הים</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> מוסד אקדמי / מחקר.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת תאורה חכמה למבנה הכולל כיתות לימוד, מעבדות מחקר וחללים אקדמיים, תוך התאמת התאורה לאופי השימוש המשתנה בכל חלל ושיפור היעילות האנרגטית.</p>
    <h2>פתרון I Feel</h2>
    <p>תכנון והטמעה של מערכת KNX בשילוב גלאי נוכחות וחיישנים חכמים, המאפשרים הפעלה אוטומטית של התאורה בהתאם לתפוסת החללים ולצרכי המשתמשים.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX · גלאי נוכחות · חיישנים</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>שליטה ובקרה על תאורת כיתות הלימוד</li><li>שליטה על תאורת מעבדות וחדרי מחקר</li><li>גלאי נוכחות להפעלה וכיבוי אוטומטיים</li><li>ניהול אזורי תאורה לפי שימוש</li><li>תרחישי תאורה לסביבות לימוד ומחקר</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>חיסכון משמעותי בצריכת החשמל</li><li>שיפור נוחות בלימוד ובמחקר</li><li>הפעלה אוטומטית לפי תפוסה</li><li>מערכת אמינה, גמישה וקלה לתפעול</li></ul>
    <h2>תוצאה</h2>
    <p>חיסכון משמעותי בחשמל, נוחות בלימוד ובמחקר ותפעול קל.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>