---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/structure-control/projects/museum-of-illusions/';
const img = '/structure-control/projects/museum-of-illusions';
const meta = {
  title: 'מוזיאון האשליות תל אביב | בקרת תאורה חכמה KNX · DALI | i-feel',
  description: 'פרויקט בקרת תאורה של i-feel במוזיאון האשליות בנמל תל אביב: שליטה חכמה בתאורה בתקן KNX עם בקרי DALI, תרחישים ולוחות זמנים לתפעול יעיל וחסכוני.',
  canonical,
  ogTitle: 'מוזיאון האשליות תל אביב | בקרת תאורה חכמה KNX · DALI | i-feel',
  ogDescription: 'שליטה מרכזית בתאורה, דימור DALI, תרחישים והפעלות לפי זמנים — ניהול יעיל של מערכות התאורה באתר פעיל.',
  ogUrl: canonical,
  ogImage: 'https://i-feel.co.il/structure-control/projects/museum-of-illusions/museum-of-illusions-126.jpg',
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
        "@id": "https://i-feel.co.il/#business",
        "name": "i-feel",
        "url": "https://i-feel.co.il/",
        "logo": "https://i-feel.co.il/assets/ifeel-logo.png",
        "telephone": "+972-3-508-9553",
        "email": "sales@i-feel.co.il",
        "address": { "@type": "PostalAddress", "streetAddress": "אימבר 14", "addressLocality": "פתח תקווה", "addressRegion": "מחוז המרכז", "postalCode": "4951148", "addressCountry": "IL" },
        "areaServed": { "@type": "Country", "name": "Israel" },
        "sameAs": ["https://www.facebook.com/SmarthomeIsrael", "https://www.instagram.com/ifeelisrael", "https://www.linkedin.com/company/i-feel-smart-home-systems"]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://i-feel.co.il/" },
          { "@type": "ListItem", "position": 2, "name": "בקרת מבנה", "item": "https://i-feel.co.il/structure-control/" },
          { "@type": "ListItem", "position": 3, "name": "פרויקטים", "item": "https://i-feel.co.il/structure-control/projects/" },
          { "@type": "ListItem", "position": 4, "name": "מוזיאון האשליות תל אביב", "item": canonical }
        ]
      },
      {
        "@type": "Article",
        "headline": "בקרת תאורה חכמה במוזיאון האשליות תל אביב — מקרה בוחן",
        "image": "https://i-feel.co.il/structure-control/projects/museum-of-illusions/museum-of-illusions-126.jpg",
        "author": { "@id": "https://i-feel.co.il/#business" },
        "publisher": { "@id": "https://i-feel.co.il/#business" },
        "mainEntityOfPage": canonical
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article dir="rtl">
    <!-- פירורי לחם -->
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">מוזיאון האשליות</span></div></nav>

    <!-- HERO ויזואלי עם תמונת פרויקט אמיתית -->
    <header class="relative min-h-[60vh] md:min-h-[70vh] flex items-end">
      <img src={`${img}/museum-of-illusions-126.jpg`} alt="בקרת תאורה במוזיאון האשליות תל אביב — פרויקט i-feel" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/25"></div>
      <div class="relative max-w-6xl mx-auto px-4 py-12 md:py-16 w-full text-white">
        <p class="inline-block bg-accent-500 rounded-full px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן · פרויקט KNX</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-4xl">בקרת תאורה חכמה במוזיאון האשליות בנמל תל אביב</h1>
        <p class="text-xl text-brand-100 mt-5 max-w-3xl">אתר חווייתי עם מערכות פעילות, תאורה משתנה וקהל מבקרים לאורך כל היום — מנוהל ממערכת בקרה מרכזית אחת לתפעול יעיל, בטוח וחסכוני.</p>
      </div>
    </header>

    <!-- נתוני פרויקט מהירים -->
    <section class="bg-brand-900 text-white"><div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג פרויקט</div><div class="font-bold text-lg mt-1">בקרת תאורה KNX · DALI</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מיקום</div><div class="font-bold text-lg mt-1">מוזיאון האשליות, נמל תל אביב</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מערכות</div><div class="font-bold text-lg mt-1">תאורה · דימור DALI</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג לקוח</div><div class="font-bold text-lg mt-1">מסחרי / מבנה ציבורי</div></div>
    </div></section>

    <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
      <section id="overview"><h2>על הפרויקט</h2><p>מוזיאון האשליות בנמל תל אביב הוא אתר שבו חוויית המבקר נשענת על שילוב מדויק בין חללים, תאורה, צבעים ותחושת תנועה. כשאתר כזה פעיל לאורך שעות רבות, ניהול ידני של התאורה הופך למסורבל, לא מדויק ויקר באנרגיה. i-feel הקימה פתרון בקרת תאורה שמנהל את התאורה בצורה חכמה, אוטומטית ומדויקת.</p></section>

      <!-- גלריה גדולה ונקייה -->
      <section id="gallery"><h2>תמונות מהפרויקט</h2>
      <div class="not-prose grid sm:grid-cols-2 gap-4 my-6">
        <a href={`${img}/museum-of-illusions-126.jpg`} class="sm:col-span-2 block"><img src={`${img}/museum-of-illusions-126.jpg`} alt="מוזיאון האשליות תל אביב — תצוגת תאורה ובקרה" class="w-full h-72 md:h-[28rem] object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" /></a>
        <img src={`${img}/museum-of-illusions-125.jpg`} alt="מוזיאון האשליות — חלל תצוגה עם תאורה מנוהלת" class="w-full h-56 md:h-72 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
        <img src={`${img}/museum-of-illusions-124.jpg`} alt="מוזיאון האשליות — תאורה חכמה בחללי התצוגה" class="w-full h-56 md:h-72 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
        <img src={`${img}/museum-of-illusions-123.jpg`} alt="מוזיאון האשליות — מערכת בקרת התאורה של i-feel" class="sm:col-span-2 w-full h-56 md:h-80 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
      </div></section>

      <section id="challenge"><h2>האתגר</h2><p>במוזיאון פעיל יש אזורים רבים עם צרכים שונים: חללים ציבוריים, אזורי תצוגה, מעברים, עמדות שירות ואזורי תפעול. כל אזור צריך תאורה שמתאימה לשימוש שלו — אבל צוות התפעול צריך דרך פשוטה לראות את המצב, לשלוט בתאורה ולמנוע הפעלה מיותרת. בלי בקרה מרכזית, התוצאה היא עבודה ידנית מפוזרת, בזבוז אנרגיה ושחיקת מערכות.</p></section>

      <section id="solution"><h2>הפתרון של i-feel</h2><p>i-feel תכננה והקימה מערכת בקרת תאורה חכמה בתקן KNX עם בקרי DALI, שמרכזת את ניהול התאורה לממשק אחד, עם אוטומציה מלאה לפי שעות הפעילות של המוזיאון. במקום הפעלה ידנית, התאורה עובדת לפי לוגיקה מתוכננת מראש.</p></section>

      <section id="systems"><h2>מערכות שנכללו</h2>
      <ul>
        <li><strong>שליטה מרכזית בתאורה</strong> — תרחישים וזמני הפעלה לכל אזור.</li>
        <li><strong>בקרת DALI</strong> — שליטה ודימור מדויקים בכל גוף תאורה.</li>
        <li><strong>לוחות זמנים אוטומטיים</strong> — הפעלה וכיבוי בלי מגע יד אדם.</li>
      </ul></section>

      <section id="result"><h2>התוצאה</h2><p>צוות התפעול קיבל שליטה מסודרת, עקבית וחכמה במקום הסתמכות על זיכרון או הדלקה ידנית. המבקרים נהנים מחוויה נעימה ויציבה יותר, הצוות עובד בצורה רגועה יותר, והמבנה צורך פחות אנרגיה כשאין בכך צורך — חיסכון ישיר בעלויות התפעול.</p></section>

      <section id="why"><h2>למה i-feel היה האינטגרטור הנכון</h2><p>בקרת מבנה לאתר חווייתי דורשת לא רק ציוד, אלא הבנה של אופן השימוש במבנה. i-feel תכננה, התקינה, תכנתה ונותנת <a href="/service-and-maintenance/">שירות</a> תחת קורת גג אחת — ספק אחד שאחראי על כל המערכת מקצה לקצה. רוצים לראות עוד? ראו את <a href="/structure-control/projects/">כל פרויקטי בקרת המבנה</a> או קראו על <a href="/structure-control/">בקרת מבנה BMS</a>.</p></section>
    </div></div>

    <section id="contact" class="bg-brand-900 text-white py-16"><div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">צריכים בקרת מבנה לאתר פעיל או מבנה מסחרי?</h2>
      <p class="text-xl text-brand-200 mb-8">i-feel מתכננת ומיישמת מערכות BMS לתאורה, מיזוג, אנרגיה, לוחות זמנים ותפעול מרכזי.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3.5 rounded-lg font-semibold text-lg">03-508-9553</a><a href="/contactus/" class="bg-white/10 hover:bg-white/20 text-white px-7 py-3.5 rounded-lg font-semibold text-lg border border-white/30">לתיאום פגישה</a></div>
    </div></section>
  </article>
</BaseLayout>
