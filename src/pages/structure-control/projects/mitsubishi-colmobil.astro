import BaseLayout from '../../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/structure-control/projects/mitsubishi-colmobil/';
const hero = '/structure-control/projects/mitsubishi-colmobil/mitsubishi-colmobil.jpg';
const meta = {
  title: 'מיצובישי / כלמוביל | פרויקט i-feel',
  description: 'פרויקט i-feel באולם התצוגה של מיצובישי (כלמוביל) — [לאישור: מערכות שהותקנו].',
  canonical: url,
  ogTitle: 'מיצובישי / כלמוביל | פרויקט i-feel',
  ogDescription: 'פרויקט i-feel באולם התצוגה של מיצובישי (כלמוביל).',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il' + hero,
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id': 'https://i-feel.co.il/#business', name: 'i-feel', url: 'https://i-feel.co.il/', logo: 'https://i-feel.co.il/assets/ifeel-logo.png', telephone: '+972-3-508-9553', email: 'sales@i-feel.co.il', address: { '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed: { '@type':'Country', name:'Israel' } },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' },
        { '@type':'ListItem', position:2, name:'בקרת מבנה', item:'https://i-feel.co.il/structure-control/' },
        { '@type':'ListItem', position:3, name:'פרויקטים', item:'https://i-feel.co.il/structure-control/projects/' },
        { '@type':'ListItem', position:4, name:'מיצובישי / כלמוביל', item:url } ] },
      { '@type': 'CreativeWork', name: 'מיצובישי / כלמוביל — פרויקט i-feel', creator: { '@id':'https://i-feel.co.il/#business' }, image: 'https://i-feel.co.il' + hero },
      { '@type': 'Article', headline: 'מיצובישי / כלמוביל — מקרה בוחן', image: 'https://i-feel.co.il' + hero, author: { '@id':'https://i-feel.co.il/#business' }, publisher: { '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage: url, inLanguage: 'he-IL' },
      { '@type': 'FAQPage', mainEntity: [
        { '@type':'Question', name:'אילו מערכות הותקנו בפרויקט מיצובישי?', acceptedAnswer:{ '@type':'Answer', text:'[לאישור: רשימת המערכות — תאורה / KNX / DALI / בקרת מבנה / וכו׳].' } },
        { '@type':'Question', name:'איפה ממוקם הפרויקט?', acceptedAnswer:{ '@type':'Answer', text:'[לאישור: עיר/סניף כלמוביל].' } } ] }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article dir="rtl">
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">מיצובישי / כלמוביל</span></div></nav>

    <header class="relative min-h-[52vh] md:min-h-[60vh] flex items-end">
      <img src={hero} alt="פרויקט i-feel באולם התצוגה של מיצובישי (כלמוביל)" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/30"></div>
      <div class="relative max-w-6xl mx-auto px-4 py-12 md:py-16 w-full text-white">
        <p class="inline-block bg-accent-500 rounded-full px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן · מסחרי / אולם תצוגה</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-4xl">מיצובישי / כלמוביל — פרויקט i-feel</h1>
        <p class="text-xl text-brand-100 mt-5 max-w-3xl">אולם תצוגה של מיצובישי (כלמוביל) — [לאישור: משפט פתיחה קצר על מה i-feel סיפקה].</p>
      </div>
    </header>

    <section class="bg-brand-900 text-white"><div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג נכס</div><div class="font-bold text-lg mt-1">אולם תצוגה / מסחרי</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מיקום</div><div class="font-bold text-lg mt-1">[לאישור]</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מערכות</div><div class="font-bold text-lg mt-1">[לאישור]</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">לקוח</div><div class="font-bold text-lg mt-1">כלמוביל / מיצובישי</div></div>
    </div></section>

    <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
      <section id="overview"><h2>על הפרויקט</h2><p>[לאישור: 2-3 משפטים על הפרויקט באולם התצוגה של מיצובישי (כלמוביל) — מה i-feel תכננה והקימה.]</p></section>
      <section id="challenge"><h2>האתגר</h2><p>[לאישור: מה היה האתגר — תאורת אולם תצוגה, שטחים ציבוריים, חיסכון אנרגיה, שליטה מרכזית.]</p></section>
      <section id="systems"><h2>המערכות שהותקנו</h2><ul><li>[לאישור: מערכת 1 — למשל בקרת תאורה DALI / KNX]</li><li>[לאישור: מערכת 2]</li><li>[לאישור: מערכת 3]</li></ul></section>
      <section id="solution"><h2>הפתרון של i-feel</h2><p>[לאישור: מה i-feel תכננה, התקינה ותכנתה.] ראו <a href="/structure-control/">בקרת מבנה</a> ו<a href="/structure-control/dali-lighting-control/">בקרת תאורה DALI</a>.</p></section>
      <section id="result"><h2>התוצאה</h2><p>[לאישור: התוצאה ללקוח — שליטה מרכזית, חיסכון, חוויית מבקרים.]</p></section>
    </div></div>

    <section id="contact" class="bg-brand-900 text-white py-16"><div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">צריכים פתרון דומה למבנה מסחרי?</h2>
      <p class="text-xl text-brand-200 mb-8">i-feel מתכננת ומיישמת בקרת תאורה, בקרת מבנה ואוטומציה לאולמות תצוגה ומבנים מסחריים.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3.5 rounded-lg font-semibold text-lg">03-508-9553</a><a href="/structure-control/projects/" class="bg-white/10 text-white px-7 py-3.5 rounded-lg font-semibold border border-white/30">לכל הפרויקטים</a></div>
    </div></section>
  </article>
</BaseLayout>
