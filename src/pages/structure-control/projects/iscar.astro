---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/structure-control/projects/iscar/';
const img = '/structure-control/projects/iscar';
const meta = {
  title: 'ISCAR — בקרת מבנה ותאורת DALI בבניין החדש | פרויקט BMS | i-feel',
  description: 'פרויקט בקרת מבנה של i-feel בבניין החדש של ISCAR: ניהול מרכזי של תאורת DALI ומערכות המבנה, בשילוב מסכי שליטה Siemens לתפעול חלק, מדויק ויעיל.',
  canonical,
  ogTitle: 'ISCAR — בקרת מבנה ותאורת DALI בבניין החדש | פרויקט BMS | i-feel',
  ogDescription: 'ניהול מרכזי של תאורת DALI ומערכות המבנה בבניין החדש של ISCAR, בשילוב מסכי שליטה Siemens לתפעול חלק ומקצועי.',
  ogUrl: canonical,
  ogImage: 'https://i-feel.co.il/structure-control/projects/iscar/iscar-building-exterior.jpeg',
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
        "@id": "https://i-feel.co.il/#business",
        "name": "i-feel",
        "url": "https://i-feel.co.il/",
        "logo": "https://i-feel.co.il/assets/ifeel-logo.png",
        "telephone": "+972-3-508-9553",
        "email": "sales@i-feel.co.il",
        "address": { "@type": "PostalAddress", "streetAddress": "אימבר 14", "addressLocality": "פתח תקווה", "addressRegion": "מחוז המרכז", "postalCode": "4951148", "addressCountry": "IL" },
        "areaServed": { "@type": "Country", "name": "Israel" },
        "sameAs": ["https://www.facebook.com/SmarthomeIsrael", "https://www.instagram.com/ifeelisrael", "https://www.linkedin.com/company/200156"]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://i-feel.co.il/" },
          { "@type": "ListItem", "position": 2, "name": "בקרת מבנה", "item": "https://i-feel.co.il/structure-control/" },
          { "@type": "ListItem", "position": 3, "name": "פרויקטים", "item": "https://i-feel.co.il/structure-control/projects/" },
          { "@type": "ListItem", "position": 4, "name": "ISCAR", "item": canonical }
        ]
      },
      {
        "@type": "Article",
        "headline": "בקרת מבנה ותאורת DALI בבניין החדש של ISCAR — מקרה בוחן",
        "image": "https://i-feel.co.il/structure-control/projects/iscar/iscar-building-exterior.jpeg",
        "author": { "@id": "https://i-feel.co.il/#business" },
        "publisher": { "@id": "https://i-feel.co.il/#business" },
        "mainEntityOfPage": canonical
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article dir="rtl">
    <!-- פירורי לחם -->
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">ISCAR</span></div></nav>

    <!-- HERO ויזואלי עם תמונת פרויקט אמיתית -->
    <header class="relative min-h-[60vh] md:min-h-[70vh] flex items-end">
      <img src={`${img}/iscar-building-exterior.jpeg`} alt="חזית הבניין החדש של ISCAR שבו הוטמעו מערכות בקרת מבנה של i-feel" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/25"></div>
      <div class="relative max-w-6xl mx-auto px-4 py-12 md:py-16 w-full text-white">
        <p class="inline-block bg-accent-500 rounded-full px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן · פרויקט BMS</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-4xl">בקרת מבנה ותאורת DALI בבניין החדש של ISCAR</h1>
        <p class="text-xl text-brand-100 mt-5 max-w-3xl">בניין חדש ומתקדם של אחת החברות המובילות בתעשייה — עם מערכת בקרת מבנה מרכזית המנהלת את תאורת ה-DALI ומערכות המבנה, בשילוב מסכי שליטה Siemens לתפעול חלק ומקצועי.</p>
      </div>
    </header>

    <!-- נתוני פרויקט מהירים -->
    <section class="bg-brand-900 text-white"><div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג פרויקט</div><div class="font-bold text-lg mt-1">בקרת מבנה · תאורת DALI</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">לקוח</div><div class="font-bold text-lg mt-1">ISCAR</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מערכות</div><div class="font-bold text-lg mt-1">DALI · Siemens · בקרה מרכזית</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג לקוח</div><div class="font-bold text-lg mt-1">תעשייה / מבנה מסחרי</div></div>
    </div></section>

    <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
      <section id="overview"><h2>על הפרויקט</h2><p>חברת ISCAR, מהחברות המובילות בתחום האלומיניום והתעשייה, הקימה בניין חדש ומתקדם ובחרה ב-i-feel להקמה ולהטמעה של מערכות בקרת מבנה ותאורה חכמה. המטרה: בניין שמתפקד מהיום הראשון כסביבת עבודה חכמה, יעילה ונוחה לתפעול — עם שליטה מרכזית אחת על התאורה ומערכות המבנה.</p></section>

      <!-- גלריה גדולה ונקייה -->
      <section id="gallery"><h2>תמונות מהפרויקט</h2>
      <div class="not-prose grid sm:grid-cols-2 gap-4 my-6">
        <a href={`${img}/iscar-open-space-dali-lighting.jpeg`} class="sm:col-span-2 block"><img src={`${img}/iscar-open-space-dali-lighting.jpeg`} alt="חלל מרכזי בבניין ISCAR עם מערכות תאורה ובקרת מבנה מתקדמות" class="w-full h-72 md:h-[28rem] object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" /></a>
        <img src={`${img}/iscar-showroom-lighting.jpeg`} alt="חלל תצוגה בבניין ISCAR עם תאורה חכמה הנשלטת באמצעות מערכת DALI" class="w-full h-56 md:h-72 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
        <img src={`${img}/iscar-office-dali-lighting.jpeg`} alt="אזור משרדים בבניין ISCAR עם גופי תאורה הנשלטים במערכת DALI" class="w-full h-56 md:h-72 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
        <img src={`${img}/iscar-siemens-control-panel.jpeg`} alt="מסך שליטה Siemens לניהול מערכות בקרת המבנה בבניין ISCAR" class="sm:col-span-2 w-full h-56 md:h-80 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
      </div></section>

      <section id="challenge"><h2>האתגר</h2><p>בניין חדש בקנה מידה תעשייתי כולל חללים רבים ושונים — אזורי תצוגה, חללים פתוחים, משרדים ואזורי תפעול — שלכל אחד מהם צרכי תאורה משלו. ניהול ידני ומפוזר של תרחישי התאורה והמערכות הופך לא מדויק, מסורבל ובזבזני. נדרשה מערכת אחת שתרכז את השליטה, תתאים את התאורה לכל חלל, ותאפשר לצוות התפעול ניהול פשוט ורציף.</p></section>

      <section id="solution"><h2>הפתרון של i-feel</h2><p>i-feel תכננה והקימה מערכת ניהול מרכזית השולטת בבקרי ה-DALI ובמערכות התאורה ברחבי הבניין. המערכת מאפשרת שליטה נוחה, מדויקת ורציפה בתרחישי התאורה, תוך התאמה לצורכי המשתמשים ולחללים השונים במבנה. במקביל שולבו מסכי שליטה של Siemens המאפשרים ניהול מלא של מערכות המבנה בצורה חלקה, מקצועית ואינטואיטיבית.</p></section>

      <section id="systems"><h2>מערכות שנכללו</h2>
      <ul>
        <li><strong>בקרת תאורת DALI</strong> — שליטה מרכזית בבקרי DALI ובתרחישי תאורה לכל אזור בבניין.</li>
        <li><strong>מערכת ניהול מרכזית</strong> — שליטה רציפה ומדויקת בכלל מערכות התאורה מממשק אחד.</li>
        <li><strong>מסכי שליטה Siemens</strong> — ניהול מלא ואינטואיטיבי של מערכות המבנה.</li>
        <li><strong>התאמה לחללים</strong> — תרחישי תאורה לפי השימוש בכל חלל: תצוגה, חלל פתוח ומשרדים.</li>
        <li><strong>תפעול יומיומי נוח</strong> — סביבת עבודה מתקדמת ויעילה לצוות הבניין.</li>
      </ul></section>

      <section id="result"><h2>התוצאה</h2><p>שילוב המערכות מעניק ל-ISCAR סביבת עבודה מתקדמת, יעילה ונוחה לתפעול יומיומי. צוות הבניין מקבל שליטה מסודרת וחכמה בתאורה ובמערכות המבנה ממקום אחד, עם התאמה מדויקת לכל חלל — לתפעול חלק, מקצועי וחסכוני לאורך זמן.</p></section>

      <section id="why"><h2>למה i-feel היה האינטגרטור הנכון</h2><p>בקרת מבנה לבניין חדש בקנה מידה תעשייתי דורשת לא רק ציוד, אלא הבנה של אופן השימוש במבנה. i-feel תכננה, התקינה, תכנתה ונותנת <a href="/service-and-maintenance/">שירות</a> תחת קורת גג אחת — ספק אחד שאחראי על כל המערכת מקצה לקצה. רוצים לראות עוד? ראו את <a href="/structure-control/projects/">כל פרויקטי בקרת המבנה</a> או קראו על <a href="/structure-control/">בקרת מבנה BMS</a>.</p></section>
    </div></div>

    <section id="contact" class="bg-brand-900 text-white py-16"><div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">צריכים בקרת מבנה לבניין חדש או מבנה תעשייתי?</h2>
      <p class="text-xl text-brand-200 mb-8">i-feel מתכננת ומיישמת מערכות BMS לתאורה, תאורת DALI, מיזוג, אנרגיה ותפעול מרכזי.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3.5 rounded-lg font-semibold text-lg">03-508-9553</a><a href="/contactus/" class="bg-white/10 hover:bg-white/20 text-white px-7 py-3.5 rounded-lg font-semibold text-lg border border-white/30">לתיאום פגישה</a></div>
    </div></section>
  </article>
</BaseLayout>
