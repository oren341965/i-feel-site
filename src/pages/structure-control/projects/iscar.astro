---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/structure-control/projects/iscar/';
const img = '/structure-control/projects/iscar';
const faqs = [
  {
    question: 'מה הוטמע בפרויקט ISCAR בתפן?',
    answer: 'בפרויקט הוטמעה מערכת בקרת מבנה לניהול מרכזי של תאורת DALI ומערכות המבנה, עם ממשקי שליטה של Siemens המאפשרים לצוות התפעול לנהל את האזורים השונים ממקום אחד.'
  },
  {
    question: 'מה היתרון של DALI במבנה תעשייתי ומשרדי?',
    answer: 'DALI מאפשר חלוקה לאזורים וקבוצות, יצירת תרחישי תאורה, שינוי הגדרות ותפעול מדויק יותר של גופי התאורה. החיבור למערכת BMS מרכז את השליטה ומקל על התחזוקה.'
  },
  {
    question: 'האם מדובר במערכת בית חכם?',
    answer: 'לא. זהו פרויקט בקרת מבנה מקצועי למבנה תעשייתי ומשרדי. התכנון, התכנות, ההפעלה והשירות מותאמים לצוותי אחזקה, יועצים, מנהלי מתקנים ואנשי BMS.'
  },
  {
    question: 'מי מטפל בתכנון, בתכנות ובשירות?',
    answer: 'צוות הבקרה של i-feel מרכז את התכנון, האינטגרציה, התכנות, ההפעלה והשירות. כך נשמרת אחריות מקצועית רציפה לאורך חיי המערכת.'
  }
];

const meta = {
  title: 'ISCAR תפן: בקרת מבנה BMS ותאורת DALI | פרויקט i-feel',
  description: 'מקרה בוחן מקצועי: מערכת בקרת מבנה BMS ותאורת DALI בפרויקט ISCAR בתפן, עם ניהול מרכזי, ממשקי Siemens, תכנות ושירות של צוות i-feel.',
  canonical,
  ogTitle: 'ISCAR תפן: בקרת מבנה BMS ותאורת DALI | i-feel',
  ogDescription: 'מערכת BMS לניהול תאורת DALI ומערכות המבנה בפרויקט ISCAR בתפן, משלב התכנון ועד התכנות והשירות.',
  ogUrl: canonical,
  ogImage: 'https://i-feel.co.il/structure-control/projects/iscar/iscar-building-exterior.jpeg',
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
        "@id": "https://i-feel.co.il/#business",
        "name": "i-feel",
        "url": "https://i-feel.co.il/",
        "logo": "https://i-feel.co.il/assets/ifeel-logo.png",
        "telephone": "+972-3-508-9553",
        "email": "sales@i-feel.co.il",
        "foundingDate": "2008",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "אימבר 14",
          "addressLocality": "פתח תקווה",
          "addressRegion": "מחוז המרכז",
          "postalCode": "4951148",
          "addressCountry": "IL"
        },
        "areaServed": { "@type": "Country", "name": "Israel" },
        "sameAs": [
          "https://www.facebook.com/SmarthomeIsrael",
          "https://www.instagram.com/ifeelisrael",
          "https://www.linkedin.com/company/i-feel-smart-home-systems"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://i-feel.co.il/" },
          { "@type": "ListItem", "position": 2, "name": "בקרת מבנה", "item": "https://i-feel.co.il/structure-control/" },
          { "@type": "ListItem", "position": 3, "name": "פרויקטים", "item": "https://i-feel.co.il/structure-control/projects/" },
          { "@type": "ListItem", "position": 4, "name": "ISCAR", "item": canonical }
        ]
      },
      {
        "@type": "Article",
        "headline": "ISCAR תפן: בקרת מבנה BMS ותאורת DALI",
        "description": "מקרה בוחן מקצועי של מערכת בקרת מבנה, תאורת DALI, ניהול מרכזי ותפעול במבנה ISCAR בתפן.",
        "image": [
          "https://i-feel.co.il/structure-control/projects/iscar/iscar-building-exterior.jpeg",
          "https://i-feel.co.il/structure-control/projects/iscar/iscar-open-space-dali-lighting.jpeg",
          "https://i-feel.co.il/structure-control/projects/iscar/iscar-siemens-control-panel.jpeg"
        ],
        "author": { "@id": "https://i-feel.co.il/#business" },
        "publisher": { "@id": "https://i-feel.co.il/#business" },
        "mainEntityOfPage": canonical,
        "about": ["בקרת מבנה", "BMS", "DALI", "Siemens", "מבנה תעשייתי"]
      },
      {
        "@type": "VideoObject",
        "@id": `${canonical}#video`,
        "name": "בקרת מבנה BMS במשרדי ISCAR בגוש תפן",
        "description": "פרויקט בקרת מבנה BMS של i-feel במשרדי ISCAR בגוש תפן, כולל תאורת DALI, ממשקי Siemens וניהול מרכזי.",
        "uploadDate": "2026-07-27",
        "thumbnailUrl": "https://i.ytimg.com/vi/nxX_o_RmnDc/hqdefault.jpg",
        "contentUrl": "https://www.youtube.com/watch?v=nxX_o_RmnDc",
        "embedUrl": "https://www.youtube-nocookie.com/embed/nxX_o_RmnDc",
        "inLanguage": "he-IL",
        "publisher": { "@id": "https://i-feel.co.il/#business" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
        }))
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article dir="rtl">
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם">
      <div class="max-w-7xl mx-auto px-4 py-3 text-sm">
        <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
        <span class="mx-2 text-brand-400">›</span>
        <a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a>
        <span class="mx-2 text-brand-400">›</span>
        <a href="/structure-control/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a>
        <span class="mx-2 text-brand-400">›</span>
        <span class="text-brand-900 font-medium">ISCAR</span>
      </div>
    </nav>

    <header class="relative min-h-[60vh] md:min-h-[70vh] flex items-end">
      <img src={`${img}/iscar-building-exterior.jpeg`} alt="מבנה ISCAR בתפן שבו הוטמעה מערכת בקרת מבנה BMS של i-feel" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/25"></div>
      <div class="relative max-w-6xl mx-auto px-4 py-12 md:py-16 w-full text-white">
        <p class="inline-block bg-accent-500 rounded-full px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן מקצועי · בקרת מבנה BMS</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-4xl">בקרת מבנה ותאורת DALI בפרויקט ISCAR בתפן</h1>
        <p class="text-xl text-brand-100 mt-5 max-w-3xl">ניהול מרכזי של התאורה ומערכות המבנה בסביבה תעשייתית ומשרדית, עם תכנון, אינטגרציה, תכנות ושירות של צוות הבקרה של i-feel.</p>
      </div>
    </header>

    <section class="bg-brand-900 text-white">
      <div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">תחום</div><div class="font-bold text-lg mt-1">בקרת מבנה BMS</div></div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">אתר</div><div class="font-bold text-lg mt-1">ISCAR, תפן</div></div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מערכות</div><div class="font-bold text-lg mt-1">DALI · Siemens · ניהול מרכזי</div></div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">שירות</div><div class="font-bold text-lg mt-1">תכנון · תכנות · הפעלה</div></div>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16">
      <div class="prose-he">
        <section id="overview">
          <h2>על פרויקט ISCAR בתפן</h2>
          <p>ISCAR היא חברה תעשייתית גלובלית המתמחה בכלי חיתוך ובעיבוד מתכת. במבנה החברה בתפן פועלים אזורים בעלי אופי שונה, ובהם חללי עבודה פתוחים, משרדים, אזורי תצוגה ושטחים תפעוליים. לכל אזור שעות פעילות, צורכי תאורה ואופן שימוש שונים. לכן נדרש פתרון של בקרת מבנה מקצועית, ולא מערכת בית חכם המיועדת לדירה פרטית.</p>
          <p>i-feel תכננה והטמיעה בפרויקט מערכת BMS המרכזת את ניהול תאורת ה-DALI ומאפשרת לצוות התפעול לקבל תמונת מצב ברורה ולשלוט באזורים השונים דרך ממשקים מרכזיים. המערכת נבנתה כדי לפשט את התפעול היומיומי, לשמור על אחידות ולהעניק בסיס מסודר לשינויים, תחזוקה והרחבות בעתיד.</p>
        </section>

        <section id="challenge">
          <h2>האתגר: מבנה אחד, שימושים רבים</h2>
          <p>במבנה תעשייתי ומשרדי גדול, תאורה אינה מערכת אחידה. אולם תצוגה דורש תרחישים שונים ממשרד, וחלל עבודה פתוח מתנהל אחרת מאזור תפעולי. כאשר כל אזור פועל בנפרד, קשה לשמור על רמת תאורה עקבית, לבצע שינויים ולזהות במהירות את מקור התקלה. ריבוי לוחות, קבוצות וגופי תאורה עלול להפוך את העבודה השוטפת למסורבלת.</p>
          <p>האתגר המקצועי היה ליצור שכבת ניהול משותפת שתכבד את החלוקה לאזורים ותאפשר לכל חלל לפעול בהתאם לצרכיו. במקביל נדרשה מערכת שתהיה ברורה לצוות האחזקה, תאפשר תפעול מרכזי ותישאר נוחה לשירות גם לאחר מסירת הפרויקט.</p>
        </section>

        <section id="planning">
          <h2>תכנון מערכת הבקרה</h2>
          <p>תכנון BMS נכון מתחיל בהבנת המבנה, המשתמשים ואופן התפעול הרצוי. צוות i-feel מיפה את האזורים, את קבוצות התאורה ואת הפעולות שהמפעיל צריך לבצע ביום רגיל ובמצבים מיוחדים. לאחר מכן הוגדרה לוגיקת השליטה: אילו אזורים מופעלים יחד, אילו תרחישים נדרשים, מה מוצג בממשק ואיך ניתן להגיע במהירות לפעולה הנכונה.</p>
          <p>העבודה כללה תיאום בין התכנון, לוחות החשמל, תשתיות התקשורת, רכיבי DALI ומערכת הניהול. החיבור בין התחומים חשוב במיוחד, משום שמערכת מצוינת על הנייר אינה מספיקה אם הכתובות, הקבוצות, השמות והמסכים אינם תואמים למה שקיים בשטח.</p>
        </section>

        <section id="solution">
          <h2>הפתרון: DALI וממשק ניהול מרכזי</h2>
          <p>מערכת DALI מאפשרת לזהות ולנהל גופי תאורה וקבוצות בצורה גמישה יותר ממיתוג בסיסי. ניתן לחלק את התאורה לפי אזורים, להתאים תרחישים לשימוש בחלל ולשנות הגדרות בתהליך מסודר. בפרויקט ISCAR שולבה התאורה בתוך מערכת הבקרה המרכזית, כך שהמפעיל אינו נדרש לעבור בין מערכות נפרדות כדי לבצע פעולות שוטפות.</p>
          <p>ממשקי השליטה של Siemens מרכזים את המידע והפקודות הרלוונטיות לצוות התפעול. מטרת המסכים אינה רק להציג מערכת מרשימה, אלא להפוך מידע טכני לפעולות ברורות: בחירת אזור, הפעלה, כיבוי, מעבר בין מצבים וקבלת חיווי. בתיעוד הפומבי של הפרויקט איננו מפרסמים דגמי בקרים, כתובות רשת או תכניות פנימיות שאינן מאושרות לפרסום.</p>
        </section>

        <section id="systems">
          <h2>המערכות והיכולות בפרויקט</h2>
          <ul>
            <li><strong>בקרת תאורת DALI:</strong> חלוקה לקבוצות ואזורים, הפעלה מרכזית ותרחישים בהתאם לשימוש בחלל.</li>
            <li><strong>מערכת ניהול BMS:</strong> ריכוז התפעול בממשק אחד במקום עבודה מול מערכות מנותקות.</li>
            <li><strong>ממשקי Siemens:</strong> תצוגה ושליטה ברורה המותאמת לצוות התפעול והאחזקה.</li>
            <li><strong>שמות והיררכיה תפעולית:</strong> ארגון האזורים והפקודות באופן שמקל על איתור ושליטה.</li>
            <li><strong>בסיס לתחזוקה ולהרחבה:</strong> תיעוד ולוגיקה מסודרים המאפשרים טיפול מקצועי בהמשך חיי המבנה.</li>
          </ul>
        </section>

        <section id="implementation">
          <h2>ביצוע, תכנות ו-Commissioning</h2>
          <p>לאחר השלמת התכנון בוצעו הגדרת הרכיבים, חלוקת הקבוצות, בניית התרחישים והכנת מסכי השליטה. בשלב התכנות נבדקה ההתאמה בין שמות האזורים במערכת לבין המצב בפועל, כדי שהמפעיל יראה במסך את אותו מבנה שהוא מכיר מהשטח.</p>
          <p>בשלב ה-Commissioning נבדקו הפקודות, החיוויים וההתנהגות של כל אזור. בדיקות אלו מאפשרות לאתר פערים בין התכנון, החיווט וההגדרות לפני המסירה. בפרויקט BMS אמין, ההפעלה אינה סוף העבודה: חשוב למסור מערכת ברורה, לתעד את ההגדרות ולהבטיח שיש כתובת מקצועית להמשך טיפול.</p>
        </section>

        <section id="video">
          <h2>צפו במערכת בפעולה</h2>
          <p>הסרטון מציג חלק מהחללים ואת ממשק השליטה כפי שהם פועלים בפרויקט. הוא מאפשר ליועצי חשמל, יצרני לוחות, מנהלי מתקנים ואנשי BMS לראות כיצד תאורת DALI ומערכת ניהול מרכזית מתחברות לפתרון תפעולי אחד.</p>
          <div class="not-prose bg-brand-900 flex justify-center rounded-2xl p-4 my-6">
            <div class="w-full max-w-[300px] overflow-hidden rounded-xl" style="aspect-ratio:9/16;">
              <iframe loading="lazy" class="w-full h-full" src="https://www.youtube-nocookie.com/embed/nxX_o_RmnDc" title="בקרת מבנה BMS במשרדי ISCAR בגוש תפן, i-feel" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          </div>
        </section>

        <section id="gallery">
          <h2>תמונות מהפרויקט</h2>
          <div class="not-prose grid sm:grid-cols-2 gap-4 my-6">
            <a href={`${img}/iscar-open-space-dali-lighting.jpeg`} class="sm:col-span-2 block"><img src={`${img}/iscar-open-space-dali-lighting.jpeg`} alt="חלל עבודה מרכזי בפרויקט ISCAR בתפן עם תאורת DALI" class="w-full h-72 md:h-[28rem] object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" /></a>
            <img src={`${img}/iscar-showroom-lighting.jpeg`} alt="אולם תצוגה בפרויקט ISCAR עם תאורה הנשלטת באמצעות DALI" class="w-full h-56 md:h-72 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
            <img src={`${img}/iscar-office-dali-lighting.jpeg`} alt="אזור משרדים בפרויקט ISCAR עם בקרת תאורה" class="w-full h-56 md:h-72 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
            <img src={`${img}/iscar-siemens-control-panel.jpeg`} alt="ממשק שליטה Siemens לניהול מערכת בקרת המבנה בפרויקט ISCAR" class="sm:col-span-2 w-full h-56 md:h-80 object-cover rounded-2xl border border-brand-100 shadow-sm" loading="lazy" />
          </div>
        </section>

        <section id="result">
          <h2>התוצאה: תפעול ברור ומרוכז</h2>
          <p>הפרויקט מעניק לצוות המבנה דרך מסודרת לנהל את התאורה והאזורים השונים. במקום שליטה מפוזרת, מתקבל ממשק מרכזי שמציג את החלוקה התפעולית ומאפשר לבצע פעולות בצורה עקבית. החיבור בין DALI לבין ה-BMS תומך בגמישות תפעולית ומקל על ביצוע התאמות כאשר צורכי המבנה משתנים.</p>
          <p>הערך המרכזי הוא רציפות: אותו צוות שמכיר את התכנון ואת התכנות יכול לסייע גם בשירות, באבחון ובהרחבות. כך נשמר הידע שנצבר בפרויקט ומצטמצמת התלות בגורמים שאינם מכירים את המערכת.</p>
        </section>

        <section id="service">
          <h2>ניסיון ושירות לאורך חיי המערכת</h2>
