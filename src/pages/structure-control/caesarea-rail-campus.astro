---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/structure-control/caesarea-rail-campus/';
const hero = '/assets/structure-projects/img/image4.png';
const meta = {
  title: 'קמפוס רכבת קיסריה | מקרה בוחן BMS | i-feel',
  description: 'קמפוס רכבת קיסריה — מערכת BMS מרכזית מבוססת Siemens Desigo ו-DDC לקמפוס רחב היקף: ניהול אנרגיה, צ׳ילרים, יחידות טיפול באוויר, ניטור ובקרה בזמן אמת.',
  canonical: url,
  ogTitle: 'קמפוס רכבת קיסריה | מקרה בוחן BMS | i-feel',
  ogDescription: 'שליטה מרכזית מלאה, חיסכון אנרגטי ותחזוקה מבוססת-נתונים — Siemens Desigo, DDC.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il' + hero,
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id': 'https://i-feel.co.il/#business', name: 'i-feel', url: 'https://i-feel.co.il/', logo: 'https://i-feel.co.il/assets/ifeel-logo.png', telephone: '+972-3-508-9553', email: 'sales@i-feel.co.il', address: { '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed: { '@type':'Country', name:'Israel' }, sameAs: ['https://www.facebook.com/SmarthomeIsrael','https://www.instagram.com/ifeelisrael','https://www.linkedin.com/company/i-feel-smart-home-systems'] },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' },
        { '@type':'ListItem', position:2, name:'בקרת מבנה', item:'https://i-feel.co.il/structure-control/' },
        { '@type':'ListItem', position:3, name:'פרויקטים', item:'https://i-feel.co.il/structure-control/projects/' },
        { '@type':'ListItem', position:4, name:'קמפוס רכבת קיסריה', item:url } ] },
      { '@type': 'CreativeWork', name: 'קמפוס רכבת קיסריה — פרויקט בקרת מבנה BMS של i-feel', about: ['BMS','בקרת מבנה','Siemens Desigo','DDC','ניהול אנרגיה'], creator: { '@id':'https://i-feel.co.il/#business' }, locationCreated: { '@type':'Place', name:'קיסריה, ישראל' }, image: 'https://i-feel.co.il' + hero },
      { '@type': 'Article', headline: 'קמפוס רכבת קיסריה — מקרה בוחן בקרת מבנה BMS', image: 'https://i-feel.co.il' + hero, author: { '@id':'https://i-feel.co.il/#business' }, publisher: { '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage: url, inLanguage: 'he-IL' },
      { '@type': 'FAQPage', mainEntity: [
        { '@type':'Question', name:'איזו מערכת BMS הוקמה בקמפוס רכבת קיסריה?', acceptedAnswer:{ '@type':'Answer', text:'מערכת Siemens Desigo מבוססת בקרי DDC, עם שרת ניהול מרכזי המאגד את כלל מערכות הקמפוס תחת ממשק אחיד.' } },
        { '@type':'Question', name:'אילו מערכות מנוהלות בקמפוס?', acceptedAnswer:{ '@type':'Answer', text:'ניהול אנרגיה מרכזי, מערך הצ׳ילרים, יחידות טיפול באוויר (יט״א), מערכות חימום וקירור, מונים וצריכות אנרגיה, לוחות חשמל, לוחות זמנים ומגמות (Trends).' } },
        { '@type':'Question', name:'מה היה האתגר בפרויקט?', acceptedAnswer:{ '@type':'Answer', text:'ניהול תאורה, מיזוג ואנרגיה על קמפוס רחב היקף הכולל מבנים מרובים ומערכות מורכבות, עם אמינות וניטור מרכזי בזמן אמת.' } },
        { '@type':'Question', name:'מה הושג בפרויקט?', acceptedAnswer:{ '@type':'Answer', text:'שליטה מרכזית מלאה, שיפור היעילות האנרגטית, התראות מיידיות על תקלות, ותחזוקה מבוססת-נתונים שמצמצמת זמני השבתה.' } } ] }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article dir="rtl">
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">קמפוס רכבת קיסריה</span></div></nav>

    <header class="relative min-h-[52vh] md:min-h-[60vh] flex items-end">
      <img src={hero} alt="קמפוס רכבת קיסריה — מערכת בקרת מבנה BMS של i-feel" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/30"></div>
      <div class="relative max-w-6xl mx-auto px-4 py-12 md:py-16 w-full text-white">
        <p class="inline-block bg-accent-500 rounded-full px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן · בקרת מבנה BMS</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-4xl">קמפוס הרכבת קיסריה — BMS בקנה מידה קמפוס</h1>
        <p class="text-xl text-brand-100 mt-5 max-w-3xl">קמפוס רחב היקף עם מבנים מרובים ומערכות אנרגיה מורכבות, מנוהל ממערכת BMS מרכזית אחת המבוססת Siemens Desigo ו-DDC.</p>
      </div>
    </header>

    <section class="bg-brand-900 text-white"><div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג פרויקט</div><div class="font-bold text-lg mt-1">בקרת מבנה BMS</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מיקום</div><div class="font-bold text-lg mt-1">קיסריה</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג מבנה</div><div class="font-bold text-lg mt-1">קמפוס / מבני תחבורה</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">טכנולוגיה</div><div class="font-bold text-lg mt-1">Siemens Desigo · DDC</div></div>
    </div></section>

    <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
      <section id="challenge"><h2>האתגר</h2><p>הקמת מערכת בקרת מבנה מרכזית עבור קמפוס רחב היקף הכולל מספר מבנים ומערכות טכניות מורכבות. הפרויקט דרש ריכוז כלל מערכות האנרגיה והתפעול תחת פלטפורמה אחת, תוך שיפור היעילות האנרגטית, זמינות המערכות ויכולת הניהול השוטפת של צוותי האחזקה.</p></section>
      <section id="solution"><h2>הפתרון של i-feel</h2><p>תכנון והטמעה של מערכת <a href="/structure-control/">BMS</a> מרכזית המאפשרת שליטה, בקרה וניטור בזמן אמת של כלל מערכות המבנה. המערכת כוללת מסכי ניהול גרפיים, ניתוח נתוני אנרגיה, התראות אוטומטיות ומנגנוני דיווח מתקדמים המאפשרים קבלת החלטות מהירה ויעילה.</p></section>
      <section id="tech"><h2>המערכת והטכנולוגיה</h2><p>מערכת <a href="/siemens-desigo-bms/">Siemens Desigo</a> המבוססת על בקרי <strong>DDC</strong> מתקדמים, עם שרת ניהול מרכזי המאגד את כלל מערכות הקמפוס תחת ממשק אחיד.</p></section>
      <section id="scope"><h2>היקף הפרויקט</h2>
        <ul>
          <li>מערכת ניהול ובקרת אנרגיה מרכזית</li>
          <li>שליטה וניטור של מערך הצ׳ילרים</li>
          <li>בקרה על יחידות טיפול באוויר (יט״א)</li>
          <li>בקרה על מערכות חימום וקירור</li>
          <li>ניטור וניהול מונים וצריכות אנרגיה</li>
          <li>אינטגרציה ללוחות חשמל ומערכות תשתית</li>
          <li>ניהול לוחות זמנים ותרחישי הפעלה אוטומטיים</li>
          <li>מערכת מגמות (Trends) ודוחות ביצועים לצורכי תחזוקה והתייעלות אנרגטית</li>
        </ul>
      </section>
      <section id="results"><h2>יתרונות ותוצאות</h2>
        <ul>
          <li>שליטה מלאה על כלל מערכות הקמפוס מממשק מרכזי אחד</li>
          <li>שיפור משמעותי ביעילות האנרגטית ובמעקב אחר צריכות החשמל והאנרגיה</li>
          <li>קבלת התראות מיידיות על תקלות ואירועים קריטיים</li>
          <li>שיפור זמינות המערכות וצמצום זמני השבתה</li>
          <li>הפקת דוחות ניהוליים וניתוח ביצועי המערכות לאורך זמן</li>
          <li>תשתית גמישה המאפשרת הרחבות עתידיות ושילוב מערכות נוספות</li>
        </ul>
      </section>
      <section id="faq"><h2>שאלות ותשובות</h2>
        <details><summary>איזו מערכת BMS הוקמה בקמפוס?</summary><p>מערכת Siemens Desigo מבוססת DDC, עם שרת ניהול מרכזי המאגד את כל מערכות הקמפוס לממשק אחיד.</p></details>
        <details><summary>אילו מערכות נוהלו?</summary><p>אנרגיה מרכזית, צ׳ילרים, יחידות טיפול באוויר, חימום וקירור, מונים וצריכות, לוחות חשמל, לוחות זמנים ומגמות.</p></details>
        <details><summary>מה היה האתגר?</summary><p>ניהול תאורה, מיזוג ואנרגיה על קמפוס רחב עם מבנים מרובים, בניטור מרכזי בזמן אמת.</p></details>
        <details><summary>אפשר מערכת דומה בקמפוס/מבנה ציבורי שלי?</summary><p>כן. ראו <a href="/bms-public-buildings/">בקרת מבנה למבני ציבור</a> או <a href="/contactus/">צרו קשר</a> לאפיון.</p></details>
      </section>
    </div></div>

    <section class="bg-brand-900 text-white py-16"><div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">צריכים BMS לקמפוס או מבנה ציבורי גדול?</h2>
      <p class="text-xl text-brand-200 mb-8">i-feel מתכננת ומיישמת מערכות בקרת מבנה בקנה מידה גדול — ניהול אנרגיה, ניטור ובקרה מרכזית.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3.5 rounded-lg font-semibold text-lg">03-508-9553</a><a href="/structure-control/projects/" class="bg-white/10 text-white px-7 py-3.5 rounded-lg font-semibold border border-white/30">לכל פרויקטי ה-BMS</a></div>
    </div></section>
  </article>
</BaseLayout>
