---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'קמפוס רכבת קיסריה | מקרה בוחן BMS | i-feel', description: 'קמפוס רכבת קיסריה — מערכת BMS מרכזית מבוססת Siemens Desigo לקמפוס רחב היקף: ניהול אנרגיה, צ׳ילרים, יט״א, ניטור ובקרה בזמן אמת.', canonical: 'https://i-feel.co.il/structure-control/caesarea-rail-campus/', ogTitle: 'קמפוס רכבת קיסריה | מקרה בוחן BMS | i-feel', ogDescription: 'שליטה מרכזית מלאה, חיסכון אנרגטי ותחזוקה מבוססת-נתונים.', ogUrl: 'https://i-feel.co.il/structure-control/caesarea-rail-campus/', ogImage: 'https://i-feel.co.il/assets/structure-projects/img/image4.png' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">קמפוס רכבת קיסריה</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <p class="text-accent-600 font-bold mb-1">מקרה בוחן · בקרת מבנה BMS</p>
    <h1>קמפוס הרכבת – קיסריה</h1>
    <p class="text-xl text-brand-700"><strong>סוג מבנה:</strong> קמפוס רחב היקף ומבני ציבור/תחבורה. <strong>טכנולוגיה:</strong> Siemens Desigo · DDC.</p>
    <img src="/assets/structure-projects/img/image4.png" alt="קמפוס רכבת קיסריה — מערכת בקרת מבנה BMS של i-feel" class="rounded-xl my-7 w-full" loading="lazy" />
    <h2>האתגר</h2>
    <p>הקמת מערכת בקרת מבנה מרכזית עבור קמפוס רחב היקף הכולל מספר מבנים ומערכות טכניות מורכבות. הפרויקט דרש ריכוז כלל מערכות האנרגיה והתפעול תחת פלטפורמה אחת, תוך שיפור היעילות האנרגטית, זמינות המערכות ויכולת הניהול השוטפת של צוותי האחזקה.</p>
    <h2>הפתרון שבוצע</h2>
    <p>תכנון והטמעה של מערכת BMS מרכזית המאפשרת שליטה, בקרה וניטור בזמן אמת של כלל מערכות המבנה. המערכת כוללת מסכי ניהול גרפיים, ניתוח נתוני אנרגיה, התראות אוטומטיות ומנגנוני דיווח מתקדמים המאפשרים קבלת החלטות מהירה ויעילה.</p>
    <h2>המערכת והטכנולוגיה</h2>
    <p>מערכת Siemens Desigo המבוססת על בקרי DDC מתקדמים, עם שרת ניהול מרכזי המאגד את כלל מערכות הקמפוס תחת ממשק אחיד.</p>
    <h2>היקף הפרויקט</h2>
    <ul>
      <li>מערכת ניהול ובקרת אנרגיה מרכזית</li>
      <li>שליטה וניטור של מערך הצ׳ילרים</li>
      <li>בקרה על יחידות טיפול באוויר (יט״א)</li>
      <li>בקרה על מערכות חימום וקירור</li>
      <li>ניטור וניהול מונים וצריכות אנרגיה</li>
      <li>אינטגרציה ללוחות חשמל ומערכות תשתית</li>
      <li>ניהול לוחות זמנים ותרחישי הפעלה אוטומטיים</li>
      <li>מערכת מגמות (Trends) ודוחות ביצועים לצורכי תחזוקה והתייעלות אנרגטית</li>
    </ul>
    <h2>יתרונות ותוצאות</h2>
    <ul>
      <li>שליטה מלאה על כלל מערכות הקמפוס מממשק מרכזי אחד</li>
      <li>שיפור משמעותי ביעילות האנרגטית ובמעקב אחר צריכות החשמל והאנרגיה</li>
      <li>קבלת התראות מיידיות על תקלות ואירועים קריטיים</li>
      <li>שיפור זמינות המערכות וצמצום זמני השבתה</li>
      <li>הפקת דוחות ניהוליים וניתוח ביצועי המערכות לאורך זמן</li>
      <li>תשתית גמישה המאפשרת הרחבות עתידיות ושילוב מערכות נוספות</li>
    </ul>
    <p class="mt-8 flex flex-wrap gap-3 not-prose">
      <a href="/structure-control/projects/" class="inline-flex items-center bg-accent-500 hover:bg-accent-600 text-white px-5 py-2.5 rounded-lg font-bold">← לכל פרויקטי בקרת המבנה</a>
      <a href="/contactus/" class="inline-flex items-center bg-brand-100 hover:bg-brand-200 text-brand-900 px-5 py-2.5 rounded-lg font-bold">לפרויקט דומה אצלכם — צרו קשר</a>
    </p>
  </article>
</BaseLayout>
