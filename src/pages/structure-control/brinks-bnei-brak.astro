---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/structure-control/brinks-bnei-brak/';
const hero = '/assets/structure-projects/img/image2.jpeg';
const meta = {
  title: 'ברינקס בני ברק | מקרה בוחן BMS | i-feel',
  description: 'ברינקס בני ברק — מערכת בקרת מבנה (BMS) מרכזית מבוססת Siemens Desigo ו-DDC: ניטור, שליטה וניהול של כלל המערכות האלקטרומכניות מממשק אחד, במתקן עם דרישות אמינות ואבטחה גבוהות.',
  canonical: url,
  ogTitle: 'ברינקס בני ברק | מקרה בוחן BMS | i-feel',
  ogDescription: 'ניהול מבנה אמין ומאובטח עם נראות ושליטה מרכזית — Siemens Desigo, DDC, KNX.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il' + hero,
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id': 'https://i-feel.co.il/#business', name: 'i-feel', url: 'https://i-feel.co.il/', logo: 'https://i-feel.co.il/assets/ifeel-logo.png', telephone: '+972-3-508-9553', email: 'sales@i-feel.co.il', address: { '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed: { '@type':'Country', name:'Israel' }, sameAs: ['https://www.facebook.com/SmarthomeIsrael','https://www.instagram.com/ifeelisrael','https://www.linkedin.com/company/200156'] },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' },
        { '@type':'ListItem', position:2, name:'בקרת מבנה', item:'https://i-feel.co.il/structure-control/' },
        { '@type':'ListItem', position:3, name:'פרויקטים', item:'https://i-feel.co.il/structure-control/projects/' },
        { '@type':'ListItem', position:4, name:'ברינקס בני ברק', item:url } ] },
      { '@type': 'CreativeWork', name: 'ברינקס בני ברק — פרויקט בקרת מבנה BMS של i-feel', about: ['BMS','בקרת מבנה','Siemens Desigo','DDC','KNX'], creator: { '@id':'https://i-feel.co.il/#business' }, locationCreated: { '@type':'Place', name:'בני ברק, ישראל' }, image: 'https://i-feel.co.il' + hero },
      { '@type': 'Article', headline: 'ברינקס בני ברק — מקרה בוחן בקרת מבנה BMS', image: 'https://i-feel.co.il' + hero, author: { '@id':'https://i-feel.co.il/#business' }, publisher: { '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage: url, inLanguage: 'he-IL' },
      { '@type': 'FAQPage', mainEntity: [
        { '@type':'Question', name:'איזו מערכת בקרת מבנה הותקנה בברינקס?', acceptedAnswer:{ '@type':'Answer', text:'מערכת Siemens Desigo מבוססת בקרי DDC, עם KNX וממשק ניהול מרכזי אחד לניטור ושליטה בכל מערכות המבנה.' } },
        { '@type':'Question', name:'אילו מערכות מנוהלות במערכת?', acceptedAnswer:{ '@type':'Answer', text:'מיזוג אוויר ואוורור, אינסטלציה ומשאבות, תאורה, חשמל ולוחות חשמל, לוחות זמנים ותרחישי הפעלה, וניטור תקלות והתראות.' } },
        { '@type':'Question', name:'מה היה האתגר המרכזי בפרויקט?', acceptedAnswer:{ '@type':'Answer', text:'איחוד מגוון מערכות טכניות במתקן עם דרישות אמינות ואבטחה גבוהות, תחת פלטפורמת ניהול אחת עם שליטה ובקרה בזמן אמת.' } },
        { '@type':'Question', name:'מה הושג בסוף הפרויקט?', acceptedAnswer:{ '@type':'Answer', text:'ניהול מרכזי אמין ומאובטח, חיסכון באנרגיה, התראות בזמן אמת על תקלות, וצמצום זמני תגובה — עם גמישות להרחבות עתידיות.' } } ] }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article dir="rtl">
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">ברינקס בני ברק</span></div></nav>

    <header class="relative min-h-[52vh] md:min-h-[60vh] flex items-end">
      <img src={hero} alt="ברינקס בני ברק — מערכת בקרת מבנה BMS של i-feel" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/75 to-brand-900/30"></div>
      <div class="relative max-w-6xl mx-auto px-4 py-12 md:py-16 w-full text-white">
        <p class="inline-block bg-accent-500 rounded-full px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן · בקרת מבנה BMS</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-4xl">ברינקס (BRINKS) בני ברק — בקרת מבנה מרכזית</h1>
        <p class="text-xl text-brand-100 mt-5 max-w-3xl">מתקן תפעולי/לוגיסטי עם דרישות אמינות ואבטחה גבוהות, מנוהל ממערכת בקרת מבנה אחת המבוססת Siemens Desigo ו-DDC.</p>
      </div>
    </header>

    <section class="bg-brand-900 text-white"><div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג פרויקט</div><div class="font-bold text-lg mt-1">בקרת מבנה BMS</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">מיקום</div><div class="font-bold text-lg mt-1">בני ברק</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">סוג מבנה</div><div class="font-bold text-lg mt-1">מתקן תפעולי/לוגיסטי</div></div>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5"><div class="text-sm text-brand-300">טכנולוגיה</div><div class="font-bold text-lg mt-1">Siemens Desigo · DDC · KNX</div></div>
    </div></section>

    <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
      <section id="challenge"><h2>האתגר</h2><p>הקמת מערכת בקרת מבנה מרכזית עבור מתקן תפעולי בעל דרישות גבוהות של אמינות, זמינות ובקרה רציפה. נדרש לאחד מגוון מערכות טכניות תחת פלטפורמה אחת, לאפשר שליטה ובקרה בזמן אמת, לייעל את צריכת האנרגיה ולספק לצוות האחזקה כלי ניהול מתקדם ונוח לשימוש.</p></section>
      <section id="solution"><h2>הפתרון של i-feel</h2><p>תכנון והטמעה של מערכת <a href="/structure-control/">בקרת מבנה</a> מרכזית (BMS) המאפשרת ניטור, שליטה וניהול של כלל המערכות האלקטרומכניות באתר מממשק אחד. המערכת מספקת התראות, לוחות מחוונים, תרחישי הפעלה אוטומטיים ותיעוד מלא של אירועים ותקלות.</p></section>
      <section id="tech"><h2>המערכת והטכנולוגיה</h2><p>מערכת <a href="/siemens-desigo-bms/">Siemens Desigo</a> המבוססת על בקרי <strong>DDC</strong> מתקדמים, עם <a href="/knx-smart-home/">KNX</a> וממשק ניהול מרכזי לניטור ושליטה בכל מערכות המבנה.</p></section>
      <section id="scope"><h2>היקף הפרויקט</h2>
        <ul>
          <li>מערכות מיזוג אוויר ואוורור</li>
          <li>מערכות אינסטלציה ומשאבות</li>
          <li>מערכות תאורה</li>
          <li>מערכות חשמל ולוחות חשמל</li>
          <li>לוחות זמנים (Schedules) ותרחישי הפעלה אוטומטיים</li>
          <li>ניטור תקלות, התראות ומגמות (Trends)</li>
        </ul>
      </section>
      <section id="results"><h2>יתרונות ותוצאות</h2>
        <ul>
          <li>ריכוז כלל מערכות המבנה בפלטפורמת ניהול אחת</li>
          <li>שיפור משמעותי ביכולת הניטור והבקרה של צוות האחזקה</li>
          <li>חיסכון באנרגיה באמצעות תפעול אוטומטי ולוחות זמנים</li>
          <li>קבלת התראות בזמן אמת על תקלות ואירועים חריגים</li>
          <li>שיפור אמינות המערכות והקטנת זמני תגובה לתקלות</li>
          <li>גמישות להרחבת המערכת ושילוב מערכות נוספות בעתיד</li>
        </ul>
      </section>
      <section id="faq"><h2>שאלות ותשובות</h2>
        <details><summary>איזו מערכת בקרת מבנה הותקנה בברינקס?</summary><p>מערכת Siemens Desigo מבוססת בקרי DDC, עם KNX וממשק ניהול מרכזי אחד.</p></details>
        <details><summary>אילו מערכות מנוהלות?</summary><p>מיזוג ואוורור, אינסטלציה ומשאבות, תאורה, חשמל ולוחות, לוחות זמנים, וניטור תקלות והתראות.</p></details>
        <details><summary>מה היה האתגר המרכזי?</summary><p>איחוד מערכות במתקן עם דרישות אמינות ואבטחה גבוהות, לשליטה מרכזית בזמן אמת.</p></details>
        <details><summary>אפשר מערכת דומה במבנה שלי?</summary><p>כן. ראו <a href="/structure-control/">בקרת מבנה BMS</a> או <a href="/contactus/">צרו קשר</a> לאפיון.</p></details>
      </section>
    </div></div>

    <section class="bg-brand-900 text-white py-16"><div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">צריכים בקרת מבנה למתקן תפעולי או מסחרי?</h2>
      <p class="text-xl text-brand-200 mb-8">i-feel מתכננת ומיישמת מערכות BMS אמינות לניהול מרכזי של תאורה, מיזוג, אנרגיה והתראות.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3.5 rounded-lg font-semibold text-lg">03-508-9553</a><a href="/structure-control/projects/" class="bg-white/10 text-white px-7 py-3.5 rounded-lg font-semibold border border-white/30">לכל פרויקטי ה-BMS</a></div>
    </div></section>
  </article>
</BaseLayout>
