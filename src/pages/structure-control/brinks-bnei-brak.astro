---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'ברינקס בני ברק | מקרה בוחן BMS | i-feel', description: 'ברינקס בני ברק — מערכת בקרת מבנה (BMS) מרכזית מבוססת Siemens Desigo: ניטור, שליטה וניהול של כלל המערכות האלקטרומכניות מממשק אחד.', canonical: 'https://i-feel.co.il/structure-control/brinks-bnei-brak/', ogTitle: 'ברינקס בני ברק | מקרה בוחן BMS | i-feel', ogDescription: 'ניהול מבנה אמין ומאובטח עם נראות ושליטה מרכזית — Siemens Desigo, DDC.', ogUrl: 'https://i-feel.co.il/structure-control/brinks-bnei-brak/', ogImage: 'https://i-feel.co.il/assets/structure-projects/img/image2.jpeg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">ברינקס – בני ברק</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <p class="text-accent-600 font-bold mb-1">מקרה בוחן · בקרת מבנה BMS</p>
    <h1>ברינקס (BRINKS) – בני ברק</h1>
    <p class="text-xl text-brand-700"><strong>סוג מבנה:</strong> מתקן תפעולי/לוגיסטי עם דרישות אמינות ואבטחה גבוהות. <strong>טכנולוגיה:</strong> Siemens Desigo · DDC · KNX.</p>
    <img src="/assets/structure-projects/img/image2.jpeg" alt="ברינקס בני ברק — מערכת בקרת מבנה BMS של i-feel" class="rounded-xl my-7 w-full" loading="lazy" />
    <h2>האתגר</h2>
    <p>הקמת מערכת בקרת מבנה מרכזית עבור מתקן תפעולי בעל דרישות גבוהות של אמינות, זמינות ובקרה רציפה. נדרש לאחד מגוון מערכות טכניות תחת פלטפורמה אחת, לאפשר שליטה ובקרה בזמן אמת, לייעל את צריכת האנרגיה ולספק לצוות האחזקה כלי ניהול מתקדם ונוח לשימוש.</p>
    <h2>הפתרון שבוצע</h2>
    <p>תכנון והטמעה של מערכת בקרת מבנה מרכזית (BMS) המאפשרת ניטור, שליטה וניהול של כלל המערכות האלקטרומכניות באתר מממשק אחד. המערכת מספקת התראות, לוחות מחוונים, תרחישי הפעלה אוטומטיים ותיעוד מלא של אירועים ותקלות.</p>
    <h2>המערכת והטכנולוגיה</h2>
    <p>מערכת Siemens Desigo המבוססת על בקרי DDC מתקדמים, הכוללת ממשק ניהול מרכזי לניטור ושליטה בכל מערכות המבנה.</p>
    <h2>היקף הפרויקט</h2>
    <ul>
      <li>מערכות מיזוג אוויר ואוורור</li>
      <li>מערכות אינסטלציה ומשאבות</li>
      <li>מערכות תאורה</li>
      <li>מערכות חשמל ולוחות חשמל</li>
      <li>לוחות זמנים (Schedules) ותרחישי הפעלה אוטומטיים</li>
      <li>ניטור תקלות, התראות ומגמות (Trends)</li>
    </ul>
    <h2>יתרונות ותוצאות</h2>
    <ul>
      <li>ריכוז כלל מערכות המבנה בפלטפורמת ניהול אחת</li>
      <li>שיפור משמעותי ביכולת הניטור והבקרה של צוות האחזקה</li>
      <li>חיסכון באנרגיה באמצעות תפעול אוטומטי ולוחות זמנים</li>
      <li>קבלת התראות בזמן אמת על תקלות ואירועים חריגים</li>
      <li>שיפור אמינות המערכות והקטנת זמני תגובה לתקלות</li>
      <li>גמישות להרחבת המערכת ושילוב מערכות נוספות בעתיד</li>
    </ul>
    <p class="mt-8 flex flex-wrap gap-3 not-prose">
      <a href="/structure-control/projects/" class="inline-flex items-center bg-accent-500 hover:bg-accent-600 text-white px-5 py-2.5 rounded-lg font-bold">← לכל פרויקטי בקרת המבנה</a>
      <a href="/contactus/" class="inline-flex items-center bg-brand-100 hover:bg-brand-200 text-brand-900 px-5 py-2.5 rounded-lg font-bold">לפרויקט דומה אצלכם — צרו קשר</a>
    </p>
  </article>
</BaseLayout>
