---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'משרדי INNOVIZ | מקרה בוחן בקרת מבנה | i-feel', description: 'משרדי INNOVIZ — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/innoviz-offices/', ogTitle: 'משרדי INNOVIZ | i-feel', ogDescription: 'שליטה מלאה ממסך אחד, חיסכון באנרגיה ותפעול יעיל לאחזקה.', ogUrl: 'https://www.i-feel.co.il/structure-control/innoviz-offices/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">משרדי INNOVIZ</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>משרדי INNOVIZ</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> משרדי הייטק.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת אוטומציה ובקרת מבנה מתקדמת למשרדי החברה, ושילוב כלל מערכות המבנה תחת פלטפורמה אחת — עם שליטה נוחה ואינטואיטיבית ויכולות ניהול ובקרה מתקדמות.</p>
    <h2>פתרון I Feel</h2>
    <p>תכנון והטמעה של מערכת KNX ובקרת מבנה מתקדמת, הכוללת ממשק HMI מרכזי לניהול כלל מערכות המבנה, ניטור תקלות, ניהול תרחישים ולוחות זמנים ושליטה מלאה במיזוג ובתאורה.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX · BMS · HMI</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>שליטה ובקרה על מערכות התאורה</li><li>שליטה וניטור מערכות מיזוג האוויר</li><li>בקרה על יחידות טיפול באוויר (יט״א)</li><li>ניהול לוחות זמנים ותרחישי הפעלה</li><li>ממשק HMI מרכזי לכלל המערכות</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>שליטה מלאה ממסך אחד</li><li>שיפור נוחות המשתמשים ואיכות הסביבה</li><li>חיסכון באנרגיה בבקרה חכמה</li><li>ניטור וזיהוי תקלות בזמן אמת</li><li>תפעול פשוט ויעיל לאחזקה</li></ul>
    <h2>תוצאה</h2>
    <p>שליטה מלאה ממסך אחד, חיסכון באנרגיה ותפעול יעיל לאחזקה.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>