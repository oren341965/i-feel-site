---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'היכל התרבות כפר ויתקין | מקרה בוחן בקרת מבנה | i-feel', description: 'היכל התרבות כפר ויתקין — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/kfar-vitkin-culture-hall/', ogTitle: 'היכל התרבות כפר ויתקין | i-feel', ogDescription: 'תפעול פשוט וגמיש, התאמת תאורה לכל אירוע וחיסכון באנרגיה.', ogUrl: 'https://www.i-feel.co.il/structure-control/kfar-vitkin-culture-hall/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">היכל התרבות כפר ויתקין</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>היכל התרבות כפר ויתקין</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> מרכז תרבות ואירועים.</p>
    <h2>אתגר</h2>
    <p>יישום מערכת תאורה חכמה למרכז תרבות ואירועים, המאפשרת התאמה מהירה של התאורה למגוון פעילויות, מופעים ואירועים לאורך השנה.</p>
    <h2>פתרון I Feel</h2>
    <p>הטמעת מערכת KNX לניהול ובקרה של מערכות התאורה במבנה, כולל יצירת תרחישים מותאמים למופעים, כנסים ואירועים קהילתיים.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>שליטה על תאורת האולם והשטחים הציבוריים</li><li>תרחישי תאורה למופעים, כנסים ואירועים</li><li>ניהול מרכזי של מערכות התאורה</li><li>ממשקי שליטה נוחים לצוותי התפעול</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>תפעול פשוט וגמיש</li><li>התאמת התאורה לכל סוג אירוע</li><li>חיסכון באנרגיה</li><li>מערכת יציבה ואמינה לאורך שנים</li></ul>
    <h2>תוצאה</h2>
    <p>תפעול פשוט וגמיש, התאמת תאורה לכל אירוע וחיסכון באנרגיה.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>