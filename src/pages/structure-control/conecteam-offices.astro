---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'משרדי Conecteam | מקרה בוחן בקרת מבנה | i-feel', description: 'משרדי Conecteam — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/conecteam-offices/', ogTitle: 'משרדי Conecteam | i-feel', ogDescription: 'שליטה מלאה מממשק אחד, חיסכון באנרגיה ותפעול ידידותי לאחזקה.', ogUrl: 'https://www.i-feel.co.il/structure-control/conecteam-offices/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">משרדי Conecteam</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>משרדי Conecteam</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> מתחם משרדים.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת בקרת מבנה ותאורה למתחם משרדים מודרני, עם שליטה מרכזית על מערכות התאורה והתשתיות החשמליות, ניהול יעיל של המבנה, חיסכון באנרגיה ונוחות מרבית לעובדים.</p>
    <h2>פתרון I Feel</h2>
    <p>תכנון והטמעה של מערכת בקרת מבנה מרכזית לניטור, שליטה וניהול של מערכות התאורה והחשמל מממשק אחיד — כולל לוחות זמנים, תרחישי הפעלה אוטומטיים, התראות ומסכי ניהול גרפיים.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>Siemens Desigo · DDC</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>שליטה ובקרה על מערכות התאורה</li><li>ניהול אזורי תאורה לפי שימושים</li><li>שליטה על מעגלי חשמל נבחרים</li><li>לוחות זמנים ותרחישי הפעלה</li><li>ניטור תקלות והתראות בזמן אמת</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>שליטה מלאה מממשק אחד</li><li>חיסכון באנרגיה בניהול חכם של שעות פעילות</li><li>שיפור נוחות המשתמשים</li><li>ניטור וזיהוי תקלות בזמן אמת</li><li>מערכת גמישה להרחבות</li></ul>
    <h2>תוצאה</h2>
    <p>שליטה מלאה מממשק אחד, חיסכון באנרגיה ותפעול ידידותי לאחזקה.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>