---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'משרדי RAPID | מקרה בוחן בקרת מבנה | i-feel', description: 'משרדי RAPID — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/rapid-offices/', ogTitle: 'משרדי RAPID | i-feel', ogDescription: 'נוחות לעובדים, חיסכון בחשמל ושליטה מדויקת בכל אזור.', ogUrl: 'https://www.i-feel.co.il/structure-control/rapid-offices/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">משרדי RAPID</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>משרדי RAPID</h1>
    <img src="/assets/projects/rapid-offices.png" alt="משרדי RAPID" class="rounded-lg w-full my-6" loading="lazy" />
    <p class="text-xl text-brand-700"><strong>סוג:</strong> משרדים.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת תאורה חכמה למשרדי החברה ליצירת סביבת עבודה נוחה ומודרנית, עם שליטה גמישה בתאורה באזורים שונים, שיפור חוויית המשתמש וצמצום צריכת האנרגיה.</p>
    <h2>פתרון I Feel</h2>
    <p>תכנון והטמעה של מערכת תאורה חכמה לשליטה מלאה על גופי התאורה במשרדים, חדרי ישיבות, חללים משותפים ואזורי עבודה — כולל תרחישי תאורה, הפעלה לפי אזורים וניהול מרכזי.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX · DALI</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>תאורת משרדים וחללי עבודה</li><li>תאורת חדרי ישיבות</li><li>תאורת שטחים ציבוריים ומעברים</li><li>בקרת DALI לגופי התאורה</li><li>תרחישי תאורה מותאמים לפעילות</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>שיפור נוחות העובדים בשליטה גמישה</li><li>חיסכון משמעותי בצריכת החשמל</li><li>שליטה מדויקת בכל גוף תאורה ובכל אזור</li><li>סביבת עבודה מודרנית ונעימה</li><li>גמישות לשינויים והרחבות</li></ul>
    <h2>תוצאה</h2>
    <p>נוחות לעובדים, חיסכון בחשמל ושליטה מדויקת בכל אזור.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>