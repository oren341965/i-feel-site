const meta = { title: 'הוט סינמה — רשת בתי קולנוע | מקרה בוחן בקרת מבנה | i-feel', description: 'הוט סינמה — רשת בתי קולנוע — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/hot-cinema/', ogTitle: 'הוט סינמה — רשת בתי קולנוע | i-feel', ogDescription: 'חוויית צפייה מקצועית, חיסכון באנרגיה ותפעול פשוט לצוותי המקום.', ogUrl: 'https://www.i-feel.co.il/structure-control/hot-cinema/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">הוט סינמה — רשת בתי קולנוע</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>הוט סינמה — רשת בתי קולנוע</h1>
    <img src="/assets/projects/hot-cinema.png" alt="הוט סינמה — רשת בתי קולנוע" class="rounded-lg w-full my-6" loading="lazy" />
    <p class="text-xl text-brand-700"><strong>סוג:</strong> בידור / בתי קולנוע.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת תאורה חכמה למתחם בתי קולנוע הכולל מספר אולמות הקרנה ושטחים ציבוריים — ליצירת חוויית צפייה מושלמת, בסנכרון מלא עם מערכות ההקרנה ולצד חיסכון באנרגיה.</p>
    <h2>פתרון I Feel</h2>
    <p>תכנון והטמעה של מערכת תאורה חכמה המפעילה אוטומטית תרחישי תאורה לפי שלבי ההקרנה, ומאפשרת מעבר חלק בין מצבי התאורה ללא התערבות ידנית.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX · בקרי דימור</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>תאורת אולמות הקולנוע</li><li>תאורת לובי, מבואות ומסדרונות</li><li>מערכות דימור מתקדמות</li><li>אינטגרציה עם מערכות ההקרנה והמקרנים</li><li>ממשקי שליטה לצוותי האתר</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>חוויית צפייה מקצועית ואיכותית</li><li>הפעלה אוטומטית לפי מצב ההקרנה</li><li>חיסכון באנרגיה בשליטה מדויקת בעוצמות</li><li>תפעול פשוט ויעיל</li><li>גמישות להרחבה עתידית</li></ul>
    <h2>תוצאה</h2>
    <p>חוויית צפייה מקצועית, חיסכון באנרגיה ותפעול פשוט לצוותי המקום.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
