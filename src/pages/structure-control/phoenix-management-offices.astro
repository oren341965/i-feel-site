---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'משרדי הנהלת הפניקס | מקרה בוחן בקרת מבנה | i-feel', description: 'משרדי הנהלת הפניקס — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/phoenix-management-offices/', ogTitle: 'משרדי הנהלת הפניקס | i-feel', ogDescription: 'חוויית משתמש משופרת, חיסכון באנרגיה ותפעול פשוט.', ogUrl: 'https://www.i-feel.co.il/structure-control/phoenix-management-offices/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">משרדי הנהלת הפניקס</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>משרדי הנהלת הפניקס</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> משרדי הנהלה.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת תאורה חכמה למשרדי ההנהלה ליצירת סביבת עבודה יוקרתית, נוחה ויעילה, לצד חיסכון באנרגיה ושליטה פשוטה למשתמשים.</p>
    <h2>פתרון I Feel</h2>
    <p>תכנון והטמעה של מערכת KNX לשליטה מרכזית על התאורה, הפעלת תרחישים מותאמים לחללי העבודה וחדרי הישיבות וניהול יעיל של מערך התאורה.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>שליטה ובקרה על מערכות התאורה</li><li>תרחישי תאורה לחדרי ישיבות ומשרדי הנהלה</li><li>שליטה לפי אזורים ושעות פעילות</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>חוויית משתמש משופרת</li><li>חיסכון באנרגיה</li><li>תפעול פשוט ונוח</li><li>מערכת יציבה ואמינה</li></ul>
    <h2>תוצאה</h2>
    <p>חוויית משתמש משופרת, חיסכון באנרגיה ותפעול פשוט.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>