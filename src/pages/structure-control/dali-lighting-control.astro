---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageUrl = 'https://i-feel.co.il/structure-control/dali-lighting-control/';

const faqs = [
  { question: 'האם DALI מתאים גם לדירה ולבית פרטי?', answer: 'כן. ניתן לתכנן עמעום, קבוצות ותרחישים גם בבית ובדירה. אין חובה להתקין מערכת BMS; בוחרים בקר, דרייברים ותשתית לפי התאורה הרצויה.' },
  { question: 'אפשר לשלב DALI עם בית חכם אלחוטי?', answer: 'כן, באמצעות בקר או שער תואם למערכת האלחוטית ולציוד DALI. לא כל מערכת מתחברת ישירות. בפתרון עם שער ל-DALI קווי נדרשים גם הזנה וקו תקשורת בין השער לדרייברים.' },
  { question: 'האם DALI מאפשר שינוי גוון וצבע?', answer: 'אפשר עם ציוד תואם. לבן משתנה דורש תמיכה מתאימה כגון DT8 Tc, וצבע דורש סוג נתמך כגון RGBWAF. יש לבדוק את הבקר, הדרייבר וגוף התאורה יחד; עמעום רגיל אינו מבטיח שינוי צבע.' },
  { question: 'האם DALI בהכרח יקר יותר?', answer: 'לא ניתן לקבוע בלי מפרט. משווים מחיר עדכני של הבקר, הדרייברים, התשתית, התכנות והמסירה עבור אותן דרישות. מספר הקבוצות והיכולות המבוקשות משפיעים על הכדאיות.' },
  { question: 'אפשר לשדרג בית קיים בלי להחליף הכול?', answer: 'לעיתים אפשר לשלב חלק מהציוד הקיים, אך בודקים התאמת דרייברים, מקום לבקר ונתיבי חיווט. שליטה אלחוטית אינה מבטיחה שצד התאורה אינו דורש תשתית.' },
  {
    question: 'מה זה DALI?',
    answer:
      'DALI - Digital Addressable Lighting Interface - הוא פרוטוקול תקני בינלאומי לפי IEC 62386 לשליטה דיגיטלית בתאורה. הוא מאפשר לפקד על גופי תאורה, לעמעם, לשייך לקבוצות, להפעיל תרחישים ולקבל מידע חוזר על מצב ותקינות.',
  },
  {
    question: 'מה זה DALI-2?',
    answer:
      'DALI-2 הוא הדור המתקדם של תקן DALI. הוא משפר תאימות בין יצרנים, מוסיף בדיקות הסמכה ברורות יותר, ומרחיב את התמיכה באביזרי קלט כמו חיישני נוכחות, חיישני אור ולחצנים.',
  },
  {
    question: 'האם Siemens תומכת ב-DALI-2?',
    answer:
      'כן. שערי KNX/DALI מתאימים של Siemens משמשים לתאורה בבית ובבניין. אפשר לשלב גם בפתרונות Desigo, לפי הדגם והאינטגרציה. חיבור לבית אלחוטי מחייב בדיקת שער וממשקים נתמכים.',
  },
  {
    question: 'מה ההבדל בין DALI לבין 0-10V?',
    answer:
      '0-10V הוא פתרון אנלוגי פשוט לעמעום תאורה. DALI הוא פרוטוקול דיגיטלי דו-כיווני שמאפשר כתובות, קבוצות, תרחישים, דיווח תקלות וגמישות גבוהה יותר בפרויקטים גדולים.',
  },
  {
    question: 'מה ההבדל בין DALI לבין KNX?',
    answer:
      'KNX הוא פרוטוקול בקרת מבנה רחב לתאורה, מיזוג, וילונות, חיישנים ועוד. DALI הוא פרוטוקול ייעודי לתאורה. בפרויקטים רבים KNX מנהל את היגיון החדר, ו-DALI מנהל את שכבת גופי התאורה.',
  },
  {
    question: 'האם DALI מתאים לחיסכון באנרגיה?',
    answer:
      'כן. שילוב DALI עם חיישני נוכחות, חיישני אור יום ולוחות זמנים מאפשר להפעיל תאורה רק לפי צורך, לעמעם לפי אור טבעי ולצמצם צריכת חשמל מיותרת.',
  },
  {
    question: 'לאילו פרויקטים DALI מתאים?',
    answer:
      'DALI מתאים לדירות ולבתים פרטיים שרוצים עמעום ותרחישים, וגם למשרדים, מלונות ומבני ציבור. אפשר לשלב בבית אלחוטי, ב-KNX או ב-BMS, בהתאם לשער, לציוד ולתשתית.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'תאורת DALI ו-DALI-2 לבית חכם ולבקרת מבנה',
    description:
      'תכנון ואינטגרציה של תאורת DALI-2 לדירות, בתים ובניינים: שילוב בבית אלחוטי באמצעות שער תואם, ב-KNX או ב-Siemens Desigo, לפי הציוד והתשתית.',
    provider: {
      '@type': 'Organization',
      name: 'i-feel',
      url: 'https://i-feel.co.il',
      telephone: '+97235089553',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'IL',
      },
    },
    areaServed: {
      '@type': 'Country',
      name: 'Israel',
    },
    serviceType: 'DALI and DALI-2 Lighting Control Integration',
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'דף הבית',
        item: 'https://i-feel.co.il/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'בקרת מבנה BMS',
        item: 'https://i-feel.co.il/structure-control/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'בקרת תאורה DALI ו-DALI-2',
        item: pageUrl,
      },
    ],
  },
];

const meta = {
  title: 'תאורת DALI-2 לבית חכם ולבקרת מבנה | i-feel',
  description:
    'DALI-2 לבית ולבניין: עמעום, תרחישים, גוון וצבע, שילוב בבית אלחוטי או KNX ובבקרת מבנה. בדיקת התאמה ותכנון עם i-feel: 03-508-9553.',
  canonical: pageUrl,
  ogTitle: 'תאורת DALI-2 לבית, לדירה ולבקרת מבנה | i-feel',
  ogDescription:
    'בחרו את המסלול שלכם: תאורה ותרחישים לבית, שילוב במערכת אלחוטית, או ניהול תאורה והתראות בבניין. התאמת ציוד, תשתית ותקציב.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(jsonLd),
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם">
    <div class="max-w-7xl mx-auto px-4 py-3 text-sm">
      <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
      <span class="mx-2 text-brand-400">›</span>
      <a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה BMS</a>
      <span class="mx-2 text-brand-400">›</span>
      <span class="text-brand-900 font-medium">בקרת תאורה DALI ו-DALI-2</span>
    </div>
  </nav>

  <article dir="rtl">

    <header class="hero-gradient text-white">
      <div class="max-w-6xl mx-auto px-4 py-16 lg:py-24">
        <p class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-sm font-bold mb-6">
          בית פרטי · דירה · בית אלחוטי · KNX · בקרת מבנה
        </p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-5xl">
          תאורת DALI-2 לבית ולבניין — האור שמתאים לכם
        </h1>
        <p class="text-xl text-brand-100 mt-6 max-w-4xl leading-8">
          עמעום נעים, תרחישי אירוח, גוון אור משתנה ושליטה לפי אזורים. DALI מתאים גם לבית ולדירה עם מערכת חכמה קווית או אלחוטית, וגם לניהול תאורה בבניין. ב־i-feel מתאימים את הבקר, גופי התאורה והתשתית לחוויה שאתם רוצים ולתקציב שלכם.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="#home-lighting" class="bg-white text-brand-900 px-6 py-3 rounded-lg font-bold">לבית ולדירה</a>
          <a href="#bms-value" class="bg-accent-500 hover:bg-accent-600 text-white px-6 py-3 rounded-lg font-bold">לבניין ולעסק</a>
          <a href="#wireless-home" class="bg-white/10 text-white px-6 py-3 rounded-lg border border-white/30">יש לי בית אלחוטי</a>
        </div>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16 prose-he">
      <section id="intro">
        <h2>מה תרצו לעשות עם התאורה?</h2>
        <p>DALI הוא תקן לתקשורת עם ציוד תאורה תואם. בבית הוא מאפשר לתכנן שכבות אור ותרחישים; בבניין הוא משתלב גם בניהול אזורים, חיישנים והתראות. בחרו את המסלול שמתאים לכם, או התחילו בהסבר הפשוט על המערכת.</p>
        <div class="not-prose grid md:grid-cols-2 gap-5 my-6">
          <a href="#home-lighting" class="block rounded-2xl border border-brand-100 bg-brand-50 p-6 hover:shadow-lg"><h3 class="text-2xl font-bold text-brand-900 mb-3">אני מתכנן תאורה לבית</h3><p class="text-brand-700">דירה או בית פרטי, בבנייה או בשדרוג: עמעום, תאורת אווירה, גוון וצבע, שליטה אלחוטית או קווית.</p><span class="inline-block mt-4 text-accent-700 font-bold">לאפשרויות בבית ←</span></a>
          <a href="#bms-value" class="block rounded-2xl border border-brand-100 bg-brand-50 p-6 hover:shadow-lg"><h3 class="text-2xl font-bold text-brand-900 mb-3">אני מנהל או מתכנן מבנה</h3><p class="text-brand-700">משרד, מלון או מבנה ציבור: חיסכון בחשמל, נוכחות, אור יום, תקלות ושילוב Siemens Desigo.</p><span class="inline-block mt-4 text-accent-700 font-bold">לבקרת תאורה בבניין ←</span></a>
        </div>
        <nav aria-label="ניווט במדריך DALI" class="not-prose flex flex-wrap gap-x-5 gap-y-3 my-6 text-accent-700 font-bold">
          <a href="#what-is-dali">מה זה DALI?</a><a href="#wireless-home">שילוב אלחוטי</a><a href="#lighting-scenes">תרחישים וגוונים</a><a href="#cost">מחיר והתאמה</a><a href="#dali-wiring-electricians">מדריך לחשמלאים</a><a href="#faq">שאלות נפוצות</a>
        </nav>
      </section>



      <section id="what-is-dali">
        <h2>מה זה DALI, במילים פשוטות?</h2>
        <p>במקום להסתפק בהדלקה וכיבוי של קו שלם, מערכת DALI שולחת פקודות דיגיטליות לדרייברים תואמים — הרכיבים שמפעילים את גופי התאורה. כך אפשר לעמעם, לשייך גופים לקבוצות ולשמור תרחישים. כל דרייבר מזוהה בכתובת, ויכולות המערכת תלויות בציוד ובתכנון.</p>
        <p>לדוגמה: אור חזק במטבח בזמן הכנה, אור רך מעל השולחן ואור עדין בנישה בסלון. בלחיצה על ״אירוח״ אפשר לשנות כמה קבוצות יחד. אותה יכולת משמשת גם לחדר ישיבות או ללובי במלון.</p>
        <p>אין צורך במערכת BMS כדי ליהנות מ־DALI בבית. אפשר לבחור בקר מתאים, לשלב במערכת בית חכם אלחוטית באמצעות שער תואם, או לחבר ל־KNX. בבניין מסחרי אפשר להוסיף חיבור למערכת ניהול מרכזית.</p>
      </section>

      <section id="home-lighting" class="scroll-mt-32">
        <h2>DALI לבית ולדירה: לתכנן את האווירה שאתם אוהבים</h2>
        <p>כשמתכננים סלון, מטבח או חדר שינה, השאלה היא איזו תאורה תרצו בכל רגע. DALI מאפשר להפריד בין תאורה כללית, תאורת עבודה ותאורת הדגשה, ולשלב אותן בתרחישים נוחים. הבחירה מתאימה גם לדירה, ולא נקבעת רק לפי גודל הנכס.</p>
        <figure class="not-prose my-6"><img src="/projects/knx-smart-home-central-moshav/09-smart-living-room-knx.jpg" alt="חלל מגורים בבית חכם בפרויקט i-feel במושב במרכז" class="w-full max-h-96 object-cover rounded-2xl" loading="lazy" /><figcaption class="text-sm text-brand-600 mt-2">בית חכם בפרויקט i-feel במושב במרכז — להמחשת סביבת המגורים. התאמת DALI נבדקת בכל פרויקט.</figcaption></figure>
        <div id="lighting-scenes" class="not-prose grid sm:grid-cols-2 gap-4 my-6 scroll-mt-32">
          <div class="rounded-xl bg-brand-50 p-5"><h3 class="text-xl font-bold mb-2">אירוח וארוחה</h3><p>שולחן מואר, סלון בעוצמה רכה ותאורת הדגשה לפינות האהובות.</p></div>
          <div class="rounded-xl bg-brand-50 p-5"><h3 class="text-xl font-bold mb-2">סרט וערב רגוע</h3><p>עמעום התאורה באזור המסך והשארת אור נעים במעברים.</p></div>
          <div class="rounded-xl bg-brand-50 p-5"><h3 class="text-xl font-bold mb-2">לבן חם או קר</h3><p>שינוי גוון הלבן באמצעות Tunable White, כאשר הבקר, הדרייבר וגוף התאורה תומכים ב־DT8 מסוג Tc.</p></div>
          <div class="rounded-xl bg-brand-50 p-5"><h3 class="text-xl font-bold mb-2">צבע ואווירה</h3><p>שילוב תאורה צבעונית בציוד תואם, למשל DT8 מסוג RGBWAF. תמיכה בעמעום אינה מבטיחה תמיכה בצבע.</p></div>
        </div>
        <p>אפשר להפעיל את התרחישים מלחצן, ממסך או מאפליקציה, לפי מערכת השליטה שנבחרה. לפרויקטים של אפקטים ותאורה צבעונית ראו גם <a href="/dmx-home-lighting/">שילוב DMX ותאורת אווירה בבית</a>.</p>
        <p><a href="/smart-home/#smart-panel-video">לצפייה בהדגמת שליטה בבית חכם</a> · <a href="/projects/private-homes/">לפרויקטים של בתים פרטיים</a></p>
        <p class="text-sm">מידע מקצועי: <a href="https://www.dali-alliance.org/dali/colour.html">סוגי בקרת גוון וצבע — DALI Alliance</a>.</p>
        <p><a href="/contactus/?interest=dali-home" class="font-bold">בדיקת התאמה לתאורה בבית שלי ←</a></p>
      </section>

      <section id="wireless-home" class="scroll-mt-32 bg-brand-50 rounded-2xl p-6 my-10">
        <h2>יש לכם בית חכם אלחוטי? אפשר לשלב גם DALI</h2>
        <p><strong>מערכת בית חכם אלחוטית יכולה לשלוט בתאורת DALI באמצעות בקר או שער תואם.</strong> לא חייבים להתקין KNX בכל הבית. בודקים את דגם המערכת הקיימת, את שער החיבור ואת הפקודות הנתמכות — הדלקה, עמעום, תרחישים ולעיתים גם גוון וצבע.</p>
        <p class="not-prose rounded-xl bg-white border border-brand-100 p-4 font-bold">לחצן או אפליקציה במערכת האלחוטית ← בקר / שער תואם ← קו DALI ← דרייברים וגופי תאורה</p>
        <p>השליטה יכולה להיות אלחוטית, אך בפתרון עם שער ל־DALI קווי עדיין נדרשים הזנה וחיווט DALI בין השער לציוד התאורה. בשדרוג בית קיים בודקים מה כבר מותקן ומה ניתן להעביר. שילוב אלחוטי אינו מבטיח התקנה ללא עבודות תשתית.</p>
        <p>כדאי לשלוח לנו את שם המערכת, דגם הבקר, מפרט גופי התאורה ותמונות של התשתית. נבדוק מה ניתן לשלב, האם השליטה מקומית או תלויה בענן, ומה קורה כשאין אינטרנט. ההתאמה נקבעת לפי הדגמים, ולא רק לפי שם המותג.</p>
        <p><a href="/contactus/?interest=dali-wireless" class="font-bold">בדקו שילוב DALI בבית האלחוטי שלי ←</a></p>
        <p class="text-sm">מידע מקצועי: <a href="https://www.dali-alliance.org/wireless/">שילוב DALI ומערכות אלחוטיות — DALI Alliance</a>.</p>
      </section>

      <section id="cost" class="scroll-mt-32">
        <h2>כמה עולה DALI, ומתי הוא משתלם בבית?</h2>
        <p>מחירי הרכיבים והחלופות משתנים, ולכן כדאי להשוות הצעות עדכניות במקום לפסול DALI מראש כפתרון יקר. כשמבקשים כמה קבוצות עמעום, תרחישים ושינויי גוון, בוחנים את התמורה של הפתרון כולו מול החלופות.</p>
