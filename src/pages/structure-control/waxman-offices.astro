---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'משרדי וקסמן | מקרה בוחן בקרת מבנה | i-feel', description: 'משרדי וקסמן — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/waxman-offices/', ogTitle: 'משרדי וקסמן | i-feel', ogDescription: 'איכות סביבת עבודה משופרת, חיסכון בחשמל ושליטה פשוטה.', ogUrl: 'https://www.i-feel.co.il/structure-control/waxman-offices/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">BMS</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">משרדי וקסמן</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>משרדי וקסמן</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> משרדים.</p>
    <h2>אתגר</h2>
    <p>הטמעת מערכת תאורה חכמה המאפשרת נוחות מרבית לעובדים לצד חיסכון באנרגיה.</p>
    <h2>פתרון I Feel</h2>
    <p>הקמת מערכת KNX לניהול מרכזי של התאורה במשרדים, המאפשרת שליטה לפי אזורים ויצירת תרחישי תאורה מותאמים לצורכי הארגון.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>ניהול מרכזי של מערכות התאורה</li><li>חלוקה לאזורי תאורה</li><li>תרחישי הפעלה מותאמים</li><li>שליטה נוחה למשתמשים</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>שיפור איכות סביבת העבודה</li><li>חיסכון בצריכת החשמל</li><li>שליטה פשוטה וגמישה</li></ul>
    <h2>תוצאה</h2>
    <p>איכות סביבת עבודה משופרת, חיסכון בחשמל ושליטה פשוטה.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>