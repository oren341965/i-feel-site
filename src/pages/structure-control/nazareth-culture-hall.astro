---
import BaseLayout from '../../layouts/BaseLayout.astro';
const meta = { title: 'היכל התרבות נצרת | מקרה בוחן בקרת מבנה | i-feel', description: 'היכל התרבות נצרת — מקרה בוחן בקרת מבנה ואוטומציה חכמה של i-feel.', canonical: 'https://www.i-feel.co.il/structure-control/nazareth-culture-hall/', ogTitle: 'היכל התרבות נצרת | i-feel', ogDescription: 'גמישות תפעולית גבוהה, חיסכון באנרגיה ושיפור חוויית המבקרים.', ogUrl: 'https://www.i-feel.co.il/structure-control/nazareth-culture-hall/', ogImage: 'https://www.i-feel.co.il/assets/og-cover.jpg' };
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">היכל התרבות נצרת</span></div></nav>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16 prose-he">
    <h1>היכל התרבות נצרת</h1>
    <p class="text-xl text-brand-700"><strong>סוג:</strong> היכל תרבות רב-שימושי.</p>
    <h2>אתגר</h2>
    <p>הקמת מערכת תאורה חכמה להיכל תרבות רב-שימושי המארח מופעים, כנסים ואירועים קהילתיים, תוך מתן גמישות תפעולית מלאה והתאמת התאורה לאופי הפעילות.</p>
    <h2>פתרון I Feel</h2>
    <p>הטמעת מערכת KNX לשליטה מרכזית על כלל מערכות התאורה במבנה, כולל יצירת תרחישי תאורה ייעודיים למופעים, כנסים ואירועים.</p>
    <h2>מערכות וטכנולוגיה</h2>
    <p>KNX</p>
    <h2>היקף הפרויקט</h2>
    <ul><li>שליטה על תאורת האולם והמבואות</li><li>תרחישי תאורה מותאמים לאירועים שונים</li><li>ניהול מרכזי של מערכות התאורה</li><li>שליטה פשוטה וידידותית למפעילים</li></ul>
    <h2>יתרונות ותוצאות</h2>
    <ul><li>גמישות תפעולית גבוהה</li><li>חיסכון באנרגיה</li><li>שיפור חוויית המבקרים</li><li>מערכת אמינה וקלה לתפעול</li></ul>
    <h2>תוצאה</h2>
    <p>גמישות תפעולית גבוהה, חיסכון באנרגיה ושיפור חוויית המבקרים.</p>
    <p><a href="/structure-control/#case-studies" class="text-accent-600 font-semibold hover:underline">חזרה למקרי הבוחן</a></p>
  </article>
</BaseLayout>