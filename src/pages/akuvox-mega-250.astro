---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/akuvox-mega-250.html?raw';
import '../styles/mega-guides.css';

const canonical = 'https://i-feel.co.il/akuvox-mega-250/';
const title = 'אינטרקום Akuvox MEGA 250 לווילה — הכנות תשתית | i-feel';
const description = 'מדריך תשתית לאינטרקום Akuvox MEGA 250 בווילה ובבית פרטי: הכנת CAT6 ו-PoE, חיבור מנעול ושער, שנאי ומידות התקנה. ייעוץ i-feel: 03-508-9553.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL'
      },
      areaServed: { '@type': 'Country', name: 'Israel' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'בית חכם', item: 'https://i-feel.co.il/smart-home/' },
        { '@type': 'ListItem', position: 3, name: 'Akuvox MEGA 250', item: canonical }
      ]
    },
    {
      '@type': 'Service',
      name: 'אינטרקום Akuvox MEGA 250 לווילות ובתים פרטיים',
      serviceType: 'תכנון והתקנת אינטרקום IP לבית פרטי',
      provider: { '@id': 'https://i-feel.co.il/#business' },
      areaServed: { '@type': 'Country', name: 'Israel' },
      audience: { '@type': 'Audience', audienceType: 'בעלי וילות ובתים פרטיים' },
      description
    },
    {
      '@type': 'TechArticle',
      headline: 'הנחיות תשתית לאינטרקום Akuvox MEGA 250 בווילה',
      description,
      image: 'https://i-feel.co.il/assets/akuvox/mega-250-silver.png',
      inLanguage: 'he-IL',
      datePublished: '2026-07-20',
      dateModified: '2026-07-20',
      author: { '@id': 'https://i-feel.co.il/#business' },
      publisher: { '@id': 'https://i-feel.co.il/#business' },
      mainEntityOfPage: canonical
    }
  ]
});
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  ogImage="https://i-feel.co.il/assets/akuvox/mega-250-silver.png"
  jsonLd={jsonLd}
>
  <Fragment set:html={content} />
</BaseLayout>
