---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/hotel-control-products.json';
const canonical='https://i-feel.co.il/hotel-control-products/';
const meta={title:'ספריית מוצרי בקרת מלון KNX ו־Siemens Desigo | I FEEL',description:'מידע בעברית, תמונות ודפי נתונים של היצרנים: מפסקי Eelectron, מסך Siemens TC4, Schneider System M, חיישני נוכחות ובקרי Desigo.',canonical,ogUrl:canonical,robots:'index, follow, max-image-preview:large'};
---
<BaseLayout {...meta}>
<article dir="rtl" class="bg-slate-50 text-slate-900"><div class="max-w-6xl mx-auto px-4 py-12"><nav class="text-sm mb-6"><a href="/">ראשי</a> / <a href="/eelectron-hotel-room-control/">בקרת מלון</a></nav><header class="mb-10"><h1 class="text-3xl md:text-5xl font-extrabold mb-5">ספריית מוצרי בקרת מלון</h1><p class="text-lg leading-8">ממשקי אורח, בקרי טמפרטורה וחיישנים עם הסברים בעברית ודפי יצרן להורדה מתוך אתר I FEEL.</p></header><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">{products.map(p=><section class="bg-white rounded-xl border border-slate-200 p-6"><a href={`/hotel-control-products/${p.slug}/`}><img src={`/assets/hotel-products/${p.image}`} alt={p.name} width="400" height="280" loading="lazy" class="w-full h-48 object-contain mb-5" /><h2 class="text-xl font-bold mb-3">{p.name}</h2></a><p class="font-mono text-sm mb-3"><bdi dir="ltr">{p.model}</bdi></p><p class="leading-7 mb-4">{p.description}</p><a class="text-sky-800 font-bold underline" href={`/hotel-control-products/${p.slug}/`}>מידע בעברית ודף נתונים</a></section>)}</div><section class="bg-white rounded-xl border border-slate-200 p-7"><h2 class="text-2xl font-bold mb-4">מערכת הניהול ובקרי Siemens</h2><p class="leading-8 mb-5">Siemens DESIGO CC מרכזת את ניהול המלון. בקרי DDC ממשפחת Desigo PXC מבצעים בקרה מקומית למערכות הטכניות, בשילוב מודולי כניסות ויציאות וציוד שדה.</p><div class="grid md:grid-cols-3 gap-5 mb-5">{['4','5','7'].map(n=><figure><img src={`/assets/hotel-products/siemens-pxc${n}.png`} alt={`בקר Siemens PXC${n}`} width="400" height="280" loading="lazy" class="h-40 w-full object-contain" /><figcaption class="text-center font-bold">PXC{n}</figcaption></figure>)}</div><div class="flex flex-wrap gap-5"><a class="text-sky-800 underline font-bold" href="/siemens-desigo-bms/">מערכת Desigo בעברית</a><a class="text-sky-800 underline font-bold" href="/siemens-desigo-cc-system-specification/">מפרט DESIGO CC</a><a class="text-sky-800 underline font-bold" href="/siemens-desigo-pxc4-pxc5-pxc7-system-specification/">מפרט בקרי PXC4 / PXC5 / PXC7</a></div></section></div></article>
</BaseLayout>
