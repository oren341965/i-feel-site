const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://i-feel.co.il/catalogs/#page',
      url: 'https://i-feel.co.il/catalogs/',
      name: 'קטלוגים להורדה',
      description: 'אוסף הקטלוגים הרשמיים של i-feel, בית חכם אלחוטי, KNX, בקרת מבנה BMS, סימנס, בנייה רוויה, אדריכלים, מלונאות ומדריכי התקנה.',
      inLanguage: 'he-IL',
      isPartOf: { '@id': 'https://i-feel.co.il/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'קטלוגים', item: 'https://i-feel.co.il/catalogs/' },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'קטלוגי i-feel',
      numberOfItems: 19,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'קטלוג ZWAVE חשמל אלחוטי 2025', url: '/assets/catalogs/zwave-catalog-2025.pdf' },
        { '@type': 'ListItem', position: 2, name: 'מפסק זכוכית GlassWand Z-Wave 9 כפתורים', url: '/assets/catalogs/glasswand-9-button.pdf' },
        { '@type': 'ListItem', position: 3, name: 'Z-Wave Micro Module', url: '/assets/catalogs/zwave-micro-module.pdf' },
        { '@type': 'ListItem', position: 4, name: 'Wanderfull Z-Wave Hub', url: '/assets/catalogs/wanderfull-hub.pdf' },
        { '@type': 'ListItem', position: 5, name: 'קטלוג מוצרי KNX חשמל קווי 2025', url: '/assets/catalogs/knx-catalog-2025.pdf' },
        { '@type': 'ListItem', position: 6, name: 'קטלוג TACTEO, חיישנים ומפסקי KNX', url: '/assets/catalogs/tacteo-catalog.pdf' },
        { '@type': 'ListItem', position: 7, name: 'קטלוג סימנס Siemens, בקרת מבנה', url: '/assets/catalogs/siemens-bms-catalog.pdf' },
        { '@type': 'ListItem', position: 8, name: 'ספר מערכת בתי מלון, בקרת חדר', url: '/assets/catalogs/hotel-room-control.pdf' },
        { '@type': 'ListItem', position: 9, name: 'קטלוג ארונות תקשורת', url: '/assets/catalogs/communication-cabinets.pdf' },
        { '@type': 'ListItem', position: 10, name: 'קטלוג בנייה רוויה', url: '/assets/catalogs/dense-residential-catalog.pdf' },
        { '@type': 'ListItem', position: 11, name: 'עלון לקבלנים, בנייה ירוקה ותקן 5281', url: '/assets/catalogs/green-building-contractors.pdf' },
        { '@type': 'ListItem', position: 12, name: 'קטלוג מבנים ציבוריים', url: '/assets/catalogs/public-buildings-catalog.pdf' },
        { '@type': 'ListItem', position: 13, name: 'קטלוג חדרי ישיבות', url: '/assets/catalogs/meeting-rooms-catalog.pdf' },
        { '@type': 'ListItem', position: 14, name: 'קטלוג ASLORD, כורסאות לחדרי קולנוע', url: '/assets/catalogs/aslord-cinema-seating.pdf' },
        { '@type': 'ListItem', position: 15, name: 'קטלוג מערכות אאוטדור, גינה וקולנוע חוץ', url: '/assets/catalogs/outdoor-catalog.pdf' },
        { '@type': 'ListItem', position: 16, name: 'מדריך התקנת מפסק WallWand LCD', url: '/assets/catalogs/wallwand-lcd-installation-guide.pdf' },
        { '@type': 'ListItem', position: 17, name: 'חוברת למתקין, Wanderfull', url: '/assets/catalogs/wanderfull-installer-guide.pdf' },
        { '@type': 'ListItem', position: 18, name: 'דף אייקונים למפסק GlassWand, סמלים ללחצנים', url: '/assets/catalogs/glasswand-button-icons.pdf' },
        { '@type': 'ListItem', position: 19, name: 'Siemens Touch Control TC4 ו-TC5, מדריך בעברית', url: '/assets/catalogs/siemens-touch-control-tc4-tc5-he.pdf' },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'דפי מוצר Siemens KNX',
      numberOfItems: siemensActuators.length,
      itemListElement: siemensActuators.map((actuator, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: actuator.title,
        url: `https://i-feel.co.il/articles/${actuator.slug}/`,
      })),
    },
  ],
};

const meta = {
  title: 'קטלוגים להורדה | בית חכם, KNX, BMS ובנייה רוויה | i-feel',
  description: 'קטלוגים רשמיים של i-feel להורדה, בית חכם אלחוטי, KNX קווי, בקרת מבנה BMS, סימנס, בנייה רוויה, אדריכלים ומלונאות. PDF, ללא הרשמה.',
  canonical: 'https://i-feel.co.il/catalogs/',
  ogTitle: 'קטלוגים להורדה | i-feel',
  ogDescription: 'כל הקטלוגים הרשמיים של i-feel, בית חכם, KNX, BMS, בנייה רוויה ומלונאות. PDF להורדה.',
  ogUrl: 'https://i-feel.co.il/catalogs/',
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(jsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />

  <section id="siemens-knx-actuators" class="bg-brand-50 py-12 lg:py-16 border-y border-brand-100 scroll-mt-32" dir="rtl">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-7">
        <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 border-r-4 border-accent-500 pr-3 mb-2">דפי מוצר Siemens KNX</h2>
        <p class="text-brand-700 max-w-4xl">
          מידע טכני ברור עבור הלקוח על בקרי Siemens לתאורה, עומסים, תריסים והצללות, כולל יכולות, שימושים ונתונים חשובים לתכנון המערכת.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {siemensActuators.map((actuator, index) => (
          <article class={`bg-white ${index === 0 ? 'border-2 border-accent-500' : 'border border-brand-100 hover:border-accent-500'} hover:shadow-lg rounded-2xl p-6 flex flex-col transition`}>
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="tag tag-bms">Siemens</span>
              <span class="tag tag-architect">KNX</span>
              <span class="tag tag-private">{actuator.channelTag}</span>
              <span class="tag tag-contractor">{actuator.applicationTag}</span>
            </div>
            <h3 class="text-xl font-extrabold text-brand-900 mb-3 leading-snug">{actuator.title}</h3>
            <p class="text-brand-700 mb-4 flex-grow">{actuator.description}</p>
            <div class="text-sm text-brand-600 mb-5 space-y-1">
              <p><strong>מק״ט:</strong> {actuator.partNumber}</p>
              <p><strong>מתאים עבור:</strong> {actuator.suitableFor}</p>
            </div>
            <a href={`/articles/${actuator.slug}/`} class={`inline-flex items-center justify-center gap-2 ${index === 0 ? 'bg-accent-600 hover:bg-accent-700' : 'bg-brand-700 hover:bg-brand-800'} text-white px-5 py-3 rounded-lg font-semibold transition`}>
              {actuator.buttonLabel} <span aria-hidden="true">←</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SiemensDdcCta />
  <KnxAdvisorCta />
</BaseLayout>
