const siemensKnowledgeResources = [
  {
    title: 'מרכז הידע Siemens Desigo לבקרת מבנה BMS',
    description: 'מפרטי PXC4, PXC5, PXC7 ו-Desigo CC, כולל מסמכי Word ו-PDF ותוכן מלא שניתן לחיפוש.',
    href: '/siemens-bms-knowledge-center/',
    label: 'פתיחת מרכז הידע BMS',
  },
  {
    title: 'קטלוג ומסמכי Siemens KNX לשנת 2026',
    description: 'קטלוגים, דפי נתונים, מדריכי התקנה ומסמכים טכניים רשמיים של Siemens KNX.',
