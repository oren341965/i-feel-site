import content from '../page-html/brands-and-technologies.html?raw';

const meta = {
  title: "מותגים וטכנולוגיות | Siemens, KNX, Control4 | i-feel",
  description: "המותגים שאיתם i-feel עובדת: Siemens Desigo, KNX, Control4, Hikvision, Akuvox, Aruba, Risco, Focal ו-Touchwand. אינטגרטור אחד לכל המערכות. 03-508-9553.",
