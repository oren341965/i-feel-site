  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
        "@id": "https://i-feel.co.il/#business",
        "name": "i-feel",
        "alternateName": "i-feel מערכות בקרת מבנה ובית חכם",
        "url": "https://i-feel.co.il/",
        "logo": "https://i-feel.co.il/assets/ifeel-logo.png",
        "image": "https://i-feel.co.il/assets/ifeel-logo.png",
        "telephone": "+972-3-508-9553",
        "email": "sales@i-feel.co.il",
        "priceRange": "₪₪₪",
        "address": { "@type": "PostalAddress", "streetAddress": "אימבר 14", "addressLocality": "פתח תקווה", "addressRegion": "מחוז המרכז", "postalCode": "4951148", "addressCountry": "IL" },
        "areaServed": { "@type": "Country", "name": "Israel", "sameAs": "https://www.wikidata.org/wiki/Q801" },
        "sameAs": ["https://www.facebook.com/SmarthomeIsrael", "https://www.instagram.com/ifeelisrael", "https://www.linkedin.com/company/i-feel-smart-home-systems"]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://i-feel.co.il/" },
          { "@type": "ListItem", "position": 2, "name": "מותגים וטכנולוגיות", "item": "https://i-feel.co.il/brands-and-technologies/" }
        ]
      },
      {
        "@type": "ItemList",
        "name": "מותגים וטכנולוגיות שאיתם i-feel עובדת",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Siemens Desigo — בקרת מבנה BMS" },
          { "@type": "ListItem", "position": 2, "name": "KNX — בית חכם קווי" },
          { "@type": "ListItem", "position": 3, "name": "Control4 — שליטה מתקדמת" },
          { "@type": "ListItem", "position": 4, "name": "Touchwand — בית חכם אלחוטי" },
          { "@type": "ListItem", "position": 5, "name": "Hikvision — מצלמות ואנליטיקה" },
          { "@type": "ListItem", "position": 6, "name": "Akuvox — אינטרקום IP" },
          { "@type": "ListItem", "position": 7, "name": "Risco — אזעקה וגילוי" },
          { "@type": "ListItem", "position": 8, "name": "Aruba — רשת ו-Wi-Fi" },
