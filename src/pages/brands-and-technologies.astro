          { "@type": "ListItem", "position": 10, "name": "Klipsch — רמקולים" },
          { "@type": "ListItem", "position": 11, "name": "SpeakerCraft — רמקולים שקועים" },
          { "@type": "ListItem", "position": 12, "name": "Epson — מקרני קולנוע" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "עם אילו מותגים i-feel עובדת?", "acceptedAnswer": { "@type": "Answer", "text": "Siemens Desigo ל-BMS, KNX לבית חכם קווי, Control4 לשליטה מתקדמת, Touchwand לבית חכם אלחוטי, Hikvision למצלמות, Akuvox לאינטרקום IP, Risco לאזעקה, Aruba לרשת, ו-Focal, Klipsch, SpeakerCraft ו-Epson לאודיו וקולנוע ביתי." } },
          { "@type": "Question", "name": "האם i-feel עובדת עם Siemens Desigo?", "acceptedAnswer": { "@type": "Answer", "text": "כן. i-feel מטמיעה ומבצעת אינטגרציה של פתרונות Siemens Desigo בפרויקטי בקרת מבנה BMS, לצד DDC, KNX, BACnet ו-Modbus." } },
          { "@type": "Question", "name": "מה ההבדל בין KNX ל-Control4?", "acceptedAnswer": { "@type": "Answer", "text": "KNX הוא תקן בקרה פתוח לתשתית הבית (תאורה, תריסים, מיזוג), אמין ועצמאי מהאינטרנט. Control4 הוא פלטפורמת שליטה וחוויית משתמש מעל התשתית. לרוב משלבים את שניהם." } },
          { "@type": "Question", "name": "למה לבחור אינטגרטור ולא מתקין?", "acceptedAnswer": { "@type": "Answer", "text": "אינטגרטור מחבר את כל המותגים והמערכות למערכת אחת, עם תכנון, תכנות ושירות תחת ספק אחד — לא רק התקנת מוצרים נפרדים." } }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
