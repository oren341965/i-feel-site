        "dateModified": "2026-09-07",
        "isPartOf": { "@id": "https://i-feel.co.il/#website" },
        "about": { "@id": "https://i-feel.co.il/#business" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": "https://i-feel.co.il/" },
          { "@type": "ListItem", "position": 2, "name": "מדיניות פרטיות", "item": "https://i-feel.co.il/privacy/" }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
