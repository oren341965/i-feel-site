---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingCta from '../../components/FloatingCta.astro';

// הסרטון האופקי פורסם בערוץ YouTube הרשמי.
const videos = [
  {
    name: 'בוטיק הנביאים - מערכת צלונים כלואים 24V | I FEEL',
    ratio: '16 / 9',
    src: 'https://www.youtube-nocookie.com/embed/iOplohn-kQs',
    link: 'https://youtu.be/iOplohn-kQs',
  },
];

const meta = {
  title: 'בוטיק הנביאים | מערכת צלונים כלואים 24V | I FEEL',
  description: 'הכירו את מערכת הצלונים הכלואים במתח 24V בפרויקט בוטיק הנביאים. סרטוני הדגמה של פתרון הצללה ובקרה המותקן בפרויקט.',
  canonical: 'https://i-feel.co.il/projects/boutique-haneviim-24v/',
  ogTitle: 'בוטיק הנביאים - מערכת צלונים כלואים 24V | I FEEL',
  ogDescription: 'מערכת צלונים כלואים במתח 24V בפרויקט בוטיק הנביאים.',
  ogUrl: 'https://i-feel.co.il/projects/boutique-haneviim-24v/',
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': 'https://i-feel.co.il/projects/boutique-haneviim-24v/#page',
        name: 'בוטיק הנביאים - מערכת צלונים כלואים 24V',
        url: 'https://i-feel.co.il/projects/boutique-haneviim-24v/',
        description: 'תיעוד מצולם של מערכת הצלונים הכלואים במתח 24V בפרויקט בוטיק הנביאים.',
        inLanguage: 'he-IL',
        isPartOf: { '@id': 'https://i-feel.co.il/#website' },
        publisher: { '@id': 'https://i-feel.co.il/#business' },
      },
      {
        '@type': 'VideoObject',
        '@id': 'https://i-feel.co.il/projects/boutique-haneviim-24v/#video',
        name: 'בוטיק הנביאים - מערכת צלונים כלואים 24V | I FEEL',
        description: 'הדגמה מצולמת של מערכת צלונים כלואים במתח 24V בפרויקט בוטיק הנביאים.',
        uploadDate: '2026-10-27',
        thumbnailUrl: 'https://i.ytimg.com/vi/iOplohn-kQs/hqdefault.jpg',
        contentUrl: 'https://www.youtube.com/watch?v=iOplohn-kQs',
        embedUrl: 'https://www.youtube-nocookie.com/embed/iOplohn-kQs',
        inLanguage: 'he-IL',
        publisher: { '@id': 'https://i-feel.co.il/#business' },
      }
    ]
  }),
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם">
    <div class="max-w-5xl mx-auto px-4 py-3 text-sm">
      <a href="/" class="text-brand-700 hover:underline">דף הבית</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <a href="/projects/" class="text-brand-700 hover:underline">פרויקטים</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span aria-current="page">בוטיק הנביאים</span>
    </div>
  </nav>

  <section class="hero-gradient text-white">
    <div class="max-w-5xl mx-auto px-4 py-14">
      <p class="text-brand-100 font-semibold mb-2">פרויקט מגורים | הצללה חכמה</p>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4">בוטיק הנביאים - מערכת של צלונים כלואים 24V</h1>
      <p class="text-xl text-brand-100 leading-relaxed max-w-3xl">
        הצצה מצולמת למערכת הצלונים הכלואים במתח 24V שהותקנה בפרויקט בוטיק הנביאים.
      </p>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-10 text-brand-800">
      <h2 class="text-2xl font-extrabold text-brand-900 mb-3">מערכת הצלונים בפרויקט</h2>
      <p class="text-lg leading-relaxed">
        הסרטון מציג את פתרון הצלונים הכלואים ואת אופן הפעולה שלו בפרויקט.
        לתכנון פתרון הצללה ובקרה בפרויקט מגורים ניתן לפנות לצוות I FEEL.
      </p>
    </div>
    <div class="grid lg:grid-cols-2 gap-8 items-start" id="video">
      {videos.map((video) => (
        <article class="border border-brand-100 shadow-sm bg-white rounded-2xl overflow-hidden">
          <h2 class="text-lg font-bold text-brand-900 px-5 pt-5 pb-3">{video.name}</h2>
          <div class="bg-brand-900 mx-auto" style={`aspect-ratio: ${video.ratio}; max-width: ${video.ratio === '9 / 16' ? '320px' : '100%'}`}>
            <iframe class="w-full h-full" loading="lazy" src={video.src} title={video.name} allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="px-5 py-4">
            <a href={video.link} target="_blank" rel="noopener noreferrer" class="text-accent-700 underline">צפייה בסרטון ב-YouTube</a>
          </div>
        </article>
      ))}
    </div>
    <aside class="mt-12 rounded-xl bg-brand-50 p-6 border border-brand-100">
      <h2 class="text-xl font-bold text-brand-900 mb-2">מתכננים מערכת הצללה חכמה?</h2>
      <p class="text-brand-700 mb-4">צוות I FEEL מסייע בתכנון ובהתקנת מערכות בקרה למגורים, כולל פתרונות הצללה ותריסים.</p>
      <a class="inline-block bg-accent-600 hover:bg-accent-700 text-white font-bold rounded-lg px-6 py-3" href="/contactus/">לייעוץ והצעת מחיר</a>
    </aside>
  </main>
  <FloatingCta label="ייעוץ על מערכת צלונים" href="/contactus/" event="consultation_click" params={{ source_page: '/projects/boutique-haneviim-24v/' }} />
</BaseLayout>
