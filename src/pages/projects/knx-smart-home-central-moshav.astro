---
import BaseLayout from '../../layouts/BaseLayout.astro';

const url = 'https://i-feel.co.il/projects/knx-smart-home-central-moshav/';
const base = '/projects/knx-smart-home-central-moshav';
const hero = `${base}/16-smart-home-entrance-knx-akuvox.jpg`;

const galleryGroups = [
  {
    id: 'outdoor-detectors',
    eyebrow: 'בקרת תאורת חוץ',
    title: 'גלאי נוכחות KNX חיצוניים',
    intro: 'הגלאים מותקנים באזורי החצר והפרגולה ומפעילים תאורה רק כאשר מזוהה תנועה ורמת האור נמוכה מסף ה‑LUX שהוגדר.',
    photos: [
      { src: `${base}/02-knx-outdoor-presence-detector-close.jpg`, alt: 'גלאי נוכחות KNX חיצוני תחת פרגולה', cap: 'גלאי חוץ תחת הפרגולה — זיהוי תנועה ומדידת LUX' },
      { src: `${base}/03-knx-outdoor-presence-detector-patio.jpg`, alt: 'גלאי KNX חיצוני באזור ישיבה', cap: 'כיסוי אזור הישיבה והמעבר בחצר' },
      { src: `${base}/04-knx-outdoor-presence-detector-window.jpg`, alt: 'גלאי נוכחות KNX חיצוני ליד חלון', cap: 'מיקום דיסקרטי ליד החלון, מכוון לאזור התנועה' },
      { src: `${base}/12-knx-detector-outdoor-siren.jpg`, alt: 'דוגמה להתקנת גלאי נוכחות KNX חיצוני לצד צופר נפרד מעל החלון', cap: 'דוגמה נוספת לגלאי נוכחות KNX חיצוני; לצדו מותקן צופר האזעקה מעל החלון, כחלק ממערכות הבית המשולבות' },
      { src: `${base}/13-knx-detector-outdoor-siren-close.jpg`, alt: 'גלאי חוץ KNX וצופר במבט קרוב', cap: 'מבט קרוב על הגלאי והצופר מעל החלון' },
      { src: `${base}/16-smart-home-entrance-knx-akuvox.jpg`, alt: 'כניסה לבית עם גלאי נוכחות, צופר ואינטרקום', cap: 'הכניסה לבית — גלאי, צופר ואינטרקום במערכת משולבת' },
    ],
  },
  {
    id: 'control',
    eyebrow: 'ממשקי משתמש',
    title: 'מסכי שליטה, מיזוג ומפסקי KNX',
    intro: 'מסכי המגע והבקרים מרכזים את הפעולות היומיומיות במקום נגיש, בלי להעמיס על הקיר ובלי לחייב שימוש בטלפון.',
    photos: [
      { src: `${base}/05-knx-touch-panel-kitchen.jpg`, alt: 'מסך מגע KNX במטבח', cap: 'מסך מגע לשליטה בבית החכם במטבח' },
      { src: `${base}/06-knx-touch-panel-wide.jpg`, alt: 'מסך מגע מרכזי לשליטה בבית החכם KNX ולצמצום מספר המפסקים בקירות', cap: 'מסך שליטה מרכזי ואפליקציה מאפשרים לצמצם משמעותית את מספר המפסקים ולשמור על קירות נקיים' },
      { src: `${base}/07-knx-touch-panel-display.jpg`, alt: 'תצוגת מסך מגע של מערכת KNX', cap: 'ממשק הפעלה לתאורה, תריסים ותרחישים' },
      { src: `${base}/10-knx-control-station-hvac.jpg`, alt: 'בקר מיזוג, מסך מגע ומפסק KNX', cap: 'עמדת שליטה משולבת: מיזוג, מסך מגע ומפסק KNX' },
    ],
  },
  {
    id: 'network-security',
    eyebrow: 'תקשורת ואבטחה',
    title: 'Aruba AP27, אינטרקום Akuvox ומצלמה',
    intro: 'הרשת, האינטרקום והאבטחה מתוכננים כחלק מהבית החכם, כדי שכל המערכות יקבלו תשתית תקשורת יציבה וניהול מרכזי.',
    photos: [
      { src: `${base}/01-aruba-ap27-courtyard.jpg`, alt: 'נקודת גישה חיצונית Aruba AP27 לתקשורת WiFi 6 רחבת פס בחצר', cap: 'Aruba AP27 — תקשורת אלחוטית חיצונית מהירה ורחבת פס, בהתקנה דיסקרטית ששומרת על נראות הבית' },
      { src: `${base}/11-akuvox-ip-intercom.jpg`, alt: 'אינטרקום IP Akuvox עם קודן וקורא קרבה', cap: 'אינטרקום Akuvox עם מצלמה, קודן וקורא קרבה' },
      { src: `${base}/15-outdoor-security-camera.jpg`, alt: 'מצלמת אבטחה חיצונית בגינה', cap: 'מצלמת אבטחה חיצונית המשולבת בתכנון הגינה והחזית' },
    ],
  },
  {
    id: 'indoor-automation',
    eyebrow: 'אוטומציה בתוך הבית',
    title: 'תאורה, תריסים וגלאי פנים',
    intro: 'המערכת מחברת תאורה, תריסים וגלאי פנים לתרחישים נוחים, כאשר ההפעלות האוטומטיות מותאמות לשעה, לתנועה ולרמת האור.',
    photos: [
      { src: `${base}/08-smart-kitchen-knx.jpg`, alt: 'מטבח עם תאורה וגלאי במערכת KNX', cap: 'מטבח חכם עם תאורה וגלאי תקרה' },
      { src: `${base}/09-smart-living-room-knx.jpg`, alt: 'סלון חכם עם תאורה ותריסים בשליטת KNX וגלאי אזעקה קטן ודיסקרטי', cap: 'סלון חכם עם תאורה ותריסים בשליטת KNX — גלאי האזעקה הקטן נטמע בחלל, מוסיף ביטחון ואינו פוגע בנראות הבית' },
      { src: `${base}/14-knx-ceiling-presence-detector.jpg`, alt: 'גלאי נוכחות שקוע בתקרה', cap: 'גלאי נוכחות פנימי שקוע ודיסקרטי' },
      { src: `${base}/17-knx-motorized-shading.jpg`, alt: 'ויטרינה עם תריס והצללה ממונעים בשליטת Siemens KNX להצללה מדויקת', cap: 'הצללה ממונעת ומדויקת בוויטרינה — שליטה מרכזית במקום להוסיף מפסק אלחוטי ליד כל חלון' },
    ],
  },
];

const meta = {
  title: 'בית חכם KNX במושב במרכז | גלאי חוץ, Aruba ו-Akuvox | i-feel',
  description: 'פרויקט בית חכם Siemens KNX במושב במרכז: ציוד שמשתלב אסתטית, גלאי חוץ לפי תנועה ו-LUX, חשמל חכם, אזעקה, מצלמות, Aruba AP27, אינטרקום ותריסים.',
  canonical: url,
  ogTitle: 'בית חכם KNX במושב במרכז — תמונות התקנה אמיתיות | i-feel',
  ogDescription: 'כך נראים גלאי KNX, מסכי שליטה, רשת Aruba, אינטרקום Akuvox ותריסים לאחר התקנה בבית פרטי.',
  ogUrl: url,
  ogImage: `https://i-feel.co.il${hero}`,
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
        '@id': 'https://i-feel.co.il/#business',
        name: 'i-feel',
        url: 'https://i-feel.co.il/',
        telephone: '+972-3-508-9553',
        email: 'sales@i-feel.co.il',
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'פרויקטים', item: 'https://i-feel.co.il/projects/' },
          { '@type': 'ListItem', position: 3, name: 'בית חכם KNX במושב במרכז', item: url },
        ],
      },
      {
        '@type': 'Article',
        headline: 'בית חכם KNX במושב במרכז — מקרה בוחן מצולם',
        description: 'גלאי נוכחות חיצוניים, מסכי שליטה, רשת Aruba, אינטרקום Akuvox, אבטחה ותריסים במערכת אחת.',
        image: `https://i-feel.co.il${hero}`,
        datePublished: '2026-07-23',
        dateModified: '2026-07-23',
        author: { '@id': 'https://i-feel.co.il/#business' },
        publisher: { '@id': 'https://i-feel.co.il/#business' },
        mainEntityOfPage: url,
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'מתי גלאי הנוכחות החיצוני מדליק את התאורה?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'התאורה נדלקת רק כאשר מתקיימים שני תנאים יחד: הגלאי מזהה תנועה ורמת התאורה הנמדדת נמוכה מסף ה-LUX שהוגדר. כאשר יש מספיק אור טבעי, תנועה לבדה אינה מדליקה את התאורה.',
            },
          },
          {
            '@type': 'Question',
            name: 'אפשר לכוון את רגישות הגלאי ואת משך ההדלקה?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'כן. בתכנות מגדירים את סף ה-LUX, זמן ההשהיה והאזור הנשלט בהתאם למיקום ולשימוש.',
            },
          },
        ],
      },
    ],
  }),
};
---

<BaseLayout {...meta}>
  <article dir="rtl">
    <nav class="border-b border-brand-100 bg-brand-50" aria-label="פירורי לחם">
      <div class="max-w-7xl mx-auto px-4 py-3 text-sm">
        <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
        <span class="mx-2 text-brand-400">›</span>
        <a href="/projects/" class="text-brand-600 hover:text-accent-600">פרויקטים</a>
        <span class="mx-2 text-brand-400">›</span>
        <span class="font-medium text-brand-900">בית חכם KNX במושב במרכז</span>
      </div>
    </nav>

    <header class="bg-brand-900 text-white">
      <div class="max-w-6xl mx-auto px-4 py-12 lg:py-16 grid lg:grid-cols-[1.15fr_.85fr] gap-8 items-center">
        <div>
          <p class="inline-block rounded-full bg-accent-500 px-4 py-1.5 text-sm font-bold mb-5">מקרה בוחן מצולם · בית פרטי</p>
          <h1 class="text-4xl md:text-6xl font-extrabold leading-tight">בית חכם KNX במושב במרכז</h1>
          <p class="mt-5 max-w-3xl text-xl leading-8 text-brand-100">גלאי נוכחות חיצוניים, מסכי שליטה, מיזוג, רשת Aruba, אינטרקום Akuvox, אבטחה ותריסים — מתוכננים לעבוד יחד ולהשתלב באופן נקי ואסתטי בבית.</p>
        </div>
        <figure class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-lg">
          <img src={hero} alt="כניסה לבית חכם KNX במושב במרכז עם גלאי, צופר ואינטרקום" class="aspect-[4/3] w-full object-cover" loading="eager" />
        </figure>
      </div>
    </header>

    <section class="bg-brand-900 text-white border-t border-white/10">
      <div class="max-w-6xl mx-auto px-4 pb-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-brand-300">סוג נכס</div><div class="font-bold text-lg mt-1">בית פרטי</div></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-brand-300">מערכת</div><div class="font-bold text-lg mt-1">KNX קווי</div></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-brand-300">רשת</div><div class="font-bold text-lg mt-1">Aruba AP27</div></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-brand-300">בקרת כניסה</div><div class="font-bold text-lg mt-1">Akuvox</div></div>
      </div>
    </section>

    <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16">
      <div class="prose-he max-w-4xl">
        <section>
          <h2>גלאי KNX חיצוני להדלקת תאורה — בלי לבזבז חשמל בצהריים</h2>
          <p>הגלאי החיצוני בפרויקט אינו מפעיל את התאורה על כל תנועה. הלוגיקה בודקת שני תנאים בו־זמנית: <strong>האם זוהתה תנועה</strong>, ו<strong>האם רמת התאורה שנמדדה נמוכה מסף ה‑LUX שהוגדר</strong>. רק כאשר שתי התשובות חיוביות נשלחת פקודת ההדלקה.</p>
          <p>לכן מעבר בחצר בצהריים, כאשר יש אור טבעי מספק, אינו מדליק סתם את התאורה. בערב או בלילה אותה תנועה כן מפעילה את האור למשך הזמן שנקבע. אפשר להתאים לכל אזור את סף ה‑LUX, זמן ההשהיה והמעגלים שיופעלו.</p>
        </section>
      </div>

      <div class="my-10 grid md:grid-cols-3 gap-4" aria-label="לוגיקת הפעלת תאורה">
        <div class="rounded-2xl bg-brand-900 p-6 text-center text-white"><span class="text-sm text-brand-200">תנאי ראשון</span><strong class="block mt-2 text-2xl">זוהתה תנועה</strong></div>
        <div class="rounded-2xl bg-brand-900 p-6 text-center text-white"><span class="text-sm text-brand-200">תנאי שני</span><strong class="block mt-2 text-2xl">רמת LUX נמוכה</strong></div>
        <div class="rounded-2xl bg-accent-500 p-6 text-center text-white"><span class="text-sm text-white/80">רק אז</span><strong class="block mt-2 text-2xl">התאורה נדלקת</strong></div>
      </div>

      <section id="aesthetic-integration" class="py-10 border-t border-brand-100">
        <div class="max-w-4xl mb-6">
          <p class="text-sm font-extrabold text-accent-600">הטכנולוגיה משתלבת באדריכלות</p>
          <h2 class="mt-2 text-3xl font-extrabold text-brand-900">כמה מערכות, מראה אחד נקי</h2>
          <p class="mt-3 text-lg leading-8 text-brand-700">רוב הציוד אינו צריך למשוך תשומת לב. גלאי תקרה שקוע, מסך שטוח על הקיר, אינטרקום בקו נקי ונקודת גישה המותקנת גבוה ובמיקום מתוכנן מאפשרים לבית להישאר בית — בזמן שהאוטומציה פועלת ברקע.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <figure class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
            <div class="aspect-[4/3] bg-brand-100"><img src={`${base}/14-knx-ceiling-presence-detector.jpg`} alt="גלאי נוכחות KNX שקוע ודיסקרטי בתקרה" class="h-full w-full object-cover" loading="lazy" /></div>
            <figcaption class="p-4"><strong class="text-brand-900">גלאי תקרה שקוע</strong><p class="mt-1 text-sm leading-6 text-brand-700">נוכחות אוטומטית בלי אביזר בולט בחלל.</p></figcaption>
          </figure>
          <figure class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
            <div class="aspect-[4/3] bg-brand-100"><img src={`${base}/05-knx-touch-panel-kitchen.jpg`} alt="מסך מגע KNX המשתלב בקיר המטבח" class="h-full w-full object-cover" loading="lazy" /></div>
            <figcaption class="p-4"><strong class="text-brand-900">מסך שליטה על הקיר</strong><p class="mt-1 text-sm leading-6 text-brand-700">ממשק נגיש לתאורה, תריסים, מיזוג ותרחישים.</p></figcaption>
          </figure>
          <figure class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
            <div class="aspect-[4/3] bg-brand-100"><img src={`${base}/11-akuvox-ip-intercom.jpg`} alt="אינטרקום Akuvox בקו נקי לצד הכניסה" class="h-full w-full object-cover" loading="lazy" /></div>
            <figcaption class="p-4"><strong class="text-brand-900">אינטרקום ובקרת כניסה</strong><p class="mt-1 text-sm leading-6 text-brand-700">מצלמה, קודן וקורא קרבה ביחידה אחת מסודרת.</p></figcaption>
          </figure>
          <figure class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
            <div class="aspect-[4/3] bg-brand-100"><img src={`${base}/09-smart-living-room-knx.jpg`} alt="סלון חכם עם גלאי אזעקה קטן המשתלב בעיצוב הבית" class="h-full w-full object-cover" loading="lazy" /></div>
            <figcaption class="p-4"><strong class="text-brand-900">גלאי אזעקה דיסקרטי בסלון</strong><p class="mt-1 text-sm leading-6 text-brand-700">גודלו הקטן מאפשר ביטחון והשתלבות במערכת, בלי לפגוע בנראות הבית.</p></figcaption>
          </figure>
        </div>
        <div class="mt-8 overflow-hidden rounded-3xl border border-brand-100 bg-white shadow-sm">
          <div class="p-6 md:p-8">
            <p class="text-sm font-extrabold text-accent-600">פחות מפסקים, יותר שליטה</p>
            <h3 class="mt-2 text-2xl md:text-3xl font-extrabold text-brand-900">קירות נקיים והצללה מדויקת עם Siemens KNX</h3>
            <p class="mt-3 max-w-4xl text-lg leading-8 text-brand-700">במקום לפזר מפסקים אלחוטיים בכל פינה, תשתית Siemens KNX קווית מרכזת את התאורה, התריסים וההצללה. מפסקי Siemens מתוכננים רק במקומות שבהם שליטה פיזית באמת נוחה, ואת שאר הפעולות אפשר לבצע במסך המרכזי, באפליקציה ובתרחישים אוטומטיים. התוצאה היא פחות אביזרים על הקירות, מראה נקי יותר ושליטה מדויקת בכמות האור הנכנסת דרך הוויטרינה.</p>
          </div>
          <div class="grid sm:grid-cols-2 gap-px bg-brand-100">
            <figure class="bg-white">
              <div class="aspect-[4/3] bg-brand-100"><img src={`${base}/06-knx-touch-panel-wide.jpg`} alt="מסך מגע מרכזי לשליטה בבית החכם KNX על קיר נקי" class="h-full w-full object-cover" loading="lazy" /></div>
              <figcaption class="p-4 text-sm leading-6 text-brand-700"><strong class="text-brand-900">שליטה מרכזית</strong> — תאורה, תריסים, מיזוג ותרחישים ממסך אחד ובאפליקציה.</figcaption>
            </figure>
            <figure class="bg-white">
              <div class="aspect-[4/3] bg-brand-100"><img src={`${base}/17-knx-motorized-shading.jpg`} alt="ויטרינה עם הצללה ממונעת ומדויקת בשליטת KNX" class="h-full w-full object-cover" loading="lazy" /></div>
              <figcaption class="p-4 text-sm leading-6 text-brand-700"><strong class="text-brand-900">הצללה מדויקת</strong> — התאמת התריס וההצללה בלי להוסיף מפסק אלחוטי ליד כל פתח.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      {galleryGroups.map((group) => (
        <section id={group.id} class="py-10 border-t border-brand-100 first:border-t-0">
          <div class="max-w-4xl mb-6">
            <p class="text-sm font-extrabold text-accent-600">{group.eyebrow}</p>
            <h2 class="mt-2 text-3xl font-extrabold text-brand-900">{group.title}</h2>
            <p class="mt-3 text-lg leading-8 text-brand-700">{group.intro}</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {group.photos.map((photo) => (
              <figure class="overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
                <div class="aspect-[4/3] bg-brand-100"><img src={photo.src} alt={photo.alt} class="h-full w-full object-cover" loading="lazy" /></div>
                <figcaption class="p-4 text-sm leading-6 text-brand-700">{photo.cap}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))}

      <section id="siemens-integration" class="my-10 overflow-hidden rounded-3xl bg-brand-900 text-white">
        <div class="grid lg:grid-cols-[1.05fr_.95fr]">
          <div class="p-7 md:p-10">
            <p class="text-sm font-extrabold text-accent-400">מערכת משולבת מבוססת Siemens KNX</p>
            <h2 class="mt-2 text-3xl md:text-4xl font-extrabold">חשמל, אבטחה ותקשורת שעובדים יחד</h2>
            <p class="mt-4 text-lg leading-8 text-brand-100">מערכת בית חכם מבוססת Siemens KNX יכולה לשמש כשכבת הבקרה היציבה של החשמל החכם — תאורה, תריסים, מיזוג, חיישנים ותרחישים. באמצעות ממשקים תואמים ותכנות מתאים ניתן לשלב באותה חוויית שימוש גם אזעקה, מצלמות, אינטרקום ורשת אלחוטית מנוהלת.</p>
            <p class="mt-4 text-sm leading-6 text-brand-300">החיבור המדויק תלוי בדגמי הציוד, בפרוטוקולים ובממשקים הזמינים; לכן בודקים תאימות ומתכננים את האינטגרציה לפני הביצוע.</p>
          </div>
          <div class="grid grid-cols-2 gap-px bg-white/10">
            <div class="bg-brand-900 p-6"><span class="text-sm text-brand-300">שכבת KNX</span><strong class="block mt-2 text-xl">חשמל חכם</strong><p class="mt-2 text-sm leading-6 text-brand-200">תאורה, תריסים, מיזוג ותרחישים.</p></div>
            <div class="bg-brand-900 p-6"><span class="text-sm text-brand-300">בטיחות</span><strong class="block mt-2 text-xl">אזעקה</strong><p class="mt-2 text-sm leading-6 text-brand-200">מצבים ואירועים דרך ממשק תואם.</p></div>
            <div class="bg-brand-900 p-6"><span class="text-sm text-brand-300">אבטחה וכניסה</span><strong class="block mt-2 text-xl">מצלמות ואינטרקום</strong><p class="mt-2 text-sm leading-6 text-brand-200">תצוגה, התראות ובקרת כניסה.</p></div>
            <div class="bg-brand-900 p-6"><span class="text-sm text-brand-300">תשתית IP</span><strong class="block mt-2 text-xl">תקשורת אלחוטית</strong><p class="mt-2 text-sm leading-6 text-brand-200">רשת מנוהלת לבית ולחצר.</p></div>
          </div>
        </div>
      </section>

      <div class="prose-he max-w-4xl">
        <section id="result">
          <h2>התוצאה: אוטומציה שמרגישים, לא כזו שמפריעה</h2>
          <p>הציוד אינו אוסף מוצרים נפרדים. הגלאים, התאורה, התריסים, המיזוג, הרשת והאינטרקום מתוכננים כמערכת אחת — וגם כחלק מהמראה האדריכלי. המשתמש מקבל פעולות אוטומטיות בזמן הנכון, שליטה ידנית ברורה ותשתית שניתנת לשירות ולהרחבה, בלי להפוך את הבית לאולם תצוגה של אביזרים.</p>
        </section>
        <section id="faq">
          <h2>שאלות נפוצות</h2>
          <details><summary>האם הגלאי מדליק את האור בכל פעם שמישהו עובר?</summary><p>לא. ההדלקה מתבצעת רק כאשר יש גם תנועה וגם רמת LUX נמוכה מהסף שהוגדר. באור יום מספק, תנועה אינה מפעילה את התאורה.</p></details>
          <details><summary>אפשר לשנות את סף ה‑LUX?</summary><p>כן. סף האור, משך ההדלקה והמעגלים הנשלטים ניתנים להתאמה בתכנות לפי כל אזור.</p></details>
          <details><summary>האם מערכת KNX ממשיכה לעבוד בלי אינטרנט?</summary><p>כן. לוגיקת התאורה המקומית פועלת על גבי מערכת KNX ואינה תלויה באינטרנט. חיבור הרשת נדרש לשירותים מרוחקים ולמערכות IP, לא להפעלה הבסיסית של התאורה.</p></details>
          <details><summary>האם Siemens KNX יכולה להשתלב עם אזעקה, מצלמות ורשת אלחוטית?</summary><p>כן, כאשר קיימים ממשקים תואמים ומתכננים את האינטגרציה בהתאם לדגמים ולפרוטוקולים. KNX מטפלת בשכבת הבקרה הקווית, ושכבת אינטגרציה יכולה לחבר אליה אירועי אזעקה, מצלמות, אינטרקום ומערכות IP.</p></details>
        </section>
      </div>
    </div>

    <section class="bg-brand-900 py-16 text-white" id="contact">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold">רוצים גלאים ואוטומציה שמתוכננים נכון?</h2>
        <p class="mt-4 text-xl text-brand-200">נתאים את הגלאים, ספי ה‑LUX, זמני ההפעלה והתרחישים לבית ולשגרת החיים.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="tel:+972-3-508-9553" class="rounded-lg bg-accent-500 px-7 py-3.5 text-lg font-semibold text-white hover:bg-accent-600">03-508-9553</a>
          <a href="/contactus/" class="rounded-lg border border-white/30 bg-white/10 px-7 py-3.5 text-lg font-semibold text-white hover:bg-white/20">לתיאום פגישה</a>
        </div>
      </div>
    </section>
  </article>
