---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/privacy-policy.html?raw';

const url = 'https://i-feel.co.il/privacy-policy/';
const meta = {
  title: 'מדיניות פרטיות | אתר ואפליקציית I FEEL AI Sales Manager | i-feel',
  description: 'מדיניות הפרטיות של i-feel לאתר ולאפליקציית I FEEL AI Sales Manager: מידע, מטרות, ספקים, שמירה, אבטחה וזכויות. לבירורים: 03-508-9553.',
  canonical: url,
  ogTitle: 'מדיניות פרטיות | i-feel',
  ogDescription: 'איך i-feel אוספת, משתמשת, שומרת ומגינה על מידע באתר ובאפליקציית I FEEL AI Sales Manager.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'LocalBusiness',
        '@id': 'https://i-feel.co.il/#business',
        'name': 'i-feel',
        'url': 'https://i-feel.co.il/',
        'telephone': '+972-3-508-9553',
        'email': 'oren@i-feel.co.il',
        'address': {
          '@type': 'PostalAddress',
          'streetAddress': 'אימבר 14',
          'addressLocality': 'פתח תקווה',
          'postalCode': '4951148',
          'addressCountry': 'IL'
        }
      },
      {
        '@type': 'WebPage',
        '@id': `${url}#page`,
        'url': url,
        'name': 'מדיניות פרטיות — i-feel',
        'description': 'מדיניות פרטיות לאתר i-feel ולאפליקציית I FEEL AI Sales Manager.',
        'inLanguage': 'he-IL',
        'datePublished': '2026-09-07',
        'dateModified': '2026-09-07',
        'about': { '@id': 'https://i-feel.co.il/#business' }
      },
      {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'דף הבית', 'item': 'https://i-feel.co.il/' },
          { '@type': 'ListItem', 'position': 2, 'name': 'מדיניות פרטיות', 'item': url }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
