---
import BaseLayout from '../layouts/BaseLayout.astro';
import { glassSocketProducts } from '../data/glass-socket-products';
const canonical="https://i-feel.co.il/glass-socket-catalog/";
const meta={title:"קטלוג שקעי זכוכית ומסגרות לבנות ושחורות | i-feel",description:"קטלוג שקעי זכוכית, מסגרות לבנות ושחורות, שקעי USB ומפסקי מדרגות. סננו לפי צבע וסוג ופתחו עמוד מוצר.",canonical,ogTitle:"קטלוג שקעי הזכוכית של i-feel",ogDescription:"מסגרות זכוכית, שקעים, USB ומפסקים עם תמונות, מידע טכני וקישורים להרכבת שילוב.",ogUrl:canonical,ogImage:"https://i-feel.co.il/assets/glass-sockets/glass-frame-display.jpg",jsonLd:JSON.stringify({"@context":"https://schema.org","@type":"CollectionPage","name":"קטלוג שקעי זכוכית ומסגרות","url":canonical})};
---
<BaseLayout {...meta}><main id="main-content" class="bg-white text-brand-900">
<nav class="border-b border-brand-100 bg-brand-50" aria-label="פירורי לחם"><div class="mx-auto max-w-7xl px-4 py-3 text-sm"><a href="/" class="text-brand-600">דף הבית</a><span class="mx-2">›</span><a href="/glass-sockets/" class="text-brand-600">שקעי זכוכית</a><span class="mx-2">›</span>קטלוג מוצרים</div></nav>
<header class="mx-auto max-w-7xl px-4 pb-8 pt-10 md:pt-16"><p class="mb-3 font-bold text-accent-700">קטלוג מוצרים · שקעי זכוכית i-feel</p><h1 class="mb-5 max-w-4xl text-4xl font-extrabold md:text-5xl">שקעי זכוכית, מסגרות ומפסקים</h1><p class="max-w-3xl text-lg leading-8 text-brand-700">מצאו מסגרת זכוכית לבנה או שחורה, שקע חשמל, שקע USB או מפסק מדרגות. בכל כרטיס יש תמונה, תיאור וקישור לעמוד מוצר. לבחירת השילוב בכל מקום, עברו אל <a class="font-bold text-accent-700 underline" href="/glass-socket-frame-builder/">סימולטור הרכבת המסגרת</a>.</p><div class="mt-7 flex flex-wrap gap-3"><a href="/glass-socket-frame-builder/" class="rounded-lg bg-accent-500 px-5 py-3 font-bold text-white">בנו שילוב בסימולטור</a><a href="/glass-sockets/" class="rounded-lg border border-brand-200 px-5 py-3 font-bold">למדריך שקעי הזכוכית</a></div></header>
<section class="mx-auto max-w-7xl px-4 pb-16"><div class="mb-7 rounded-2xl border border-brand-200 bg-brand-50 p-4 md:p-6"><div class="grid gap-4 md:grid-cols-2"><label class="block text-sm font-bold">סוג מוצר<select id="catalog-category" class="mt-2 w-full rounded-lg border border-brand-300 bg-white px-4 py-3"><option value="all">כל הקטגוריות</option><option value="frames">מסגרות זכוכית</option><option value="sockets">שקעי חשמל</option><option value="usb">שקעי USB</option><option value="switches">מפסקים</option></select></label><label class="block text-sm font-bold">צבע<select id="catalog-color" class="mt-2 w-full rounded-lg border border-brand-300 bg-white px-4 py-3"><option value="all">לבן ושחור</option><option value="white">לבן</option><option value="black">שחור</option></select></label></div></div>
<div class="mb-5 flex flex-wrap items-center justify-between gap-4"><p id="catalog-count" class="font-semibold text-brand-700" aria-live="polite">6 מוצרים</p><div class="flex gap-2" role="group" aria-label="תצוגת מוצרים"><button id="catalog-grid" type="button" class="rounded-lg bg-brand-900 px-4 py-2 font-bold text-white" aria-pressed="true">רשת</button><button id="catalog-list" type="button" class="rounded-lg border border-brand-300 px-4 py-2 font-bold" aria-pressed="false">רשימה</button></div></div>
<div id="product-list" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">{glassSocketProducts.map((product)=><article class="catalog-card overflow-hidden border border-brand-200 bg-white transition hover:shadow-xl" data-category={product.category} data-color={product.color}><a href={`/glass-socket-products/${product.slug}/`} class="block h-full"><div class="flex h-64 items-center justify-center p-5 md:h-72"><img src={product.image} alt={product.alt} width="900" height="900" loading="lazy" class="h-full w-full object-contain"></div><div class="border-t border-brand-100 p-5 text-center"><p class="mb-2 font-extrabold text-accent-700">{product.categoryLabel} · {product.colorLabel}</p><h2 class="mb-3 text-xl font-extrabold">{product.name}</h2><p class="mb-5 text-sm leading-6 text-brand-700">{product.summary}</p><span class="font-extrabold text-accent-700">הצג מוצר ‹</span></div></a></article>)}</div>
<p id="catalog-empty" class="mt-8 hidden rounded-xl bg-brand-50 p-6 text-center font-semibold">לא נמצאו מוצרים לפי הסינון.</p></section>
<section class="border-t border-brand-100 bg-brand-50 py-12 text-center"><h2 class="mb-4 text-3xl font-extrabold">מתכננים מסגרת משלכם?</h2><p class="mb-7 text-lg text-brand-700">בחרו לבן או שחור, מספר מקומות ומה יהיה בכל מקום.</p><a href="/glass-socket-frame-builder/" class="inline-block rounded-lg bg-accent-500 px-6 py-3 font-bold text-white">פתחו את סימולטור המסגרת</a></section>
</main>
<script>
const c=document.querySelector("#catalog-category"),color=document.querySelector("#catalog-color"),grid=document.querySelector("#product-list"),cards=[...document.querySelectorAll(".catalog-card")],count=document.querySelector("#catalog-count"),empty=document.querySelector("#catalog-empty"),gridButton=document.querySelector("#catalog-grid"),listButton=document.querySelector("#catalog-list");
function filter(){let n=0;for(const card of cards){const show=(c.value==="all"||card.dataset.category===c.value)&&(color.value==="all"||card.dataset.color===color.value||card.dataset.color==="all");card.hidden=!show;if(show)n++;}count.textContent=`${n} מוצרים`;empty.classList.toggle("hidden",n!==0);}
c.addEventListener("change",filter);color.addEventListener("change",filter);
gridButton.addEventListener("click",()=>{grid.classList.remove("catalog-list");gridButton.setAttribute("aria-pressed","true");listButton.setAttribute("aria-pressed","false");});
listButton.addEventListener("click",()=>{grid.classList.add("catalog-list");gridButton.setAttribute("aria-pressed","false");listButton.setAttribute("aria-pressed","true");});
</script>
<style>
#product-list.catalog-list{grid-template-columns:minmax(0,1fr)}
#product-list.catalog-list .catalog-card>a{display:grid;grid-template-columns:minmax(110px,240px) minmax(0,1fr);align-items:center}
#product-list.catalog-list .catalog-card img{max-height:150px}
@media(max-width:540px){#product-list.catalog-list .catalog-card>a{grid-template-columns:110px minmax(0,1fr)}#product-list.catalog-list .catalog-card>a>div:first-child{height:140px;padding:10px}}
</style></BaseLayout>