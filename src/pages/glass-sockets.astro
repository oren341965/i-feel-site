---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/glass-sockets.html?raw';

const meta = {
  title: "שקעי זכוכית לבנים ושחורים לבית | i-feel",
  description: "שקעי זכוכית לבנים ושחורים בהתאמה למפסקי i-feel: מסגרת לשקע יחיד או כפול, מפסק מדרגות ושקעי USB. ייעוץ: 03-508-9553.",
  canonical: "https://i-feel.co.il/glass-sockets/",
  ogTitle: "שקעי זכוכית לבנים ושחורים לבית | i-feel",
  ogDescription: "מסגרות זכוכית תואמות למפסקי i-feel — לשקע יחיד או כפול, מפסק מדרגות ופתרונות USB.",
  ogUrl: "https://i-feel.co.il/glass-sockets/",
  ogImage: "https://i-feel.co.il/assets/glass-sockets/white-glass-power-socket.jpg",
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
        '@id': 'https://i-feel.co.il/#business',
        name: 'i-feel',
        url: 'https://i-feel.co.il/',
        telephone: '+972-3-508-9553',
        email: 'sales@i-feel.co.il',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'אימבר 14',
          addressLocality: 'פתח תקווה',
          addressRegion: 'מחוז המרכז',
          postalCode: '4951148',
          addressCountry: 'IL'
        },
        areaServed: { '@type': 'Country', name: 'Israel' }
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'בית חכם', item: 'https://i-feel.co.il/smart-home/' },
          { '@type': 'ListItem', position: 3, name: 'שקעי זכוכית', item: 'https://i-feel.co.il/glass-sockets/' }
        ]
      },
      {
        '@type': 'Service',
        '@id': 'https://i-feel.co.il/glass-sockets/#service',
        url: 'https://i-feel.co.il/glass-sockets/',
        name: 'התאמת שקעי זכוכית לבית',
        serviceType: 'Glass Socket Frame Planning and Installation',
        provider: { '@id': 'https://i-feel.co.il/#business' },
        areaServed: { '@type': 'Country', name: 'Israel' },
        image: 'https://i-feel.co.il/assets/glass-sockets/white-glass-power-socket.jpg',
        description: 'תכנון והתאמה של מסגרות זכוכית לבנות ושחורות לשקע יחיד או כפול, למפסק מדרגות ולפתרונות USB, בהתאם למפסקי הזכוכית ולתשתית החשמל.'
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          { '@type': 'Question', name: 'מה היתרון של שקע זכוכית?', acceptedAnswer: { '@type': 'Answer', text: 'מסגרת הזכוכית יוצרת מראה נקי ואחיד עם מפסקי הזכוכית, במיוחד בקירות ובמשטחי חיפוי שנמצאים בקו הראייה.' } },
          { '@type': 'Question', name: 'האם צריך להחליף את כל השקעים בבית לזכוכית?', acceptedAnswer: { '@type': 'Answer', text: 'לא. בדרך כלל אנו ממליצים לבחור כשלוש מסגרות זכוכית באזורים בעלי נראות גבוהה, כמו המטבח והסלון. במקומות נסתרים אפשר להשתמש במסגרות פלסטיק.' } },
          { '@type': 'Question', name: 'אילו צבעים קיימים?', acceptedAnswer: { '@type': 'Answer', text: 'ניתן לבחור מסגרות זכוכית לבנות או שחורות ולתאם את הצבע למפסקי הזכוכית של i-feel ולעיצוב החלל.' } },
          { '@type': 'Question', name: 'האם יש מסגרת לשני שקעים?', acceptedAnswer: { '@type': 'Answer', text: 'כן. קיימות גם מסגרות זכוכית המיועדות לשני שקעים, בכפוף להתאמה לקופסה, למידות ולמפרט החשמל.' } },
          { '@type': 'Question', name: 'האם יש מפסק מדרגות עם מסגרת זכוכית?', acceptedAnswer: { '@type': 'Answer', text: 'כן. ניתן לשלב מפסק מדרגות במסגרת זכוכית תואמת, לאחר בדיקת סוג המפסק והתשתית.' } },
          { '@type': 'Question', name: 'אילו שקעי USB אפשר לשלב?', acceptedAnswer: { '@type': 'Answer', text: 'קיימים פתרונות USB שונים, לרבות שילובים של USB-A ו־USB-C, בהתאם לדגם ולמפרט שנבחר.' } },
          { '@type': 'Question', name: 'האם אפשר להתקין בבית קיים?', acceptedAnswer: { '@type': 'Answer', text: 'במקרים רבים כן, אך לפני ההתקנה צריך לבדוק את הקופסה הקיימת, המידות, מספר המודולים וסוג התשתית.' } }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
