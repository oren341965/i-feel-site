---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/siemens-bms-knowledge-center/';
const title = 'מרכז ידע Siemens Desigo לבקרת מבנה BMS | i-feel';
const description = 'מסמכי Siemens Desigo מקצועיים ליועצי חשמל, יצרני לוחות ואנשי BMS: מפרטי PXC4, PXC5, PXC7, Desigo CC, CAD, BIM, BACnet, TX-I/O וניהול אנרגיה.';

const documents = [
  {
    title: 'מפרט מערכת Desigo לבקרי PXC4 PXC5 PXC7',
    description: 'מפרט מערכת BMS הכולל ארכיטקטורה, BACnet/SC, תקשורת, אבטחת רשת, ניהול אנרגיה, כלי הנדסה, I/O ואינטגרציה.',
    href: '/siemens-desigo-pxc4-pxc5-pxc7-system-specification/',
    tags: ['PXC4', 'PXC5', 'PXC7', 'DDC', 'BACnet/SC'],
  },
  {
    title: 'מפרט מערכת הניהול Siemens Desigo CC',
    description: 'מסמך ניהול BMS מלא הכולל SCADA, BIM, אנרגיה, אירועים, משתמשים, דוחות, וידאו, בקרת כניסה, OPC, SNMP ושירותי Web.',
    href: '/siemens-desigo-cc-system-specification/',
    tags: ['Desigo CC', 'SCADA', 'BIM', 'Energy', 'OPC'],
  },
];

const externalResources = [
  { title: 'CAD ו-BIM לבקרי PXC4 ו-PXC7', href: 'https://siemens-bt.partcommunity.com/3d-cad-models/sso/automation-stations-pxc4-pxc7-siemens-building-technologies-european-portfolio?info=siemens_bt_eu%2Fgebaeudeautomationssysteme%2Fdesigo%2Fautomationundbedienung%2Fautomationsstationenpxc4pxc7&cwid=9268' },
  { title: 'CAD ו-BIM למודולי TX-I/O', href: 'https://siemens-bt.partcommunity.com/3d-cad-models/sso/i-o-modules-txm-siemens-building-technologies-european-portfolio?info=siemens_bt_eu%2Fgebaeudeautomationssysteme%2Fdesigo%2Fautomationundbedienung%2Fioerweiterungsmoduletxm%2Fiomoduletxm&cwid=9268' },
  { title: 'Siemens HIT למסמכים ודפי נתונים', href: 'https://hit.sbt.siemens.com/RWD/App/Main?RC=HQEU&lang=en&MODULE=HitBase&ACTION=OpenPage&KEY=Home' },
  { title: 'Siemens KNX Technical Documentation', href: 'https://knx-td.sihub.siemens.com/' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'he-IL',
  about: ['Siemens Desigo', 'Building Management System', 'Building Automation', 'PXC4', 'PXC5', 'PXC7', 'Desigo CC'],
  hasPart: documents.map((document) => ({ '@type': 'TechArticle', name: document.title, url: `https://i-feel.co.il${document.href}` })),
});
---

<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl={canonical} jsonLd={jsonLd}>
  <div dir="rtl" class="bg-white">
    <section class="bg-brand-900 text-white py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4">
        <p class="text-accent-400 font-bold mb-3">Building Automation · Siemens Desigo · ישראל</p>
        <h1 class="text-4xl md:text-5xl font-extrabold mb-5">מרכז הידע Siemens לבקרת מבנה BMS</h1>
        <p class="max-w-4xl text-lg md:text-xl text-brand-100 leading-8">מידע מקצועי ליועצי חשמל, יצרני לוחות, קבלני חשמל, אנשי BMS ומנהלי אחזקה. כאן ניתן לחפש מפרטים, בקרי DDC, ‏PXC4, ‏PXC5, ‏PXC7, ‏Desigo CC, ‏BACnet, ‏Modbus, ‏KNX, ‏DALI, ‏TX-I/O, ניהול אנרגיה, CAD ו-BIM.</p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 py-12 md:py-16">
      <div class="mb-8">
        <p class="text-accent-700 font-bold mb-2">מסמכים חדשים שסופקו על ידי Siemens</p>
        <h2 class="text-3xl font-extrabold text-brand-900 mb-3">מפרטים מלאים לקריאה, חיפוש והורדה</h2>
        <p class="max-w-4xl text-brand-700 leading-7">תוכן המסמכים הומר גם לעמודי HTML ציבוריים כדי שמנוע החיפוש באתר ומנועי חיפוש חיצוניים יוכלו לאתר את הנושאים המקצועיים שבתוכם. קובצי Word ו-PDF זמינים מתוך כל עמוד.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {documents.map((document) => (
          <article class="rounded-2xl border border-brand-100 bg-brand-50 p-6 shadow-sm hover:border-accent-400 hover:shadow-lg transition flex flex-col">
            <div class="flex flex-wrap gap-2 mb-4">{document.tags.map((tag) => <span class="rounded-full bg-white border border-brand-100 px-3 py-1 text-xs font-bold text-brand-700">{tag}</span>)}</div>
            <h3 class="text-2xl font-extrabold text-brand-900 mb-3">{document.title}</h3>
            <p class="text-brand-700 leading-7 mb-6 flex-grow">{document.description}</p>
            <a href={document.href} class="inline-flex justify-center rounded-lg bg-brand-700 px-5 py-3 font-bold text-white hover:bg-brand-800 transition">פתיחת המסמך המקצועי</a>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-brand-50 border-y border-brand-100 py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-extrabold text-brand-900 mb-3">ספריות Siemens רשמיות</h2>
        <p class="max-w-4xl text-brand-700 leading-7 mb-7">קישורים ציבוריים למסמכי תכנון, מודלים וקבצים טכניים. יש לוודא דגם וגרסה לפני שילוב במפרט או בתכנון.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {externalResources.map((resource) => (
            <a href={resource.href} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-brand-100 bg-white p-5 font-bold text-brand-800 hover:border-accent-400 hover:text-accent-700 transition">{resource.title} ↗</a>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 py-12 md:py-16">
      <h2 class="text-3xl font-extrabold text-brand-900 mb-5">ידע ותמיכה מקצועית בישראל</h2>
      <div class="space-y-4 text-brand-700 leading-8">
        <p>I FEEL פועלת משנת 2008 ומספקת תכנון, אינטגרציה, תכנות, Commissioning ושירות למערכות בקרת מבנה. מרכז הידע נועד לסייע בתכנון מפרטים ובהבנת ארכיטקטורת Siemens Desigo, אך אינו מחליף בדיקת התאמה הנדסית לכל פרויקט.</p>
        <p>החומר בעמוד זה עוסק בבקרת מבנה מסחרית וציבורית ולא בבית חכם פרטי. לשאלות על בחירת בקרים, תקשורת, נקודות I/O, אינטגרציה או ניהול אנרגיה ניתן לפנות לצוות הבקרה של I FEEL.</p>
      </div>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/siemens-desigo-bms/" class="rounded-lg bg-brand-700 px-5 py-3 font-bold text-white hover:bg-brand-800 transition">מידע על Siemens Desigo</a>
        <a href="/contactus/" class="rounded-lg border-2 border-accent-600 px-5 py-3 font-bold text-accent-700 hover:bg-accent-50 transition">פנייה לצוות BMS</a>
      </div>
    </section>
  </div>
</BaseLayout>
