---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/bms-building-cost/';
const question = 'כמה עולה מערכת BMS לבניין?';
const answer = 'אין מחיר אחד למערכת BMS — העלות נקבעת לפי גודל המבנה, מספר נקודות הבקרה, המערכות שמשולבות (מיזוג, תאורה, אנרגיה, אבטחה), הפרוטוקולים (DDC, BACnet, KNX, Modbus, Siemens Desigo) ורמת הזמינות הנדרשת. למבנה מסחרי טווח ההשקעה הראשוני נע בדרך כלל מעשרות אלפי שקלים למבנה קטן ועד מאות אלפי שקלים למבנה גדול ומורכב. המחיר המדויק נקבע פר-פרויקט לאחר סקר באתר ואפיון.';
const meta = {
  title: 'כמה עולה מערכת BMS לבניין? | תקציב בקרת מבנה | i-feel',
  description: answer.slice(0, 155),
  canonical: url,
  ogTitle: question + ' | i-feel',
  ogDescription: 'מה משפיע על מחיר פרויקט BMS, מה כלול, ואיך בונים תקציב נכון לבקרת מבנה.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id': 'https://i-feel.co.il/#business', name: 'i-feel', url: 'https://i-feel.co.il/', telephone: '+972-3-508-9553', email: 'sales@i-feel.co.il', address: { '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed: { '@type':'Country', name:'Israel' } },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' },
        { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' },
        { '@type':'ListItem', position:3, name: question, item: url } ] },
      { '@type': 'Article', headline: question, author: { '@id':'https://i-feel.co.il/#business' }, publisher: { '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage: url },
      { '@type': 'FAQPage', mainEntity: [
        { '@type':'Question', name: question, acceptedAnswer: { '@type':'Answer', text: answer } },
        { '@type':'Question', name: 'מה משפיע הכי הרבה על מחיר BMS?', acceptedAnswer: { '@type':'Answer', text: 'מספר נקודות הבקרה והמערכות שמשולבות. ככל שמשלבים יותר מערכות (מיזוג, תאורה, אנרגיה, אבטחה) ויותר אזורים, כך עולה מספר הבקרים והחיווט.' } },
        { '@type':'Question', name: 'איך מקבלים הצעת מחיר מדויקת ל-BMS?', acceptedAnswer: { '@type':'Answer', text: 'באמצעות סקר באתר ואפיון: מיפוי הציוד הקיים, נקודות הבקרה, רשת התקשורת ויעדי החיסכון. רק אז ניתן לבנות תכולה והצעה מדויקת.' } } ] }
    ]
  })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">מחיר BMS לבניין</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>מה משפיע על מחיר מערכת BMS</h2>
    <ul>
      <li><strong>גודל המבנה ומספר האזורים</strong> — יותר חללים = יותר נקודות בקרה וחיווט.</li>
      <li><strong>המערכות שמשולבות</strong> — מיזוג (HVAC), תאורה, חשמל, משאבות, אבטחה וגילוי אש; כל מערכת נוספת מרחיבה את ההיקף.</li>
      <li><strong>פרוטוקולים וארכיטקטורה</strong> — שכבת <a href="/structure-control/">בקרי DDC</a>, ושילוב BACnet, Modbus, KNX או <a href="/siemens-desigo-bms/">Siemens Desigo</a> כשרת ניהול.</li>
      <li><strong>זמינות ו-Redundancy</strong> — מבנים קריטיים (בתי חולים, דאטה) דורשים תצורות גיבוי.</li>
      <li><strong>ניטור אנרגיה ודוחות</strong> — מונים, חיישנים ולוחות בקרה מוסיפים ערך ועלות.</li>
    </ul>
    <h2>מה כלול בפרויקט BMS</h2>
    <p>פרויקט מלא כולל ארכיטקטורת בקרה, בקרי DDC, חיישנים, אינטגרציית HVAC ותאורה, ניטור אנרגיה, לוחות בקרה והתראות, והפעלה (Commissioning) עם תיעוד בעברית. פירוט מלא בעמוד <a href="/structure-control/">בקרת מבנה BMS</a>.</p>
    <h2>איך מקבלים הצעת מחיר מדויקת</h2>
    <p>לא נותנים מספר באוויר. מבצעים סקר באתר ואפיון — מיפוי הציוד, נקודות הבקרה ויעדי החיסכון — ורק אז בונים תכולה והצעה. <a href="/contactus/">לתיאום סקר</a>.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/siemens-desigo-vs-knx/" class="text-accent-600 font-semibold hover:underline">מה ההבדל בין Siemens Desigo ל-KNX?</a></li><li><a href="/answers/choosing-smart-home-integrator/" class="text-accent-600 font-semibold hover:underline">איך בוחרים אינטגרטור?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">רוצים תקציב מדויק ל-BMS בפרויקט שלכם?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/contactus/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">לתיאום סקר</a></div></div></section>
</BaseLayout>
