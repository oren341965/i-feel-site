---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/choosing-smart-home-integrator/';
const question = 'איך בוחרים אינטגרטור לבית חכם בישראל?';
const answer = 'בחירת אינטגרטור לבית חכם צריכה להתבסס על חמישה דברים: (1) ניסיון ופרויקטים אמיתיים שאפשר לראות; (2) שליטה בכל שרשרת האספקה — תכנון, התקנה, תכנות ושירות תחת ספק אחד; (3) מחלקת שירות ותמיכה בישראל לאורך שנים; (4) עבודה עם תקנים ומותגים מובילים (KNX, Siemens, מכון התקנים); (5) יכולת אינטגרציה אמיתית — לחבר תאורה, מיזוג, אבטחה, אודיו ותקשורת למערכת אחת, ולא רק להתקין מוצרים נפרדים.';
const meta = {
  title: 'איך בוחרים אינטגרטור לבית חכם בישראל? | i-feel',
  description: answer.slice(0, 155),
  canonical: url, ogTitle: question + ' | i-feel', ogDescription: '5 הדברים לבדוק, שאלות לשאול לפני שחותמים, ודגלים אדומים.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org', '@graph': [
    { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      { '@type':'Question', name:'מה הדגל האדום הכי חשוב?', acceptedAnswer:{ '@type':'Answer', text:'אינטגרטור שמוכר ציוד בלי לתכנן, או שאין לו מחלקת שירות משלו בישראל. בית חכם בלי שירות לאורך שנים הופך לנטל.' } },
      { '@type':'Question', name:'כדאי לבחור לפי המחיר הזול ביותר?', acceptedAnswer:{ '@type':'Answer', text:'לא. מערכת זולה בלי תכנון, תמיכה בישראל ויכולת אינטגרציה תעלה יותר בטווח הארוך. הערך הוא בתכנון, בשירות וביכולת לחבר את כל המערכות יחד.' } } ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">בחירת אינטגרטור</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>5 הדברים לבדוק</h2>
    <ul>
      <li><strong>ניסיון ופרויקטים אמיתיים</strong> — בקשו לראות <a href="/projects/">פרויקטים</a> ולא רק הצהרות.</li>
      <li><strong>שרשרת אספקה מלאה</strong> — תכנון, התקנה, תכנות ושירות תחת ספק אחד = אחריות אחת.</li>
      <li><strong>מחלקת שירות בישראל</strong> — תמיכה לאורך שנים, לא רק התקנה. ראו <a href="/service-and-maintenance/">שירות ותחזוקה</a>.</li>
      <li><strong>תקנים ומותגים מובילים</strong> — <a href="/brands-and-technologies/">KNX, Siemens, מכון התקנים</a> ומותגים נתמכים בישראל.</li>
      <li><strong>אינטגרציה אמיתית</strong> — חיבור תאורה, מיזוג, אבטחה, אודיו ותקשורת למערכת אחת.</li>
    </ul>
    <h2>שאלות לשאול לפני שחותמים</h2>
    <ul>
      <li>מי נותן שירות אחרי ההתקנה, ובאילו שעות?</li>
      <li>האם התכנון נעשה לפי הנכס ואורח החיים, או שזו רשימת ציוד?</li>
      <li>אילו מערכות ניתן לחבר עכשיו, ומה אפשר להוסיף בעתיד?</li>
    </ul>
    <h2>דגלים אדומים</h2>
    <p>ספק שמתחיל מ"איזה ציוד אתה רוצה" במקום מאפיון; אין מחלקת שירות בישראל; מחיר זול בלי הסבר על מה שמאחוריו. ראו גם <a href="/smart-home/">בית חכם — המדריך המקיף</a>.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/knx-vs-control4/" class="text-accent-600 font-semibold hover:underline">KNX מול Control4?</a></li><li><a href="/answers/smart-home-service-existing/" class="text-accent-600 font-semibold hover:underline">שירות למערכת קיימת?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">רוצים אינטגרטור שמלווה לאורך שנים?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/contactus/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">דברו איתנו</a></div></div></section>
</BaseLayout>
