---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/what-is-bms/';
const question = 'מה זה BMS?';
const answer = 'BMS (Building Management System — מערכת בקרת מבנה) היא מערכת ניהול ובקרה מרכזית למבנה, שמאחדת מיזוג, תאורה, חשמל, אנרגיה, אבטחה והתראות לפלטפורמה אחת המנוהלת ממסוף יחיד. שכבת הבקרה מבוססת על בקרי DDC, שמתחברים לפי הצורך ל-KNX, BACnet, Modbus ו-Siemens Desigo. BMS מתאים למלונות, משרדים, בתי חולים, מבני ציבור וקמפוסים.';
const meta = {
  title: 'מה זה BMS? בקרת מבנה — הסבר מלא | i-feel',
  description: answer.slice(0,155), canonical: url, ogTitle: question+' | i-feel', ogDescription: 'מערכת בקרת מבנה — מה זה, מה היא מנהלת ולמי מתאים.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org','@graph':[
    { '@type':['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url, inLanguage:'he-IL' },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      { '@type':'Question', name:'מה BMS מנהל?', acceptedAnswer:{ '@type':'Answer', text:'מיזוג אוויר (HVAC), תאורה, חשמל ואנרגיה, משאבות, אבטחה וגילוי אש, מעליות ועוד — בניטור ושליטה מרכזית עם התראות בזמן אמת.' } },
      { '@type':'Question', name:'למי מתאים BMS?', acceptedAnswer:{ '@type':'Answer', text:'למלונות, מגדלי משרדים, בתי חולים, מבני ציבור, מרכזי מסחר וקמפוסים — מבנים עם מערכות טכניות מרובות הדורשים ניהול מרכזי וחיסכון אנרגיה.' } } ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">מה זה BMS</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>מה BMS מנהל</h2><p>מערכת <a href="/structure-control/">בקרת מבנה</a> מנהלת מיזוג אוויר (HVAC), תאורה, חשמל ואנרגיה, משאבות, אבטחה וגילוי אש — ממשק גרפי מרכזי עם לוחות זמנים, תרחישים, מגמות (Trends) והתראות. שכבת הבקרה מבוססת על בקרי <a href="/answers/what-is-ddc/">DDC</a>.</p>
    <h2>אילו פרוטוקולים BMS משלב</h2><p>הליבה מתחברת ל-<a href="/answers/what-is-bacnet/">BACnet</a>, Modbus, <a href="/knx-smart-home/">KNX</a> ו-<a href="/siemens-desigo-bms/">Siemens Desigo</a> כשרת ניהול. KNX מתאים לבקרה ברמת החדר ולא משמש כשכבת הבקרה היחידה במבנה.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/bms-vs-smart-home/" class="text-accent-600 font-semibold hover:underline">מה ההבדל בין BMS לבית חכם?</a></li><li><a href="/answers/bms-building-cost/" class="text-accent-600 font-semibold hover:underline">כמה עולה מערכת BMS?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">מתכננים פרויקט BMS?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/structure-control/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">בקרת מבנה BMS</a></div></div></section>
</BaseLayout>
