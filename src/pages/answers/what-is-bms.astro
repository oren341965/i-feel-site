---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/what-is-bms/';
const question = 'מה זה BMS?';
const answer = 'מערכת בקרת מבנה (BMS) מרכזת ניטור, שליטה והתראות של מערכות כמו מיזוג, תאורה וצריכת אנרגיה. צוות התפעול רואה ממסך אחד מה פועל, מה דורש טיפול ואילו מערכות אפשר להפעיל או לתזמן. ההיקף נקבע לפי הציוד והנקודות ששולבו בפרויקט.';
const projectQuestions = [
  {
    id: 'bms-control-vs-monitoring',
    name: 'מה ההבדל בין ניטור לשליטה במערכת בקרת מבנה?',
    text: 'בניטור המערכת קוראת ערך או מצב, למשל צריכת חשמל או חיווי תקלה. בשליטה היא גם שולחת פקודה, למשל להדליק תאורה או לשנות לוח זמנים. לכן מפרט BMS טוב מציין לכל נקודה אם היא מיועדת לקריאה בלבד, להתראה או גם לפיקוד.',
  },
  {
    id: 'bms-project-example',
    name: 'איך מערכת בקרת מבנה עובדת בפרויקט אמיתי?',
    text: 'בבית הלוחם באשדוד, Siemens Desigo מרכזת את הפיקוד על התאורה ואת החיווי ממערכות המבנה. לדוגמה, צוות התפעול יכול לתזמן את תאורת החוץ, לקרוא מדידות מלוחות החשמל ולראות חיוויים ממערכות נוספות. פיקוד על התאורה אינו מעיד שכל ציוד שמופיע במסך ניתן להפעלה ממנו.',
    href: '/structure-control/beit-halochem-ashdod/',
    linkText: 'למקרה הבוחן בבית הלוחם באשדוד',
  },
  {
    id: 'bms-retrofit-existing',
    name: 'האם אפשר לשדרג מערכת BMS בלי להחליף את כל הבקרים?',
    text: 'לפעמים כן. מתחילים בסקר שממפה את הבקרים, את נקודות הקריאה והפיקוד ואת הפרוטוקולים שנתמכים בפועל. לאחר בדיקת חיבור מצומצמת מחליטים מה אפשר לשמר, מה מחייב ממשק ומה צריך להחליף, ומתכננים את סדר העבודות לפי צורכי התפעול.',
    href: '/bms-retrofit/',
    linkText: 'לבדיקת שדרוג מערכת קיימת',
  },
];
const meta = {
  title: 'מהי מערכת בקרת מבנה (BMS)? הסבר ודוגמה מפרויקט | I Feel',
  description: 'מהי מערכת בקרת מבנה (BMS), מה ההבדל בין ניטור לפיקוד, ואיך Siemens Desigo משלבת תאורה וחיוויים בבית הלוחם באשדוד. כולל שדרוג מערכת קיימת.', canonical: url, ogTitle: question+' | i-feel', ogDescription: 'מהי מערכת בקרת מבנה, מה היא מפעילה ואיך זה נראה בפרויקט שבוצע.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org','@graph':[
    { '@type':['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url, inLanguage:'he-IL' },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      ...projectQuestions.map(({ name, text }) => ({ '@type':'Question', name, acceptedAnswer:{ '@type':'Answer', text } })) ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">מה זה BMS</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>מה BMS מנהל</h2><p>מערכת <a href="/structure-control/">בקרת מבנה</a> יכולה לרכז מיזוג, תאורה, מדידות אנרגיה ומשאבות בממשק אחד. במבני משרדים, מלונות, בתי חולים וקמפוסים, הממשק עוזר לצוות התפעול לצפות במצבים ולנהל לוחות זמנים לפי הרשאות. בקרי השטח, כגון <a href="/answers/what-is-ddc/">DDC</a>, מבצעים את לוגיקת הבקרה המקומית.</p>
    <h2>איך הבקרים והמערכות מתחברים ל־BMS?</h2><p><a href="/answers/what-is-bacnet/">BACnet</a>, Modbus ו־<a href="/knx-smart-home/">KNX</a> הם פרוטוקולים שאפשר לשלב לפי הציוד והממשקים. <a href="/siemens-desigo-bms/">Siemens Desigo</a> היא פלטפורמת ניהול, שמרכזת את התצוגה והתפעול של הנקודות שהוגדרו והוטמעו בפרויקט.</p>
    {projectQuestions.map(({ id, name, text, href, linkText }) => (
      <section id={id} aria-labelledby={id + '-title'}>
        <h2 id={id + '-title'}>{name}</h2>
        <p>{text}</p>
        {href && <p><a href={href}>{linkText}</a></p>}
      </section>
    ))}
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/bms-vs-smart-home/" class="text-accent-600 font-semibold hover:underline">מה ההבדל בין BMS לבית חכם?</a></li><li><a href="/answers/bms-building-cost/" class="text-accent-600 font-semibold hover:underline">כמה עולה מערכת BMS?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">מתכננים פרויקט BMS?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/structure-control/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">בקרת מבנה BMS</a></div></div></section>
</BaseLayout>
