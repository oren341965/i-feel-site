---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/bms-for-hotels/';
const question = 'מתי צריך BMS במלון?';
const answer = 'מלון צריך מערכת בקרת מבנה (BMS) כשהוא מנהל מספר רב של חדרים ומערכות טכניות — מיזוג, תאורה, אנרגיה ובקרת חדרים (GRMS) — ורוצה חיסכון אנרגטי, חוויית אורח אחידה ושילוב למערכת ניהול המלון (PMS). BMS מאפשר כיבוי אוטומטי של מערכות בחדרים ריקים, ניהול מרכזי, ניטור תקלות והתראות. בפועל זה משתלם כבר ממלון בוטיק ומעלה.';
const meta = {
  title: 'מתי צריך BMS במלון? בקרת מבנה למלונאות | i-feel',
  description: answer.slice(0,155), canonical: url, ogTitle: question+' | i-feel', ogDescription: 'בקרת מבנה למלונות — GRMS, חיסכון אנרגיה ושילוב ל-PMS.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org','@graph':[
    { '@type':['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url, inLanguage:'he-IL' },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      { '@type':'Question', name:'מה זה GRMS במלון?', acceptedAnswer:{ '@type':'Answer', text:'GRMS (Guest Room Management System) היא בקרת חדר חכמה לתאורה, מיזוג, וילונות ותרחישי צ׳ק-אין/אאוט, המשולבת למערכת ה-BMS ולמערכת ניהול המלון (PMS).' } },
      { '@type':'Question', name:'כמה BMS חוסך למלון?', acceptedAnswer:{ '@type':'Answer', text:'בפרויקטים מתאימים BMS יכול לסייע בחיסכון של כ-20-40% בצריכת האנרגיה, בעיקר דרך כיבוי מערכות בחדרים ריקים ובקרת מיזוג חכמה.' } } ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">BMS במלון</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>מה BMS נותן למלון</h2><p>בקרת חדרים (GRMS), ניהול מרכזי של מיזוג ותאורה, חיסכון אנרגטי בחדרים ריקים, ניטור תקלות ושילוב ל-PMS — חוויית אורח אחידה ותפעול יעיל. ראו <a href="/bms-hotels/">בקרת מבנה למלונות</a>.</p>
    <h2>הטכנולוגיה</h2><p>הליבה מבוססת <a href="/answers/what-is-ddc/">DDC</a> ו-<a href="/siemens-desigo-bms/">Siemens Desigo</a>, עם KNX לבקרת חדר ו-<a href="/structure-control/dali-lighting-control/">DALI</a> לתאורה.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/what-is-bms/" class="text-accent-600 font-semibold hover:underline">מה זה BMS?</a></li><li><a href="/answers/bms-building-cost/" class="text-accent-600 font-semibold hover:underline">כמה עולה מערכת BMS?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">מתכננים בקרת מבנה למלון?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/bms-hotels/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">BMS למלונות</a></div></div></section>
</BaseLayout>
