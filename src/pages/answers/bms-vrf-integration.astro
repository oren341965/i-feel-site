---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/bms-vrf-integration/';
const question = 'איך מחברים BMS למיזוג VRF?';
const answer = 'חיבור מערכת בקרת מבנה (BMS) למיזוג VRF נעשה דרך שער/כרטיס ייעודי (gateway) של יצרן המיזוג, שמתרגם את פרוטוקול ה-VRF לפרוטוקול תקני — בדרך כלל BACnet או Modbus — שה-BMS מבין. כך ניתן לשלוט בטמפרטורה, במצבי העבודה ובלוחות הזמנים פר-אזור, לכבות יחידות באזורים ריקים, ולנטר צריכת אנרגיה — הכול ממסוף הבקרה המרכזי.';
const meta = {
  title: 'איך מחברים BMS למיזוג VRF? | i-feel',
  description: answer.slice(0,155), canonical: url, ogTitle: question+' | i-feel', ogDescription: 'אינטגרציית BMS ל-VRF דרך gateway — BACnet/Modbus, שליטה אזורית וניטור אנרגיה.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org','@graph':[
    { '@type':['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url, inLanguage:'he-IL' },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      { '@type':'Question', name:'איזה פרוטוקול משמש לחיבור VRF?', acceptedAnswer:{ '@type':'Answer', text:'בדרך כלל BACnet או Modbus, דרך שער ייעודי של יצרן המיזוג (Daikin, Mitsubishi, LG וכד׳). השער מחבר את ה-VRF לבקר ה-DDC או לשרת Siemens Desigo.' } },
      { '@type':'Question', name:'מה אפשר לשלוט בו ב-VRF דרך ה-BMS?', acceptedAnswer:{ '@type':'Answer', text:'טמפרטורה, מצבי עבודה (קירור/חימום), הפעלה וכיבוי פר-אזור, לוחות זמנים, וניטור צריכת אנרגיה — עם התראות על תקלות.' } } ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">BMS ומיזוג VRF</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>איך החיבור עובד</h2><p>השער (gateway) של יצרן המיזוג מתרגם את פרוטוקול ה-VRF ל-<a href="/answers/what-is-bacnet/">BACnet</a> או Modbus, שמתחבר לבקר ה-<a href="/answers/what-is-ddc/">DDC</a> או לשרת <a href="/siemens-desigo-bms/">Siemens Desigo</a>. כך המיזוג נכלל ב-<a href="/structure-control/">בקרת המבנה</a> המרכזית.</p>
    <h2>מה מרוויחים</h2><p>שליטה אזורית, כיבוי יחידות באזורים ריקים, לוחות זמנים, ניטור אנרגיה והתראות תקלה — חיסכון אנרגטי ותפעול נוח.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/what-is-bms/" class="text-accent-600 font-semibold hover:underline">מה זה BMS?</a></li><li><a href="/answers/what-is-bacnet/" class="text-accent-600 font-semibold hover:underline">מה זה BACnet?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">צריכים לחבר מיזוג ל-BMS?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/structure-control/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">בקרת מבנה BMS</a></div></div></section>
</BaseLayout>
