---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/knx-ets-service-home-assistant/';
const question = 'מי מתחזק מערכת KNX, מי מקבל את קבצי ETS ומה קורה אם השרת נופל?';
const answer = 'בפרויקט KNX של i-feel הלקוח מקבל בסיום את קבצי ה-ETS, הגיבויים והתיעוד הנדרש. הציוד המרכזי הוא Siemens, החשמלאי מתקין את הבקרים ו-i-feel מבצעת את התכנות, השירות והתחזוקה. פעולות בסיסיות כמו תאורה ותריסים ממשיכות לעבוד גם במקרה של תקלה בשרת, בעוד פונקציות מתקדמות התלויות בשרת עשויות להיפסק זמנית.';
const faqs = [
  { q: 'האם בסיום הפרויקט מקבלים את כל קבצי מערכת ה-ETS, הגיבויים והתיעוד?', a: 'כן. בסיום הפרויקט הלקוח מקבל את קבצי מערכת ה-ETS, הגיבויים והתיעוד הנדרש, כך שניתן יהיה לתחזק את מערכת ה-KNX גם בעתיד.' },
  { q: 'מי היצרן של רכיבי ה-KNX המרכזיים?', a: 'הציוד המרכזי במערכת ה-KNX הוא מתוצרת Siemens.' },
  { q: 'מי מתקין את הבקרים?', a: 'החשמלאי מתקין ומחבר את הבקרים בהתאם לתכנון ולהנחיות של i-feel.' },
  { q: 'מי מבצע את התכנות?', a: 'התכנות והקמת המערכת מבוצעים על ידי i-feel.' },
  { q: 'מי נותן שירות בעתיד?', a: 'i-feel היא הכתובת לשירות, תמיכה וטיפול בתקלות גם לאחר סיום הפרויקט.' },
  { q: 'מי אחראי על התרחישים, הלוגיקה, התכנות ו-Home Assistant?', a: 'i-feel אחראית על התכנות, הלוגיקה, התרחישים ו-Home Assistant במסגרת המערכת שסופקה והוגדרה על ידינו.' },
  { q: 'אם בקר מתקלקל בעתיד, האם אינטגרטור KNX אחר יכול להחליף אותו?', a: 'כן. KNX הוא תקן פתוח. ניתן להחליף רכיב באמצעות איש מקצוע מתאים בתחום ה-KNX, ובוודאי באמצעות i-feel.' },
  { q: 'אם השרת מתקלקל, האם התאורה והתריסים ממשיכים לעבוד?', a: 'כן. התאורה והתריסים ממשיכים לעבוד גם במקרה שהשרת אינו פעיל. הפעולות הבסיסיות מבוססות KNX ואינן תלויות בשרת. פונקציות מתקדמות שתלויות בשרת, כגון חלק מהתרחישים המורכבים, האפליקציה או התראות, עשויות שלא להיות זמינות עד להחזרת השרת לפעולה.' },
  { q: 'מי מתחזק את Home Assistant?', a: 'i-feel מטפלת במערכת, לרבות התחזוקה הנדרשת, עדכונים, גיבויים ושחזור.' },
  { q: 'האם ניתן לבצע הרחבות בעתיד ללא תלות ב-i-feel?', a: 'כן. ניתן להוסיף בעתיד תאורה, תריסים, שערים, מצלמות, השקיה ומערכות נוספות. מאחר שמדובר ב-KNX, אין חובה להיות תלויים ב-i-feel לצורך הרחבות עתידיות.' },
  { q: 'היכן נשמרים התרחישים, ב-KNX או ב-Home Assistant?', a: 'תלוי בסוג התרחיש. משתמשים גם ב-KNX וגם ב-Home Assistant בהתאם לפונקציה ולמורכבות שלה. פעולות שחשוב שימשיכו לעבוד ללא תלות בשרת יכולות להיות ממומשות ברמת ה-KNX, בעוד פונקציות מתקדמות ואינטגרציות בין מערכות יכולות להתבצע באמצעות Home Assistant.' }
];
const meta = {
  title: 'KNX, קבצי ETS, שירות ו-Home Assistant | שאלות ותשובות | i-feel',
  description: 'תשובות לשאלות נפוצות על קבצי ETS, ציוד Siemens, התקנת ותכנות KNX, שירות, החלפת בקרים, תקלה בשרת, Home Assistant והרחבות עתידיות.',
  canonical: url,
  ogTitle: 'KNX, ETS, שירות ו-Home Assistant | i-feel',
  ogDescription: 'מי מתקין, מי מתכנת, מי נותן שירות, מה קורה אם השרת נופל והאם ניתן להחליף אינטגרטור בעתיד.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org', '@graph': [
    { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'FAQPage', mainEntity: faqs.map(item => ({ '@type':'Question', name:item.q, acceptedAnswer:{ '@type':'Answer', text:item.a } })) }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">KNX, ETS ושירות</span></div></nav>

  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16">
    <div class="prose-he">
      <h1>{question}</h1>
      <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>

      <h2>שאלות ותשובות על מערכת KNX של i-feel</h2>
      {faqs.map((item, index) => (
        <section class="not-prose bg-white border border-brand-100 rounded-2xl p-6 my-5 shadow-sm">
          <h3 class="text-xl font-bold text-brand-900 mb-3">{index + 1}. {item.q}</h3>
          <p class="text-brand-700 leading-relaxed" style="margin:0">{item.a}</p>
        </section>
      ))}

      <h2>העיקרון שלנו</h2>
      <p>המטרה בתכנון היא לשלב בין יציבות ועצמאות של מערכת KNX לבין היכולות המתקדמות של Home Assistant. פעולות בסיסיות וקריטיות מתוכננות כך שלא יהיו תלויות בשרת, ובמקביל ניתן להשתמש בשרת עבור אינטגרציות, תרחישים מורכבים, אפליקציה והתראות.</p>

      <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">מידע נוסף</p><ul class="space-y-1" style="margin:0"><li><a href="/knx-smart-home/" class="text-accent-600 font-semibold hover:underline">מערכת בית חכם KNX</a></li><li><a href="/answers/choosing-smart-home-integrator/" class="text-accent-600 font-semibold hover:underline">איך בוחרים אינטגרטור לבית חכם?</a></li><li><a href="/service-and-maintenance/" class="text-accent-600 font-semibold hover:underline">שירות ותחזוקה</a></li></ul></div>
    </div>
  </article>

  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">יש לכם שאלות נוספות על KNX או Home Assistant?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/contactus/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">דברו איתנו</a></div></div></section>
</BaseLayout>
