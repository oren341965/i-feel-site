---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageUrl = 'https://i-feel.co.il/answers/';
const qas = [
  { href: '/answers/knx-ets-service-home-assistant/', q: 'מי מתחזק מערכת KNX, מי מקבל את קבצי ETS ומה קורה אם השרת נופל?', d: 'קבצי ETS, ציוד Siemens, התקנה, תכנות, שירות, Home Assistant והרחבות עתידיות.' },
  { href: '/answers/bms-building-cost/', q: 'כמה עולה מערכת BMS לבניין?', d: 'מה משפיע על מחיר פרויקט בקרת מבנה ואיך בונים תקציב נכון.' },
  { href: '/answers/knx-vs-control4/', q: 'מה ההבדל בין KNX ל-Control4?', d: 'תשתית בקרה מול פלטפורמת שליטה — ולמה לרוב משלבים את שתיהן.' },
  { href: '/answers/siemens-desigo-vs-knx/', q: 'מה ההבדל בין Siemens Desigo ל-KNX?', d: 'שרת ניהול מבנה מול פרוטוקול בקרה ברמת החדר.' },
  { href: '/answers/smart-home-service-existing/', q: 'מי נותן שירות למערכת בית חכם קיימת?', d: 'אבחון, תמיכה מרחוק, ביקורי טכנאי, תחזוקה והרחבות.' },
  { href: '/answers/choosing-smart-home-integrator/', q: 'איך בוחרים אינטגרטור לבית חכם בישראל?', d: 'מה חשוב לבדוק לפני שבוחרים מי מתכנן ומתקין.' },
  { href: '/answers/what-is-bms/', q: 'מה זה BMS?', d: 'מערכת בקרת מבנה — מה היא מנהלת, אילו פרוטוקולים ולמי מתאים.' },
  { href: '/answers/bms-vs-smart-home/', q: 'מה ההבדל בין BMS לבית חכם?', d: 'ניהול מבנה מסחרי מול בית מגורים — מתי כל אחד.' },
  { href: '/answers/what-is-dali/', q: 'מה זה DALI?', d: 'פרוטוקול בקרת תאורה דיגיטלי — כתובת לכל גוף, עמעום ותרחישים.' },
  { href: '/answers/what-is-ddc/', q: 'מה זה DDC?', d: 'הבקר הדיגיטלי שהוא הליבה של מערכת בקרת מבנה.' },
  { href: '/answers/what-is-bacnet/', q: 'מה זה BACnet?', d: 'פרוטוקול תקני לתקשורת בין מערכות בקרת מבנה ו-HVAC.' },
  { href: '/answers/bms-for-hotels/', q: 'מתי צריך BMS במלון?', d: 'בקרת חדרים GRMS, חיסכון אנרגיה ושילוב ל-PMS.' },
  { href: '/answers/developer-smart-home/', q: 'מתי יזם צריך בית חכם בפרויקט?', d: 'בית חכם כערך שיווקי — תכנון מראש בשלב החשמל.' },
  { href: '/answers/knx-for-contractor-apartments/', q: 'האם KNX מתאים לדירות קבלן?', d: 'KNX מול אלחוטי לדירות קבלן — מתי כל אחד מתאים.' },
  { href: '/answers/bms-vrf-integration/', q: 'איך מחברים BMS למיזוג VRF?', d: 'אינטגרציה דרך gateway — BACnet/Modbus ושליטה אזורית.' },
];
const meta = {
  title: 'שאלות ותשובות | בית חכם, KNX, BMS | i-feel',
  description: 'תשובות מומחה לשאלות הנפוצות על בית חכם, KNX, BMS, Siemens Desigo, Control4 ושירות — מאת i-feel, מומחי בית חכם ובקרת מבנה בישראל.',
  canonical: pageUrl,
  ogTitle: 'שאלות ותשובות — בית חכם ו-BMS | i-feel',
  ogDescription: 'תשובות מומחה לשאלות על בית חכם, KNX, BMS, Control4 ו-Siemens Desigo.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id': 'https://i-feel.co.il/#business', name: 'i-feel', url: 'https://i-feel.co.il/', telephone: '+972-3-508-9553', email: 'sales@i-feel.co.il', address: { '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed: { '@type':'Country', name:'Israel' } },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' },
        { '@type':'ListItem', position:2, name:'שאלות ותשובות', item: pageUrl } ] }
    ]
  })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">שאלות ותשובות</span></div></nav>
  <section class="hero-gradient text-white"><div class="max-w-6xl mx-auto px-4 py-16 lg:py-20"><h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-5">שאלות ותשובות — בית חכם ו-BMS</h1><p class="text-xl text-brand-100 max-w-3xl">תשובות מומחה, קצרות ומדויקות, לשאלות שלקוחות, יזמים ואדריכלים שואלים על בית חכם, KNX, BMS, Control4 ו-Siemens Desigo.</p></div></section>
  <div class="max-w-5xl mx-auto px-4 py-12 lg:py-16"><div class="grid sm:grid-cols-2 gap-5">
    {qas.map(item => (
      <a href={item.href} class="block bg-white border border-brand-100 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-accent-300 transition">
        <h2 class="text-xl font-bold text-brand-900 mb-2">{item.q}</h2>
        <p class="text-brand-600">{item.d}</p>
        <span class="text-accent-600 font-semibold mt-3 inline-block">לתשובה ←</span>
      </a>
    ))}
  </div>
  <p class="text-brand-600 mt-10 text-center">לא מצאתם תשובה? <a href="/contactus/" class="text-accent-600 font-semibold hover:underline">דברו עם מומחה i-feel</a> או ראו את <a href="/שאלות-נפוצות/" class="text-accent-600 font-semibold hover:underline">השאלות הנפוצות המלאות</a>.</p>
  </div>
</BaseLayout>
