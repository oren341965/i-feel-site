---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url='https://i-feel.co.il/answers/what-is-dali-2/';
const title='מה זה DALI-2 ואיך הוא משתלב ב-BMS? | i-feel';
const description='DALI-2 היא תוכנית הסמכה של DALI Alliance לבקרת תאורה דיגיטלית. הסבר קצר על IEC 62386, BMS, KNX ו-Siemens Desigo.';
const jsonLd=JSON.stringify({'@context':'https://schema.org','@graph':[
{'@type':'WebPage',url,name:title,description,inLanguage:'he-IL',dateModified:'2026-10-07'},
{'@type':'FAQPage',mainEntity:[{'@type':'Question',name:'מה זה DALI-2?',acceptedAnswer:{'@type':'Answer',text:'DALI-2 היא תוכנית הסמכה של DALI Alliance המבוססת על הגרסה העדכנית של פרוטוקול DALI. בדיקות ההסמכה נגזרות מחלקים רלוונטיים של IEC 62386 או ממפרטי DALI Alliance, ותוצאות הבדיקה מאומתות על ידי הארגון.'}}]}
]});
---
<BaseLayout title={title} description={description} canonical={url} ogTitle={title} ogDescription={description} ogUrl={url} jsonLd={jsonLd}>
<main dir="rtl" class="max-w-3xl mx-auto px-4 py-12">
<h1 class="text-4xl font-extrabold text-brand-900">מה זה DALI-2 ואיך הוא משתלב ב-BMS?</h1>
<div class="mt-6 rounded-2xl border border-brand-100 bg-brand-50 p-6">
<p class="text-lg leading-8 text-brand-800"><strong>DALI-2</strong> היא תוכנית הסמכה של DALI Alliance לבקרת תאורה דיגיטלית. במערכת BMS היא מאפשרת לשלב תאורה, חיישנים ותרחישים עם מערכות ניהול מבנה כגון Siemens Desigo, DDC ו-KNX.</p>
</div>
<p class="mt-8 text-lg leading-8 text-brand-700">למדריך המקצועי המלא, כולל השוואה ל-0-10V, תכנון ויישום, ראו <a class="font-bold text-accent-700" href="/structure-control/dali-lighting-control/">בקרת תאורה DALI ו-DALI-2</a>.</p>
</main>
</BaseLayout>
