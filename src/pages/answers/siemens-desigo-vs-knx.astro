---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/siemens-desigo-vs-knx/';
const question = 'מה ההבדל בין Siemens Desigo ל-KNX?';
const answer = 'Siemens Desigo ו-KNX פועלים בשתי רמות שונות. Siemens Desigo הוא שרת ניהול BMS מרכזי למבנים מסחריים גדולים — מנהל מאות אלפי נקודות בקרה ממסוף אחד, עם תמיכה ב-BACnet, KNX ו-Modbus, ומיועד לניהול כל המבנה. KNX הוא פרוטוקול בקרה ברמת החדר — תאורה, תריסים, מיזוג וחיישנים. הם לא מתחרים: Desigo מנהל ברמת המבנה, ו-KNX משתלב בתוכו כשכבת בקרה ברמת החדר.';
const meta = {
  title: 'Siemens Desigo מול KNX — מה ההבדל? | i-feel',
  description: answer.slice(0, 155),
  canonical: url, ogTitle: question + ' | i-feel', ogDescription: 'שרת ניהול מבנה מול פרוטוקול בקרה ברמת החדר — ואיך הם עובדים יחד.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org', '@graph': [
    { '@type': ['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      { '@type':'Question', name:'האם KNX מחליף BMS?', acceptedAnswer:{ '@type':'Answer', text:'לא. KNX מתאים לבקרה ברמת החדר. בפרויקט BMS מלא שכבת הבקרה המרכזית מבוססת על בקרי DDC ושרת ניהול כמו Siemens Desigo, ו-KNX משתלב כחלק מהמערכת.' } },
      { '@type':'Question', name:'מתי צריך Siemens Desigo?', acceptedAnswer:{ '@type':'Answer', text:'במבנים מסחריים וציבוריים גדולים עם מערכות טכניות מרובות, שדורשים ניהול מרכזי, ניטור אנרגיה והתראות ממסוף אחד.' } } ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">Siemens Desigo מול KNX</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>מה זה Siemens Desigo</h2>
    <p><a href="/siemens-desigo-bms/">Siemens Desigo</a> הוא שרת ניהול BMS מוביל למבנים מסחריים גדולים. Desigo CC מנהלת מאות אלפי נקודות בקרה ממסוף אחד, עם תמיכה ישירה ב-BACnet, KNX ו-Modbus — מתאים למלונות, מגדלי משרדים, בתי חולים ומבני ציבור.</p>
    <h2>מה זה KNX</h2>
    <p><a href="/knx-smart-home/">KNX</a> הוא פרוטוקול תקני בינלאומי לבקרה ברמת החדר — תאורה, תריסים, מיזוג וחיישנים. אמין, אינטראופרבילי, ומתאים לאינטגרציה אדריכלית.</p>
    <h2>איך הם עובדים יחד</h2>
    <p>בפרויקט <a href="/structure-control/">בקרת מבנה</a> מלא, שכבת הבקרה המרכזית מבוססת על בקרי DDC ושרת ניהול כמו Desigo, ו-KNX משתלב כשכבת בקרה ברמת החדר. כך מקבלים ניהול מרכזי של כל המבנה יחד עם בקרה מדויקת בכל חלל.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/bms-building-cost/" class="text-accent-600 font-semibold hover:underline">כמה עולה BMS לבניין?</a></li><li><a href="/answers/knx-vs-control4/" class="text-accent-600 font-semibold hover:underline">KNX מול Control4?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">מתכננים פרויקט BMS?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/contactus/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">לתיאום פגישה</a></div></div></section>
</BaseLayout>
