---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/answers/developer-smart-home/';
const question = 'מתי יזם בנייה צריך בית חכם בפרויקט?';
const answer = 'יזם בנייה צריך לשלב בית חכם כשהוא רוצה להעלות את ערך הדירות ולבדל את הפרויקט — "דירה חכמה" כסטנדרט הופכת לערך שיווקי. ההחלטה הנכונה מתקבלת כבר בשלב התכנון, יחד עם תכנון החשמל, כך שהתשתית מונחת מראש בעלות נמוכה ובלי שיפוצים. בבנייה רוויה אפשר להגדיר מפרט אחיד לכל הדירות, ולאפשר לרוכשים שדרוגים.';
const meta = {
  title: 'מתי יזם צריך בית חכם בפרויקט? | i-feel',
  description: answer.slice(0,155), canonical: url, ogTitle: question+' | i-feel', ogDescription: 'בית חכם כערך שיווקי לפרויקטי יזמים — תכנון מראש בשלב החשמל.', ogUrl: url, ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({ '@context':'https://schema.org','@graph':[
    { '@type':['LocalBusiness','HomeAndConstructionBusiness'], '@id':'https://i-feel.co.il/#business', name:'i-feel', url:'https://i-feel.co.il/', telephone:'+972-3-508-9553', email:'sales@i-feel.co.il', address:{ '@type':'PostalAddress', streetAddress:'אימבר 14', addressLocality:'פתח תקווה', postalCode:'4951148', addressCountry:'IL' }, areaServed:{ '@type':'Country', name:'Israel' } },
    { '@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'דף הבית', item:'https://i-feel.co.il/' }, { '@type':'ListItem', position:2, name:'שאלות ותשובות', item:'https://i-feel.co.il/answers/' }, { '@type':'ListItem', position:3, name:question, item:url } ] },
    { '@type':'Article', headline:question, author:{ '@id':'https://i-feel.co.il/#business' }, publisher:{ '@id':'https://i-feel.co.il/#business' }, mainEntityOfPage:url, inLanguage:'he-IL' },
    { '@type':'FAQPage', mainEntity:[
      { '@type':'Question', name:question, acceptedAnswer:{ '@type':'Answer', text:answer } },
      { '@type':'Question', name:'מתי הזמן הנכון להחליט?', acceptedAnswer:{ '@type':'Answer', text:'כבר בשלב תכנון החשמל. הנחת תשתית בזמן עולה מעט מאוד ופותחת את כל האפשרויות, בעוד שהוספה אחרי הביצוע הופכת לשיפוץ יקר.' } },
      { '@type':'Question', name:'איך מנהלים שינויי דיירים?', acceptedAnswer:{ '@type':'Answer', text:'מגדירים מפרט בסיס אחיד לכל הדירות, ומאפשרים לרוכשים שדרוגים אישיים — i-feel מלווה את התהליך מול היזם ומול הדיירים.' } } ] }
  ] })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a><span class="mx-2 text-brand-400">›</span><a href="/answers/" class="text-brand-600 hover:text-accent-600">שאלות ותשובות</a><span class="mx-2 text-brand-400">›</span><span class="text-brand-900 font-medium">בית חכם ליזמים</span></div></nav>
  <article class="max-w-3xl mx-auto px-4 py-12 lg:py-16"><div class="prose-he">
    <h1>{question}</h1>
    <div class="not-prose bg-brand-50 border-r-4 border-accent-500 rounded-lg p-6 my-6"><p class="text-lg leading-relaxed text-brand-800" style="margin:0"><strong>תשובה קצרה:</strong> {answer}</p></div>
    <h2>בית חכם כערך שיווקי</h2><p>"דירה חכמה" כסטנדרט מבדלת את הפרויקט ומעלה את ערך הדירות. ראו <a href="/contractor-customer-care/">פתרונות ליזמי בנייה</a> — תמ"א 38, התחדשות עירונית ובנייה רוויה חדשה.</p>
    <h2>למה לתכנן מראש</h2><p>ההחלטה כבר בשלב <a href="/smart-home/">החשמל</a> חוסכת כסף ופותחת אפשרויות. תיאום מול <a href="/architects-smart-home-planning/">אדריכלים</a> והחשמלאי מבטיח שהתשתית תונח נכון.</p>
    <div class="not-prose bg-brand-50 rounded-lg p-5 my-8"><p class="font-bold text-brand-900 mb-2" style="margin:0">שאלות קשורות</p><ul class="space-y-1" style="margin:0"><li><a href="/answers/knx-for-contractor-apartments/" class="text-accent-600 font-semibold hover:underline">האם KNX מתאים לדירות קבלן?</a></li><li><a href="/smart-home-price/" class="text-accent-600 font-semibold hover:underline">כמה עולה בית חכם?</a></li></ul></div>
  </div></article>
  <section class="bg-brand-900 text-white py-14"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-2xl md:text-3xl font-extrabold mb-4">יזמים — רוצים דירה חכמה בפרויקט?</h2><div class="flex flex-wrap justify-center gap-3"><a href="tel:+972-3-508-9553" class="bg-accent-500 hover:bg-accent-600 text-white px-7 py-3 rounded-lg font-semibold">03-508-9553</a><a href="/contractor-customer-care/" class="bg-white/10 text-white px-7 py-3 rounded-lg font-semibold border border-white/30">פתרונות ליזמים</a></div></div></section>
</BaseLayout>
