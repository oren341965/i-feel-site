            <div class="advisor-field-grid">
              <div class="advisor-field"><label for="lead-name">שם מלא *</label><input id="lead-name" name="name" type="text" maxlength="120" autocomplete="name" required /></div>
              <div class="advisor-field"><label for="lead-phone">טלפון *</label><input id="lead-phone" name="phone" type="tel" maxlength="30" autocomplete="tel" inputmode="tel" required /></div>
              <div class="advisor-field"><label for="lead-email">דואר אלקטרוני</label><input id="lead-email" name="email" type="email" maxlength="160" autocomplete="email" /></div>
              <div class="advisor-field"><label for="lead-city">עיר</label><input id="lead-city" type="text" maxlength="80" autocomplete="address-level2" /></div>
              <div class="advisor-field"><label for="lead-plans">תוכניות זמינות</label><select id="lead-plans"><option value="ללא תוכניות כרגע">ללא תוכניות כרגע</option><option value="תוכנית אדריכלית">תוכנית אדריכלית</option><option value="תוכנית חשמל">תוכנית חשמל</option><option value="תוכנית אדריכלית וחשמל">תוכנית אדריכלית וחשמל</option><option value="אעביר לאחר השיחה">אעביר לאחר השיחה</option></select></div>
              <div class="advisor-field"><label for="lead-notes">הערות</label><textarea id="lead-notes" maxlength="900" placeholder="שלב הפרויקט, שאלות או מידע חשוב"></textarea></div>
