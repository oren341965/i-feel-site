---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/knx-advisor.css';

const title = 'איזה מפסק KNX מתאים לבית? יועץ חשמל חכם | I Feel';
const description = 'כלי אינטראקטיבי לבחירת מפסקי KNX ומערכת חשמל חכם לפי חדר, תאורה, תריסים, מיזוג, חימום, אודיו, תרחישים והתקנה בקו אפס.';
const canonical = 'https://i-feel.co.il/knx-switch-advisor/';

const faqs = [
  ['מה ההבדל בין Siemens TC4 ל-TC5?', 'TC4 הוא מסך 4 אינץ׳ קומפקטי לחדרים ולנקודות עם שטח תצוגה קטן יותר. TC5 הוא מסך 5 אינץ׳ ומציג יותר מידע ופעולות, ולכן מתאים במיוחד לאזורים מרכזיים. ההתאמה הסופית תלויה בכמות הפעולות, במערכות ובתכנון.'],
  ['כמה מפסקים צריך בחדר?', 'בדרך כלל מתחילים בנקודה בכניסה. בחדר שינה מוסיפים נקודה ליד המיטה, ובחדר הורים נהוג לשקול נקודה בכל צד של המיטה ובאזורים צמודים. הכלי מתאים את ההצעה למבנה החדר.'],
  ['האם מפסק KNX יכול לשלוט במזגן?', 'כן, בכפוף לסוג המזגן, לממשק התקשורת ולתכנון KNX. במערכת VRF נדרש בדרך כלל מתאם תקשורת מתאים ותיאום עם איש המיזוג.'],
  ['האם TC4 או TC5 יכולים להחליף תרמוסטט?', 'בחלק מהמערכות כן, בכפוף לתאימות, לבקרת הטמפרטורה ולמתאם התקשורת. אין לוותר על תרמוסטט לפני אימות מול מתכנן KNX ואיש המיזוג.'],
  ['מה חשוב לדעת על VRF?', 'מסך מתאים גם כאשר יש מעט פעולות, משום שהוא מרכז את בקרת המיזוג. נדרש מתאם תקשורת, ובדרך כלל נבחנת אינטגרציה מסוג CoolMaster KNX שהמתאם עבורה מתואם עם איש המיזוג.'],
  ['איך משלבים חימום תת רצפתי?', 'עם מתאם מתאים ניתן לשלב הפעלה ובקרת טמפרטורה. ללא מתאם ניתן לתכנן נקודות קיצון להפעלה וכיבוי, בעוד שינוי הטמפרטורה נשאר ביחידת החימום.'],
  ['מה נחשב פעולה במפסק?', 'תאורה, דימר, מזגן, דוד או תרחיש נספרים בדרך כלל כפעולה אחת. תריס, וילון או צלון כלוא נספרים כשתי פעולות - פתיחה וסגירה.'],
  ['מהי התקנה בקו אפס?', 'מתאם ייעודי מאפשר להתקין את המפסק בקו אחיד עם הקיר למראה שטוח. יש לתכנן זאת לפני השלמת הקיר ולתאם קופסה, עומק וחומר גמר.'],
  ['האם אפשר לשנות את פעולות המפסק בעתיד?', 'כן. מתקין KNX מורשה יכול לשנות תפקידי לחצנים ותרחישים, בכפוף ליכולות הדגם ולתשתית. במסך דינמי הגמישות גבוהה במיוחד.'],
  ['מה מומלץ בחדר ילדים?', 'ליד המיטה מומלצים בדרך כלל לחצנים פשוטים ועמידים עם מעט פעולות ותרחישים ברורים. מסך בכניסה נשקל כאשר נדרשת שליטת מיזוג או ריבוי מערכות.'],
  ['איזה מפסק מתאים ליד בריכה או באזור חשוף למים?', 'אין להשתמש שם במסך פנימי רגיל. הכלי יציע מתאם Siemens PBI בתוך מפסק קפיצי חיצוני מוגן מים שאותו מספק החשמלאי, לאחר תיאום הקופסה וההתקנה.'],
  ['מהו PBI?', 'PBI הוא מתאם KNX פנימי שמותקן מאחורי מפסק קפיצי חיצוני. הוא אינו מפסק מוגן מים בפני עצמו, ואין להסיק ממנו דרגת IP.'],
  ['מי מספק את המפסק החיצוני?', 'המפסק הקפיצי החיצוני המוגן מים מסופק על ידי החשמלאי. יש לתאם מראש קופסה, עומק, כבילה ומקום למתאם PBI.'],
  ['האם ההמלצה מחליפה תכנון מקצועי?', 'לא. התוצאה היא אפיון ראשוני בלבד. ההתאמה הסופית נקבעת לאחר בדיקת תוכניות ותיאום עם I Feel, החשמלאי, איש המיזוג והאדריכל.']
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${canonical}#application`,
      name: 'יועץ מערכת חשמל חכם ומפסקי KNX',
      url: canonical,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'he-IL',
      isAccessibleForFree: true,
      description
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'בית חכם KNX', item: 'https://i-feel.co.il/knx-smart-home/' },
        { '@type': 'ListItem', position: 3, name: 'יועץ מפסקי KNX', item: canonical }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer }
      }))
    }
  ]
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle="יועץ מערכת חשמל חכם ומפסקי KNX | I Feel"
  ogDescription={description}
  ogUrl={canonical}
  ogImage="https://i-feel.co.il/assets/smart-home-ramat-hasharon.jpg"
  jsonLd={jsonLd}
>
  <div class="advisor-page">
    <section class="advisor-hero" aria-labelledby="advisor-title">
      <div class="advisor-shell">
        <span class="advisor-eyebrow">⚡ מרכז בחירה והדגמה למפסקי KNX</span>
        <h1 id="advisor-title">רואים מה כל מפסק עושה, בונים את התוכן ורק אז בוחרים</h1>
        <p>הכירו את TC4, TC5, לחצני KNX ומתאמי PBI, נסו דוגמאות אמיתיות לפי חדר ובנו על המסך את הפעולות שתרצו לקבל. ליד כל מוצר תמצאו הסבר, תמונה, יתרונות, מגבלות וקטלוג.</p>
        <div class="advisor-hero-actions">
          <a class="advisor-btn advisor-btn-primary" href="#switch-lab" data-track="advisor_hero_builder">בואו נבנה מפסק</a>
          <a class="advisor-btn advisor-btn-secondary" href="#product-guide" data-track="advisor_hero_products">הכירו את הדגמים</a>
          <a class="advisor-btn advisor-btn-ghost advisor-btn-on-dark" href="#start-advisor" data-track="advisor_hero_start">לתכנון בית שלם</a>
        </div>
      </div>
    </section>

    <nav class="advisor-journeys" aria-label="בחירת מסלול מהיר">
      <div class="advisor-shell advisor-journey-grid">
        <a href="#product-guide"><span>1</span><strong>להבין מה מקבלים</strong><small>השוואת מוצרים פשוטה עם תמונות וקטלוגים</small></a>
        <a href="#switch-lab"><span>2</span><strong>לבנות מפסק לדוגמה</strong><small>בחירת חדר, פעולות ותצוגה חיה של התוכן</small></a>
        <a href="#start-advisor"><span>3</span><strong>לתכנן את כל הבית</strong><small>חדרים, מיקומים, כמויות ותיאומים לביצוע</small></a>
      </div>
    </nav>

    <section class="advisor-products" id="product-guide" aria-labelledby="product-guide-title">
      <div class="advisor-shell">
        <div class="advisor-section-head advisor-section-head-wide">
          <span class="advisor-kicker">לפני שבוחרים - מבינים</span>
          <h2 id="product-guide-title">מה כל סוג מפסק נותן לכם בפועל?</h2>
          <p>הבחירה אינה רק לפי מספר לחצנים. צריך להבין האם נדרשת תצוגה משתנה, שליטה במיזוג, פעולה מהירה בחושך, עמידות באזור חוץ או התאמה לעיצוב הקיר.</p>
        </div>

        <div class="advisor-product-grid">
          <article class="advisor-product-card" data-product-card="tc4">
            <div class="advisor-product-image"><img src="/assets/knx-advisor/siemens-tc4.webp" alt="Siemens Touch Control TC4 בגוון לבן" width="900" height="900" loading="lazy" /></div>
            <div class="advisor-product-content">
              <div class="advisor-product-title"><div><span>מסך מגע 4 אינץ׳</span><h3>Siemens TC4</h3></div><span class="advisor-product-fit">קומפקטי וגמיש</span></div>
              <p><strong>מה הוא מבצע?</strong> מרכז תאורה, תריסים, תרחישים, טמפרטורה, אוורור ומידע מהמערכת בדפי תצוגה שנקבעים בתכנון ETS.</p>
              <ul>
                <li><b>מתאים במיוחד:</b> חדרי שינה, משרד, מטבח או סלון עם כמות בינונית של פעולות.</li>
                <li><b>מה הלקוח מקבל:</b> מסך צבעוני, דפי פונקציה, אייקונים ותוכן שניתן לתכנת ולעדכן.</li>
                <li><b>חשוב לדעת:</b> נדרשים קופסת התקנה, KNX והזנת עזר; התאמת מיזוג נבדקת בנפרד.</li>
              </ul>
              <div class="advisor-product-actions">
                <a class="advisor-btn advisor-btn-primary advisor-btn-sm" href="/assets/catalogs/siemens-touch-control-tc4-tc5-he.pdf#page=3" target="_blank" rel="noopener" data-track="advisor_catalog_tc4">פתיחת מדריך TC4</a>
                <a class="advisor-text-link" href="#switch-lab" data-lab-product="tc4">לבניית תוכן לדוגמה ←</a>
              </div>
            </div>
          </article>

          <article class="advisor-product-card" data-product-card="tc5">
            <div class="advisor-product-image advisor-product-image-tall"><img src="/assets/knx-advisor/siemens-tc5.webp" alt="Siemens Touch Control TC5 בגוון לבן" width="700" height="1200" loading="lazy" /></div>
            <div class="advisor-product-content">
              <div class="advisor-product-title"><div><span>מסך מגע 5 אינץ׳</span><h3>Siemens TC5</h3></div><span class="advisor-product-fit advisor-product-fit-orange">יותר מידע</span></div>
              <p><strong>מה הוא מבצע?</strong> אותן משפחות שליטה של TC4, עם שטח תצוגה גדול יותר ועד 15 דפי פונקציה המוגדרים ב-ETS, בהתקנה אנכית או אופקית.</p>
              <ul>
                <li><b>מתאים במיוחד:</b> כניסה, סלון גדול, חדר קולנוע או אזור מרכזי עם הרבה מערכות.</li>
                <li><b>מה הלקוח מקבל:</b> יותר פעולות ומידע גלוי בכל מסך ופחות מעבר בין דפים.</li>
                <li><b>חשוב לדעת:</b> מסך גדול אינו בהכרח טוב יותר בחדר פשוט; הוא דורש מקום ותכנון מתאים.</li>
              </ul>
              <div class="advisor-product-actions">
                <a class="advisor-btn advisor-btn-primary advisor-btn-sm" href="/assets/catalogs/siemens-touch-control-tc4-tc5-he.pdf#page=4" target="_blank" rel="noopener" data-track="advisor_catalog_tc5">פתיחת מדריך TC5</a>
                <a class="advisor-text-link" href="#switch-lab" data-lab-product="tc5">לבניית תוכן לדוגמה ←</a>
              </div>
            </div>
          </article>

          <article class="advisor-product-card" data-product-card="tacteo">
            <div class="advisor-product-image advisor-product-image-wide"><img src="/assets/knx-advisor/abb-tacteo-preview.webp" alt="דוגמאות לחצני מגע ABB Tacteo KNX בצבעים ובפריסות שונות" width="1000" height="562" loading="lazy" /></div>
            <div class="advisor-product-content">
              <div class="advisor-product-title"><div><span>לחצן מגע KNX</span><h3>ABB Tacteo</h3></div><span class="advisor-product-fit">ישיר ועיצובי</span></div>
              <p><strong>מה הוא מבצע?</strong> פעולות קבועות ונגישות כמו תאורה, דימר, תריס, תרחיש וטמפרטורה - בלי להיכנס לדפי מסך.</p>
              <ul>
                <li><b>מתאים במיוחד:</b> נקודות ליד מיטה, מסדרונות וחדרים שבהם רוצים פעולה מיידית וברורה.</li>
                <li><b>מה הלקוח מקבל:</b> חזית זכוכית מותאמת, אייקונים ופריסה לפי מספר ערוצי הדגם שנבחר.</li>
                <li><b>חשוב לדעת:</b> התוכן פחות דינמי ממסך; שינוי עתידי יכול לדרוש עדכון סימון או חזית.</li>
              </ul>
              <div class="advisor-product-actions">
                <a class="advisor-btn advisor-btn-primary advisor-btn-sm" href="/assets/catalogs/tacteo-catalog.pdf" target="_blank" rel="noopener" data-track="advisor_catalog_tacteo">פתיחת קטלוג Tacteo</a>
                <a class="advisor-text-link" href="#switch-lab" data-lab-product="tacteo">לבניית לחצנים לדוגמה ←</a>
              </div>
            </div>
          </article>

          <article class="advisor-product-card" data-product-card="pbi">
            <div class="advisor-product-image advisor-product-image-wide"><img src="/assets/knx-advisor/siemens-pbi-up220.webp" alt="מתאם Siemens KNX Push Button Interface UP 220" width="800" height="430" loading="lazy" /></div>
            <div class="advisor-product-content">
              <div class="advisor-product-title"><div><span>מתאם מאחורי מפסק</span><h3>Siemens PBI</h3></div><span class="advisor-product-fit advisor-product-fit-dark">לחוץ ולמפסק רגיל</span></div>
              <p><strong>מה הוא מבצע?</strong> מחבר ל-KNX מפסק קפיצי רגיל או מוגן מים. קיימת גרסת 2 ערוצים וגרסת 4 ערוצים לפעולות כמו תאורה, דימר, תריס או תרחיש.</p>
              <ul>
                <li><b>מתאים במיוחד:</b> מרפסת, גינה, ליד בריכה או כאשר רוצים לשמור חזית מפסק מסדרה רגילה.</li>
                <li><b>מה הלקוח מקבל:</b> מתאם פנימי; המפסק החיצוני עצמו מסופק ומתואם עם החשמלאי.</li>
                <li><b>חשוב לדעת:</b> ה-PBI אינו מפסק מוגן מים ואינו קובע את דרגת האטימות של החזית.</li>
              </ul>
              <div class="advisor-product-actions">
                <a class="advisor-btn advisor-btn-primary advisor-btn-sm" href="https://cache.industry.siemens.com/dl/files/531/109818531/att_1136419/v1/A6V10416506.pdf" target="_blank" rel="noopener" data-track="advisor_catalog_pbi">פתיחת דף Siemens PBI</a>
                <a class="advisor-text-link" href="#switch-lab" data-lab-product="pbi">לבניית נקודת חוץ לדוגמה ←</a>
              </div>
            </div>
          </article>
        </div>

        <div class="advisor-family-section" aria-labelledby="alternative-families-title">
          <div class="advisor-family-heading">
            <div><span class="advisor-kicker">חלופות אמיתיות, לא רשימת שמות</span><h3 id="alternative-families-title">מה נותנות משפחות המפסקים הנוספות?</h3></div>
            <p>המוצר המדויק נבחר רק אחרי שסוגרים את מספר הפעולות, הגמר והקופסה. כאן אפשר להבין מראש מה אופי השימוש של כל משפחה ולפתוח את חומר היצרן.</p>
          </div>

          <div class="advisor-family-grid">
            <article class="advisor-family-card">
              <img src="/assets/knx-advisor/siemens-buttons-preview.webp" alt="דוגמאות לחצני KNX של Siemens מתוך קטלוג I Feel" width="1100" height="778" loading="lazy" />
              <div><span>פעולות קבועות וברורות</span><h4>לחצני KNX של Siemens</h4>
                <p><b>מה מקבלים:</b> לחצני מגע בגרסאות שונות לפי הדגם, נוריות מצב ואפשרות לסימון — בלי לעבור בין דפי מסך.</p>
                <p><b>כדאי כאשר:</b> יש מעט פעולות יומיומיות ורוצים שימוש ישיר בחדר, במסדרון או ליד המיטה.</p>
                <p><b>בודקים לפני הזמנה:</b> מספר לחצנים, דגם, אייקונים, צבע וקופסת התקנה.</p>
                <a href="/assets/catalogs/knx-catalog-2025.pdf#page=15" target="_blank" rel="noopener">לצפייה בדגמים בקטלוג ←</a>
              </div>
            </article>

            <article class="advisor-family-card">
              <img src="/assets/knx-advisor/eelectron-catalog-preview.webp" alt="דוגמאות מפסקי זכוכית Eelectron 9025 מתוך קטלוג I Feel" width="1100" height="778" loading="lazy" />
              <div><span>זכוכית ופריסות מגוונות</span><h4>Eelectron 9025</h4>
                <p><b>מה מקבלים:</b> חזית מגע מזכוכית ופריסת לחצנים לפי הדגם, לפעולות כמו תאורה, עמעום, תריסים ותרחישים.</p>
                <p><b>כדאי כאשר:</b> רוצים מפסק עיצובי עם פעולות גלויות, בלי ממשק של מסך מלא.</p>
                <p><b>בודקים לפני הזמנה:</b> מק״ט, מספר ערוצים, סימון, צבע, חיווי ותאימות לקופסה.</p>
                <a href="/assets/catalogs/knx-catalog-2025.pdf#page=5" target="_blank" rel="noopener">לפתיחת עמוד Eelectron ←</a>
              </div>
            </article>

            <article class="advisor-family-card">
              <img src="/assets/knx-advisor/mdt-catalog-preview.webp" alt="דוגמאות מפסקי KNX של MDT מתוך קטלוג I Feel" width="1100" height="778" loading="lazy" />
              <div><span>לחצנים, חיווי ודגמים עם תצוגה</span><h4>MDT Glass Push Button</h4>
