 <a href="/contactus/" class="inline-block mt-6 underline font-bold">פנייה לקבלת טופס התנאים המלא</a>
 </main>
 <script is:inline>
 (function () {
   const buttons = Array.from(document.querySelectorAll('[data-terms-choice]'));
   const panels = Array.from(document.querySelectorAll('[data-terms-panel]'));
   function show(name) {
      panels.forEach(p => { p.hidden = p.dataset.termsPanel !== name; });
      buttons.forEach(b => {
         const active = b.dataset.termsChoice === name;
         b.setAttribute('aria-pressed', active ? 'true' : 'false');
         b.classList.toggle('bg-brand-900',active);
         b.classList.toggle('text-white',active);
         b.classList.toggle('border-brand-900',active);
         b.classList.toggle('border-brand-200',!active);
      });
   }
   buttons.forEach(b => b.addEventListener('click', () => {
      const name = b.dataset.termsChoice;
      show(name);
      history.replaceState(null,'', name === 'zwave' ? '#cancellation' : '#'+name);
   }));
   const hash=location.hash.replace('#','');
   show(hash === 'knx' || hash === 'low-voltage' ? hash : 'zwave');
 })();
 </script>
</BaseLayout>