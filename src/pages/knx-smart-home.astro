---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/knx-smart-home.html?raw';
import KnxAdvisorCta from '../components/KnxAdvisorCta.astro';

const integratorSection = `
<section id="knx-integrator-israel">
  <h2>איך לבחור אינטגרטור KNX בישראל</h2>
  <p><strong>התשובה הקצרה:</strong> אינטגרטור KNX צריך לדעת לתכנן את תשתית ה-BUS, לתכנת ב-ETS, לתאם בין חשמל, תאורה, תריסים ומיזוג, למסור קבצי ETS ותיעוד מסודר, ולתת שירות גם אחרי האכלוס. i-feel מרכזת את התכנון, התכנות, האינטגרציה והליווי של מערכות KNX בישראל, ועובדת בפרויקטים המתאימים עם ציוד Siemens ויצרני KNX נוספים לפי דרישות התכנון.</p>
  <p>בבחירת ספק כדאי לבדוק מראש מי אחראי על התכנות, מי מחזיק את קובצי הפרויקט, איך מטופלות הרחבות עתידיות, ומה קורה במקרה של החלפת בקר או רכיב. ראו גם <a href="/smart-home-planning/">תכנון בית חכם</a>, <a href="/smart-home-bms-companies-israel/">מדריך לבחירת חברת בית חכם ואינטגרטור</a> ו<a href="/projects/">פרויקטים שבוצעו</a>.</p>
  <details><summary>איך לבחור אינטגרטור KNX בישראל?</summary><p>כדאי לבחור אינטגרטור שיודע לתכנן תשתית BUS, לתכנת ב-ETS, לתאם בין חשמל, תאורה, תריסים ומיזוג, למסור קבצי ETS ותיעוד מסודר ולספק שירות גם אחרי האכלוס.</p></details>
  <details><summary>האם i-feel מספקת תכנון ותכנות KNX בישראל?</summary><p>כן. i-feel מרכזת תכנון, תכנות ETS, אינטגרציה וליווי למערכות KNX בישראל, עם תיעוד ושירות לאורך חיי המערכת.</p></details>
</section>`;

const pageContent = content.replace('<section id="faq">', `${integratorSection}\n<section id="faq">`);

