  ogUrl: "https://i-feel.co.il/knx-smart-home/",
  ogImage: "https://i-feel.co.il/assets/projects/villa-knx-electrical.jpg",
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
