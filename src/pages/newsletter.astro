---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/newsletter.html?raw';

const pageUrl = 'https://i-feel.co.il/newsletter/';
const meta = {
  title: 'i-feel Insights | עדכונים על בית חכם ו-BMS',
  description: 'הצטרפו לעדכונים מקצועיים קצרים של i-feel על בית חכם, KNX, BMS, Siemens Desigo, DALI ופרויקטים בישראל.',
  canonical: pageUrl,
  ogTitle: 'i-feel Insights — בית חכם ובקרת מבנה',
  ogDescription: 'מדריכים, פרויקטים ותובנות מקצועיות על KNX, BMS ותכנון מערכות לבית ולמבנה.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': `${pageUrl}#page`,
        url: pageUrl,
        name: 'i-feel Insights',
        description: 'הרשמה לעדכונים מקצועיים על בית חכם ובקרת מבנה.',
        inLanguage: 'he-IL',
        isPartOf: { '@id': 'https://i-feel.co.il/#website' },
        about: { '@id': 'https://i-feel.co.il/#business' },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'i-feel Insights', item: pageUrl },
        ],
      },
    ],
  }),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>

