---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-18.html?raw';

const pageUrl = 'https://i-feel.co.il/structure-control/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      priceRange: '₪₪₪',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 32.09124,
        longitude: 34.88762,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
          opens: '09:00',
          closes: '18:00',
        },
      ],
      areaServed: {
        '@type': 'Country',
        name: 'Israel',
      },
      knowsAbout: [
        'BMS',
        'בקרת מבנה',
        'DDC',
        'Siemens Desigo',
        'KNX',
        'BACnet',
        'Modbus',
        'LoRaWAN',
        'ניהול אנרגיה',
      ],
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'בקרת מבנה BMS',
      serviceType: 'Building Management System integration',
      provider: {
        '@id': 'https://i-feel.co.il/#business',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Israel',
      },
      url: pageUrl,
      description:
        'תכנון, אינטגרציה והטמעה של מערכות בקרת מבנה BMS למלונות, משרדים, בתי חולים ומבני ציבור, כולל בקרי DDC, Siemens Desigo, KNX, BACnet, Modbus וניטור אנרגיה.',
      audience: [
        { '@type': 'BusinessAudience', audienceType: 'מלונות' },
        { '@type': 'BusinessAudience', audienceType: 'משרדים' },
        { '@type': 'BusinessAudience', audienceType: 'מבני ציבור' },
        { '@type': 'BusinessAudience', audienceType: 'בתי חולים' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'פתרונות BMS',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'אינטגרציית Siemens Desigo' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'בקרי DDC וממשקי HMI' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'בקרת תאורה ומיזוג מבוססת KNX' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ניטור אנרגיה ודוחות תפעול' } },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'מהי מערכת בקרת מבנה BMS?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'BMS היא מערכת ניהול ובקרה מרכזית שמחברת מיזוג, תאורה, חשמל, משאבות, חיישנים, אבטחה וניטור אנרגיה לפלטפורמה אחת. בפרויקטים מסחריים הליבה מבוססת לרוב על בקרי DDC שמתחברים לפי הצורך ל-KNX, BACnet, Modbus ו-Siemens Desigo.',
          },
        },
        {
          '@type': 'Question',
          name: 'כמה אנרגיה אפשר לחסוך עם BMS?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'בפרויקטים מתאימים, מערכת BMS מתוכננת ומכוילת יכולה לסייע בחיסכון אנרגטי של כ-20-40%, בהתאם לסוג המבנה, מצב הציוד, שעות הפעילות, לוגיקת הבקרה והתחזוקה השוטפת.',
          },
        },
        {
          '@type': 'Question',
          name: 'האם KNX מחליף BMS?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'לא. KNX מתאים בעיקר לבקרה ברמת החדר כמו תאורה, תריסים, מתגים וחיישנים. בפרויקט BMS מלא שכבת הבקרה המרכזית מבוססת בדרך כלל על DDC ושרת ניהול, כאשר KNX יכול להשתלב כחלק מהמערכת.',
          },
        },
        {
          '@type': 'Question',
          name: 'האם i-feel עובדת עם Siemens Desigo?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'כן. i-feel מטמיעה ומבצעת אינטגרציה של פתרונות Siemens Desigo בפרויקטי BMS, לצד KNX, BACnet, Modbus ובקרי DDC לפי דרישות הפרויקט.',
          },
        },
        {
          '@type': 'Question',
          name: 'לאילו מבנים מתאים BMS?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'BMS מתאים למלונות, משרדים, בתי חולים, מבני ציבור, מרכזי מסחר ומבנים עם מערכות טכניות מרובות שדורשות ניטור, תזמון, התראות, חיסכון אנרגיה וניהול מרכזי.',
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'דף הבית',
          item: 'https://i-feel.co.il/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'בקרת מבנה',
          item: pageUrl,
        },
      ],
    },
  ],
};

const meta = {
  title: 'בקרת מבנה BMS | Siemens Desigo, KNX ו-DDC | i-feel',
  description:
    'בקרת מבנה BMS למלונות, משרדים, בתי חולים ומבני ציבור: תכנון, אינטגרציה והטמעה של DDC, Siemens Desigo, KNX, BACnet, Modbus וניטור אנרגיה.',
  canonical: pageUrl,
  ogTitle: 'בקרת מבנה BMS | Siemens Desigo, KNX ו-DDC | i-feel',
  ogDescription:
    'פתרונות BMS למבנים מסחריים וציבוריים: DDC, Siemens Desigo, KNX, BACnet, Modbus, חיסכון אנרגיה וניהול מרכזי.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(jsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
