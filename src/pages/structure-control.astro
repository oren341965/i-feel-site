---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-18.html?raw';

const pageUrl = 'https://i-feel.co.il/structure-control/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      priceRange: '₪₪₪',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 32.09124,
        longitude: 34.88762,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
          opens: '09:00',
          closes: '18:00',
        },
      ],
      areaServed: {
        '@type': 'Country',
        name: 'Israel',
      },
      knowsAbout: [
        'BMS',
        'בקרת מבנה',
        'DDC',
        'Siemens Desigo',
        'KNX',
        'DALI',
        'BACnet',
        'Modbus',
        'LoRaWAN',
        'ניהול אנרגיה',
      ],
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: 'Siemens Solution Partner — Building Automation',
        credentialCategory: 'Manufacturer partner certification',
        recognizedBy: {
          '@type': 'Organization',
          name: 'Siemens',
        },
        validThrough: '2026-12-31',
        url: 'https://i-feel.co.il/license/',
      },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'בקרת מבנה BMS',
      serviceType: 'Building Management System integration',
      provider: {
        '@id': 'https://i-feel.co.il/#business',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Israel',
      },
      url: pageUrl,
      description:
        'תכנון, אינטגרציה והטמעה של מערכות בקרת מבנה BMS למלונות, משרדים, בתי חולים ומבני ציבור, כולל בקרי DDC, Siemens Desigo, KNX, DALI, BACnet, Modbus וניטור אנרגיה.',
      audience: [
        { '@type': 'BusinessAudience', audienceType: 'מלונות' },
        { '@type': 'BusinessAudience', audienceType: 'משרדים' },
        { '@type': 'BusinessAudience', audienceType: 'מבני ציבור' },
        { '@type': 'BusinessAudience', audienceType: 'בתי חולים' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'פתרונות BMS',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'אינטגרציית Siemens Desigo' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'בקרי DDC וממשקי HMI' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'בקרת תאורה DALI במערכות BMS' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'בקרת תאורה ומיזוג מבוססת KNX' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ניטור אנרגיה ודוחות תפעול' } },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'מה זה BMS ומה הוא עושה?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'BMS הוא מערכת ניהול ובקרה מרכזית למבנה. המנהל רואה את כל המבנה ממסך אחד ויכול לטפל בתקלות לפני שדיירים מרגישים.',
          },
        },
        {
          '@type': 'Question',
          name: 'כמה חוסך BMS באנרגיה?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'בפרויקטים מתאימים, מערכת BMS מתוכננת ומכוילת יכולה לסייע בחיסכון אנרגטי של כ-20-40%, בהתאם לסוג המבנה, מצב הציוד, שעות הפעילות, לוגיקת הבקרה והתחזוקה השוטפת.',
          },
        },
        {
          '@type': 'Question',
          name: 'איזה פרוטוקול עדיף — KNX או BACnet?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'KNX ו-BACnet אינם בהכרח חלופות. KNX מתאים לבקרה ברמת החדר, תאורה, חיישנים ותריסים; BACnet מקשר ציוד HVAC ובקרי DDC לשכבת הניהול. בפרויקטים רבים משלבים ביניהם, ובמידת הצורך מוסיפים LoRaWAN לחיישנים אלחוטיים.',
          },
        },
        {
          '@type': 'Question',
          name: 'איך i-feel עובדת עם Siemens Desigo?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'נכון ל-2026, i-feel היא Siemens Solution Partner בתחום Building Automation. החברה מטמיעה ומבצעת אינטגרציה של Siemens Desigo בפרויקטי BMS, לצד DDC, KNX, BACnet ו-Modbus.',
          },
        },
        {
          '@type': 'Question',
          name: 'כמה עולה מערכת בקרת מבנה?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'אין מחיר אחד למערכת בקרת מבנה. העלות נגזרת מגודל המבנה, ממספר נקודות הבקרה ומהמערכות שמשולבות. טווח ההשקעה הראשוני במבנה מסחרי נע בדרך כלל מעשרות אלפי שקלים למבנה קטן ועד מאות אלפי שקלים למבנה גדול ומורכב. המחיר המדויק נקבע פר-פרויקט לאחר סקר באתר ואפיון.',
          },
        },
        {
          '@type': 'Question',
          name: 'אפשר להוסיף BMS למבנה קיים?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'כן. Retrofit מתחיל בסקר של הבקרים, החיישנים, התקשורת והציוד הקיים. משמרים רכיבים תקינים, מחברים פרוטוקולים קיימים ומחליפים רק ציוד שאינו נתמך או אמין, בדרך כלל בשלבים כדי לצמצם השבתה.',
          },
        },
        {
          '@type': 'Question',
          name: 'איך בוחרים חברת בקרת מבנה?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'משווים ניסיון בפרויקטים דומים, שליטה בפרוטוקולים כמו KNX, BACnet ו-Siemens Desigo, יכולת תכנון פנימית ומחלקת שירות זמינה.',
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'דף הבית',
          item: 'https://i-feel.co.il/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'בקרת מבנה',
          item: pageUrl,
        },
      ],
    },
  ],
};

const daliBmsBlock = `
<section id="dali-lighting-control" class="not-prose bg-brand-50 border border-brand-100 rounded-2xl p-6 md:p-8 my-10">
  <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 mb-4">בקרת תאורה DALI כחלק ממערכת BMS</h2>
  <p class="text-lg leading-8 text-brand-700">אחד הרכיבים החשובים ביותר בפרויקט BMS מסחרי הוא שכבת בקרת התאורה. i-feel מתמחה בשילוב מערכות DALI בתוך ארכיטקטורת BMS מלאה: מחיבור ה-DALI gateway לבקרי DDC, דרך שילוב בשרת Siemens Desigo, ועד לתרחישי חיסכון אנרגטי מלאים.</p>
  <p class="text-lg leading-8 text-brand-700 mt-4">DALI מאפשר שליטה דיגיטלית נפרדת על כל גוף תאורה, עמעום לפי אור יום, כיבוי לפי חיישני נוכחות ודיווח על מצב ותקינות כל גוף. בפרויקטים כמו Amazon Sarona ורכבת קיסריה, DALI ותאורה חכמה משתלבים בתוך מערכת BMS עם KNX ו-Siemens Desigo.</p>
  <a href="/structure-control/dali-lighting-control/" class="inline-flex items-center justify-center bg-accent-500 hover:bg-accent-600 text-white px-6 py-3 rounded-lg font-bold shadow-lg mt-5">קראו עוד על בקרת תאורה DALI במערכות BMS ←</a>
</section>
`;

const featuredCaseStudiesBlock = `
<section id="featured-case-studies" class="not-prose my-10 rounded-2xl border border-brand-100 bg-white p-6 md:p-8 shadow-sm">
  <p class="text-sm font-bold tracking-wide text-accent-600 mb-2">הוכחות מהשטח</p>
  <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 mb-3">שלושה מקרי בוחן בבקרת מבנה</h2>
  <p class="text-lg leading-8 text-brand-700 mb-6">שלושה סוגי מבנים, שלוש ארכיטקטורות שונות — בקרת חדרי מלון, קמפוס רחב ומרכז רפואי.</p>
  <div class="grid gap-5 lg:grid-cols-3">
    <article class="rounded-xl border border-brand-100 bg-brand-50 p-5">
      <p class="text-sm font-bold text-accent-600 mb-2">מלונאות · KNX · Silverbyte</p>
      <h3 class="text-xl font-bold text-brand-900 mb-3"><a href="/structure-control/d-city-roxon-hotels/" class="hover:text-accent-600">D-CITY ו-ROXON</a></h3>
      <p class="text-brand-700 leading-7 mb-3"><strong>האתגר:</strong> בקרת חדרים אחידה, קידוד כרטיסים, תפעול שבת וחיבור למערכת המלונאית.</p>
      <p class="text-brand-700 leading-7 mb-4"><strong>הפתרון:</strong> KNX לבקרת תאורה ומיזוג, תרחישי תפוסה ואינטגרציה ל-Silverbyte.</p>
      <a href="/structure-control/d-city-roxon-hotels/" class="font-bold text-accent-600 hover:underline">למקרה הבוחן ←</a>
    </article>
    <article class="rounded-xl border border-brand-100 bg-brand-50 p-5">
      <p class="text-sm font-bold text-accent-600 mb-2">קמפוס · Siemens Desigo · DDC</p>
      <h3 class="text-xl font-bold text-brand-900 mb-3"><a href="/structure-control/caesarea-rail-campus/" class="hover:text-accent-600">קמפוס רכבת קיסריה</a></h3>
      <p class="text-brand-700 leading-7 mb-3"><strong>האתגר:</strong> ניהול מספר מבנים, צ׳ילרים, יט״א, מונים וצריכות אנרגיה בזמן אמת.</p>
      <p class="text-brand-700 leading-7 mb-4"><strong>הפתרון:</strong> BMS מרכזי מבוסס Siemens Desigo ו-DDC עם מגמות, דוחות והתראות.</p>
      <a href="/structure-control/caesarea-rail-campus/" class="font-bold text-accent-600 hover:underline">למקרה הבוחן ←</a>
    </article>
    <article class="rounded-xl border border-brand-100 bg-brand-50 p-5">
      <p class="text-sm font-bold text-accent-600 mb-2">בריאות · KNX · חיישני נוכחות</p>
      <h3 class="text-xl font-bold text-brand-900 mb-3"><a href="/hadassah-knx-system/" class="hover:text-accent-600">הדסה נתיבות</a></h3>
      <p class="text-brand-700 leading-7 mb-3"><strong>האתגר:</strong> צמצום הפעלה מיותרת של תאורה ומיזוג במרכז רפואי פעיל.</p>
      <p class="text-brand-700 leading-7 mb-4"><strong>הפתרון:</strong> מערכת KNX וכ-80 חיישני תנועה להפעלה לפי שימוש באזורים השונים.</p>
      <a href="/hadassah-knx-system/" class="font-bold text-accent-600 hover:underline">למקרה הבוחן ←</a>
    </article>
  </div>
</section>
`;

const enhancedContent = content
  .replace('<section id="case-studies"', `${featuredCaseStudiesBlock}<section id="case-studies"`)
  .replace('</div></article>', `${daliBmsBlock}</div></article>`);

const meta = {
  title: 'בקרת מבנה BMS | DDC, Siemens Desigo, KNX ו-DALI | i-feel',
  description:
    'בקרת מבנה BMS למלונות, משרדים, בתי חולים ומבני ציבור: תכנון, אינטגרציה והטמעה של DDC, Siemens Desigo, KNX, DALI, BACnet, Modbus וניטור אנרגיה.',
  canonical: pageUrl,
  ogTitle: 'בקרת מבנה BMS | DDC, Siemens Desigo, KNX ו-DALI | i-feel',
  ogDescription:
    'פתרונות BMS למבנים מסחריים וציבוריים: DDC, Siemens Desigo, KNX, DALI, BACnet, Modbus, חיסכון אנרגיה וניהול מרכזי.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(jsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={enhancedContent} />
</BaseLayout>
