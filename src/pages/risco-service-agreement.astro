---
import BaseLayout from '../layouts/BaseLayout.astro';
import sections from '../data/risco-agreement.json';
import signing from '../data/risco-signing.json';
const candidate = signing.powerFormUrl;
let signingUrl = '';
try {
  const url = new URL(candidate);
  if (url.protocol === 'https:' && /(^|\.)docusign\.(com|net)$/.test(url.hostname) && /powerform/i.test(url.pathname) && !url.username && !url.password) signingUrl = url.href;
} catch {}
const meta = {
 title: 'הסכם שירותי ענן ותמיכה מרחוק למערכת RISCO | i-feel',
 description: 'חבילת RISCO של i-feel ב־20 ₪ לחודש כולל מע״מ: גישה לשירותי ענן ותמיכה טלפונית מרחוק. פירוט השירות, ההחרגות ותנאי הפסקת השירות.',
 canonical: 'https://i-feel.co.il/risco-service-agreement/',
 ogTitle: 'שירותי ענן ותמיכה מרחוק למערכת RISCO | i-feel',
 ogDescription: 'גישה לענן ותמיכה מרחוק ב־20 ₪ לחודש כולל מע״מ. עיון בהסכם השירות.',
 ogUrl: 'https://i-feel.co.il/risco-service-agreement/',
 ogImage: 'https://i-feel.co.il/assets/og-cover.jpg'
};
---
<BaseLayout {...meta}>
 <main dir="rtl" class="bg-brand-50 text-brand-900">
  <section class="hero-gradient text-white">
   <div class="max-w-5xl mx-auto px-4 py-14">
    <a href="/risco-cloud-subscription/" class="text-brand-100 underline">להסבר על שירותי הענן של RISCO</a>
    <h1 class="text-3xl md:text-5xl font-extrabold mt-6 mb-5">הסכם שירותי ענן ותמיכה מרחוק למערכת RISCO</h1>
    <p class="text-xl leading-8">גישה לשירותי הענן ותמיכה טלפונית מרחוק מטעם i-feel, בעלות 20 ₪ לחודש כולל מע״מ.</p>
   </div>
  </section>
  <article class="max-w-5xl mx-auto px-4 py-10 space-y-6">
   <div class="rounded-2xl bg-white border border-brand-100 p-6">
    <h2 class="text-2xl font-bold mb-3">עיון בהסכם והצטרפות</h2>
    <p class="leading-8 mb-4">השירות חל על מערכת האזעקה שתפורט בהסכם החתום. תחילת השירות והחיוב תאושר בכתב לאחר בדיקת התאמה ושיוך המנוי.</p>
    <div class="flex flex-wrap gap-3">
     <a href="/assets/documents/ifeel-risco-cloud-agreement.pdf" class="bg-brand-900 text-white rounded-xl px-5 py-3 font-bold">הורדת ההסכם ב־PDF</a>
     {signingUrl ? <a href={signingUrl} class="bg-accent-500 text-white rounded-xl px-5 py-3 font-bold">מילוי פרטים וחתימה ב־Docusign</a> : <a href="mailto:support@i-feel.co.il?subject=הצטרפות%20לחבילת%20ריסקו" class="border border-brand-300 rounded-xl px-5 py-3 font-bold">קבלת קישור חתימה ממחלקת השירות</a>}
    </div>
   </div>
   <p class="leading-8">נותן השירות: i-feel, אימבר 14, פתח תקווה. טלפון <a href="tel:+972-3-508-9553" class="underline" dir="ltr">03-508-9553</a>.</p>
   {sections.map(([title, paragraphs], index) => <section class="bg-white border border-brand-100 rounded-2xl p-6" aria-labelledby={`agreement-${index}`}>
    <h2 id={`agreement-${index}`} class="text-2xl font-bold mb-4">{index + 1}. {title}</h2>
    {paragraphs.map((text) => <p class="leading-8 mb-3">{text}</p>)}
   </section>)}
  </article>
 </main>
</BaseLayout>
