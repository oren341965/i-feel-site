---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/home-technology-center/';
const title = 'מרכז המידע לטכנולוגיות הבית | i-feel';
const description = 'מדריכים, שאלות ותשובות, מפרטים, קטלוגים וסרטונים על מערכות הבית: חשמל ואנרגיה, מיזוג, תאורה, הצללה, אבטחה, תקשורת, אודיו ובקרה.';

const categories = [
  {
    title: 'בקרה ואוטומציה',
    description: 'איך מערכות שונות בבית מתקשרות, מתוזמנות ונשלטות יחד — מבית חכם ועד בקרת מבנה.',
    topics: ['KNX לבית חכם קווי', 'מערכות אלחוטיות ושדרוג דירה קיימת', 'BMS, DDC ופרוטוקולי אינטגרציה'],
    links: [
      { label: 'בית חכם KNX', href: '/knx-smart-home/' },
      { label: 'בית חכם אלחוטי בדירה קיימת', href: '/wireless-smart-home-existing-apartment/' },
      { label: 'מרכז הידע Siemens BMS', href: '/siemens-bms-knowledge-center/' },
      { label: 'בקרי DDC', href: '/ddc-controllers-bms/' },
    ],
  },
  {
    title: 'חשמל, אנרגיה ואגירה',
    description: 'תשתיות חשמל, ציוד, גיבוי וניהול צריכת האנרגיה — מהתכנון ועד לבחירת רכיבים.',
    topics: ['ציוד ומפרטים טכניים', 'גיבוי חשמלי ואל-פסק', 'אנרגיה סולארית ואגירה ביתית'],
    links: [
      { label: 'מאגר ציוד לפי דגם ומק״ט', href: '/equipment/' },
      { label: 'קטלוגים ומסמכים', href: '/catalogs/' },
      { label: 'בנייה ירוקה', href: '/green-building/' },
    ],
  },
  {
    title: 'מיזוג, אוורור ונוחות אקלימית',
    description: 'חיבור מערכות המיזוג והאוורור לבקרה, לחיישנים ולתרחישים בבית או בבניין.',
    topics: ['מיזוג VRF ואינטגרציה', 'בקרת HVAC', 'מערכות ניהול לבניינים'],
    links: [
      { label: 'איך מחברים BMS למיזוג VRF?', href: '/answers/bms-vrf-integration/' },
      { label: 'מהי מערכת BMS?', href: '/answers/what-is-bms/' },
      { label: 'בקרת מבנה', href: '/structure-control/' },
    ],
  },
  {
    title: 'תאורה והצללה',
    description: 'בחירת גופי תאורה ובקרים, עמעמים, וילונות ותריסים — והדרך לתאם ביניהם.',
    topics: ['תאורת KNX ו-DALI', 'עמעום ותאורה דינמית', 'תריסים והצללות'],
    links: [
      { label: 'תכנון תאורה חכמה', href: '/smart-lighting/' },
      { label: 'מה זה DALI?', href: '/answers/what-is-dali/' },
      { label: 'תאורת DMX לבית', href: '/dmx-home-lighting/' },
    ],
  },
  {
    title: 'אבטחה, בטיחות וכניסה',
    description: 'מערכות שמגינות על הבית ומנהלות כניסה: אזעקה, מצלמות, אינטרקום וגילוי אירועים.',
    topics: ['אזעקות ומצלמות', 'אינטרקום ובקרת כניסה', 'גילוי נזילות וחיישני בטיחות'],
    links: [
      { label: 'מערכת אזעקה אלחוטית', href: '/wireless-alarm-system/' },
      { label: 'מדריכים למערכת RISCO', href: '/risco-cloud-subscription/' },
      { label: 'אינטרקום Akuvox', href: '/akuvox-mega-250/' },
      { label: 'גלאי נזילת מים ABB', href: '/equipment/abb-swm4-rn-water-leak-detector/' },
    ],
  },
  {
    title: 'תקשורת ורשת ביתית',
    description: 'התשתית שמאפשרת למערכות הבית, למחשבים ולמכשירים מחוברים לתקשר בצורה יציבה.',
    topics: ['רשתות תקשורת', 'Wi-Fi ותכנון נקודות גישה', 'חיבור מערכות צד שלישי'],
    links: [
      { label: 'רשתות תקשורת לבית ולמבנה', href: '/communication-networks/' },
      { label: 'מותגים וטכנולוגיות', href: '/brands-and-technologies/' },
    ],
  },
  {
    title: 'אודיו, וידאו וקולנוע ביתי',
    description: 'מערכות שמע, מסכים ומקרנים — מתכנון התשתית ועד להפעלה משולבת.',
    topics: ['אודיו רב-אזורי', 'קולנוע ביתי ומקרנים', 'מסכים ותכנון נגרות'],
    links: [
      { label: 'מערכות אודיו וסאונד', href: '/audio-and-sound-systems/' },
      { label: 'גלריית חדר קולנוע ביתי', href: '/gallery/home-cinema-room/' },
      { label: 'התקנת מעלית למקרן', href: '/projector-lift-installation/' },
    ],
  },
  {
    title: 'תכנון, שדרוג ושירות',
    description: 'מידע לפי שלב הפרויקט: בנייה חדשה, שיפוץ, מעבר לדירה או שדרוג מערכת קיימת.',
    topics: ['תכנון תשתיות לפני הבנייה', 'בדיקת מערכת קיימת', 'תחזוקה, תפעול ותמיכה'],
    links: [
      { label: 'תכנון בית חכם', href: '/smart-home-planning/' },
      { label: 'תשתית נכונה לבית', href: '/right-infrastructure-for-a-smart-home/' },
      { label: 'שירות ותחזוקה', href: '/service-and-maintenance/' },
    ],
  },
];

const knowledgeTypes = [
  { title: 'מדריכים ותשובות', href: '/answers/', description: 'הסברים פשוטים לצד תשובות מקצועיות למונחים ולשאלות נפוצות.' },
  { title: 'מוצרים ומפרטים', href: '/equipment/', description: 'דגמים, מק״טים, שימושים וקישורים למסמכי יצרן.' },
  { title: 'קטלוגים ומסמכים', href: '/catalogs/', description: 'מסמכי PDF וחומרי תכנון ממקורות יצרן.' },
  { title: 'סרטונים והדרכות', href: '/video/', description: 'הדגמות, הסברים ותיעוד של מערכות.' },
  { title: 'פרויקטים מהשטח', href: '/projects/', description: 'דוגמאות למערכות ולפתרונות בפרויקטים שהושלמו.' },
];

const faqItems = [
  {
    question: 'מה כולל מרכז המידע לטכנולוגיות הבית?',
    answer: 'המרכז אוסף מידע על המערכות והתשתיות בבית — חשמל ואנרגיה, מיזוג, תאורה והצללה, אבטחה, כניסה, תקשורת, אודיו-וידאו ובקרה — לצד מדריכים, מפרטים, קטלוגים, סרטונים ופרויקטים.',
  },
  {
    question: 'האם כל בית צריך מערכת בית חכם?',
    answer: 'לא. לכל בית יש מערכות ותשתיות טכנולוגיות, אך לא כל מערכת חייבת להיות אוטומטית או מחוברת למערכת שליטה מרכזית. הבחירה תלויה בצרכים, בתשתית, בתקציב ובשלב שבו נמצא הפרויקט.',
  },
  {
    question: 'איך בודקים אם מערכות שונות יכולות לעבוד יחד?',
    answer: 'בודקים את הדגמים והגרסאות, ממשקי התקשורת, פרוטוקולי האינטגרציה ותיעוד היצרן. התאמה לפרויקט מסוים דורשת בדיקת תכנון והתקנה ואינה נקבעת רק לפי שם הפרוטוקול.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical + '#collection',
      name: title,
      description,
      url: canonical,
      inLanguage: 'he-IL',
      dateModified: '2026-10-09',
      about: ['טכנולוגיות הבית', 'בית חכם', 'חשמל', 'אנרגיה', 'מיזוג', 'תאורה', 'הצללה', 'אבטחה', 'תקשורת', 'אודיו-וידאו', 'KNX', 'BMS'],
      hasPart: categories.flatMap((category) => category.links.map((link) => ({ '@type': 'ListItem', name: link.label, url: 'https://i-feel.co.il' + link.href }))),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'מרכז המידע לטכנולוגיות הבית', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': canonical + '#faq',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
});
---

<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl={canonical} jsonLd={jsonLd}>
  <div dir="rtl">
    <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם">
      <div class="max-w-7xl mx-auto px-4 py-3 text-sm">
        <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
        <span class="mx-2 text-brand-400">›</span>
        <span class="text-brand-900 font-medium">מרכז המידע לטכנולוגיות הבית</span>
      </div>
    </nav>

    <section class="bg-brand-900 text-white py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4">
        <p class="text-accent-400 font-bold mb-3">מדריכים · מוצרים · מערכות · פרויקטים</p>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-5">מרכז המידע לטכנולוגיות הבית</h1>
        <p class="max-w-4xl text-lg md:text-xl text-brand-100 leading-8">בית הוא מכלול של מערכות: חשמל ואנרגיה, מיזוג, תאורה, הצללה, אבטחה, תקשורת, אודיו ובקרה. כאן אפשר להכיר כל מערכת בפני עצמה ולהבין איך היא משתלבת עם שאר הבית — גם כשהפתרון אינו “בית חכם” מלא.</p>
        <div class="flex flex-wrap gap-3 mt-7">
          <a href="/answers/" class="rounded-lg bg-accent-500 px-5 py-3 font-bold text-white hover:bg-accent-600">חיפוש תשובות ומדריכים</a>
          <a href="/equipment/" class="rounded-lg border border-white/40 px-5 py-3 font-bold text-white hover:bg-white/10">עיון במאגר הציוד</a>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 py-10 md:py-14">
      <div class="max-w-4xl mb-8">
        <p class="text-accent-700 font-bold mb-2">מפת הטכנולוגיות בבית</p>
        <h2 class="text-3xl font-extrabold text-brand-900 mb-3">מתשתית אחת למערכת שעובדת יחד</h2>
        <p class="text-brand-700 leading-7">מערכת בקרה יכולה לחבר בין חלק מהטכנולוגיות, אך אינה מחליפה את התכנון, המפרט או האחריות של כל מערכת בנפרד. התחילו בנושא שמעניין אתכם ועברו למדריכים ולמסמכים הקיימים.</p>
      </div>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
        {categories.map((category) => (
          <article class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-extrabold text-brand-900 mb-2">{category.title}</h3>
            <p class="text-brand-700 leading-7 mb-4">{category.description}</p>
            <ul class="list-disc pr-5 mb-5 space-y-1 text-sm text-brand-600">
              {category.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <div class="flex flex-wrap gap-x-4 gap-y-2 border-t border-brand-100 pt-4">
              {category.links.map((link) => <a href={link.href} class="font-bold text-accent-700 hover:text-accent-800 underline underline-offset-2">{link.label}</a>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-brand-50 border-y border-brand-100 py-12 md:py-14">
      <div class="max-w-7xl mx-auto px-4">
        <p class="text-accent-700 font-bold mb-2">איך המידע מסודר</p>
        <h2 class="text-3xl font-extrabold text-brand-900 mb-7">בחרו את סוג התוכן שמתאים לכם</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {knowledgeTypes.map((item) => (
            <a href={item.href} class="rounded-xl border border-brand-100 bg-white p-5 hover:border-accent-400 hover:shadow-sm transition">
              <h3 class="font-extrabold text-brand-900 mb-2">{item.title}</h3>
              <p class="text-sm leading-6 text-brand-700">{item.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 py-12 md:py-16">
      <h2 class="text-3xl font-extrabold text-brand-900 mb-5">שאלות נפוצות</h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <article class="rounded-xl border border-brand-100 p-5">
            <h3 class="font-extrabold text-brand-900 mb-2">{item.question}</h3>
            <p class="text-brand-700 leading-7">{item.answer}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 text-brand-700">לא מצאתם את המידע שאתם צריכים? <a href="/contactus/" class="font-bold text-accent-700 underline">פנו אלינו</a> או חפשו באתר.</p>
    </section>
  </div>
</BaseLayout>
