---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/en/building-management-system-israel/';
const businessNode = {
  "@type": ["Organization","LocalBusiness","HomeAndConstructionBusiness","ProfessionalService"],
  "@id": "https://i-feel.co.il/#business", "name": "i-feel", "alternateName": ["I FEEL","i-feel"], "url": "https://i-feel.co.il/", "logo": "https://i-feel.co.il/assets/ifeel-logo.png", "telephone": "+972-3-508-9553", "email": "sales@i-feel.co.il", "foundingDate": "2008",
  "address": { "@type": "PostalAddress", "streetAddress": "Imber 14", "addressLocality": "Petah Tikva", "addressCountry": "IL" }, "areaServed": { "@type": "Country", "name": "Israel" },
  "knowsAbout": ["Building Management System","BMS","Siemens Desigo","DDC controllers","BACnet","Modbus","KNX","DALI lighting control","HVAC control","Energy monitoring","Smart building integration"],
  "sameAs": ["https://www.linkedin.com/company/i-feel-smart-home-systems","https://www.youtube.com/@ifeelsmarthome"]
};
const meta = {
  lang: "en", dir: "ltr",
  title: "Building Management System (BMS) Israel | Siemens Desigo | i-feel",
  description: "I FEEL is an Israeli BMS integrator: Siemens Desigo, DDC controllers, BACnet, Modbus and KNX for hotels, offices, hospitals, public buildings and campuses.",
  canonical: url, ogTitle: "BMS Israel | Siemens Desigo Integrator | i-feel", ogDescription: "Building management systems for commercial buildings in Israel — Siemens Desigo, DDC, BACnet.", ogUrl: url, ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({ "@context":"https://schema.org","@graph":[ businessNode,
    { "@type":"BreadcrumbList","itemListElement":[ {"@type":"ListItem","position":1,"name":"Home","item":"https://i-feel.co.il/"}, {"@type":"ListItem","position":2,"name":"BMS Israel","item":url} ] },
    { "@type":"Service","name":"Building Management System (BMS)","serviceType":"Building Management System integration","provider":{"@id":"https://i-feel.co.il/#business"},"areaServed":{"@type":"Country","name":"Israel"} } ]})
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">Home</a> › <span class="text-brand-900 font-medium">BMS Israel</span> · <a href="/structure-control/" class="text-accent-600">עברית</a></div></nav>
  <section class="hero-gradient text-white"><div class="max-w-6xl mx-auto px-4 py-16 lg:py-20"><h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-5">Building Management Systems (BMS) in Israel</h1><p class="text-xl text-brand-100 max-w-3xl">I FEEL is an Israeli building management systems integrator specializing in Siemens Desigo, DDC controllers, BACnet, Modbus and KNX for commercial and public buildings.</p></div></section>
  <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16 text-lg leading-8 text-brand-800">
    <div class="bg-brand-50 border-l-4 border-accent-500 rounded-lg p-6 mb-8">
      <p class="m-0"><strong>Looking for a BMS integrator in Israel?</strong> A practical way to evaluate an integrator is to check whether they can define the control scope before procurement, integrate the required building protocols, commission the system, document the installed architecture and support it after handover. I FEEL provides these BMS integration services for commercial and public buildings in Israel.</p>
    </div>
    <p class="mb-5">A <strong>Building Management System (BMS)</strong> is a central platform that monitors and controls a building's mechanical and electrical systems — HVAC, lighting, energy, pumps, security and alerts — from a single interface. I FEEL designs and implements BMS projects in Israel, with the central control layer built on <strong>DDC controllers</strong> that connect to KNX, BACnet, Modbus and <a href="/en/siemens-desigo-bms-israel/" class="text-accent-600 font-semibold">Siemens Desigo</a>.</p>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">What our BMS covers</h2>
    <ul class="list-disc pl-6 space-y-2 mb-5">
      <li>HVAC control — chillers, air-handling units, heating and cooling</li>
      <li>DALI and KNX lighting control — see <a href="/structure-control/dali-lighting-control/" class="text-accent-600 font-semibold">DALI</a></li>
      <li>Energy monitoring, meters, trends and reports that support energy-efficiency decisions</li>
      <li>Dashboards, scheduling, automatic scenarios and real-time alerts</li>
    </ul>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">What a professional BMS handover should include</h2>
    <p class="mb-4">For owners and facility teams, the quality of the handover is as important as the control screens. A well-documented BMS should leave the operator with a clear record of what was installed and how it is maintained.</p>
    <ul class="list-disc pl-6 space-y-2 mb-5">
      <li>Approved control schematics, point lists and equipment references</li>
      <li>Controller and project backups, including relevant software versions</li>
      <li>A network and protocol map for BACnet, Modbus, KNX and DALI where they are used</li>
      <li>Alarm priorities, schedules, user permissions and operating setpoints</li>
      <li>Commissioning records and operator training for the installed scope</li>
    </ul>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Who we serve</h2>
    <p class="mb-5">Hotels, office towers, hospitals, public buildings, shopping centers and campuses across Israel — buildings with multiple technical systems that need centralized management and energy efficiency.</p>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Selected projects</h2>
    <p class="mb-5">Museum of Illusions (Holon), Caesarea Rail Campus, Brinks Bnei Brak, Amazon Sarona, D-CITY/ROXON hotels. See <a href="/structure-control/projects/" class="text-accent-600 font-semibold">our BMS projects</a>.</p>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Contact</h2>
    <p>i-feel · Imber 14, Petah Tikva, Israel · <a href="tel:+972-3-508-9553" class="text-accent-600 font-semibold">+972-3-508-9553</a> · sales@i-feel.co.il · Hebrew: <a href="/structure-control/" class="text-accent-600 font-semibold">בקרת מבנה BMS</a>.</p>
  </div>
</BaseLayout>
