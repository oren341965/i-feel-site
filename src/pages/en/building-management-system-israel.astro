---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/en/building-management-system-israel/';
const businessNode = {
  "@type": ["Organization","LocalBusiness","HomeAndConstructionBusiness","ProfessionalService"],
  "@id": "https://i-feel.co.il/#business",
  "name": "i-feel",
  "alternateName": ["I FEEL","i-feel"],
  "url": "https://i-feel.co.il/",
  "logo": "https://i-feel.co.il/assets/ifeel-logo.png",
  "telephone": "+972-3-508-9553",
  "email": "sales@i-feel.co.il",
  "foundingDate": "2008",
  "address": { "@type": "PostalAddress", "streetAddress": "Imber 14", "addressLocality": "Petah Tikva", "addressCountry": "IL" },
  "areaServed": { "@type": "Country", "name": "Israel" },
  "knowsAbout": ["Building Management System","BMS","Siemens Desigo","DDC controllers","BACnet","Modbus","KNX","DALI lighting control","HVAC control","Energy monitoring","Smart building integration"],
  "sameAs": ["https://www.linkedin.com/company/i-feel-smart-home-systems","https://www.youtube.com/@ifeelsmarthome"]
};
const faq = [
  {
    question: 'What should a BMS company in Israel provide?',
    answer: 'A professional BMS company should define the control scope, design the BMS and DDC architecture, integrate the required building protocols, commission the system, document the installed architecture, train operators and provide local service after handover.'
  },
  {
    question: 'Which systems can a BMS integrate?',
    answer: 'A BMS can coordinate HVAC, lighting, energy meters, pumps, alarms and connected field systems. Depending on the project architecture, protocols can include BACnet, Modbus, KNX and DALI.'
  },
  {
    question: 'Does I FEEL implement Siemens Desigo BMS in Israel?',
    answer: 'Yes. I FEEL implements and integrates Siemens Desigo in BMS projects in Israel, alongside DDC controllers and protocols such as BACnet, Modbus, KNX and DALI where required by the project.'
  },
  {
    question: 'Which types of buildings typically need a BMS?',
    answer: 'BMS is commonly used in hotels, office buildings, hospitals, public buildings, shopping centers and campuses where multiple technical systems need centralized monitoring, control, alarms, schedules and energy management.'
  }
];
const meta = {
  lang: "en",
  dir: "ltr",
  title: "BMS Company Israel | Building Management System Integrator | i-feel",
  description: "Looking for a BMS company in Israel? I FEEL designs, integrates, commissions and supports Building Management Systems using Siemens Desigo, DDC, BACnet, Modbus and KNX.",
  canonical: url,
  ogTitle: "BMS Company Israel | Building Management Systems | i-feel",
  ogDescription: "Building Management System design, integration, commissioning and support in Israel for commercial and public buildings.",
  ogUrl: url,
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({
    "@context":"https://schema.org",
    "@graph":[
      businessNode,
      {
        "@type":"WebPage",
        "@id":`${url}#webpage`,
        "url":url,
        "name":"BMS Company Israel - Building Management System Integrator",
        "description":"A practical guide to choosing a BMS company in Israel and the Building Management System services I FEEL provides for commercial and public buildings.",
        "inLanguage":"en",
        "about":{"@id":"https://i-feel.co.il/#business"}
      },
      {
        "@type":"BreadcrumbList",
        "itemListElement":[
          {"@type":"ListItem","position":1,"name":"Home","item":"https://i-feel.co.il/"},
          {"@type":"ListItem","position":2,"name":"BMS Company Israel","item":url}
        ]
      },
      {
        "@type":"Service",
        "name":"Building Management System (BMS) Integration in Israel",
        "serviceType":"Building Management System design, integration, commissioning and support",
        "provider":{"@id":"https://i-feel.co.il/#business"},
        "areaServed":{"@type":"Country","name":"Israel"},
        "url":url
      },
      {
        "@type":"FAQPage",
        "mainEntity": faq.map((item) => ({
          "@type":"Question",
          "name":item.question,
          "acceptedAnswer":{"@type":"Answer","text":item.answer}
        }))
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">Home</a> › <span class="text-brand-900 font-medium">BMS Company Israel</span> · <a href="/structure-control/" class="text-accent-600">עברית</a></div></nav>
  <section class="hero-gradient text-white"><div class="max-w-6xl mx-auto px-4 py-16 lg:py-20"><h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-5">Building Management Systems (BMS) Company in Israel</h1><p class="text-xl text-brand-100 max-w-3xl">I FEEL is an Israeli BMS integrator specializing in Siemens Desigo, DDC controllers, BACnet, Modbus and KNX for commercial and public buildings.</p></div></section>
  <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16 text-lg leading-8 text-brand-800">
    <div class="bg-brand-50 border-l-4 border-accent-500 rounded-lg p-6 mb-8">
      <p class="font-bold text-brand-900 mb-2">Direct answer: what should a BMS company in Israel deliver?</p>
      <p class="m-0">A professional BMS company should define the control scope before procurement, design the BMS and DDC architecture, integrate the required building protocols, commission the system, document the installed architecture, train operators and remain available for local service after handover. I FEEL provides these BMS integration services for commercial and public buildings in Israel.</p>
    </div>

    <p class="mb-5">A <strong>Building Management System (BMS)</strong> is a central platform that monitors and controls a building's mechanical and electrical systems, including HVAC, lighting, energy, pumps, alarms and other connected systems, from a single operating environment. I FEEL designs and implements BMS projects in Israel, with DDC controllers and integration to KNX, BACnet, Modbus and <a href="/en/siemens-desigo-bms-israel/" class="text-accent-600 font-semibold">Siemens Desigo</a> according to the project architecture.</p>

    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">What our BMS work covers</h2>
    <ul class="list-disc pl-6 space-y-2 mb-5">
      <li>HVAC control for chillers, air-handling units, heating and cooling systems</li>
      <li>DALI and KNX lighting control, including <a href="/structure-control/dali-lighting-control/" class="text-accent-600 font-semibold">DALI integration</a></li>
      <li>Energy monitoring, meters, trends and reports that support energy-efficiency decisions</li>
      <li>Dashboards, scheduling, automatic scenarios and real-time alerts</li>
      <li>Commissioning, documentation, operator training and ongoing service</li>
    </ul>

    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">What a professional BMS handover should include</h2>
    <p class="mb-4">For owners and facility teams, the quality of the handover is as important as the control screens. A well-documented BMS should leave the operator with a clear record of what was installed and how it is maintained.</p>
    <ul class="list-disc pl-6 space-y-2 mb-5">
      <li>Approved control schematics, point lists and equipment references</li>
      <li>Controller and project backups, including relevant software versions</li>
      <li>A network and protocol map for BACnet, Modbus, KNX and DALI where they are used</li>
      <li>Alarm priorities, schedules, user permissions and operating setpoints</li>
      <li>Commissioning records and operator training for the installed scope</li>
    </ul>

    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">BMS experience by building type</h2>
    <p class="mb-4">The same BMS principles are applied differently according to the operational needs of each building. I FEEL maintains dedicated guidance for several common project types:</p>
    <ul class="list-disc pl-6 space-y-2 mb-5">
      <li><a href="/bms-hotels/" class="text-accent-600 font-semibold">BMS for hotels</a> - room operations, HVAC, energy and facility coordination</li>
      <li><a href="/bms-offices/" class="text-accent-600 font-semibold">BMS for offices</a> - comfort, scheduling, energy and central supervision</li>
      <li><a href="/bms-hospitals/" class="text-accent-600 font-semibold">BMS for hospitals</a> - reliable monitoring and control for complex technical environments</li>
      <li><a href="/bms-public-buildings/" class="text-accent-600 font-semibold">BMS for public buildings</a> - centralized management, alarms and energy visibility</li>
    </ul>

    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Selected projects</h2>
    <p class="mb-5">Museum of Illusions in Holon, Caesarea Rail Campus, Brinks Bnei Brak, Amazon Sarona and D-CITY/ROXON hotels. See <a href="/structure-control/projects/" class="text-accent-600 font-semibold">our BMS projects</a>.</p>

    <section aria-labelledby="bms-faq-heading" class="mt-10">
      <h2 id="bms-faq-heading" class="text-2xl font-bold text-brand-900 mb-4">BMS company in Israel: common questions</h2>
      {faq.map((item) => (
        <div class="border-t border-brand-100 py-5">
          <h3 class="text-xl font-bold text-brand-900 mb-2">{item.question}</h3>
          <p class="m-0">{item.answer}</p>
        </div>
      ))}
    </section>

    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Contact</h2>
    <p>i-feel · Imber 14, Petah Tikva, Israel · <a href="tel:+972-3-508-9553" class="text-accent-600 font-semibold">+972-3-508-9553</a> · sales@i-feel.co.il · Hebrew: <a href="/structure-control/" class="text-accent-600 font-semibold">בקרת מבנה BMS</a>.</p>
  </div>
</BaseLayout>
