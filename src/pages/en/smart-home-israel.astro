  "foundingDate": "2008",
  "address": { "@type": "PostalAddress", "streetAddress": "Imber 14", "addressLocality": "Petah Tikva", "addressCountry": "IL" },
  "areaServed": { "@type": "Country", "name": "Israel" },
  "knowsAbout": ["Smart Home","KNX","Building Management System","Siemens Desigo","DALI lighting control","DDC controllers","BACnet","Modbus","Home automation","Smart building integration"],
  "sameAs": ["https://www.facebook.com/SmarthomeIsrael","https://www.instagram.com/ifeelisrael","https://www.linkedin.com/company/i-feel-smart-home-systems","https://www.youtube.com/@ifeelsmarthome"]
};
const pageDescription = "I FEEL is a smart home company and KNX integrator in Israel, providing planning, installation, programming, integration and local service for villas, apartments and building automation projects.";
const meta = {
  lang: "en", dir: "ltr",
  title: "Smart Home Company Israel | KNX Integrator | I FEEL",
  description: pageDescription,
  canonical: url,
  ogTitle: "Smart Home Company Israel | KNX Integrator | I FEEL",
  ogDescription: "Israeli smart home company and systems integrator specializing in KNX, building automation, DALI and long-term local service.",
  ogUrl: url,
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({ "@context":"https://schema.org","@graph":[
    businessNode,
    { "@type":"BreadcrumbList","itemListElement":[ {"@type":"ListItem","position":1,"name":"Home","item":"https://i-feel.co.il/"}, {"@type":"ListItem","position":2,"name":"Smart Home Company Israel","item":url} ] },
    { "@type":"WebPage", "@id":`${url}#webpage`, "url":url, "name":"Smart Home Company Israel | KNX Integrator | I FEEL", "description":pageDescription, "inLanguage":"en-IL", "about":{"@id":"https://i-feel.co.il/#business"}, "dateModified":"2026-09-09", "mainEntity":{"@id":`${url}#service`} },
    { "@type":"Service", "@id":`${url}#service`, "name":"Smart Home Integration in Israel", "serviceType":"KNX Smart Home Integration", "description":"Planning, installation, programming, integration and support for smart home systems in Israel.", "provider":{"@id":"https://i-feel.co.il/#business"}, "areaServed":{"@type":"Country","name":"Israel"} },
    { "@type":"FAQPage","mainEntity":[
      { "@type":"Question","name":"How should I choose a smart home company in Israel?","acceptedAnswer":{"@type":"Answer","text":"Evaluate the integrator, not only the product brand. Look for KNX experience, documented electrical and control planning, integration of lighting, HVAC, security, intercom and audio, clear programming responsibility, handover documentation and long-term local service."} },
