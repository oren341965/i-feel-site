---
import BaseLayout from '../../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/en/siemens-desigo-bms-israel/';
const businessNode = {
  "@type": ["Organization","LocalBusiness","HomeAndConstructionBusiness","ProfessionalService"],
  "@id": "https://i-feel.co.il/#business", "name": "i-feel", "alternateName": ["I FEEL","i-feel"], "url": "https://i-feel.co.il/", "logo": "https://i-feel.co.il/assets/ifeel-logo.png", "telephone": "+972-3-508-9553", "email": "sales@i-feel.co.il", "foundingDate": "2008",
  "address": { "@type": "PostalAddress", "streetAddress": "Imber 14", "addressLocality": "Petah Tikva", "addressCountry": "IL" }, "areaServed": { "@type": "Country", "name": "Israel" },
  "knowsAbout": ["Siemens Desigo","Building Management System","BMS","DDC controllers","BACnet","Modbus","KNX","DALI lighting control","HVAC control","Energy monitoring"],
  "sameAs": ["https://www.linkedin.com/company/200156","https://www.youtube.com/@ifeelsmarthome"]
};
const meta = {
  lang: "en", dir: "ltr",
  title: "Siemens Desigo BMS Israel | Desigo Integrator | i-feel",
  description: "I FEEL implements and integrates Siemens Desigo building management systems in Israel — for hotels, offices, hospitals and public buildings, alongside DDC, BACnet, Modbus and KNX.",
  canonical: url, ogTitle: "Siemens Desigo BMS Israel | i-feel", ogDescription: "Siemens Desigo BMS integration in Israel — central building management.", ogUrl: url, ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({ "@context":"https://schema.org","@graph":[ businessNode,
    { "@type":"BreadcrumbList","itemListElement":[ {"@type":"ListItem","position":1,"name":"Home","item":"https://i-feel.co.il/"}, {"@type":"ListItem","position":2,"name":"Siemens Desigo BMS Israel","item":url} ] },
    { "@type":"Service","name":"Siemens Desigo Integration","serviceType":"Siemens Desigo BMS integration","provider":{"@id":"https://i-feel.co.il/#business"},"areaServed":{"@type":"Country","name":"Israel"} } ]})
};
---
<BaseLayout {...meta}>
  <nav class="bg-brand-50 border-b border-brand-100"><div class="max-w-7xl mx-auto px-4 py-3 text-sm"><a href="/" class="text-brand-600 hover:text-accent-600">Home</a> › <span class="text-brand-900 font-medium">Siemens Desigo BMS Israel</span> · <a href="/siemens-desigo-bms/" class="text-accent-600">עברית</a></div></nav>
  <section class="hero-gradient text-white"><div class="max-w-6xl mx-auto px-4 py-16 lg:py-20"><h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-5">Siemens Desigo BMS in Israel</h1><p class="text-xl text-brand-100 max-w-3xl">I FEEL implements and integrates Siemens Desigo building management systems in Israel, alongside DDC controllers, BACnet, Modbus and KNX — for commercial and public buildings.</p></div></section>
  <div class="max-w-4xl mx-auto px-4 py-12 lg:py-16 text-lg leading-8 text-brand-800">
    <p class="mb-5"><strong>Siemens Desigo</strong> is a leading building management platform for large commercial buildings. Desigo CC can manage hundreds of thousands of control points from a single console, with native support for BACnet, KNX and Modbus. I FEEL implements and integrates Siemens Desigo in BMS projects across Israel.</p>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Where Desigo fits</h2>
    <p class="mb-5">Siemens Desigo serves as the central management server for the whole building, while <a href="/en/knx-integrator-israel/" class="text-accent-600 font-semibold">KNX</a> handles room-level control (lighting, shutters, climate). In a full <a href="/en/building-management-system-israel/" class="text-accent-600 font-semibold">BMS</a>, the control layer is built on DDC controllers, with Desigo as the management server — they work together, not in competition.</p>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">What we deliver</h2>
    <ul class="list-disc pl-6 space-y-2 mb-5">
      <li>HVAC, energy and lighting management from one interface</li>
      <li>Integration of BACnet, Modbus, KNX and DALI under Desigo</li>
      <li>Energy monitoring, dashboards, alerts and trend reports</li>
      <li>Commissioning and Hebrew documentation</li>
    </ul>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Best for</h2>
    <p class="mb-5">Hotels, office towers, hospitals, public buildings and campuses in Israel that need centralized, reliable, energy-efficient building management.</p>
    <h2 class="text-2xl font-bold text-brand-900 mt-8 mb-3">Contact</h2>
    <p>i-feel · Imber 14, Petah Tikva, Israel · <a href="tel:+972-3-508-9553" class="text-accent-600 font-semibold">+972-3-508-9553</a> · sales@i-feel.co.il · Hebrew: <a href="/siemens-desigo-bms/" class="text-accent-600 font-semibold">Siemens Desigo BMS</a>, <a href="/structure-control/" class="text-accent-600 font-semibold">בקרת מבנה</a>.</p>
  </div>
</BaseLayout>
