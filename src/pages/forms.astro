---
import BaseLayout from '../layouts/BaseLayout.astro';
import forms from '../data/form-signing.json';
import { getSigningUrl } from '../utils/form-signing.mjs';
const meta={title:'טפסים והסכמים ללקוחות | i-feel',description:'מרכז הטפסים של i-feel: תנאי הזמנה למערכות KNX, Z-Wave ומתח נמוך, הסכם שירות והסכם ריסקו. עיון מסודר ומצב זמינות החתימה בכל טופס.',canonical:'https://i-feel.co.il/forms/',ogTitle:'טפסים והסכמים ללקוחות | i-feel',ogDescription:'כל ההסכמים והטפסים במקום אחד, לפי סוג השירות והמערכת.',ogUrl:'https://i-feel.co.il/forms/',ogImage:'https://i-feel.co.il/assets/og-cover.jpg'};
const groups=[{title:'תנאים להזמנת מערכת',description:'בחרו את סוג המערכת שמופיע בהצעת המחיר שלכם.',keys:['knx','zwave','low-voltage']},{title:'שירות ותמיכה',description:'הסכמים לשירות שוטף ולגישה לשירותי הענן.',keys:['service','risco']}];
---
<BaseLayout {...meta}>
<main dir="rtl" class="forms-page">
 <header class="forms-hero"><div><a href="/service-and-maintenance/">מרכז השירות</a><p class="eyebrow">I FEEL · מסמכים ללקוחות</p><h1>טפסים והסכמים</h1><p>כל מסמך במקום ברור. בחרו את הטופס המתאים, עברו על התנאים ובדקו את זמינות החתימה.</p></div></header>
 <div class="forms-wrap">
 <ol class="steps"><li><b>01</b> בוחרים מסמך</li><li><b>02</b> עוברים על התנאים</li><li><b>03</b> חותמים ומקבלים העתק כשהחתימה פעילה</li></ol>
 {groups.map(group=><section class="form-group"><h2>{group.title}</h2><p class="group-description">{group.description}</p><div class="form-cards">{group.keys.map(key=>{const f=forms[key as keyof typeof forms];const ready=!!getSigningUrl(f);return <article class="form-card"><span class:list={['status',{'ready':ready}]}>{ready?'חתימה מקוונת זמינה':'לעיון · חתימה טרם הופעלה'}</span><h3>{f.title}</h3><p class="copy-label">יעד ההעתק לחברה</p><p class="copy-email"><bdi>{f.copyEmail}</bdi></p><a href={f.path}>פתיחת המסמך <span aria-hidden="true">←</span></a></article>})}</div></section>)}
 <details class="other-version"><summary>נוסח נוסף של הסכם השירות לעיון</summary><p>באתר קיימת גרסה נוספת עם תנאים שונים. יש לוודא עם מחלקת השירות איזה נוסח חל על ההתקשרות.</p><a href="/service-agreement-private/">פתיחת הגרסה הנוספת</a></details>
 <aside class="forms-help"><h2>צריך עזרה בבחירת טופס?</h2><p>מחלקת השירות זמינה בטלפון <a href="tel:+972-3-508-9553" dir="ltr">03-508-9553</a>.</p><p>כשהחתימה תופעל, יישלח העתק לכתובת הדוא״ל שהלקוח מזין ולכתובת החברה המצוינת בכל טופס.</p></aside>
 </div>
</main>
</BaseLayout>
<style>
.forms-page{background:#edf2f6;color:#15334a}.forms-hero{background:#14334b;color:#fff;border-bottom:5px solid #d3a359;padding:48px 24px}.forms-hero>div,.forms-wrap{max-width:1120px;margin:auto}.forms-hero a{color:#b9d6e8;text-decoration:underline;font-size:14px}.forms-hero .eyebrow{font-size:12px;letter-spacing:.06em;margin-top:28px;color:#d3a359;font-weight:800}.forms-hero h1{font-size:clamp(34px,5vw,55px);font-weight:900;line-height:1.35;margin:9px 0 15px}.forms-hero p{font-size:18px;line-height:1.8;max-width:720px}.forms-wrap{padding:30px 24px 60px}.steps{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:12px;list-style:none;margin:0 0 40px;padding:0}.steps li{background:#fff;border:1px solid #d3dfe8;border-radius:12px;padding:15px;font-size:14px;line-height:1.6;display:flex;gap:12px;align-items:center}.steps b{color:#a16b24;font-size:20px}.form-group{margin:35px 0}.form-group>h2{font-size:27px;font-weight:800;margin-bottom:7px}.group-description{color:#526c7e;font-size:16px;margin-bottom:18px}.form-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.form-card{background:#fff;border:1px solid #d7e1e9;border-radius:16px;padding:24px;border-top:4px solid #6e93ad;box-shadow:0 6px 20px #17324b05;display:flex;flex-direction:column}.status{background:#fff4df;color:#74501c;font-size:12px;font-weight:700;padding:6px 9px;border-radius:6px;align-self:start}.status.ready{background:#e6f3e9;color:#205330}.form-card h3{font-size:23px;line-height:1.5;font-weight:800;margin:18px 0 24px}.copy-label{font-size:12px;color:#5a7081}.copy-email{font-size:15px;margin:5px 0 25px;overflow-wrap:anywhere}.form-card>a{margin-top:auto;display:flex;justify-content:space-between;background:#14334b;color:white;padding:12px 16px;border-radius:9px;font-size:15px;font-weight:700}.other-version{border:1px solid #cbdbe6;border-radius:12px;padding:18px;margin:25px 0;color:#38566d}.other-version summary{cursor:pointer;font-weight:700}.other-version p{margin:15px 0;line-height:1.8}.other-version a{text-decoration:underline}.forms-help{background:#dfeaf2;border:1px solid #c7d9e7;border-radius:16px;padding:25px;margin-top:32px}.forms-help h2{font-size:21px;font-weight:800}.forms-help p{font-size:15px;line-height:1.9;margin-top:9px}.forms-help a{text-decoration:underline}@media(max-width:850px){.form-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.steps{grid-template-columns:1fr}.forms-wrap{padding:24px 18px}.forms-hero{padding:32px 20px}}@media(max-width:550px){.form-cards{grid-template-columns:1fr}.form-card{padding:20px}.form-group>h2{font-size:24px}}
</style>
