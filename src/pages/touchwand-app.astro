---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/touchwand-app/';
const cloudUrl = 'https://cloud.touchwand.com';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'כיצד להתחבר למערכת TouchWand באייפון ובאנדרואיד',
  description: 'הנחיות ללקוחות TouchWand לשליטה במערכת דרך אפליקציית Android או דרך הענן במכשירי iPhone.',
  url: canonical,
  inLanguage: 'he-IL',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'פתיחת אתר הענן',
      text: 'פתחו את cloud.touchwand.com בדפדפן Safari במכשיר האייפון.'
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'התחברות למערכת',
      text: 'הזינו את פרטי ההתחברות למערכת TouchWand.'
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'הוספה למסך הבית',
      text: 'לחצו על כפתור השיתוף ב-Safari, בחרו הוספה למסך הבית ואשרו.'
    }
  ]
});

const meta = {
  title: 'TouchWand באייפון ובאנדרואיד | כניסה למערכת | i-feel',
  description: 'אפליקציית TouchWand אינה זמינה עוד בחנות Apple. כך שולטים במערכת דרך Android או דרך cloud.touchwand.com באייפון ומוסיפים קיצור למסך הבית.',
  canonical,
  ogTitle: 'כניסה למערכת TouchWand באייפון ובאנדרואיד',
  ogDescription: 'הנחיות קצרות לכניסה למערכת TouchWand דרך הענן באייפון או דרך האפליקציה באנדרואיד.',
  ogUrl: canonical,
  jsonLd
};
---

<BaseLayout {...meta}>
  <nav class="border-b border-brand-100 bg-brand-50" aria-label="פירורי לחם">
    <div class="mx-auto max-w-6xl px-4 py-3 text-sm">
      <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
      <span class="mx-2 text-brand-400">›</span>
      <a href="/service-and-maintenance/" class="text-brand-600 hover:text-accent-600">שירות ותחזוקה</a>
      <span class="mx-2 text-brand-400">›</span>
      <span class="font-medium text-brand-900">כניסה ל-TouchWand</span>
    </div>
  </nav>

  <section class="bg-gradient-to-bl from-brand-900 via-brand-800 to-brand-700 text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
      <div class="mb-5 inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold">
        מידע ללקוחות TouchWand
      </div>
      <h1 class="max-w-4xl text-4xl font-extrabold leading-tight md:text-5xl">
        כניסה למערכת TouchWand באייפון ובאנדרואיד
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-brand-100 md:text-xl">
        אפליקציית TouchWand אינה זמינה עוד בחנות האפליקציות של Apple. במכשירי iPhone ניתן להמשיך לשלוט במערכת ישירות דרך הענן, ובמכשירי Android ניתן להמשיך להשתמש באפליקציה.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={cloudUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-accent-500 px-6 py-3.5 text-base font-bold text-white shadow-lg transition hover:bg-accent-600 focus:outline-none focus:ring-4 focus:ring-accent-300"
        >
          כניסה לענן TouchWand
        </a>
        <a
          href="#iphone"
          class="rounded-xl border border-white/30 bg-white/10 px-6 py-3.5 text-base font-bold text-white transition hover:bg-white/20"
        >
          הוראות לאייפון
        </a>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6 shadow-sm md:p-8" aria-labelledby="important-title">
      <div class="flex items-start gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xl font-extrabold text-amber-800" aria-hidden="true">!</div>
        <div>
          <h2 id="important-title" class="text-2xl font-extrabold text-brand-900">חשוב לדעת</h2>
          <p class="mt-2 text-lg leading-8 text-brand-800">
            אין צורך להתקין אפליקציה חדשה באייפון. אתר הענן מאפשר שליטה במערכת דרך הדפדפן, וניתן להוסיף אותו למסך הבית כך שייפתח כמו אפליקציה.
          </p>
        </div>
      </div>
    </section>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <section id="iphone" class="scroll-mt-28 rounded-2xl border border-brand-100 bg-white p-6 shadow-lg md:p-8" aria-labelledby="iphone-title">
        <div class="mb-6 flex items-center gap-4">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-100 text-2xl font-extrabold text-brand-900" aria-hidden="true">i</div>
          <div>
            <p class="text-sm font-bold text-accent-600">iPhone ו-iPad</p>
            <h2 id="iphone-title" class="text-3xl font-extrabold text-brand-900">שליטה דרך הענן</h2>
          </div>
        </div>

        <ol class="space-y-5">
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">1</span>
            <div>
              <h3 class="font-bold text-brand-900">פתחו את אתר הענן ב-Safari</h3>
              <p class="mt-1 leading-7 text-brand-700">היכנסו לכתובת <a href={cloudUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-accent-600 underline decoration-2 underline-offset-4">cloud.touchwand.com</a>.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">2</span>
            <div>
              <h3 class="font-bold text-brand-900">התחברו למערכת</h3>
              <p class="mt-1 leading-7 text-brand-700">הזינו את שם המשתמש והסיסמה שלכם. ניתן לאפשר ל-Safari לשמור את פרטי ההתחברות לפי הגדרות האבטחה במכשיר.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">3</span>
            <div>
              <h3 class="font-bold text-brand-900">הוסיפו למסך הבית</h3>
              <p class="mt-1 leading-7 text-brand-700">לחצו על סמל השיתוף ב-Safari, בחרו <strong>הוספה למסך הבית</strong> ולאחר מכן לחצו <strong>הוסף</strong>.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">4</span>
            <div>
              <h3 class="font-bold text-brand-900">פתחו מהסמל החדש</h3>
              <p class="mt-1 leading-7 text-brand-700">מעתה ניתן לפתוח את TouchWand ישירות ממסך הבית, בדומה לפתיחת אפליקציה.</p>
            </div>
          </li>
        </ol>

        <a
          href={cloudUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 flex w-full items-center justify-center rounded-xl bg-brand-900 px-5 py-3.5 text-center font-bold text-white transition hover:bg-brand-800"
        >
          לפתיחת TouchWand באייפון
        </a>
      </section>

      <section class="rounded-2xl border border-brand-100 bg-white p-6 shadow-lg md:p-8" aria-labelledby="android-title">
        <div class="mb-6 flex items-center gap-4">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-green-100 text-2xl font-extrabold text-green-800" aria-hidden="true">A</div>
          <div>
            <p class="text-sm font-bold text-green-700">מכשירי Android</p>
            <h2 id="android-title" class="text-3xl font-extrabold text-brand-900">שליטה דרך האפליקציה</h2>
          </div>
        </div>

        <p class="text-lg leading-8 text-brand-700">
          במכשירי Android ניתן להמשיך לשלוט במערכת באמצעות אפליקציית TouchWand הקיימת במכשיר.
        </p>

        <div class="mt-6 rounded-xl bg-brand-50 p-5">
          <h3 class="text-lg font-bold text-brand-900">גם באנדרואיד אפשר להשתמש בענן</h3>
          <p class="mt-2 leading-7 text-brand-700">
            במקרה הצורך, ניתן לפתוח גם בדפדפן Android את
            <a href={cloudUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-accent-600 underline decoration-2 underline-offset-4">cloud.touchwand.com</a>
            ולהתחבר עם אותם פרטים.
          </p>
        </div>

        <div class="mt-8 border-t border-brand-100 pt-6">
          <h3 class="text-xl font-extrabold text-brand-900">לא מצליחים להתחבר?</h3>
          <p class="mt-2 leading-7 text-brand-700">
            ודאו שיש חיבור לאינטרנט ושפרטי המשתמש והסיסמה הוזנו במדויק. אם הבעיה נמשכת, פנו למחלקת השירות של i-feel וציינו שמדובר במערכת TouchWand.
          </p>
          <a href="/contactus/" class="mt-5 inline-flex rounded-xl border-2 border-brand-900 px-5 py-3 font-bold text-brand-900 transition hover:bg-brand-900 hover:text-white">
            יצירת קשר עם השירות
          </a>
        </div>
      </section>
    </div>

    <section class="mt-10 rounded-2xl bg-brand-900 px-6 py-8 text-center text-white md:px-10 md:py-10">
      <h2 class="text-2xl font-extrabold md:text-3xl">כתובת הכניסה הקבועה</h2>
      <p class="mt-3 text-brand-100">שמרו את הקישור בסימניות או הוסיפו אותו למסך הבית.</p>
      <a
        href={cloudUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex max-w-full break-all rounded-xl bg-white px-6 py-3.5 text-lg font-extrabold text-brand-900 transition hover:bg-brand-50"
      >
        cloud.touchwand.com
      </a>
    </section>
  </article>
</BaseLayout>
