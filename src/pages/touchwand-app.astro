---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/touchwand-app/';
const cloudUrl = 'https://cloud.touchwand.com';
const androidApkUrl = '/downloads/touchwand-plus-android.apk';
const smartSphereUrl = '/articles/home-assistant-smart-home-integration/';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'כיצד להשתמש במערכת TouchWand באייפון ובאנדרואיד',
  description: 'הנחיות ללקוחות TouchWand לשליטה במערכת דרך אפליקציית Android או דרך הענן במכשירי iPhone.',
  url: canonical,
  inLanguage: 'he-IL',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'פתיחת אתר הענן',
      text: 'פתחו את cloud.touchwand.com בדפדפן Safari במכשיר האייפון.'
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'התחברות למערכת',
      text: 'הזינו את פרטי ההתחברות הקיימים למערכת TouchWand.'
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'שמירת קיצור דרך',
      text: 'לחצו על כפתור השיתוף ב-Safari, בחרו הוספה למסך הבית ואשרו.'
    }
  ]
});

const meta = {
  title: 'אפליקציית TouchWand באייפון ובאנדרואיד | i-feel',
  description: 'הורדת קובץ ההתקנה של TouchWand ישירות למכשיר Android והנחיות להתקנה עצמאית עם פרטי ההתחברות הקיימים.',
  canonical,
  ogTitle: 'המשך שימוש במערכת TouchWand באייפון ובאנדרואיד',
  ogDescription: 'הורדת קובץ ההתקנה של TouchWand ישירות למכשיר Android, התקנה עצמאית וכניסה דרך הענן באייפון.',
  ogUrl: canonical,
  jsonLd
};
---

<BaseLayout {...meta}>
  <nav class="border-b border-brand-100 bg-brand-50" aria-label="פירורי לחם">
    <div class="mx-auto max-w-6xl px-4 py-3 text-sm">
      <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
      <span class="mx-2 text-brand-400">›</span>
      <a href="/service-and-maintenance/" class="text-brand-600 hover:text-accent-600">שירות ותחזוקה</a>
      <span class="mx-2 text-brand-400">›</span>
      <span class="font-medium text-brand-900">אפליקציית TouchWand</span>
    </div>
  </nav>

  <section class="bg-gradient-to-bl from-brand-900 via-brand-800 to-brand-700 text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
      <p class="text-sm font-bold text-accent-400">מידע חשוב ללקוחות TouchWand</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-extrabold leading-tight md:text-5xl">
        אפליקציית TouchWand אינה זמינה עוד בחנות של Apple
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-brand-100 md:text-xl">
        המערכת בבית ממשיכה לעבוד. במכשירי Android ניתן לשלוט באמצעות אפליקציית TouchWand, ובמכשירי iPhone ניתן לשלוט ישירות דרך אתר הענן.
      </p>
      <a
        href={cloudUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex rounded-xl bg-accent-500 px-6 py-3.5 text-base font-bold text-white shadow-lg transition hover:bg-accent-600 focus:outline-none focus:ring-4 focus:ring-accent-300"
      >
        כניסה למערכת TouchWand דרך הענן ↗
      </a>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <section class="rounded-2xl border border-amber-200 bg-amber-50 p-6 shadow-sm md:p-8" aria-labelledby="important-title">
      <h2 id="important-title" class="text-2xl font-extrabold text-brand-900">אין צורך לפתוח קריאת שירות רק כדי להתקין את האפליקציה באייפון</h2>
      <p class="mt-3 text-lg leading-8 text-brand-800">
        מאחר שהאפליקציה אינה נמצאת עוד בחנות של Apple, לא ניתן להתקין אותה מחדש באייפון. במקום זאת, נכנסים לכתובת הענן בדפדפן ושומרים אותה במסך הבית.
      </p>
    </section>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <section id="iphone" class="scroll-mt-28 rounded-2xl border border-brand-100 bg-white p-6 shadow-lg md:p-8" aria-labelledby="iphone-title">
        <p class="text-sm font-bold text-accent-600">iPhone ו-iPad</p>
        <h2 id="iphone-title" class="mt-2 text-3xl font-extrabold text-brand-900">שליטה דרך הענן</h2>
        <ol class="mt-7 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">1</span>
            <div>
              <h3 class="font-bold text-brand-900">פתחו את Safari</h3>
              <p class="mt-1 leading-7 text-brand-700">היכנסו לכתובת <a href={cloudUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-accent-600 underline decoration-2 underline-offset-4">cloud.touchwand.com</a>.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">2</span>
            <div>
              <h3 class="font-bold text-brand-900">הזינו את פרטי ההתחברות</h3>
              <p class="mt-1 leading-7 text-brand-700">השתמשו בשם המשתמש ובסיסמה הקיימים של מערכת TouchWand.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">3</span>
            <div>
              <h3 class="font-bold text-brand-900">שמרו את הדף במסך הבית</h3>
              <p class="mt-1 leading-7 text-brand-700">לחצו על סמל השיתוף ב-Safari, בחרו <strong>הוספה למסך הבית</strong> ולאחר מכן לחצו <strong>הוסף</strong>.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-bold text-white">4</span>
            <div>
              <h3 class="font-bold text-brand-900">פתחו את הקיצור בפעם הבאה</h3>
              <p class="mt-1 leading-7 text-brand-700">מומלץ לאפשר ל-Safari לשמור את פרטי ההתחברות בהתאם להגדרות האבטחה שלכם, כדי שלא יהיה צורך להזין אותם בכל פעם.</p>
            </div>
          </li>
        </ol>
        <a href={cloudUrl} target="_blank" rel="noopener noreferrer" class="mt-8 flex w-full items-center justify-center rounded-xl bg-brand-900 px-5 py-3.5 text-center font-bold text-white transition hover:bg-brand-800">
          פתיחת cloud.touchwand.com
        </a>
      </section>

      <section class="rounded-2xl border border-brand-100 bg-white p-6 shadow-lg md:p-8" aria-labelledby="android-title">
        <p class="text-sm font-bold text-green-700">מכשירי Android</p>
        <h2 id="android-title" class="mt-2 text-3xl font-extrabold text-brand-900">הורדת קובץ ההתקנה לטלפון</h2>
        <p class="mt-6 text-lg leading-8 text-brand-700">
          פתחו את העמוד במכשיר Android, הורידו את קובץ ההתקנה ישירות לטלפון והתקינו אותו באופן עצמאי. לאחר ההתקנה התחברו עם <strong>אותו שם משתמש ואותה סיסמה</strong> שבהם השתמשתם קודם.
        </p>
        <div class="mt-6 rounded-xl border border-green-200 bg-green-50 p-5">
          <h3 class="text-lg font-extrabold text-brand-900">אפליקציית TouchWand ל-Android</h3>
          <p class="mt-1 text-sm leading-6 text-brand-700">קובץ APK להורדה ישירה לטלפון, כ-23 MB. הקובץ מיועד להתקנה במכשירי Android בלבד.</p>
          <a
            href={androidApkUrl}
            download="touchwand-plus-android.apk"
            type="application/vnd.android.package-archive"
            class="mt-4 flex w-full items-center justify-center rounded-xl bg-green-700 px-5 py-3.5 text-center text-lg font-extrabold text-white transition hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-200"
          >
            הורדת קובץ ההתקנה לטלפון
          </a>
        </div>
        <ol class="mt-6 space-y-3 text-brand-700">
          <li><strong class="text-brand-900">1.</strong> במכשיר Android, לחצו על כפתור ההורדה ושמרו את קובץ ה-APK.</li>
          <li><strong class="text-brand-900">2.</strong> בסיום ההורדה, פתחו את הקובץ מהודעת ההורדה או מתיקיית ההורדות בטלפון.</li>
          <li><strong class="text-brand-900">3.</strong> אשרו את ההתקנה. אם מוצגת בקשת הרשאה, אפשרו התקנה ממקור זה וניתן לבטל את ההרשאה לאחר מכן.</li>
          <li><strong class="text-brand-900">4.</strong> פתחו את האפליקציה והתחברו עם שם המשתמש והסיסמה הקיימים.</li>
        </ol>
        <p class="mt-4 text-sm leading-6 text-brand-600">
          נכנסתם לעמוד מהמחשב? אפשר להוריד את הקובץ למחשב ולהעביר אותו למכשיר Android באמצעות כבל USB או אמצעי העברה מהימן אחר.
        </p>
        <div class="mt-6 rounded-xl bg-brand-50 p-5">
          <h3 class="text-lg font-bold text-brand-900">אפשר גם דרך אתר הענן</h3>
          <a href={cloudUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex break-all text-lg font-extrabold text-accent-600 underline decoration-2 underline-offset-4">
            cloud.touchwand.com
          </a>
        </div>
        <div class="mt-8 border-t border-brand-100 pt-6">
          <h3 class="text-xl font-extrabold text-brand-900">מתי כן צריך לפנות לשירות?</h3>
          <p class="mt-2 leading-7 text-brand-700">
            פנו לשירות אם פרטי ההתחברות אינם מתקבלים, אם המערכת אינה מופיעה לאחר הכניסה, או אם ניתן להיכנס אך אין שליטה בציוד בבית.
          </p>
          <a href="/service-request/" class="mt-5 inline-flex rounded-xl border-2 border-brand-900 px-5 py-3 font-bold text-brand-900 transition hover:bg-brand-900 hover:text-white">
            פתיחת קריאת שירות
          </a>
        </div>
      </section>
    </div>

    <section class="mt-12 overflow-hidden rounded-3xl border border-accent-200 bg-gradient-to-bl from-accent-50 to-white shadow-lg" aria-labelledby="upgrade-title">
      <div class="grid gap-8 p-7 md:p-10 lg:grid-cols-[1.35fr_0.65fr] lg:items-center">
        <div>
          <p class="text-sm font-extrabold text-accent-700">אפשרות מומלצת למערכת ותיקה</p>
          <h2 id="upgrade-title" class="mt-2 text-3xl font-extrabold leading-tight text-brand-900 md:text-4xl">
            מומלץ לבדוק מעבר ל-SmartSphere, הקונטרולר החדש של i-feel
          </h2>
          <p class="mt-5 text-lg leading-8 text-brand-700">
            SmartSphere היא מערכת שליטה חדשה ומתקדמת מבית i-feel, המבוססת על Home Assistant ומותאמת לפרויקט. היא מאפשרת ממשק עדכני לאייפון ולאנדרואיד, שילוב של מערכות הבית בממשק אחד, שירותי ענן וגישה מאובטחת לשירות מרחוק.
          </p>
          <p class="mt-3 leading-7 text-brand-600">
            המעבר אינו חובה כדי להמשיך להשתמש ב-TouchWand. הוא מומלץ ללקוחות שרוצים מערכת עדכנית יותר ואפשרויות הרחבה. לפני השדרוג נדרשת בדיקת התאמה של הקונטרולר, הציוד והתכנות הקיימים.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a href={smartSphereUrl} class="rounded-xl bg-accent-500 px-6 py-4 text-center text-lg font-extrabold text-white transition hover:bg-accent-600">
            מידע מלא על SmartSphere
          </a>
          <a href="/service-request/" class="rounded-xl border-2 border-brand-900 px-6 py-4 text-center font-bold text-brand-900 transition hover:bg-brand-900 hover:text-white">
            בקשת בדיקת התאמה לשדרוג
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
