---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../page-html/gallery/page-22.html?raw';

const meta = {
  title: "אינטרקום חכם לבניין מגורים | פרויקט i-feel",
  description: "פרויקט אינטרקום חכם לבניין מגורים — וידאו, פתיחת שערים, בקרת גישה, ואינטגרציה עם מערכות בית חכם של דיירים. i-feel מערכות בקרת מבנה.",
  canonical: "https://i-feel.co.il/gallery/smart-intercom-residential-building/",
  ogTitle: "אינטרקום חכם לבניין מגורים",
  ogDescription: "",
  ogUrl: "https://i-feel.co.il/gallery/smart-intercom-residential-building/",
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: "{\"@context\":\"https://schema.org\",\"@type\":\"ImageGallery\",\"name\":\"אינטרקום חכם לבניין מגורים\",\"description\":\"פרויקט אינטרקום חכם משולב — וידאו, פתיחת שערים, בקרת גישה לבניין מגורים\",\"mainEntityOfPage\":\"https://i-feel.co.il/gallery/smart-intercom-residential-building/\"}"
