  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href="https://i-feel.co.il/floor-tv-pole/" />
    <title>מעבר לעמוד הטלוויזיה הרצפתי | i-feel</title>
  </head>
  <body>
    <p><a href={destination}>מעבר לעמוד הטלוויזיה הרצפתי</a></p>
    <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  </body>
</html>
