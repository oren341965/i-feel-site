          { "@type": "ListItem", "position": 3, "name": "כמה עולה בית חכם", "item": "https://i-feel.co.il/smart-home-price/" }
        ]
      },
      {
        "@type": "Service",
        "name": "תכנון והתקנת בית חכם",
