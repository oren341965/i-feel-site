---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/bms-configurator.html?raw';

const canonical = 'https://i-feel.co.il/bms-configurator/';
const title = 'קונפיגורטור BMS ו-DDC של Siemens | בניית רשימת ציוד | i-feel';
const description = 'כלי לתכנון ראשוני של מערכת Siemens Desigo BMS: הזנת DI, AI, AO, DO, Triac, Pt100 ואינטגרציות לקבלת בקר PXC ורשימת מודולי TX-I/O.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
      areaServed: { '@type': 'Country', name: 'Israel' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'בקרת מבנה BMS', item: 'https://i-feel.co.il/structure-control/' },
        { '@type': 'ListItem', position: 3, name: 'קונפיגורטור BMS', item: canonical },
      ],
    },
    {
      '@type': 'WebApplication',
      name: 'קונפיגורטור Siemens Desigo BMS',
      url: canonical,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'he-IL',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS' },
      provider: { '@id': 'https://i-feel.co.il/#business' },
      description,
      featureList: [
        'בחירת בקר PXC ראשוני',
        'חלוקת מודולי TX-I/O',
        'רזרבה תכנונית',
        'רשימת ציוד BOM',
        'ייצוא CSV והדפסה ל-PDF',
        'שליחת התכנון לצוות i-feel',
      ],
    },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  ogImage="https://i-feel.co.il/assets/office-bms.jpeg"
  jsonLd={jsonLd}
>
  <Fragment set:html={content} />

  <script is:inline>
    (() => {
      const calculateButton = document.getElementById('calculate-bms');
      const leadForm = document.getElementById('bms-lead-form');
      const notes = document.getElementById('project-notes');
      const serialNetworks = document.getElementById('serial-networks');
      const pointIds = ['point-di', 'point-ai', 'point-ai-current', 'point-ao', 'point-relay', 'point-triac', 'point-pt100'];
      const serialProtocolIds = ['protocol-mstp', 'protocol-modbus-rtu', 'protocol-mbus'];

      const numericValue = (id) => Math.max(0, Number(document.getElementById(id)?.value || 0));

      const syncSerialNetworks = () => {
        if (!serialNetworks) return;
        const selectedProtocols = serialProtocolIds.filter((id) => document.getElementById(id)?.checked).length;
        const requiredByDevices = numericValue('mstp-devices') > 0 ? 1 : 0;
        const required = Math.min(4, Math.max(selectedProtocols, requiredByDevices));
        const current = numericValue('serial-networks');
        if (required > current) serialNetworks.value = String(required);
      };

      serialProtocolIds.forEach((id) => {
        document.getElementById(id)?.addEventListener('change', syncSerialNetworks);
      });
      document.getElementById('mstp-devices')?.addEventListener('change', syncSerialNetworks);
      calculateButton?.addEventListener('click', syncSerialNetworks, true);

      if (notes) {
        notes.setAttribute('maxlength', '2000');
        notes.addEventListener('input', () => {
          const cleanValue = notes.value.replace(/[<>]/g, '');
          if (cleanValue !== notes.value) notes.value = cleanValue;
        });
      }

      leadForm?.addEventListener('submit', (event) => {
        const physicalPoints = pointIds.reduce((sum, id) => sum + numericValue(id), 0);
        const integrationPoints = numericValue('integration-points');
        if (physicalPoints === 0 && integrationPoints === 0) {
          event.preventDefault();
          event.stopImmediatePropagation();
          window.alert('יש להזין לפחות נקודת I/O אחת או נקודת אינטגרציה לפני שליחת התצורה.');
          document.getElementById('bms-builder')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, true);

      syncSerialNetworks();
    })();
  </script>
</BaseLayout>
