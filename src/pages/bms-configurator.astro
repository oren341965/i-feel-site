---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/bms-configurator.html?raw';

const canonical = 'https://i-feel.co.il/bms-configurator/';
const title = 'קונפיגורטור BMS ו-DDC של Siemens | בניית רשימת ציוד | i-feel';
const description = 'כלי לתכנון ראשוני של מערכת Siemens Desigo BMS: הזנת DI, AI, AO, DO, Triac, Pt100 ואינטגרציות לקבלת בקר PXC ורשימת מודולי TX-I/O.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
      areaServed: { '@type': 'Country', name: 'Israel' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'בקרת מבנה BMS', item: 'https://i-feel.co.il/structure-control/' },
        { '@type': 'ListItem', position: 3, name: 'קונפיגורטור BMS', item: canonical },
      ],
    },
    {
      '@type': 'WebApplication',
      name: 'קונפיגורטור Siemens Desigo BMS',
      url: canonical,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'he-IL',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS' },
      provider: { '@id': 'https://i-feel.co.il/#business' },
      description,
      featureList: [
        'בחירת בקר PXC ראשוני',
        'חלוקת מודולי TX-I/O',
        'רזרבה תכנונית',
        'רשימת ציוד BOM',
        'ייצוא CSV והדפסה ל-PDF',
        'שליחת התכנון לצוות i-feel',
      ],
    },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  ogImage="https://i-feel.co.il/assets/office-bms.jpeg"
  jsonLd={jsonLd}
>
  <Fragment set:html={content} />
</BaseLayout>
