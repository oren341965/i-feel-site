---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/bms-industry.html?raw';

const pageUrl = "https://i-feel.co.il/bms-industry/";
const faqs = [
  {
    question: "מה כוללת מערכת BMS לתעשייה בישראל?",
    answer: "מערכת BMS לתעשייה מרכזת את ניהול תשתיות המבנה כמו HVAC, אוורור, משאבות, חדרי מכונות, תאורה, מדידת אנרגיה והתראות. היא אינה מחליפה מערכות ייצור או SCADA ייעודיות לקווי הייצור."
  },
  {
    question: "האם BMS מחליף SCADA במפעל?",
    answer: "לא. BMS מנהל את מערכות המבנה, בעוד SCADA מיועדת לרוב לקווי ייצור ותהליכים. בפרויקטים מתאימים מתכננים ממשק מוגבל ומבוקר בין המערכות."
  },
  {
    question: "אפשר לשדרג BMS במפעל פעיל?",
    answer: "כן. אפשר לבצע Retrofit בשלבים לפי אזור, חדר מכונות או מערכת, לאחר מיפוי הבקרים והציוד הקיים ותכנון חלונות עבודה ובדיקות."
  },
  {
    question: "אילו פרוטוקולים נפוצים ב-BMS לתעשייה?",
    answer: "BACnet נפוץ בציוד HVAC ובקרת מבנה, Modbus משמש לעיתים קרובות למוני אנרגיה ולציוד צד שלישי, KNX יכול לשמש לבקרת חדרים ותאורה, ובקרי DDC מנהלים את שכבת השטח."
  },
  {
    question: "מתי Siemens Desigo מתאים למפעל או אתר תעשייתי?",
    answer: "Siemens Desigo מתאים כאשר נדרשת מערכת BMS מרכזית עם בקרי DDC, אינטגרציה לציוד HVAC, ניטור, התראות, מגמות ויכולת הרחבה. ההתאמה נקבעת לפי ארכיטקטורת האתר, הציוד הקיים והפרוטוקולים הנדרשים."
  }
];

