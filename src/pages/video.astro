94Ph8MSXS0\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-homeassistant\",\n      \"name\": \"שילוב Home Assistant בבית חכם\",\n      \"description\": \"איך משלבים את פלטפורמת Home Assistant במערכת בית חכם של i-feel — תרחישים אוטומטיים ושכבת בקרה נוספת.\",\n      \"uploadDate\": \"2026-01-21T00:26:06-08:00\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/I28b9j8MZyg/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=I28b9j8MZyg\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/I28b9j8MZyg\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-management\",\n      \"name\": \"מערכת ניהול בית חכם\",\n      \"description\": \"הסבר כללי על מערכת ניהול הבית החכם של i-feel — מסכי בקרה, אפליקציה ושליטה מרכזית.\",\n      \"uploadDate\": \"2014-08-24T08:02:04-07:00\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/fuvLDW878yQ/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=fuvLDW878yQ\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/fuvLDW878yQ\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-knx-big-home\",\n      \"name\": \"שליטה מלאה בבית גדול עם מערכת KNX\",\n      \"description\": \"סקירת פרויקט: שליטה מלאה בבית גדול עם תשתית KNX — תאורה, מיזוג, וילונות, אודיו ואינטגרציה מלאה.\",\n      \"uploadDate\": \"2019-12-08T11:25:58-08:00\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/nrdZMtkUCSU/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=nrdZMtkUCSU\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/nrdZMtkUCSU\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-meeting-room\",\n      \"name\": \"חדר ישיבות חכם\",\n      \"description\": \"הקמת חדר ישיבות חכם — שליטה מרכזית על מולטימדיה, תאורה, מקרן, מסכים וקול ממסך אחד.\",\n      \"uploadDate\": \"2016-07-22T04:00:23-07:00\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/fvRwiO1xBAk/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=fvRwiO1xBAk\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/fvRwiO1xBAk\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-scheduling\",\n      \"name\": \"כיצד לעשות תזמונים בבית חכם\",\n      \"description\": \"מדריך וידאו קצר המראה כיצד מגדירים תזמון בבית חכם של i-feel — בחירת מעגל, קביעת שעה או זריחה/שקיעה, ימי פעילות ושמירה.\",\n      \"uploadDate\": \"2026-06-29\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/fIu6RUgQd6U/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=fIu6RUgQd6U\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/fIu6RUgQd6U\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-shutter-calibration\",\n      \"name\": \"כיול תריסים בבית חכם — מדריך שלב אחר שלב\",\n      \"description\": \"מדריך וידאו קצר של i-feel: כיצד מכיילים תריסים חשמליים בבית חכם — הגדרת מצב פתוח וסגור מלא וכיול אחוזי הפתיחה, כשהתריס לא עוצר במקום הנכון או יצא מסנכרון.\",\n      \"uploadDate\": \"2026-07-17\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/BEKATheYp9U/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=BEKATheYp9U\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/BEKATheYp9U\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-glasswand-icons\",\n      \"name\": \"איך מחליפים אייקונים במפסק זכוכית GlassWand של 9 לחצנים\",\n      \"description\": \"מדריך וידאו קצר של i-feel: פתיחת מפסק זכוכית חכם GlassWand בעל 9 לחצנים והחלפת כובעי האייקונים כדי להתאים כל לחצן לפי מפת התכנון.\",\n      \"uploadDate\": \"2026-07-08\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/AkwVp-VQ3r8/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=AkwVp-VQ3r8\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/AkwVp-VQ3r8\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-bms-commercial\",\n      \"name\": \"בקרת מבנה חכמה (BMS) בבניין מסחרי — סיור בפרויקט\",\n      \"description\": \"סיור קצר בפרויקט בקרת מבנה (BMS) של i-feel בבניין מסחרי: פאנל בקרה חכם על הקיר ומערכת ניהול מבנה מרכזית המאחדת תאורה, מיזוג, וילונות ובקרת אקלים.\",\n      \"uploadDate\": \"2026-07-08\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/WOoyIxIuF2M/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=WOoyIxIuF2M\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/WOoyIxIuF2M\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-smartsphere-air-conditioners\",\n      \"name\": \"איך מחברים מזגנים שונים למערכת SMARTSPHERE\",\n      \"description\": \"מדריך וידאו קצר של i-feel: כיצד מחברים ומשייכים סוגים שונים של מזגנים למערכת הבית החכם SMARTSPHERE, כדי לשלוט במיזוג מממשק אחד.\",\n      \"uploadDate\": \"2026-07-20\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/mVP8OHtLjso/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=mVP8OHtLjso\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/mVP8OHtLjso\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-control4-touch\",\n      \"name\": \"מסך מגע Control4 — שליטה מרכזית בבית חכם\",\n      \"description\": \"היכרות עם מסך המגע של Control4 לשליטה מרכזית בתאורה, תריסים, מיזוג ומערכות הבית מממשק אחד. תכנון, התקנה ותכנות של i-feel.\",\n      \"uploadDate\": \"2026-07-23\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/rR8Z2e7WnEo/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=rR8Z2e7WnEo\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/rR8Z2e7WnEo\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    },\n    {\n      \"@type\": \"VideoObject\",\n      \"@id\": \"https://i-feel.co.il/video/#v-control4-homeassistant\",\n      \"name\": \"מסך שליטה לבית חכם — Control4 ו-Home Assistant\",\n      \"description\": \"ממשק קיר חכם שמרכז תאורה, הצללה, מיזוג ותרחישים במערכת אחת — שילוב Control4 ו-Home Assistant בתכנון וביצוע i-feel.\",\n      \"uploadDate\": \"2026-07-23\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/v2Bj4gMtvUs/hqdefault.jpg\",\n      \"contentUrl\": \"https://www.youtube.com/watch?v=v2Bj4gMtvUs\",\n      \"embedUrl\": \"https://www.youtube-nocookie.com/embed/v2Bj4gMtvUs\",\n      \"inLanguage\": \"he-IL\",\n      \"publisher\": { \"@id\": \"https://i-feel.co.il/#business\" }\n    }\n  ]\n}"
};
