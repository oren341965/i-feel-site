---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/knx-presence-motion-detectors.html?raw';

const canonical = 'https://i-feel.co.il/knx-presence-motion-detectors/';
const faq = [
  ['איך מחברים גלאי קרן לתאורה במרלו״ג?', 'בדוגמת החיבור, PIMA PROTECTOR TP-20 מוזן מספק 12V DC נפרד; מגע יבש COM–NC מהמקלט נכנס ל-Siemens UP 220/21, שמדווח ב-KNX ל-N 305. בקר N 305 שולח פקודה לאקטואטור התאורה. דגם TP-20 מתאים לעד 20 מטר; למעבר ארוך יותר מתכננים דגם מתאים או מספר אזורי גילוי.'],
  ['האם גלאי KNX זקוק לחשמל נפרד?', 'ברוב הדגמים המתוארים ההזנה והתקשורת מתקבלות מכבל KNX TP. יש לפעול לפי דף הנתונים של כל דגם.'],
  ['האם אותו גלאי יכול לנהל תאורה ומיזוג?', 'כן. בדגמים בעלי מספר ערוצים או פונקציות HVAC ניתן להעביר פקודות נפרדות לתאורה, למיזוג ולאוורור.'],
  ['איזה גלאי מתאים לחדר מלון?', 'Eelectron MicroFL מתאים במיוחד בזכות הגוף הקטן, חמשת הערוצים והלוגיקה המלונאית. הבחירה הסופית תלויה בגודל החדר ובמיקום הדלת, המיטה וחדר הרחצה.'],
  ['איזה גלאי מתאים לתאורת חוץ?', 'ABB Busch-Watchdog 220 MasterLINE KNX הוא גלאי קווי ייעודי לחוץ, עם IP55, זווית 220 מעלות וטווח של עד 16 מטר.'],
  ['האם גלאי KNX מתאים ל-BMS?', 'כן. ניתן להעביר אירועי נוכחות וערכי חיישנים למערכת BMS באמצעות KNX ובמידת הצורך בקר פרוטוקולים מתאים.']
];

const meta = {
  title: 'גלאי KNX למרלו״גים, חניונים ומסדרונות ארוכים | i-feel',
  description: 'פתרון תאורה למרלו״גים ולחניונים עם מסדרונות ארוכים: חיישני תנועה לטווחי גילוי של כ־15–50 מ׳, המשולבים בבקרת תאורה KNX של Siemens. בנוסף, מדריך לבחירת גלאי KNX.',
  canonical,
  ogTitle: 'גלאי KNX למרלו״גים, חניונים ומעברים ארוכים | i-feel',
  ogDescription: 'תאורה אוטומטית במרלו״גים ובחניונים: חיישנים לטווחי גילוי של כ־15–50 מטר, עם בקרת תאורה מבוססת KNX של Siemens.',
  ogUrl: canonical,
  ogImage: 'https://i-feel.co.il/assets/knx-detectors/siemens-up-258-knx-presence-detector.jpg',
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        '@id': `${canonical}#article`,
        headline: 'גלאי KNX לבית חכם ולמבנה חכם: איזה גלאי מתאים לכל חלל?',
        description: 'מדריך לבחירת גלאי KNX קווי לפי סוג החלל, טווח הגילוי, חיישן התאורה והשילוב עם תאורה, מיזוג ו-BMS.',
        image: [
          'https://i-feel.co.il/assets/knx-detectors/siemens-up-258-knx-presence-detector.jpg',
          'https://i-feel.co.il/assets/knx-detectors/abb-6131-21-24-500-mini-premium-knx.jpg',
          'https://i-feel.co.il/assets/knx-detectors/eelectron-pd00e00knx-basic-presence-detector.jpg',
          'https://i-feel.co.il/assets/knx-detectors/abb-6179-01-masterline-outdoor-knx.jpg'
        ],
        author: { '@type': 'Organization', name: 'i-feel', url: 'https://i-feel.co.il/' },
        publisher: { '@id': 'https://i-feel.co.il/#business' },
        datePublished: '2026-09-12',
        dateModified: '2026-09-24',
        mainEntityOfPage: canonical,
        inLanguage: 'he-IL',
        keywords: ['גלאים למרלו״גים', 'גלאים לחניונים', 'גלאים למסדרונות ארוכים', 'תאורה למרלו״ג', 'חיישני תנועה לטווח ארוך', 'גלאי KNX', 'גלאי נוכחות KNX', 'גלאי תנועה KNX', 'חיישן KNX', 'KNX PIR', 'KNX BMS', 'Siemens KNX', 'ABB KNX', 'Eelectron KNX'],
        about: ['גלאי נוכחות KNX', 'גלאי תנועה KNX', 'חיישני תנועה למרלו״גים ולחניונים', 'בקרת תאורה במסדרונות ארוכים', 'KNX TP', 'חיישן Lux', 'בקרת תאורה', 'HVAC', 'BMS']
      },
      {
        '@type': 'Service',
        '@id': `${canonical}#service`,
        name: 'תכנון והתקנת גלאי נוכחות KNX בישראל',
        serviceType: 'KNX Presence and Motion Sensor Integration',
        url: canonical,
        provider: { '@id': 'https://i-feel.co.il/#business' },
        areaServed: { '@type': 'Country', name: 'Israel' },
        description: 'תכנון, בחירה ומיקום של חיישני תנועה לתאורה אוטומטית במרלו״גים ובחניונים, כולל מעברים ארוכים וטווחי גילוי של כ־15–50 מטר, בשילוב מערכת בקרת תאורה KNX של Siemens.'
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'בית חכם KNX', item: 'https://i-feel.co.il/knx-smart-home/' },
