  .warehouse-card{background:#fff7e8;border:2px solid #f0bd61;border-radius:20px;padding:clamp(1.15rem,3vw,2rem);margin:1rem 0 1.5rem;color:#17324e}.warehouse-card h2{font-size:clamp(1.4rem,3vw,2rem);line-height:1.3;margin:.25rem 0 .75rem;color:#0d2e52}.warehouse-card p{font-size:1.05rem;line-height:1.8;margin:.6rem 0}.warehouse-link{display:inline-block;margin-top:.6rem;background:#092f52;color:#fff;padding:.75rem 1.1rem;border-radius:999px;font-weight:700;text-decoration:none}
  .article-content{background:#fff;border:1px solid #dce6ef;border-radius:24px;padding:clamp(1.3rem,4vw,3.5rem);box-shadow:0 18px 45px rgba(20,35,59,.08)}
  .article-content :global(h1){font-size:clamp(2rem,5vw,3.4rem);line-height:1.12;margin:0 0 1.4rem;color:#0d2e52}
