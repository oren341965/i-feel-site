---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/knx-presence-motion-detectors.html?raw';

const canonical = 'https://i-feel.co.il/knx-presence-motion-detectors/';
const faq = [
  ['האם גלאי KNX זקוק לחשמל נפרד?', 'ברוב הדגמים המתוארים ההזנה והתקשורת מתקבלות מכבל KNX TP. יש לפעול לפי דף הנתונים של כל דגם.'],
  ['האם אותו גלאי יכול לנהל תאורה ומיזוג?', 'כן. בדגמים בעלי מספר ערוצים או פונקציות HVAC ניתן להעביר פקודות נפרדות לתאורה, למיזוג ולאוורור.'],
  ['איזה גלאי מתאים לחדר מלון?', 'Eelectron MicroFL מתאים במיוחד בזכות הגוף הקטן, חמשת הערוצים והלוגיקה המלונאית. הבחירה הסופית תלויה בגודל החדר ובמיקום הדלת, המיטה וחדר הרחצה.'],
  ['איזה גלאי מתאים לתאורת חוץ?', 'ABB Busch-Watchdog 220 MasterLINE KNX הוא גלאי קווי ייעודי לחוץ, עם IP55, זווית 220 מעלות וטווח של עד 16 מטר.'],
  ['האם גלאי KNX מתאים ל-BMS?', 'כן. ניתן להעביר אירועי נוכחות וערכי חיישנים למערכת BMS באמצעות KNX ובמידת הצורך שער פרוטוקולים מתאים.']
];

const meta = {
  title: 'גלאי KNX לבית חכם ול-BMS | מדריך לבחירה נכונה',
  description: 'מדריך מקצועי לבחירת גלאי KNX קווי לבית חכם, מלון, משרד או BMS. השוואת גלאי Siemens, ABB ו-Eelectron, מיקום, טווח ושילוב בתאורה ומיזוג.',
  canonical,
  ogTitle: 'גלאי KNX קוויים לבית חכם ול-BMS | i-feel',
  ogDescription: 'השוואת גלאי נוכחות ותנועה של Siemens, ABB ו-Eelectron, כולל מיקום נכון ושילוב עם תאורה, מיזוג ומערכת BMS.',
  ogUrl: canonical,
  ogImage: 'https://i-feel.co.il/assets/knx-detectors/siemens-up-258-knx-presence-detector.jpg',
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        '@id': `${canonical}#article`,
        headline: 'גלאי KNX לבית חכם ולמבנה חכם: איזה גלאי מתאים לכל חלל?',
        description: 'מדריך לבחירת גלאי KNX קווי לפי סוג החלל, טווח הגילוי, חיישן התאורה והשילוב עם תאורה, מיזוג ו-BMS.',
        image: [
          'https://i-feel.co.il/assets/knx-detectors/siemens-up-258-knx-presence-detector.jpg',
          'https://i-feel.co.il/assets/knx-detectors/abb-6131-21-24-500-mini-premium-knx.jpg',
          'https://i-feel.co.il/assets/knx-detectors/eelectron-pd00e00knx-basic-presence-detector.jpg',
          'https://i-feel.co.il/assets/knx-detectors/abb-6179-01-masterline-outdoor-knx.jpg'
        ],
        author: { '@type': 'Organization', name: 'i-feel', url: 'https://i-feel.co.il/' },
        publisher: { '@id': 'https://i-feel.co.il/#business' },
        datePublished: '2026-09-12',
        dateModified: '2026-09-12',
        mainEntityOfPage: canonical,
        inLanguage: 'he-IL',
        keywords: ['גלאי KNX', 'גלאי נוכחות KNX', 'גלאי תנועה KNX', 'חיישן KNX', 'KNX BMS', 'Siemens KNX', 'ABB KNX', 'Eelectron KNX']
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'בית חכם KNX', item: 'https://i-feel.co.il/knx-smart-home/' },
          { '@type': 'ListItem', position: 3, name: 'גלאי KNX', item: canonical }
        ]
      },
      {
        '@type': 'FAQPage',
        mainEntity: faq.map(([name, text]) => ({
          '@type': 'Question',
          name,
          acceptedAnswer: { '@type': 'Answer', text }
        }))
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <article class="knx-detectors-page" dir="rtl">
    <div class="article-shell">
      <nav class="breadcrumbs" aria-label="פירורי לחם">
        <a href="/">דף הבית</a><span>/</span><a href="/knx-smart-home/">בית חכם KNX</a><span>/</span><span>גלאי KNX</span>
      </nav>
      <div class="article-content" set:html={content} />
      <aside class="article-cta">
        <h2>צריכים לבחור גלאי KNX לפרויקט?</h2>
        <p>צוות I Feel יתאים את הגלאי למבנה, לגובה התקרה, לתאורה, למיזוג ולמערכת ה-BMS.</p>
        <div class="cta-actions">
          <a class="cta-primary" href="/contactus/">לתכנון וקבלת הצעה</a>
          <a class="cta-secondary" href="tel:035089553">03-508-9553</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .knx-detectors-page{background:linear-gradient(180deg,#f4f8fc 0,#fff 18rem);padding:2rem 1rem 5rem;color:#14233b}
  .article-shell{max-width:1040px;margin:0 auto}
  .breadcrumbs{display:flex;gap:.5rem;flex-wrap:wrap;color:#52637a;font-size:.92rem;margin-bottom:1.5rem}
  .breadcrumbs a{color:#075ea8;text-decoration:none}
  .article-content{background:#fff;border:1px solid #dce6ef;border-radius:24px;padding:clamp(1.3rem,4vw,3.5rem);box-shadow:0 18px 45px rgba(20,35,59,.08)}
  .article-content :global(h1){font-size:clamp(2rem,5vw,3.4rem);line-height:1.12;margin:0 0 1.4rem;color:#0d2e52}
  .article-content :global(h2){font-size:clamp(1.45rem,3vw,2rem);line-height:1.25;margin:3rem 0 1rem;color:#0a4f86;border-bottom:2px solid #e4edf5;padding-bottom:.55rem}
  .article-content :global(h3){font-size:1.2rem;margin:1.6rem 0 .65rem;color:#163d63}
  .article-content :global(p),.article-content :global(li){font-size:1.08rem;line-height:1.85}
  .article-content :global(ul){padding-right:1.35rem}
  .article-content :global(code){direction:ltr;unicode-bidi:isolate;background:#eef4f8;padding:.15rem .4rem;border-radius:.35rem;color:#0d416b}
  .article-content :global(img){display:block;width:min(100%,620px);height:auto;max-height:620px;object-fit:contain;margin:2rem auto .7rem;border-radius:18px;background:#fff}
  .article-content :global(em){display:block;text-align:center;color:#607086;font-size:.94rem}
  .article-content :global(table){width:100%;border-collapse:collapse;margin:1.5rem 0;display:block;overflow-x:auto}
  .article-content :global(th),.article-content :global(td){border:1px solid #cfdae5;padding:.75rem;text-align:right;min-width:145px}
  .article-content :global(th){background:#eaf3fa;color:#123b61}
  .article-cta{margin-top:2rem;background:#092f52;color:#fff;border-radius:24px;padding:clamp(1.4rem,4vw,2.6rem);text-align:center}
  .article-cta h2{font-size:clamp(1.5rem,3vw,2.2rem);margin:0 0 .7rem}
  .article-cta p{font-size:1.08rem;line-height:1.7;margin:0 auto 1.3rem;max-width:720px}
  .cta-actions{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap}
  .cta-actions a{padding:.8rem 1.25rem;border-radius:999px;font-weight:700;text-decoration:none}
  .cta-primary{background:#fff;color:#092f52}.cta-secondary{border:1px solid #fff;color:#fff}
  @media(max-width:640px){.knx-detectors-page{padding:1rem .65rem 3rem}.article-content{border-radius:16px}.article-content :global(p),.article-content :global(li){font-size:1rem}}
</style>
