---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-15.html?raw';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://i-feel.co.il/service-and-maintenance/#page',
      url: 'https://i-feel.co.il/service-and-maintenance/',
      name: 'שירות לקוחות ותחזוקה',
      description:
        'אגף השירות של i-feel, פתיחת קריאת שירות, תקלות נפוצות, תמיכה מרחוק, ביקור טכנאי, הסכמי תחזוקה ושדרוגים.',
      inLanguage: 'he-IL',
      isPartOf: { '@id': 'https://i-feel.co.il/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'דף הבית',
          item: 'https://i-feel.co.il/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'שירות לקוחות',
          item: 'https://i-feel.co.il/service-and-maintenance/',
        },
      ],
    },
    {
      '@type': 'Service',
      serviceType: 'Smart Home & BMS Maintenance and Support',
      name: 'שירות לקוחות ותחזוקה, i-feel',
      description:
        'אבחון תקלות, תמיכה מרחוק במערכות שבהן יש גישת רימוט, ביקורי טכנאי, תחזוקת מערכות בית חכם ו-BMS ושדרוגים למערכות קיימות. שעות פעילות: ראשון עד חמישי 09:00 עד 18:00.',
      provider: { '@id': 'https://i-feel.co.il/#business' },
      areaServed: { '@type': 'Country', name: 'Israel' },
      audience: { '@type': 'Audience', audienceType: 'Existing i-feel customers' },
      availableChannel: [
        {
          '@type': 'ServiceChannel',
          name: 'WhatsApp שירות',
          serviceUrl: 'https://wa.me/972533006239',
          servicePhone: '+972-53-300-6239',
        },
        {
          '@type': 'ServiceChannel',
          name: 'טלפון שירות',
          servicePhone: '+972-53-300-6239',
        },
        {
          '@type': 'ServiceChannel',
          name: 'אימייל שירות',
          serviceUrl: 'mailto:support@i-feel.co.il',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'איך פותחים קריאת שירות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'פותחים את טופס השירות באתר וממלאים את פרטי הלקוח, הכתובת ותיאור התקלה. אפשר גם לפנות ב-WhatsApp ל-053-300-6239, בטלפון לאותו מספר או באימייל ל-support@i-feel.co.il.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה צריך להכין לפני פנייה לשירות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "שם הלקוח כפי שמופיע בהסכם השירות, כתובת ההתקנה המלאה, טלפון לחזרה, סוג המערכת, תיאור התקלה, מתי התחילה, מה ניסיתם, האם היא קבועה או לסירוגין, ואם אפשר תמונה או סרטון.",
          },
        },
        {
          '@type': 'Question',
          name: 'האם אפשר לקבל תמיכה מרחוק?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "חלק מהתקלות ניתנות לאבחון מרחוק, אם למערכת יש חיבור אינטרנט פעיל ולצוות שלנו יש הרשאות גישה לרכזת או לפלטפורמת היצרן. תמיכה מרחוק תלויה בסוג המערכת ובכך שהמערכת מוגדרת לתקשורת החוצה.",
          },
        },
        {
          '@type': 'Question',
          name: 'מתי צריך ביקור טכנאי?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'תקלות חומרה, החלפת רכיב פיזי, התקנת תוספות או תקלות שלא ניתן לאבחן מרחוק דורשות ביקור טכנאי. נציג השירות יעדכן מראש ויתאם מועד.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה עושים אם אפליקציית TouchWand אינה מופיעה בחנות Apple?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'אפליקציית TouchWand אינה זמינה עוד בחנות Apple. במכשירי iPhone נכנסים למערכת דרך cloud.touchwand.com וניתן להוסיף את האתר למסך הבית. במכשירי Android ניתן להמשיך להשתמש באפליקציה.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה קורה אחרי הפסקת חשמל?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'רוב מערכות הבית החכם וה-BMS מתאוששות אוטומטית עם חזרת החשמל. אם רכיב מסוים אינו חוזר לעבודה לאחר מספר דקות, פנו לשירות עם תיאור הרכיב.',
          },
        },
        {
          '@type': 'Question',
          name: 'האם ניתן לבקש שדרוגים ותוספות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'כן. ניתן לבקש שדרוגים והוספות למערכת קיימת, כולל בדיקת התאמה למעבר לקונטרולר SmartSphere החדש של i-feel. נציג יבדוק את התשתית, הציוד והתכנות הקיימים ויחזיר הצעת מחיר.',
          },
        },
        {
          '@type': 'Question',
          name: 'איך יוצרים קשר עם מחלקת השירות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'WhatsApp או טלפון: 053-300-6239. אימייל: support@i-feel.co.il. שעות פעילות: ראשון עד חמישי 09:00 עד 18:00.',
          },
        },
      ],
    },
  ],
};

const meta = {
  title: 'שירות לקוחות ותחזוקה | פתיחת קריאת שירות | i-feel',
  description:
    'אגף השירות של i-feel, פתיחת קריאת שירות, תקלות נפוצות, תמיכה מרחוק, ביקור טכנאי והסכמי תחזוקה ללקוחות קיימים.',
  canonical: 'https://i-feel.co.il/service-and-maintenance/',
  ogTitle: 'שירות לקוחות ותחזוקה | i-feel',
  ogDescription:
    'אגף השירות של i-feel, פתיחת קריאת שירות, תקלות נפוצות, תמיכה מרחוק, ביקור טכנאי והסכמי תחזוקה.',
  ogUrl: 'https://i-feel.co.il/service-and-maintenance/',
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(serviceJsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
  <script is:inline>
    document.querySelectorAll('a[href*="63cd83d84533621571484d9b"]').forEach(function (link) {
      link.setAttribute('href', '/service-request/');
      link.removeAttribute('target');
      link.removeAttribute('rel');
    });
  </script>
</BaseLayout>