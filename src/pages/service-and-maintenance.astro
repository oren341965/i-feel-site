---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-15.html?raw';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://i-feel.co.il/service-and-maintenance/#page',
      url: 'https://i-feel.co.il/service-and-maintenance/',
      name: 'שירות לקוחות ותחזוקה',
      description:
        'אגף השירות של i-feel — פתיחת קריאת שירות, תקלות נפוצות, תמיכה מרחוק, ביקור טכנאי, הסכמי תחזוקה ושדרוגים.',
      inLanguage: 'he-IL',
      isPartOf: { '@id': 'https://i-feel.co.il/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'דף הבית',
          item: 'https://i-feel.co.il/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'שירות לקוחות',
          item: 'https://i-feel.co.il/service-and-maintenance/',
        },
      ],
    },
    {
      '@type': 'Service',
      serviceType: 'Smart Home & BMS Maintenance and Support',
      name: 'שירות לקוחות ותחזוקה — i-feel',
      description:
        'אבחון תקלות, תמיכה מרחוק במערכות שבהן יש גישת רימוט, ביקורי טכנאי, תחזוקת מערכות בית חכם ו-BMS, ושדרוגים למערכות קיימות. שעות פעילות: ראשון–חמישי 09:00–18:00.',
      provider: { '@id': 'https://i-feel.co.il/#business' },
      areaServed: { '@type': 'Country', name: 'Israel' },
      audience: { '@type': 'Audience', audienceType: 'Existing i-feel customers' },
      availableChannel: [
        {
          '@type': 'ServiceChannel',
          name: 'WhatsApp שירות',
          serviceUrl: 'https://wa.me/972533006239',
          servicePhone: '+972-53-300-6239',
        },
        {
          '@type': 'ServiceChannel',
          name: 'טלפון שירות',
          servicePhone: '+972-53-300-6239',
        },
        {
          '@type': 'ServiceChannel',
          name: 'אימייל שירות',
          serviceUrl: 'mailto:support@i-feel.co.il',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'איך פותחים קריאת שירות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'שלוש דרכים: ב-WhatsApp ל-053-300-6239 (הכי מהיר), בטלפון לאותו מספר, או באימייל ל-support@i-feel.co.il. לפני שאתם פונים, מומלץ להכין את הפרטים מהרשימה בעמוד הזה — זה מקצר את זמן הטיפול.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה צריך להכין לפני פנייה לשירות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "שם הלקוח כפי שמופיע בהסכם השירות, כתובת ההתקנה המלאה, טלפון לחזרה, סוג המערכת (KNX, Z-Wave, BMS, Siemens וכד'), תיאור התקלה — מתי התחילה, מה ניסיתם, האם זה קורה כל הזמן או לסירוגין, ואם אפשר — תמונה או סרטון של התקלה.",
          },
        },
        {
          '@type': 'Question',
          name: 'האם אפשר לקבל תמיכה מרחוק?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "חלק מהתקלות ניתנות לאבחון מרחוק, אם למערכת יש חיבור אינטרנט פעיל ולצוות שלנו יש הרשאות גישה לרכזת או לפלטפורמת היצרן. תמיכה מרחוק תלויה בסוג המערכת, בפלטפורמה (Touchwand, KNX IP, Siemens Desigo וכד'), ובכך שהמערכת באמת מוגדרת לתקשורת החוצה. במקרים שבהם אין גישת רימוט, יידרש ביקור טכנאי.",
          },
        },
        {
          '@type': 'Question',
          name: 'מתי צריך ביקור טכנאי?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'תקלות חומרה, החלפת רכיב פיזי, התקנת תוספות, או תקלות שלא הצלחנו לאבחן מרחוק — דורשות ביקור טכנאי. היקף הביקור תלוי בסוג הבעיה ובמערכת. נציג השירות יעדכן אתכם מראש מה הצפי, ויקבע מועד מתואם.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה קורה אם החלפתי טלפון?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'ברוב המקרים מספיק להתקין את האפליקציה מחדש בטלפון החדש ולחבר אותה לחשבון הקיים — אין צורך להגדיר את המערכת מחדש. במערכות שבהן הזיהוי הוא לפי המכשיר עצמו (ולא לפי החשבון), נדרש שלב נוסף שניתן לבצע מרחוק. שלחו הודעה ב-WhatsApp ונדריך לפי סוג המערכת.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה קורה אחרי הפסקת חשמל?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'רוב מערכות הבית החכם וה-BMS מתאוששות אוטומטית עם חזרת החשמל. תוך כ-5–10 דקות אחרי הפעלה מחדש המערכת אמורה לחזור לפעולה רגילה. אם רכיב מסוים לא חוזר לעבודה (תריס מסוים, תרחיש תאורה, מסך שליטה), פנו לשירות עם תיאור הרכיב.',
          },
        },
        {
          '@type': 'Question',
          name: 'האם i-feel מטפלת גם באינטרנט, מצלמות, אזעקה ומיזוג?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'אנחנו מטפלים בשכבת הבקרה — בית חכם, KNX, BMS. אינטרנט הוא באחריות ספק האינטרנט שלכם. מצלמות, אזעקה ומיזוג — תלוי במי התקין: אם זו מערכת שאנחנו התקנו או שמופיעה בהסכם — אנחנו מטפלים. אם אלה ספקים אחרים — נכוון אתכם אליהם. בקריאת השירות נציג יבדוק לפי ההסכם הספציפי שלכם.',
          },
        },
        {
          '@type': 'Question',
          name: 'מה ההבדל בין שירות, אחריות והסכם תחזוקה?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'אחריות היא לתקופת אחריות היצרן על המוצר עצמו (משתנה לפי מוצר). שירות הוא פנייה נקודתית לתיקון תקלה — בעלות לפי ההיקף. הסכם תחזוקה הוא חבילה תקופתית שכוללת ביקורים מתוכננים, עדכונים ותמיכה — היקף ותנאים מוגדרים בהסכם הספציפי לכל לקוח.',
          },
        },
        {
          '@type': 'Question',
          name: 'האם ניתן לבקש שדרוגים ותוספות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "כן. ניתן לבקש שדרוגים והוספות למערכת קיימת — מתגים, חיישנים, בקרים, אמצעי שליטה — דרך טופס יצירת קשר ב-/contactus/ עם בחירת 'שדרוגים ותוספות' כסוג הפנייה, או דרך מחלקת המכירות בטלפון 03-508-9553 לפרויקטים והרחבות גדולות. נציג יבדוק תאימות למערכת הקיימת ויחזיר הצעת מחיר.",
          },
        },
        {
          '@type': 'Question',
          name: 'איך יוצרים קשר עם מחלקת השירות?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              'WhatsApp או טלפון: 053-300-6239 · אימייל: support@i-feel.co.il · שעות פעילות: ראשון–חמישי 09:00–18:00. פניות בשעות הפעילות מטופלות בהתאם לעומסים; פניות מחוץ לשעות הפעילות מתועדות ומטופלות בימי העסקים הבאים.',
          },
        },
      ],
    },
  ],
};

const meta = {
  title: 'שירות לקוחות ותחזוקה | פתיחת קריאת שירות | i-feel',
  description:
    'אגף השירות של i-feel — פתיחת קריאת שירות ב-WhatsApp 053-300-6239, support@i-feel.co.il, תקלות נפוצות, תמיכה מרחוק, ביקור טכנאי והסכמי תחזוקה ללקוחות קיימים.',
  canonical: 'https://i-feel.co.il/service-and-maintenance/',
  ogTitle: 'שירות לקוחות ותחזוקה | i-feel',
  ogDescription:
    'אגף השירות של i-feel — פתיחת קריאת שירות, תקלות נפוצות, תמיכה מרחוק, ביקור טכנאי והסכמי תחזוקה. WhatsApp 053-300-6239 · support@i-feel.co.il.',
  ogUrl: 'https://i-feel.co.il/service-and-maintenance/',
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(serviceJsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
