---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/bms-hotels.html?raw';

const pageUrl = "https://i-feel.co.il/bms-hotels/";

const faqNode = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "מה ההבדל בין BMS ל-GRMS במלון?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BMS מנהל את מערכות המבנה המרכזיות, כגון מיזוג, אנרגיה ושטחים ציבוריים. GRMS מנהל את בקרת חדרי האורחים, כגון תאורה, מיזוג, וילונות ותרחישים. במלון ניתן לשלב בין שתי השכבות."
      }
    },
    {
      "@type": "Question",
      "name": "אפשר לשלב BMS ו-GRMS עם מערכת ניהול המלון PMS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "כן. ניתן לתכנן אינטגרציה בין מערכות הבקרה לבין PMS לצורך שימוש בסטטוס תפוסה, צ'ק-אין, צ'ק-אאוט והרשאות, בהתאם לממשקים הזמינים בפרויקט."
      }
    },
    {
      "@type": "Question",
      "name": "איך BMS ו-GRMS יכולים לחסוך אנרגיה במלון?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "החיסכון נובע בעיקר מבקרה על מיזוג ותאורה בחדרים ריקים ובשטחים ציבוריים, לפי תפוסה, שעות פעילות ולוגיקת הבקרה שהוגדרה למלון. היקף החיסכון בפועל תלוי במבנה, בציוד ובדפוסי השימוש."
      }
    },
    {
      "@type": "Question",
      "name": "אפשר להתקין מערכת BMS או GRMS במלון קיים?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "כן. ניתן לבצע retrofit במלון קיים לאחר בדיקת התשתיות, בקרי החדרים, מערכות המיזוג, התקשורת והממשקים הקיימים."
      }
    }
  ]
};

