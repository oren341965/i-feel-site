---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const speakers = [
    {
      model: 'OS55',
      hebrewModel: '55',
      sku: ['OCS5500B', 'OCS5500W'],
      woofer: '5.25 אינץ׳, ממברנת IMG',
      tweeter: '0.75 אינץ׳, אלומיניום',
      range: '63–20,000 הרץ',
      peak: '125 ואט',
      height: 266,
      imageHeight: 220,
      guidance: 'המארז הקומפקטי מתאים כשמקום ההתקנה מוגבל, למשל מעל פינת ישיבה במרפסת או על קורת פרגולה. הכמות והמיקום נקבעים לפי צורת השטח ומרחק ההאזנה.',
      relatedModel: 'OS65',
    },
    {
      model: 'OS65',
      hebrewModel: '65',
      sku: ['OCS6500B', 'OCS6500W'],
      woofer: '4 × 8 אינץ׳, ממברנת IMG ושתי ממברנות פסיביות',
      tweeter: '1 אינץ׳, אלומיניום',
      range: '58–20,000 הרץ',
      peak: '150 ואט',
      height: 334,
      imageHeight: 268,
      guidance: 'הוופר המלבני ושתי הממברנות הפסיביות מרחיבים את תחום התדרים הנמוכים. הדגם מתאים כשיש מקום למארז גבוה יותר ומחפשים יותר נוכחות בבס באזור האירוח.',
      relatedModel: 'OS55',
    },
  ];

  return speakers.map((speaker) => ({
    params: { originModel: `origin-acoustics-${speaker.model.toLowerCase()}` },
    props: { speaker },
  }));
}

const { speaker } = Astro.props;
const { model, relatedModel, sku } = speaker;
const audioUrl = '/audio-and-sound-systems/';
const name = `Origin Acoustics ${model}`;
const site = 'https://i-feel.co.il';
const canonical = new URL(Astro.url.pathname, site).href;
const image = `/assets/av/origin-acoustics-${model.toLowerCase()}.jpg`;
const datasheet = 'https://docs.originacoustics.com/wp-content/uploads/2022/03/OS_AS_Seasons_Datasheet.pdf';
const manual = 'https://docs.originacoustics.com/wp-content/uploads/2022/03/OS_5060-Manual.pdf';
const title = `${name} | רמקול חוץ ומפרט בעברית | I FEEL`;
const description = `רמקול חיצוני ${name} להתקנה על קיר או בפרגולה. מפרט בעברית, 50 ואט RMS, ${speaker.peak} שיא, עכבה 6 אוהם ומדריך התקנה.`;

const bodyDimensions = `גובה ${(speaker.height / 10).toFixed(1)} ס״מ, רוחב ועומק 18.2 על 17.2 ס״מ לפי מפרט היצרן`;
const specs = [
  ['מידות גוף הרמקול', bodyDimensions],
  ['וופר', speaker.woofer],
  ['טוויטר', speaker.tweeter],
  ['תחום תדרים', speaker.range],
  ['הספק נקוב (RMS)', '50 ואט'],
  ['הספק שיא', speaker.peak],
  ['עכבה נומינלית', '6 אוהם'],
  ['חומר מארז', 'פוליאתילן בצפיפות גבוהה (HDPE)'],
  ['גריל', 'אלומיניום'],
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name,
      model,
      description,
      brand: { '@type': 'Brand', name: 'Origin Acoustics' },
      image: site + image,
      url: canonical,
      additionalProperty: specs.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: site + '/' },
        { '@type': 'ListItem', position: 2, name: 'אודיו וקולנוע ביתי', item: site + audioUrl },
        { '@type': 'ListItem', position: 3, name, item: canonical },
      ],
    },
  ],
});
---

<BaseLayout {title} {description} {canonical} {jsonLd}>
  <header class="bg-brand-50 py-10 md:py-14">
    <div class="mx-auto grid max-w-5xl items-center gap-8 px-4 md:grid-cols-[minmax(0,1fr)_260px]">
      <div>
        <nav aria-label="פירורי לחם" class="mb-5 text-sm text-brand-700">
          <a class="underline" href={audioUrl + '#outdoor-speakers'}>רמקולים חיצוניים</a>
        </nav>
        <h1 class="text-3xl font-extrabold text-brand-900 md:text-4xl">
          רמקול חוץ <bdi>{name}</bdi>
        </h1>
        <p class="mt-4 text-lg leading-8 text-brand-800">
          רמקול פסיבי מסדרת Seasons Outdoor להתקנה על קיר, עמוד או קורה, בגינה, במרפסת ובפרגולה. {speaker.guidance}
        </p>
        <p class="mt-4 rounded-lg border border-brand-100 bg-white px-4 py-3 text-brand-900">
          <strong class="block">מידות גוף הרמקול</strong>
          {bodyDimensions}
        </p>
        <p class="mt-3 text-sm text-brand-700">שם הדגם בעברית: אוריג׳ין אקוסטיקס או אס {speaker.hebrewModel}</p>
      </div>
      <figure class="rounded-2xl border border-brand-100 bg-white p-5 text-center">
        <img src={image} width="190" height={speaker.imageHeight} alt={`רמקול ${name} בשחור ובלבן`} class="mx-auto">
        <figcaption class="mt-2 text-sm text-brand-700">צילום מתוך מפרט היצרן</figcaption>
      </figure>
    </div>
  </header>
  <div class="mx-auto max-w-5xl space-y-10 px-4 py-10">
    <section aria-labelledby="specs">
      <h2 id="specs" class="text-2xl font-extrabold text-brand-900">מפרט טכני בעברית</h2>
      <dl class="mt-4 divide-y divide-brand-100 rounded-xl border border-brand-100">
        {specs.map(([label, value]) => (
          <div class="grid gap-1 px-4 py-3 sm:grid-cols-[12rem_minmax(0,1fr)]">
            <dt class="font-semibold text-brand-900">{label}</dt>
            <dd class="text-brand-800">{value}</dd>
          </div>
        ))}
        <div class="grid gap-1 px-4 py-3 sm:grid-cols-[12rem_minmax(0,1fr)]">
          <dt class="font-semibold text-brand-900">מק״טים לפי גימור</dt>
          <dd class="text-brand-800">שחור <bdi>{sku[0]}</bdi>, לבן <bdi>{sku[1]}</bdi></dd>
        </div>
      </dl>
    </section>
    <section aria-labelledby="planning" class="text-brand-800">
      <h2 id="planning" class="text-2xl font-extrabold text-brand-900">תכנון והתקנה</h2>
      <ul class="mt-4 list-disc space-y-2 ps-6 leading-7">
        <li>בוחרים משטח יציב ותושבת שמתאימה למיקום, ומכוונים את הרמקול אל אזור הישיבה.</li>
        <li>מתכננים כבל רמקולים שמתאים לתנאי חוץ ומיקום מוגן ונגיש למגבר. בודקים שהמגבר מתאים לעומס של 6 אוהם ולמספר הרמקולים המחוברים לכל ערוץ.</li>
        <li>מתאימים את מיקום ההתקנה ואת ההגנה על הכבילה לחשיפה לשמש, לגשם ולהשקיה לפי מדריך היצרן.</li>
      </ul>
      <a class="mt-4 inline-block font-semibold text-brand-800 underline" href={`/av/origin-acoustics-${relatedModel.toLowerCase()}/`}>
        להשוואה עם <bdi>Origin Acoustics {relatedModel}</bdi>
      </a>
    </section>
    <section aria-labelledby="documents" class="rounded-2xl bg-brand-50 p-6">
      <h2 id="documents" class="text-2xl font-extrabold text-brand-900">מסמכי היצרן באנגלית</h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3 font-semibold text-brand-800">
        <li><a href={datasheet} class="underline">מפרט יצרן לדגמי OS55 ו־OS65 (PDF)</a></li>
        <li><a href={manual} class="underline">הוראות התקנה וחיווט (PDF)</a></li>
      </ul>
    </section>
    <a href="/contactus/" class="inline-block rounded-lg bg-brand-900 px-5 py-3 font-semibold text-white">
      לתיאום תכנון אודיו חוץ עם I FEEL
    </a>
  </div>
</BaseLayout>
