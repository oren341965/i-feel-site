---
import BaseLayout from '../../layouts/BaseLayout.astro';
const canonical = 'https://i-feel.co.il/av/cabasse-alcyone-2/';
const title = 'רמקולים Cabasse Alcyone 2 | מפרט, עוצמה, מידות ו-PDF | I FEEL';
const description = 'רמקולים כדוריים Cabasse Alcyone 2 בקוטר 9.9 ס״מ, 50W נומינלי, 350W שיא, 87dB, התקנה על קיר או מדף. כל הנתונים והמפרט PDF באנגלית.';
const pdf = 'https://crazyedi.co.il/wp-content/uploads/2022/12/FT-ALCYONE-2-GB-12-10-12-web_compressed.pdf';
const jsonLd = JSON.stringify({'@context':'https://schema.org','@graph':[
 {'@type':'Product',name:'Cabasse Alcyone 2 Satellite',description,brand:{'@type':'Brand',name:'Cabasse'},url:canonical,additionalProperty:[
 { '@type':'PropertyValue',name:'Diameter',value:'99 mm' },
 { '@type':'PropertyValue',name:'Nominal power handling',value:'50 W' },
 { '@type':'PropertyValue',name:'Peak power handling',value:'350 W' },
 { '@type':'PropertyValue',name:'Frequency response',value:'160–20,000 Hz' },
 { '@type':'PropertyValue',name:'Sensitivity',value:'87 dB (1 W / 1 m)' },
 { '@type':'PropertyValue',name:'Nominal impedance',value:'8 ohm' }]},
 {'@type':'BreadcrumbList',itemListElement:[
 {'@type':'ListItem',position:1,name:'בית',item:'https://i-feel.co.il/'},
 {'@type':'ListItem',position:2,name:'אודיו וקולנוע ביתי',item:'https://i-feel.co.il/audio-and-sound-systems/'},
 {'@type':'ListItem',position:3,name:'Cabasse Alcyone 2',item:canonical}]}
]});
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl={canonical} jsonLd={jsonLd}>
 <main dir="rtl">
  <header class="bg-brand-900 text-white py-14"><div class="mx-auto max-w-6xl px-4">
   <nav class="text-sm text-brand-100 mb-5"><a class="underline" href="/audio-and-sound-systems/">אודיו וקולנוע ביתי</a> / Cabasse Alcyone 2</nav>
   <p class="font-bold text-accent-300">CABASSE · ALCYONE 2</p>
   <h1 class="mt-3 text-3xl md:text-5xl font-extrabold">רמקולים כדוריים Cabasse Alcyone 2</h1>
   <p class="mt-5 max-w-3xl text-lg leading-8">צליל נקי במארז כדורי קטן במיוחד, בקוטר 9.9 ס״מ. רמקולים מעוצבים למערכת קולנוע ביתי או מוזיקה, עם התקנה גמישה על הקיר, על מדף או על מעמד ייעודי.</p>
   <a href={pdf} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block rounded-lg bg-white px-6 py-3 font-bold text-brand-900">לצפייה במפרט הטכני PDF באנגלית</a>
  </div></header>
  <div class="mx-auto max-w-6xl px-4 py-10">
   <section aria-labelledby="specs"><h2 id="specs" class="text-2xl font-extrabold text-brand-900">מפרט טכני של רמקול Alcyone 2</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-6">
     {[
      ['גודל','קוטר 99 מ״מ (9.9 ס״מ)'],
      ['הספק נומינלי','50W לרמקול'],
      ['הספק שיא','350W לרמקול, נתון שיא ולא הספק רציף'],
      ['תחום תדרים','160–20,000Hz'],
      ['רגישות','87dB (במרחק מטר, בהספק 1W)'],
      ['עכבה','8Ω נומינלית, 4.6Ω מינימלית'],
      ['משקל','0.75 ק״ג לרמקול'],
      ['גימורים','שחור מבריק / לבן מבריק']
     ].map(([label,value])=><div class="rounded-xl border border-brand-200 p-5"><h3 class="text-sm font-semibold text-brand-600">{label}</h3><p class="mt-2 text-lg font-bold text-brand-900">{value}</p></div>)}
    </div>
   </section>
   <section class="mt-12 max-w-4xl leading-8 text-brand-800"><h2 class="text-2xl font-extrabold text-brand-900">יכולת שמע, התאמה והתקנה</h2>
    <p class="mt-4">הרמקול כולל יחידת דרייבר רחבת פס בקוטר כ-8 ס״מ, עם ממברנת סיבי תאית. התכנון הכדורי הקומפקטי והבסיס המגנטי מאפשרים לכוון את הרמקול לעבר אזור ההאזנה. ניתן להציבו על מדף, לחבר לקיר או להשתמש במעמד תואם, בכפוף לזמינות האביזרים.</p>
    <p class="mt-4">למרות גודלו הקטן, הרמקול מיועד לשימוש במערכות קולנוע ביתי. תחום התדרים מתחיל ב-160Hz, ולכן להשמעת בס עמוק מומלץ להוסיף סאבוופר ולהגדיר חיתוך תדרים מתאים ברסיבר. מדובר ברמקול פסיבי המחייב מגבר או רסיבר תואם, ולא ברמקול Bluetooth עצמאי.</p>
    <h3 class="mt-8 text-xl font-bold text-brand-900">אפשרות למערכת קולנוע ביתי 5.1</h3>
    <p class="mt-3">מפרט היצרן מציג גם ערכת 5.1 הכוללת חמישה רמקולי Alcyone 2 וסאבוופר אקטיבי Santorin 17M2, עם וופר 17 ס״מ, מגבר 100W, תחום תדרים 32–300Hz ומידות 30 × 30 × 30 ס״מ. ההרכב והאביזרים בפועל יאושרו בהצעת המחיר.</p>
   </section>
   <section class="mt-12 rounded-2xl bg-brand-50 p-6 md:p-8">
    <h2 class="text-2xl font-extrabold text-brand-900">מפרט היצרן להורדה</h2>
    <p class="mt-3 text-brand-700 leading-7">Cabasse ALCYONE 2, מסמך באנגלית עם תיאור המוצר, נתוני הרמקול והסאבוופר. הקישור מוביל לקובץ PDF המאוחסן באתר חיצוני; הזמינות תלויה באתר המקור.</p>
    <a href={pdf} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block rounded-lg bg-accent-500 px-6 py-3 font-bold text-white hover:bg-accent-600">פתיחת ALCYONE 2 Datasheet (PDF)</a>
   </section>
   <aside class="mt-12"><h2 class="text-2xl font-bold text-brand-900">תכנון מערכת אודיו עם I FEEL</h2><p class="mt-3 text-brand-700 leading-8">נשמח לסייע בהתאמת מיקום הרמקולים, סוג המגבר והסאבוופר לפי גודל החדר, עיצוב הבית והשימוש המבוקש.</p><a href="mailto:sales@i-feel.co.il?subject=Cabasse%20Alcyone%202" class="mt-4 inline-block underline font-bold text-accent-700">בקשת הצעת מחיר או מידע נוסף</a></aside>
  </div>
 </main>
</BaseLayout>
