---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-12.html?raw';

const partnerCertificateUrl = 'https://i-feel.co.il/assets/certifications/siemens-solution-partner-building-automation-2026.pdf';
const partnerJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://i-feel.co.il/license/#siemens-solution-partner',
      url: 'https://i-feel.co.il/license/',
      name: 'Siemens Solution Partner בישראל | i-feel',
      inLanguage: 'he-IL',
      about: [
        { '@type': 'Thing', name: 'Siemens Solution Partner' },
        { '@type': 'Thing', name: 'Building Automation' },
        { '@type': 'Thing', name: 'Siemens Desigo' },
        { '@type': 'Thing', name: 'BMS בישראל' }
      ],
      isPartOf: { '@id': 'https://i-feel.co.il/license/#page' },
      mainEntity: {
        '@type': 'DigitalDocument',
        name: 'Siemens Solution Partner — Building Automation 2026',
        url: partnerCertificateUrl,
        encodingFormat: 'application/pdf',
        about: 'אישור Siemens Solution Partner של i-feel בתחום Building Automation לשנת 2026'
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'האם i-feel היא Siemens Solution Partner בישראל?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'כן. i-feel היא Siemens Solution Partner בתחום Building Automation. אישור 2026 זמין באתר לצפייה כ-PDF, לצד מידע על פרויקטי Siemens Desigo ו-BMS בישראל.'
          }
        }
      ]
    }
  ]
};

const meta = {
  title: "Siemens Solution Partner בישראל | אישורים ותקינה | i-feel",
  description: "i-feel היא Siemens Solution Partner בתחום Building Automation. צפו באישור 2026 ובמסמכי התקינה של החברה, לצד קישורים ל-Siemens Desigo ולפרויקטי BMS בישראל.",
  canonical: "https://i-feel.co.il/license/",
  ogTitle: "Siemens Solution Partner בישראל | i-feel",
  ogDescription: "אישור Siemens Solution Partner בתחום Building Automation לשנת 2026, לצד אישורי תקינה והכשרה של i-feel.",
  ogUrl: "https://i-feel.co.il/license/",
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: "{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"CollectionPage\",\n      \"@id\": \"https://i-feel.co.il/license/#page\",\n      \"url\": \"https://i-feel.co.il/license/\",\n      \"name\": \"אישורים, רישיונות ותקינה — i-feel\",\n      \"description\": \"מסמכי תקינה ואישורים של i-feel — Siemens Solution Partner לאוטומציית מבנים, אישורי מכון התקנים, אישור הלכתי, ISO לציוד ABB, חברות ב-Z-Wave Alliance ותעודות הכשרה.\",\n      \"inLanguage\": \"he-IL\",\n      \"isPartOf\": { \"@id\": \"https://i-feel.co.il/#website\" }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\"@type\":\"ListItem\",\"position\":1,\"name\":\"דף הבית\",\"item\":\"https://i-feel.co.il/\"},\n        {\"@type\":\"ListItem\",\"position\":2,\"name\":\"אישורים ותקינה\",\"item\":\"https://i-feel.co.il/license/\"}\n      ]\n    },\n    {\n      \"@type\": \"ItemList\",\n      \"name\": \"מסמכי תקינה ואישורים\",\n      \"numberOfItems\": 13,\n      \"itemListElement\": [\n        {\"@type\":\"ListItem\",\"position\":1,\"name\":\"מכון התקנים — Wall Controller (Wallwand)\",\"url\":\"https://i-feel.co.il/assets/certifications/sii-wallwand.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":2,\"name\":\"מכון התקנים — In Wand\",\"url\":\"https://i-feel.co.il/assets/certifications/sii-inwand.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":3,\"name\":\"מכון התקנים — ספק כוח KNX ABB\",\"url\":\"https://i-feel.co.il/assets/certifications/sii-knx-abb-power-supply.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":4,\"name\":\"מכון התקנים הישראלי\",\"url\":\"https://i-feel.co.il/assets/certifications/sii-general-9972361571.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":5,\"name\":\"אישור המכון הטכנולוגי להלכה 2023\",\"url\":\"https://i-feel.co.il/assets/certifications/halachic-approval-2023.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":6,\"name\":\"תעודות הסמכה ISO לציוד ABB\",\"url\":\"https://i-feel.co.il/assets/certifications/iso-abb-equipment.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":7,\"name\":\"Siemens Solution Partner — Building Automation 2026\",\"url\":\"https://i-feel.co.il/assets/certifications/siemens-solution-partner-building-automation-2026.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":8,\"name\":\"Z-Wave Alliance — Membership Application Agreement\",\"url\":\"https://i-feel.co.il/assets/certifications/zwave-alliance-membership-application.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":9,\"name\":\"Z-Wave Alliance — Membership Certificate\",\"url\":\"https://i-feel.co.il/assets/certifications/zwave-membership-certificate.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":10,\"name\":\"ABB Training Certificate — CXproHD (Sergei Sentarov)\",\"url\":\"https://i-feel.co.il/assets/certifications/abb-training-cxprohd-sentarov.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":11,\"name\":\"ABB Training Certificate — CXproHD (Kiril Banih)\",\"url\":\"https://i-feel.co.il/assets/certifications/abb-training-cxprohd-banih.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":12,\"name\":\"Siemens Desigo CC Basic Engineering — Level 1 (Cheyne Evans)\",\"url\":\"https://i-feel.co.il/assets/certifications/siemens-desigo-cc-basic-engineering-level-1-cheyne-evans.pdf\"},\n        {\"@type\":\"ListItem\",\"position\":13,\"name\":\"Siemens Desigo CC Basic Engineering — Level 1 (Sergei Senatorov)\",\"url\":\"https://i-feel.co.il/assets/certifications/siemens-desigo-cc-basic-engineering-level-1-sergei-senatorov.pdf\"}\n      ]\n    }\n  ]\n}"
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />

  <section class="max-w-5xl mx-auto px-4 pb-14" dir="rtl" aria-labelledby="siemens-partner-israel">
    <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6 md:p-8">
      <p class="text-sm font-bold text-accent-600 mb-2">אימות הסמכה</p>
      <h2 id="siemens-partner-israel" class="text-2xl md:text-3xl font-extrabold text-brand-900 mb-4">Siemens Solution Partner בישראל</h2>
      <p class="text-brand-700 leading-8 mb-4"><strong>i-feel היא Siemens Solution Partner בתחום Building Automation.</strong> אישור 2026 זמין באתר לצפייה ישירה, לצד מידע מפורט על פרויקטי Siemens Desigo ו-BMS בישראל.</p>
      <p class="text-brand-700 leading-8 mb-5">לבדיקת היכולת בפועל אפשר לעבור מעמוד ההסמכה לעמוד <a class="font-semibold text-accent-600 hover:underline" href="/siemens-desigo-bms/">Siemens Desigo בישראל</a>, לעמוד <a class="font-semibold text-accent-600 hover:underline" href="/structure-control/">בקרת מבנה BMS</a> ולמקרה הבוחן של <a class="font-semibold text-accent-600 hover:underline" href="/structure-control/caesarea-rail-campus/">קמפוס רכבת קיסריה</a>.</p>
      <a class="inline-flex items-center justify-center rounded-lg bg-accent-500 px-5 py-3 font-bold text-white hover:bg-accent-600" href={partnerCertificateUrl} target="_blank" rel="noopener">צפייה באישור Siemens 2026</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(partnerJsonLd)} />
</BaseLayout>
