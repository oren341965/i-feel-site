---
import BaseLayout from '../layouts/BaseLayout.astro';
import OutdoorLedQuoteForm from '../components/OutdoorLedQuoteForm.astro';
import content from '../page-html/outdoor-led-screens.html?raw';

const meta = {
  title: "מסכי LED חוץ לגינה ולווילה | P2.976 ו-DICOLOR | i-feel",
  description: "תכנון מסך Outdoor LED לגינה ולווילה: P2.976, בהירות 5,500 nits ומעלה, IP65, תחזוקה ובקרת NovaStar. אפיון מקצועי: 03-508-9553.",
  canonical: "https://i-feel.co.il/outdoor-led-screens/",
  ogTitle: "מסכי LED חוץ לגינה ולווילה | i-feel",
  ogDescription: "מדריך לבחירת מסך LED מודולרי לחוץ: בהירות, IP65, Pixel Pitch, זווית צפייה, תחזוקה, בקרה ותשתיות.",
  ogUrl: "https://i-feel.co.il/outdoor-led-screens/",
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
        '@id': 'https://i-feel.co.il/#business',
        name: 'i-feel',
        url: 'https://i-feel.co.il/',
        telephone: '+972-3-508-9553',
        email: 'sales@i-feel.co.il',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'אימבר 14',
          addressLocality: 'פתח תקווה',
          addressRegion: 'מחוז המרכז',
          postalCode: '4951148',
          addressCountry: 'IL'
        },
        areaServed: { '@type': 'Country', name: 'Israel' }
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'אודיו וקולנוע ביתי', item: 'https://i-feel.co.il/audio-and-sound-systems/' },
          { '@type': 'ListItem', position: 3, name: 'מסכי LED חוץ', item: 'https://i-feel.co.il/outdoor-led-screens/' }
        ]
      },
      {
        '@type': 'Service',
        '@id': 'https://i-feel.co.il/outdoor-led-screens/#service',
        url: 'https://i-feel.co.il/outdoor-led-screens/',
        name: 'תכנון ושילוב מסכי LED חוץ לגינה ולווילה',
        serviceType: 'Outdoor LED Display Planning and Integration',
        provider: { '@id': 'https://i-feel.co.il/#business' },
        areaServed: { '@type': 'Country', name: 'Israel' },
        description: 'אפיון, תכנון תשתיות, שילוב, התקנה וכיול של מסכי LED מודולריים לשטחי חוץ בווילות ובגינות.'
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          { '@type': 'Question', name: 'איזו בהירות צריך למסך LED בגינה?', acceptedAnswer: { '@type': 'Answer', text: 'הבהירות נקבעת לפי כיוון המסך, שעות השימוש והחשיפה לשמש. בתצורת P2.976 המתועדת בעמוד המפרט הוא 5,500 nits ומעלה, אך ההתאמה הסופית נקבעת לאחר בדיקת האתר.' } },
          { '@type': 'Question', name: 'מה המשמעות של P2.976?', acceptedAnswer: { '@type': 'Answer', text: 'P2.976 הוא Pixel Pitch של 2.976 מ״מ, כלומר המרחק בין מרכזי פיקסלים סמוכים. פסיעה קטנה מאפשרת צפייה מפורטת יותר מטווח קרוב, אך אינה מחליפה תכנון של גודל המסך ומרחק הצפייה.' } },
          { '@type': 'Question', name: 'באילו גדלים אפשר לבנות מסך Outdoor LED?', acceptedAnswer: { '@type': 'Answer', text: 'מסך LED מודולרי נבנה כרשת קבינטים. בתצורה המתועדת הקבינט הוא בגודל 1×1 מטר וברזולוציה 336×336 פיקסלים, ולכן לדוגמה מסך 4×2 מטר הוא ברזולוציה פיזית 1344×672. המידה הסופית נקבעת לפי הקיר, יחס התמונה, מרחק הצפייה והקונסטרוקציה.' } },
          { '@type': 'Question', name: 'האם בקר NovaStar עם כניסת 4K הופך את המסך למסך 4K?', acceptedAnswer: { '@type': 'Answer', text: 'לא. כניסת 4K היא יכולת של הבקר לקבל ולעבד מקור וידאו. הרזולוציה הפיזית של המסך נקבעת לפי מספר הקבינטים והפיקסלים. הבקר ממפה את המקור לרזולוציית המסך בפועל.' } },
          { '@type': 'Question', name: 'איזה מידע צריך כדי לקבל הצעה למסך LED חוץ?', acceptedAnswer: { '@type': 'Answer', text: 'כדי להכין הצעה מדויקת צריך מידה רצויה, מיקום, מרחק צפייה קרוב, חשיפה לשמש, שימוש עיקרי, מקורות וידאו, שלב הפרויקט ופרטים על תשתיות, קונסטרוקציה ואודיו.' } },
          { '@type': 'Question', name: 'האם IP65 מספיק למסך חוץ?', acceptedAnswer: { '@type': 'Answer', text: 'IP65 מציין הגנה מאבק ומסילוני מים לפי דירוג המעטפת. עדיין נדרשים תכנון ניקוז, אוורור, קונסטרוקציה, חשמל ותחזוקה המתאימים למיקום בפועל.' } },
          { '@type': 'Question', name: 'מי היצרן ומי היבואן של המסך?', acceptedAnswer: { '@type': 'Answer', text: 'DICOLOR היא יצרנית מסכי LED. יבוא או הפצה בישראל הם תפקיד מסחרי נפרד, ו-i-feel מתכננת ומשלבת את המערכת בהתאם לפרויקט. אין בעמוד טענה ש-i-feel היא נציגה רשמית של DICOLOR.' } }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
  <OutdoorLedQuoteForm />
</BaseLayout>
