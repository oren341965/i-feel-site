---
import BaseLayout from '../layouts/BaseLayout.astro';

const formUrl = 'https://www.superform.spot-nik.com/form/63cd83d84533621571484d9b';
const canonical = 'https://i-feel.co.il/service-request/';

const meta = {
  title: 'פתיחת קריאת שירות | i-feel',
  description: 'פתיחת קריאת שירות ללקוחות i-feel. לפני פתיחת קריאה בנושא אפליקציית TouchWand באייפון, מומלץ לקרוא את דף ההסבר הייעודי.',
  canonical,
  ogTitle: 'פתיחת קריאת שירות | i-feel',
  ogDescription: 'טופס קריאת השירות של i-feel ומידע מקדים ללקוחות TouchWand.',
  ogUrl: canonical,
  robots: 'noindex, follow',
};
---

<BaseLayout {...meta}>
  <nav class="border-b border-brand-100 bg-brand-50" aria-label="פירורי לחם">
    <div class="mx-auto max-w-6xl px-4 py-3 text-sm">
      <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
      <span class="mx-2 text-brand-400">›</span>
      <a href="/service-and-maintenance/" class="text-brand-600 hover:text-accent-600">שירות ותחזוקה</a>
      <span class="mx-2 text-brand-400">›</span>
      <span class="font-medium text-brand-900">פתיחת קריאת שירות</span>
    </div>
  </nav>

  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <p class="text-sm font-bold text-accent-400">ללקוחות קיימים</p>
      <h1 class="mt-3 text-4xl font-extrabold md:text-5xl">פתיחת קריאת שירות</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-brand-100">
        מלאו את הטופס עם פרטי הלקוח, הכתובת ותיאור התקלה. ככל שתצרפו מידע מדויק, תמונות או סרטון, נוכל לקצר את זמן האבחון והטיפול.
      </p>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <section class="rounded-2xl border-2 border-amber-300 bg-amber-50 p-6 shadow-sm md:p-8" aria-labelledby="touchwand-notice-title">
      <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="text-sm font-extrabold text-amber-800">לפני פתיחת קריאה בנושא TouchWand</p>
          <h2 id="touchwand-notice-title" class="mt-2 text-2xl font-extrabold text-brand-900">
            לא מוצאים את אפליקציית TouchWand באייפון?
          </h2>
          <p class="mt-3 leading-7 text-brand-700">
            אפליקציית TouchWand אינה זמינה עוד בחנות האפליקציות של Apple. אפשר להמשיך לשלוט במערכת באייפון ישירות דרך הענן. ייתכן שאין צורך לפתוח קריאת שירות.
          </p>
        </div>
        <a href="/touchwand-app/" class="rounded-xl bg-brand-900 px-6 py-3.5 text-center font-bold text-white transition hover:bg-brand-800">
          להסבר ולכניסה למערכת
        </a>
      </div>
    </section>

    <section class="mt-8 rounded-2xl border border-brand-100 bg-white p-4 shadow-lg md:p-6" aria-labelledby="service-form-title">
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="service-form-title" class="text-2xl font-extrabold text-brand-900">טופס קריאת השירות</h2>
          <p class="mt-1 text-sm leading-6 text-brand-600">הטופס מאובטח ונפתח באמצעות מערכת SuperForm.</p>
        </div>
        <a href={formUrl} target="_blank" rel="noopener noreferrer" data-direct-service-form class="shrink-0 rounded-xl border-2 border-brand-900 px-5 py-3 text-center font-bold text-brand-900 transition hover:bg-brand-900 hover:text-white">
          פתיחת הטופס בחלון חדש ↗
        </a>
      </div>

      <div class="overflow-hidden rounded-xl border border-brand-100 bg-brand-50">
        <iframe
          src={formUrl}
          title="טופס פתיחת קריאת שירות של i-feel"
          class="block h-[1250px] w-full bg-white md:h-[1150px]"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>

      <noscript>
        <p class="mt-5 rounded-xl bg-brand-50 p-4 text-brand-800">
          כדי למלא את הטופס יש להפעיל JavaScript או לפתוח אותו ישירות בקישור שמעל.
        </p>
      </noscript>
    </section>
  </main>
</BaseLayout>
