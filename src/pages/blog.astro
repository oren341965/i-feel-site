---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/articles';

const title = 'בלוג i-feel | מאמרים ומדריכים';
const description = 'בלוג i-feel מפנה למרכז המאמרים המעודכן: בית חכם, KNX, BMS, יזמים, אדריכלים ושירות.';
const canonical = 'https://i-feel.co.il/articles/';
---
<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl="https://i-feel.co.il/blog/">
  <section class="bg-brand-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4">
      <p class="text-accent-400 font-semibold mb-3">בלוג</p>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-5">מאמרים ומדריכים</h1>
      <p class="max-w-3xl text-lg text-brand-100">
        העברנו את המאמרים למרכז ידע מסודר עם עמוד מלא לכל נושא.
      </p>
      <a href="/articles/" class="inline-block mt-6 bg-accent-500 hover:bg-accent-600 text-white px-6 py-3 rounded-lg font-bold transition">
        למרכז המאמרים
      </a>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
        <article class="border border-brand-100 rounded-lg p-6">
          <p class="text-sm font-semibold text-accent-600 mb-2">{article.category}</p>
          <h2 class="text-2xl font-bold mb-3">
            <a href={`/articles/${article.slug}/`} class="hover:text-accent-600">{article.title}</a>
          </h2>
          <p class="text-brand-600 mb-4">{article.description}</p>
          <a href={`/articles/${article.slug}/`} class="font-bold text-accent-700 hover:text-accent-600">קרא את המאמר המלא</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
