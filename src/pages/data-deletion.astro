---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/data-deletion.html?raw';

const url = 'https://i-feel.co.il/data-deletion/';
const meta = {
  title: 'מחיקת נתונים | I FEEL AI Sales Manager | i-feel',
  description: 'הוראות להסרת I FEEL AI Sales Manager מ-Meta ולהגשת בקשת מחיקה, ניתוק או אנונימיזציה של מידע שנשמר ב-i-feel. סיוע: 03-508-9553.',
  canonical: url,
  ogTitle: 'מחיקת נתונים | I FEEL AI Sales Manager',
  ogDescription: 'כך מבטלים את חיבור Meta ומגישים ל-i-feel בקשה למחיקה או לניתוק של מידע.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'LocalBusiness',
        '@id': 'https://i-feel.co.il/#business',
        'name': 'i-feel',
        'url': 'https://i-feel.co.il/',
        'telephone': '+972-3-508-9553',
        'email': 'oren@i-feel.co.il',
        'address': {
          '@type': 'PostalAddress',
          'streetAddress': 'אימבר 14',
          'addressLocality': 'פתח תקווה',
          'postalCode': '4951148',
          'addressCountry': 'IL'
        }
      },
      {
        '@type': 'WebPage',
        '@id': `${url}#page`,
        'url': url,
        'name': 'מחיקת נתונים מ־I FEEL AI Sales Manager',
        'description': 'הוראות לביטול חיבור Meta ולהגשת בקשת מחיקת נתונים ל-i-feel.',
        'inLanguage': 'he-IL',
        'datePublished': '2026-09-07',
        'dateModified': '2026-09-07',
        'about': { '@id': 'https://i-feel.co.il/#business' }
      },
      {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'דף הבית', 'item': 'https://i-feel.co.il/' },
          { '@type': 'ListItem', 'position': 2, 'name': 'מחיקת נתונים', 'item': url }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
