---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/articles/siemens-n532d31-knx-4-switch-output/';
const title = 'Siemens N 532D31: בקר KNX עם 4 יציאות 10AX | i-feel';
const description = 'הכירו את Siemens N 532D31, בקר מיתוג KNX קומפקטי עם 4 יציאות ממסר פוטנציאל חופשי, דירוג 10AX, התאמה לעומסי C ופונקציות ETS מתקדמות.';
const productImage = 'https://mall.industry.siemens.com/mall/collaterals/files/197/jpg/04/78/P_I201_XX_08403i.jpg';
const dataSheetUrl = 'https://sid.siemens.com/v/u/A6V11252209';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Siemens N 532D31: בקר KNX עם 4 יציאות מיתוג 10AX',
  description,
  datePublished: '2026-07-31',
  dateModified: '2026-07-31',
  inLanguage: 'he-IL',
  mainEntityOfPage: canonical,
  image: productImage,
  author: { '@type': 'Organization', name: 'i-feel', url: 'https://i-feel.co.il/' },
  publisher: { '@type': 'Organization', name: 'i-feel', url: 'https://i-feel.co.il/' },
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  ogImage={productImage}
  jsonLd={jsonLd}
>
  <article class="bg-white" dir="rtl">
    <header class="bg-brand-900 text-white py-16 md:py-20">
      <div class="max-w-5xl mx-auto px-4">
        <a href="/articles/" class="text-accent-400 font-semibold hover:text-accent-300">מאמרים</a>
        <p class="mt-4 text-sm text-brand-200">Siemens GAMMA / KNX · עודכן 31.07.2026</p>
        <h1 class="mt-4 text-4xl md:text-5xl font-extrabold leading-tight">
          Siemens N 532D31: בקר KNX עם 4 יציאות מיתוג 10AX
        </h1>
        <p class="mt-5 max-w-4xl text-lg md:text-xl text-brand-100 leading-relaxed">
          פתרון קומפקטי לארבעה מעגלי תאורה או עומסים, עם ממסרים פוטנציאל חופשי, התאמה לעומסי C ופונקציות אוטומציה מתקדמות.
        </p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 py-12">
      <section class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 items-center mb-12">
        <div class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm">
          <img
            src={productImage}
            alt="בקר מיתוג Siemens N 532D31 עם 4 יציאות למערכת KNX"
            width="1000"
            height="800"
            loading="eager"
            class="w-full h-auto object-contain"
            referrerpolicy="no-referrer"
          />
        </div>
        <div>
          <p class="text-accent-700 font-bold text-lg mb-3">מידע עבור הלקוח</p>
          <h2 class="text-3xl font-extrabold text-brand-900 leading-tight mb-5">ארבע יציאות איכותיות, ברוחב של ארבעה מודולים</h2>
          <p class="text-lg text-brand-700 leading-relaxed mb-5">
            Siemens N 532D31 הוא בקר מיתוג KNX קומפקטי המיועד לארבעה מעגלי תאורה, שקעים או עומסים מתאימים. הוא נותן את היכולות המרכזיות של משפחת N 532 גם בפרויקט קטן, באזור נפרד או בלוח שבו חשוב לחסוך מקום.
          </p>
          <a href={dataSheetUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-accent-600 px-5 py-3 font-bold text-white transition hover:bg-accent-700">
            פתיחת ה-Datasheet הרשמי של Siemens
          </a>
        </div>
      </section>

      <section class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-14" aria-label="נתונים מרכזיים">
        <div class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">4</div><div class="mt-2 text-sm font-semibold">יציאות ממסר</div></div>
        <div class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">10AX</div><div class="mt-2 text-sm font-semibold">דירוג מיתוג</div></div>
        <div class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">230V</div><div class="mt-2 text-sm font-semibold">מתח מיתוג</div></div>
        <div class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">4</div><div class="mt-2 text-sm font-semibold">מודולים בלוח</div></div>
        <div class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">140µF</div><div class="mt-2 text-sm font-semibold">עומס קיבולי מרבי</div></div>
      </section>

      <div class="prose-he max-w-none">
        <section>
          <h2>ארבע יציאות עצמאיות ופוטנציאל חופשי</h2>
          <p>
            הבקר כולל ארבעה ממסרים דו יציבים. כל יציאה מיועדת לקבוצה חשמלית עצמאית וכוללת מגע פוטנציאל חופשי, כך שניתן לבנות חלוקת מעגלים גמישה בהתאם לתכנון הלוח ולהזנות הנדרשות.
          </p>
          <p>
            הוא מתאים לעומסים התנגדותיים, השראתיים וקיבוליים, לרבות תאורה, שקעים, פיקודים ועומסים נוספים, בכפוף לנתוני היצרן ולתכנון מקצועי של החשמל.
          </p>
        </section>

        <section>
          <h2>10AX ועומסי C במוצר קומפקטי</h2>
          <p>
            דירוג 10AX והתאמה לעומס קיבולי של עד 140µF הופכים את N 532D31 לפתרון מתאים למעגלי תאורה מודרניים, שבהם קיימים לעיתים דרייברים וספקי כוח עם זרם התנעה גבוה.
          </p>
          <p>
            יש לבדוק בכל מעגל את זרם ההתנעה של הציוד בפועל. מספר גופי התאורה שניתן לחבר אינו נקבע רק לפי ההספק הנומינלי, אלא גם לפי נתוני הדרייבר, ההגנות והחיווט.
          </p>
        </section>

        <section>
          <h2>מחוון מכני ובדיקת יציאות מהלוח</h2>
          <p>
            לכל יציאה יש מחוון מכני המציג אם מגע הממסר פתוח או סגור. ניתן לשנות את מצב הממסר באמצעות כלי מתאים, לצורך בדיקה בזמן ההתקנה או לשימוש חירום.
          </p>
          <p>
            הפעלה מכנית אינה משדרת הודעה לקו ה-KNX ואינה נרשמת על ידי הבקר. לכן היא אינה מחליפה שליטה דרך המערכת או בדיקה ב-ETS.
          </p>
        </section>

        <section>
          <h2>פונקציות מתקדמות ב-ETS</h2>
          <ul>
            <li>מיתוג עם משוב מצב לכל יציאה.</li>
            <li>לוגיקה ושליטה מרכזית.</li>
            <li>השהיות, הפעלה מוגבלת בזמן ומצב לילה.</li>
            <li>התראה לפני כיבוי.</li>
            <li>עד שמונה סצנות לכל ערוץ.</li>
            <li>עד שבע פונקציות Override.</li>
            <li>ספירת מחזורי מיתוג ושעות עבודה.</li>
            <li>הגדרת מצב לאחר נפילת מתח וחזרת מתח KNX.</li>
          </ul>
        </section>

        <section>
          <h2>מוזן מקו ה-KNX</h2>
          <p>
            האלקטרוניקה של הבקר מוזנת ישירות מקו ה-KNX, ללא צורך בספק כוח עזר. המסופים מאפשרים חיבור מוליכים בחתך 0.5 עד 2.5 ממ״ר והעברת הזנה בין ערוצים, בהתאם לתכנון ולהוראות ההתקנה.
          </p>
        </section>

        <aside class="my-8 rounded-xl border-r-4 border-accent-600 bg-accent-50 p-5 not-prose">
          <h2 class="text-xl font-extrabold text-brand-900 mb-2">חשוב לדעת: ארבע יציאות מיתוג, ללא דימור או תריסים</h2>
          <p class="m-0 text-brand-700 leading-relaxed">
            N 532D31 מפעיל ומכבה ארבעה עומסים. הוא אינו דימר ואינו בקר מנועים. עבור עמעום תאורה או תריסים יש לבחור מוצר Siemens ייעודי ליישום הנדרש.
          </p>
        </aside>

        <section>
          <h2>מתי כדאי לבחור בגרסת ארבע היציאות?</h2>
          <div class="not-prose grid md:grid-cols-2 lg:grid-cols-3 gap-4 my-6">
            <div class="rounded-xl border border-brand-100 p-5"><h3 class="font-extrabold text-accent-700 mb-2">לוח קטן או משני</h3><p class="m-0 text-brand-700">ארבעה מודולים בלבד מאפשרים לשלב את הבקר גם כאשר המקום בלוח מוגבל.</p></div>
            <div class="rounded-xl border border-brand-100 p-5"><h3 class="font-extrabold text-accent-700 mb-2">אזור נפרד בבית</h3><p class="m-0 text-brand-700">פתרון מתאים לקומה, יחידה, חדרי שירות או אזור עם מספר מצומצם של מעגלים.</p></div>
            <div class="rounded-xl border border-brand-100 p-5"><h3 class="font-extrabold text-accent-700 mb-2">הרחבת מערכת קיימת</h3><p class="m-0 text-brand-700">תוספת ממוקדת של ארבע יציאות מבלי להתקין בקר גדול מהנדרש.</p></div>
            <div class="rounded-xl border border-brand-100 p-5"><h3 class="font-extrabold text-accent-700 mb-2">תאורה עם זרמי התנעה</h3><p class="m-0 text-brand-700">דירוג 10AX והתאמה לעומסי C מסייעים בהתאמה לציוד תאורה מודרני.</p></div>
            <div class="rounded-xl border border-brand-100 p-5"><h3 class="font-extrabold text-accent-700 mb-2">שליטה חכמה מלאה</h3><p class="m-0 text-brand-700">סצנות, לוגיקה, זמנים, משובים ומוני שימוש בכל אחד מארבעת הערוצים.</p></div>
            <div class="rounded-xl border border-brand-100 p-5"><h3 class="font-extrabold text-accent-700 mb-2">פחות ציוד עזר</h3><p class="m-0 text-brand-700">אין צורך בהזנת אלקטרוניקה נפרדת מעבר לקו ה-KNX.</p></div>
          </div>
        </section>

        <section>
          <h2>נתונים טכניים מרכזיים</h2>
          <div class="not-prose overflow-hidden rounded-xl border border-brand-100 my-6">
            <table class="w-full text-right">
              <tbody class="divide-y divide-brand-100">
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900 w-2/5">דגם</th><td class="p-4">Siemens N 532D31</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">מק״ט</th><td class="p-4">5WG1532-1DB31</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">מספר יציאות</th><td class="p-4">4 ממסרים דו יציבים ופוטנציאל חופשי</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">מתח מיתוג נקוב</th><td class="p-4">AC 230V, 50/60Hz</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">דירוג לכל ערוץ</th><td class="p-4">10A, עומס תאורה 10AX</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">הספק מרבי בעומס התנגדותי</th><td class="p-4">2,300W לכל ערוץ, בהתאם לתנאי היצרן</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">עומס קיבולי מרבי</th><td class="p-4">140µF</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">רוחב בלוח</th><td class="p-4">4 מודולים, 72 מ״מ</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">הזנת אלקטרוניקה</th><td class="p-4">מקו KNX, ללא ספק כוח עזר</td></tr>
                <tr><th class="bg-brand-50 p-4 font-bold text-brand-900">דרגת הגנה</th><td class="p-4">IP20</td></tr>
              </tbody>
            </table>
          </div>
          <p class="text-sm text-brand-600">
            הנתונים מתייחסים למסמכי Siemens. ההתאמה הסופית תלויה בסוג העומס, זרם ההתנעה, תנאי ההתקנה, החיווט, ההגנות והתקנים החלים בישראל.
          </p>
        </section>
      </div>

      <section class="mt-12 rounded-2xl bg-brand-50 border border-brand-100 p-6 md:p-8">
        <h2 class="text-2xl font-extrabold text-brand-900 mb-4">בקרי Siemens KNX נוספים</h2>
        <div class="grid md:grid-cols-3 gap-3">
          <a href="/articles/siemens-n532d51-knx-8-switch-output/" class="rounded-lg bg-white border border-brand-100 p-4 font-bold text-brand-800 hover:border-accent-500">N 532D51, שמונה יציאות מיתוג 10AX</a>
          <a href="/articles/siemens-n56722-knx-16-output/" class="rounded-lg bg-white border border-brand-100 p-4 font-bold text-brand-800 hover:border-accent-500">N 567/22, שש עשרה יציאות מיתוג</a>
          <a href="/articles/siemens-n543d31-knx-4-blind-actuator/" class="rounded-lg bg-white border border-brand-100 p-4 font-bold text-brand-800 hover:border-accent-500">N 543D31, ארבעה מנועי תריס AC</a>
        </div>
      </section>

      <section class="mt-10 rounded-2xl bg-brand-900 text-white p-7 md:p-9">
        <h2 class="text-3xl font-extrabold mb-3">צריכים להתאים בקר לרשימת המעגלים?</h2>
        <p class="text-brand-100 text-lg mb-6">שלחו ל-i-feel את תכנית הלוח או רשימת התאורה והעומסים, וקבלו התאמת ציוד Siemens KNX לפרויקט.</p>
        <div class="flex flex-wrap gap-3">
          <a href="tel:0533006239" class="inline-flex items-center justify-center rounded-lg bg-accent-600 px-5 py-3 font-bold text-white hover:bg-accent-700">053-300-6239</a>
          <a href="/catalogs/#siemens-knx-actuators" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-5 py-3 font-bold text-white hover:bg-white/10">לכל דפי המוצר של Siemens</a>
        </div>
      </section>
    </div>
  <!-- ifeel:siemens-partner -->
<div class="not-prose my-10 bg-white border border-brand-100 rounded-xl p-5 shadow-sm">
  <p class="text-xs font-bold tracking-wide text-brand-500 mb-3">שותפות טכנולוגית</p>
  <a href="/license/" class="inline-flex items-center gap-4 no-underline hover:opacity-90 transition">
    <picture>
      <source type="image/webp" srcset="/assets/brands/siemens-solution-partner-68.webp 1x, /assets/brands/siemens-solution-partner-136.webp 2x, /assets/brands/siemens-solution-partner-204.webp 3x">
      <img src="/assets/brands/siemens-solution-partner-136.png" width="141" height="68" loading="lazy" decoding="async" class="h-[68px] w-auto rounded-md" alt="Siemens Solution Partner — Building Automation">
    </picture>
    <span class="text-sm leading-snug">
      <b class="block text-brand-900 text-base">Siemens Solution Partner</b>
      <span class="text-brand-600">Building Automation</span>
    </span>
  </a>
</div>
<!-- /ifeel:siemens-partner -->
</article>
</BaseLayout>
