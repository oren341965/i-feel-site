---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/articles/siemens-n14103-knx-dali-gateway-plus/';
const title = 'Siemens N 141/03: KNX / DALI Gateway Plus | i-feel';
const description = 'Siemens N 141/03, מק״ט 5WG1141-1AB03, שער KNX ל-DALI עם ערוץ DALI אחד, עד 64 התקני DALI ועד 16 קבוצות.';
const dataSheetUrl = 'https://sid.siemens.com/v/u/A6V10466086';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Siemens N 141/03 KNX DALI Gateway Plus',
  description,
  sku: '5WG1141-1AB03',
  brand: { '@type': 'Brand', name: 'Siemens' },
  url: canonical,
});
---

<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl={canonical} jsonLd={jsonLd}>
  <article class="bg-white" dir="rtl">
    <header class="bg-brand-900 text-white py-16 md:py-20">
      <div class="max-w-5xl mx-auto px-4">
        <a href="/siemens-knx-products/" class="text-accent-400 font-semibold hover:text-accent-300">ציוד Siemens KNX</a>
        <p class="mt-4 text-sm text-brand-200">Siemens GAMMA / KNX / DALI · עודכן 03.09.2026</p>
        <h1 class="mt-4 text-4xl md:text-5xl font-extrabold leading-tight">Siemens N 141/03: KNX / DALI Gateway Plus</h1>
        <p class="mt-5 max-w-4xl text-lg md:text-xl text-brand-100 leading-relaxed">שער תקשורת בין KNX לבין קו DALI אחד, עם שליטה פרטנית וקבוצתית, דימור, סצנות, חיווי תקלות ותמיכה בפונקציות DALI מתקדמות.</p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 py-12">
      <section class="rounded-2xl border border-brand-100 bg-brand-50 p-6 md:p-8 mb-10">
        <p class="text-accent-700 font-bold text-lg mb-3">מק״ט Siemens: <span dir="ltr">5WG1141-1AB03</span></p>
        <h2 class="text-3xl font-extrabold text-brand-900 mb-4">קו DALI אחד, עד 64 התקנים</h2>
        <p class="text-lg text-brand-700 leading-relaxed mb-5">N 141/03 מחבר את מערכת KNX לקו DALI יחיד. לפי Siemens ניתן לחבר עד 64 התקני DALI בערוץ ולנהל אותם בנפרד או בעד 16 קבוצות. ספק ה-DALI משולב במכשיר ולכן אין צורך בספק DALI חיצוני.</p>
        <a href={dataSheetUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-accent-600 px-5 py-3 font-bold text-white transition hover:bg-accent-700">מידע טכני רשמי של Siemens</a>
      </section>

      <section class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-12">
        <div class="rounded-xl border border-brand-100 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">1</div><div class="mt-2 text-sm font-semibold">קו DALI</div></div>
        <div class="rounded-xl border border-brand-100 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">64</div><div class="mt-2 text-sm font-semibold">התקני DALI</div></div>
        <div class="rounded-xl border border-brand-100 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">16</div><div class="mt-2 text-sm font-semibold">קבוצות</div></div>
        <div class="rounded-xl border border-brand-100 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">16</div><div class="mt-2 text-sm font-semibold">סצנות</div></div>
        <div class="rounded-xl border border-brand-100 p-4 text-center"><div class="text-3xl font-extrabold text-accent-700">4TE</div><div class="mt-2 text-sm font-semibold">רוחב בלוח</div></div>
      </section>

      <div class="prose-he max-w-none">
        <h2>יכולות עיקריות</h2>
        <ul>
          <li>הדלקה, כיבוי ודימור של תאורת DALI דרך KNX.</li>
          <li>קו DALI אחד עם עד 64 התקנים.</li>
          <li>עד 16 קבוצות DALI ועד 16 סצנות.</li>
          <li>שליטה פרטנית בהתקני DALI.</li>
          <li>תמיכה בחיישני DALI בהתאם לגרסת הקושחה והיישום.</li>
          <li>ניטור מצבים ותקלות DALI והעברתם ל-KNX.</li>
          <li>פונקציות תאורת חירום, Stand-by, Timer ובקרת תאורה בהתאם לגרסת היישום.</li>
          <li>ספק DALI משולב ותפעול ישיר מהחזית.</li>
        </ul>

        <h2>הבדל מול N 141/21</h2>
        <p>N 141/03 הוא Gateway Plus עם ערוץ DALI אחד. N 141/21 הוא Twin Plus עם שני ערוצי DALI. עבור הציוד שנבחר כעת ב-i-feel, המק״ט הוא 5WG1141-1AB03.</p>

        <h2>נתונים מרכזיים</h2>
        <div class="not-prose overflow-x-auto">
          <table class="w-full border-collapse text-right">
            <tbody>
              <tr class="border-b"><th class="p-3 bg-brand-50">דגם</th><td class="p-3">N 141/03 KNX / DALI Gateway Plus</td></tr>
              <tr class="border-b"><th class="p-3 bg-brand-50">מק״ט</th><td class="p-3" dir="ltr">5WG1141-1AB03</td></tr>
              <tr class="border-b"><th class="p-3 bg-brand-50">ערוצי DALI</th><td class="p-3">1</td></tr>
              <tr class="border-b"><th class="p-3 bg-brand-50">התקני DALI מרביים</th><td class="p-3">עד 64</td></tr>
              <tr class="border-b"><th class="p-3 bg-brand-50">קבוצות DALI</th><td class="p-3">עד 16</td></tr>
              <tr><th class="p-3 bg-brand-50">רוחב בלוח</th><td class="p-3">4 מודולים</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
