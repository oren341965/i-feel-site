---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/articles/siemens-building-x/';
const heading = 'Siemens Building X: מה מרוויחים כשמחברים את בקרת המבנה לענן?';
const description = 'מה עושה Building X של סימנס, כיצד היא משתלבת עם Desigo CC, למי היא מתאימה ואיך בודקים חיסכון באנרגיה ותועלת תפעולית במבנה קיים.';
const product = 'https://www.siemens.com/en-us/products/building-x/';
const energy = 'https://www.siemens.com/en-gb/products/building-x/applications/energy-manager/';
const operations = 'https://www.siemens.com/en-us/products/building-x/applications/operations-manager/';
const hotels = 'https://www.siemens.com/en-gb/content/h-hotels-connected-operations/';
// Siemens Web Asset Pool: c2606a26-ac51-4131-93d9-4f77f23f73bf, fa920f23-676c-410b-b3d0-5ea242922be8,
// f3e44436-414f-4f3a-9bae-37188226bd30. Unlimited, transferable, no approval required.
const assets = '/assets/siemens-building-x/';
const image = 'https://i-feel.co.il' + assets + 'building-x-dashboard.jpg';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', '@id': canonical + '#article', headline: heading, description,
      inLanguage: 'he-IL', datePublished: '2026-11-22', dateModified: '2026-11-22',
      mainEntityOfPage: canonical, image, articleSection: 'בקרת מבנה',
      author: { '@type': 'Organization', name: 'I FEEL', url: 'https://i-feel.co.il/' },
      publisher: { '@id': 'https://i-feel.co.il/#business' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
      { '@type': 'ListItem', position: 2, name: 'בקרת מבנה', item: 'https://i-feel.co.il/structure-control/' },
      { '@type': 'ListItem', position: 3, name: 'Siemens Building X', item: canonical },
    ] },
  ],
});
---

<BaseLayout title={heading + ' | i-feel'} description={description} canonical={canonical} ogImage={image} jsonLd={jsonLd}>
  <article dir="rtl" class="bg-white">
    <header class="bg-brand-900 text-white py-12 md:py-16">
      <div class="max-w-4xl mx-auto px-4">
        <a class="font-bold text-accent-400 hover:text-accent-300 underline underline-offset-4" href="/structure-control/">בקרת מבנה BMS</a>
        <p class="mt-4 text-brand-200">ניהול אנרגיה · תפעול · Siemens Desigo</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-extrabold leading-tight"><bdi>Siemens Building X:</bdi> מה מרוויחים כשמחברים את בקרת המבנה לענן?</h1>
        <p class="mt-5 text-lg text-brand-100">איך מזהים בזבוז אנרגיה ותקלות חוזרות, ולמי משתלם להתחיל למדוד?</p>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 py-10 space-y-8">
      <figure class="rounded-2xl overflow-hidden bg-brand-50 border border-brand-100">
        <img src={assets + 'building-x-dashboard.jpg'} width="1440" height="810" fetchpriority="high" alt="איש צוות מול לוחות מחוונים המציגים גרפים ונתוני מבנה בממשק Building X" class="block w-full h-auto" />
        <figcaption class="px-4 py-3 text-sm text-brand-800">הדגמת לוחות מחוונים ונתוני מבנה ב־Building X. מקור: Siemens.</figcaption>
      </figure>
      <div class="prose-he max-w-none">
        <p>למה המיזוג בבניין משרדים ממשיך לעבוד בשעות שבהן רוב הקומות ריקות? למה שני מלונות דומים צורכים כמויות שונות של חשמל? ולמה דווקא ביום העמוס ביותר צוות האחזקה מגלה שתקלה קטנה הפכה להשבתה? אלה שאלות שמנהלי מבנים מתמודדים איתן גם כשכבר מותקנת אצלם מערכת בקרה. <strong>Building X של סימנס</strong> מרכזת נתונים ממערכות המבנה בפלטפורמת ענן אחת, כדי שאפשר יהיה לזהות מה השתנה, להבין איפה כדאי להתערב ולבדוק אם הפעולה באמת שיפרה את התוצאה. <a href={product}>סקירת Building X של סימנס</a>.</p>

        <h2>מה מקבלים בפועל?</h2>
        <h3>ניהול אנרגיה עם נתונים שאפשר לפעול לפיהם</h3>
        <p>אפליקציית <a href={energy}>Energy Manager</a> מרכזת נתוני צריכה ומאפשרת להשוות בין שעות, תקופות ואתרים. כך אפשר לזהות, למשל, עלייה בצריכת הלילה ולבדוק אם היא נובעת משינוי בלוח ההפעלה או מציוד שנשאר פעיל. ההשוואה שימושית גם אחרי התיקון: אפשר לראות אם הצריכה ירדה לאורך זמן, ולא להסתפק בחשבון חשמל נמוך בחודש שבו גם מזג האוויר היה נוח יותר.</p>

        <h3>טיפול ממוקד יותר בתקלות</h3>
        <p><a href={operations}>Operations Manager</a> מאפשרת לצוותי האחזקה לעקוב מרחוק אחר ציוד מחובר, לקבל התראות ולעיין בהיסטוריית המדידות. כשיחידת מיזוג לא מגיעה לטמפרטורה הרצויה, אפשר לבדוק מתי התחילה החריגה ומה קרה במקביל, לפני ששולחים טכנאי. לפי סימנס, ניתן לשלב את האפליקציה עם התקנות Desigo CC ללא שער חומרה נוסף. בפועל בודקים מראש את הגרסה, את הנקודות הזמינות ואת מדיניות הגישה מרחוק של הארגון. הבקרה המקומית ממשיכה לנהל את הציוד; שכבת הענן מוסיפה כלי ניטור, ניתוח ותפעול.</p>
      </div>

      <section aria-labelledby="building-x-screens">
        <h2 id="building-x-screens" class="text-2xl font-extrabold text-brand-900 mb-4">מבט אל מסכי Building X</h2>
        <div class="grid gap-4 md:grid-cols-2">
          <figure class="rounded-xl overflow-hidden bg-brand-50 border border-brand-100">
            <a href={assets + 'energy-manager.png'} aria-label="פתיחת תמונת Energy Manager בגודל מלא" class="block bg-[#080a2a]">
              <img src={assets + 'energy-manager.png'} width="1600" height="1200" loading="lazy" decoding="async" alt="מסך Energy Manager לדוגמה עם גרפי צריכה ופילוח אנרגיה" class="block w-full h-auto aspect-[4/3] object-contain" />
            </a>
            <figcaption class="px-4 py-3 text-sm text-brand-800"><bdi>Energy Manager</bdi>: מסך לדוגמה לניטור ולניתוח צריכת אנרגיה. מקור: Siemens.</figcaption>
          </figure>
          <figure class="rounded-xl overflow-hidden bg-brand-50 border border-brand-100">
            <a href={assets + 'space-manager.png'} aria-label="פתיחת תמונת Space Manager בגודל מלא" class="block bg-[#080a2a]">
              <img src={assets + 'space-manager.png'} width="1200" height="630" loading="lazy" decoding="async" alt="מסך Space Manager לדוגמה המציג נתוני תפוסה וניצול שטחים" class="block w-full h-auto aspect-[4/3] object-contain" />
            </a>
            <figcaption class="px-4 py-3 text-sm text-brand-800"><bdi>Space Manager</bdi>: דוגמה להצגת תפוסה וניצול שטחים. מקור: Siemens.</figcaption>
          </figure>
        </div>
      </section>

      <div class="prose-he max-w-none">
        <h3>תמונה משותפת לכל האתרים</h3>
        <p>ברשת H Hotels Collection, למשל, חוברו 74 מוני חשמל לניטור אנרגיה ופליטות. החיבור בין Building X ל־Desigo CC מאפשר לצוותים להשוות בין שמונה אתרי נופש, לעקוב אחר מגמות ולזהות צריכה חריגה. זהו שימוש מעשי במיוחד כשכל אתר מתופעל בידי צוות מקומי, אבל ההחלטות על שדרוגים ועל תקציב מתקבלות ברמת הרשת. <a href={hotels}>מקרה הבוחן של H Hotels</a>.</p>

        <h2>למי Building X מתאימה?</h2>
        <p>הפלטפורמה רלוונטית במיוחד לבעלי נכסים, מנהלי תפעול, מנהלי אנרגיה ויועצי בקרת מבנה שאחראים על <strong>מבנה מורכב או כמה אתרים</strong>. במלונות, משרדים ומרכזים מסחריים, הערך יכול להגיע מהתאמת שעות ההפעלה לשימוש בפועל. בבתי חולים ובקמפוסים, התועלת עשויה להיות בזיהוי מוקדם של תקלות וביכולת של צוות אחד לעקוב אחר כמה מבנים. בחוות שרתים, נקודת פתיחה אפשרית היא ניטור מגמות במערכות הקירור, בכפוף למדיניות הארגון ולדרישות הזמינות. במבנה קטן עם מעט ציוד כדאי לבדוק קודם אם שיפור הבקרה הקיימת כבר פותר את הבעיה.</p>

        <h2>מה באמת אומרים ה־30% וה־10%?</h2>
        <p><a href={product}>סימנס מדווחת</a> על לקוחות שהגיעו <strong>לעד 30% חיסכון באנרגיה</strong> ו<strong>לעד 10% עלייה בהכנסה התפעולית הנקייה (NOI)</strong>. אלה תוצאות שדווחו בקרב לקוחות, לא ממוצע ולא התחייבות לפרויקט. התוצאה תלויה במצב ההתחלתי של המבנה, באיכות הנתונים ובפעולות שהצוות מבצע בעקבותיהם. לכן כדאי להתחיל בבעיה מדידה אחת, כמו צריכת מיזוג מחוץ לשעות הפעילות, לקבוע קו בסיס ולהשוות את התוצאה אחרי השינוי בתנאי שימוש דומים.</p>
        <p>לארגונים בישראל שבוחנים Building X, הצעד הראשון הוא למפות את הבקרים והמונים הקיימים, לבחור אילו נתונים באמת נחוצים ולהגדיר מי יפעל כשמופיעה חריגה. כך אפשר להתחיל עם אתר אחד, למדוד תועלת ולהחליט על הרחבה לפי התוצאות.</p>
      </div>

      <nav class="border-t border-brand-100 pt-5 flex flex-wrap gap-5 text-brand-800 font-bold" aria-label="קריאה נוספת">
        <a class="underline underline-offset-4" href="/structure-control/">בקרת מבנה עם I FEEL</a>
        <a class="underline underline-offset-4" href="/siemens-bms-knowledge-center/">מרכז הידע Siemens BMS</a>
      </nav>
    </div>
  </article>
</BaseLayout>
