---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/articles/epbd-bacs-building-automation-desigo/';
const title = 'EPBD ו-BACS: אירופה עוברת לבקרת מבנה פעילה | i-feel';
const description = 'ה-EPBD מחזקת דרישות BACS במבנים לא למגורים. כך Siemens Desigo ו-i-feel מסייעות למדוד אנרגיה, לזהות חריגות ולשפר תפעול. 03-508-9553.';
const euDirectiveUrl = 'https://eur-lex.europa.eu/eli/dir/2024/1275/oj';
const euCommissionUrl = 'https://energy.ec.europa.eu/topics/energy-efficiency/energy-efficient-buildings/energy-performance-buildings-directive_en';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: 'EPBD ו-BACS: אירופה הופכת אוטומציית מבנים לדרישה תפעולית',
      description,
      datePublished: '2026-09-14',
      dateModified: '2026-09-17',
      inLanguage: 'he-IL',
      mainEntityOfPage: canonical,
      author: { '@type': 'Organization', name: 'i-feel', url: 'https://i-feel.co.il/' },
      publisher: { '@id': 'https://i-feel.co.il/#business' },
      image: 'https://i-feel.co.il/assets/office-bms.jpeg',
      about: ['EPBD', 'BACS', 'Building Management System', 'Siemens Desigo', 'Energy Management'],
    },
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'מאמרים', item: 'https://i-feel.co.il/articles/' },
        { '@type': 'ListItem', position: 3, name: 'EPBD ו-BACS', item: canonical },
      ],
    },
  ],
});
---

<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description} ogUrl={canonical} ogImage="https://i-feel.co.il/assets/office-bms.jpeg" jsonLd={jsonLd}>
  <article class="bg-white" dir="rtl">
    <header class="bg-brand-900 text-white py-16 md:py-20">
      <div class="max-w-5xl mx-auto px-4">
        <a href="/articles/" class="text-accent-400 font-semibold hover:text-accent-300">מאמרים ועדכונים</a>
        <p class="mt-4 text-sm text-brand-200">בקרת מבנה ואנרגיה · עודכן 17.09.2026</p>
        <h1 class="mt-4 text-4xl md:text-5xl font-extrabold leading-tight">EPBD ו-BACS: אירופה הופכת אוטומציית מבנים לדרישה תפעולית</h1>
        <p class="mt-5 max-w-4xl text-lg md:text-xl text-brand-100 leading-relaxed">הכיוון האירופי ברור: מערכת בקרת מבנה כבר לא אמורה רק להציג נתונים. היא צריכה לעזור לצוות התפעול למדוד ביצועים, לזהות ירידה ביעילות, להתריע על חריגות ולאפשר שיפור מתמשך.</p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 py-12">
      <section class="rounded-2xl border border-brand-100 bg-brand-50 p-6 md:p-8 mb-10">
        <p class="text-sm font-extrabold text-accent-700 mb-2">התשובה הקצרה</p>
        <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 mb-4">מה המשמעות לבעלי מבנים בישראל?</h2>
        <p class="text-lg leading-8 text-brand-700">ה-EPBD אינה חובה ישראלית, אבל היא מספקת תמונה ברורה של כיוון השוק. מבנה שמסתפק במסך מרכזי ללא מדידה עקבית, ניתוח מגמות, התראות שימושיות ופעולות תיקון נשאר מאחור מבחינה תפעולית. i-feel מסייעת להפוך נתוני מבנה לתהליך עבודה מעשי באמצעות בקרי DDC, אינטגרציה ו-<a href="/siemens-desigo-bms/" class="font-bold text-accent-700 hover:underline">Siemens Desigo</a>.</p>
      </section>

      <div class="prose-he max-w-none">
        <h2>מה דורשת המסגרת האירופית?</h2>
        <p>הדירקטיבה האירופית לביצועי אנרגיה של מבנים, EPBD, כוללת דרישות למערכות אוטומציה ובקרה במבנים לא למגורים. לפי סעיף 13 בדירקטיבה המעודכנת, המדינות החברות נדרשות לקבוע דרישות למבנים שבהם ההספק הנקוב האפקטיבי של מערכות החימום, מיזוג האוויר או השילוב ביניהן עולה על 290kW, ובהמשך גם מעל 70kW עד סוף 2029.</p>
        <p>מערכת BACS מתאימה נדרשת לא רק לאסוף נתונים. עליה לאפשר ניטור, רישום וניתוח רציף של צריכת האנרגיה, לבצע השוואה לביצועי ייחוס, לזהות אובדן יעילות במערכות הטכניות, ליידע את צוות התפעול ולאפשר תקשורת עם מערכות וטכנולוגיות מחוברות.</p>
        <p><strong>חשוב לדייק:</strong> יישום הדירקטיבה נעשה בחקיקה הלאומית של כל מדינה באיחוד, ולכן מועדים, חריגים ואופן האכיפה עשויים להשתנות בין מדינות. בישראל זו אינה דרישה רגולטורית מחייבת, אלא אינדיקציה מקצועית משמעותית לכיוון שאליו מתקדם תחום ה-BMS.</p>

        <h2>איך נראית הבעיה במבנה שכבר פעיל?</h2>
        <p>לקוחות רבים אינם מתחילים מדף חלק. במבנה כבר יש מיזוג, לוחות חשמל, בקרים, מונים ולעיתים גם מערכת BMS ישנה, אבל המידע מפוזר וקשה להפוך אותו להחלטות. המצבים הנפוצים כוללים:</p>
        <ul>
          <li><strong>צריכת אנרגיה גבוהה בלי הסבר:</strong> רואים את חשבון החשמל, אבל לא יודעים איזה אזור, מערכת או לוח זמנים יצרו את החריגה.</li>
          <li><strong>ציוד שפועל שלא לצורך:</strong> מיזוג, משאבות או תאורה ממשיכים לפעול בשעות שבהן אין תפוסה או ביקוש.</li>
          <li><strong>מערכות מבודדות:</strong> HVAC, חשמל, תאורה ומונים עובדים בממשקים שונים ללא תמונת מצב אחת.</li>
          <li><strong>התראות רבות מדי:</strong> צוות התחזוקה מוצף באירועים, אך מתקשה לזהות מה קריטי ומה חוזר על עצמו.</li>
          <li><strong>ירידה הדרגתית ביעילות:</strong> המערכת עדיין עובדת, אבל השינוי בביצועים אינו מורגש עד שמופיעה תקלה או עלות משמעותית.</li>
          <li><strong>חוסר בנתוני בסיס:</strong> אין קו ייחוס שמאפשר להראות אם שינוי בלוגיקת הבקרה באמת שיפר את התוצאה.</li>
        </ul>

        <h2>איך i-feel מסייעת ללקוחות שנמצאים במצב הזה?</h2>
        <p>העבודה מתחילה בהבנת המבנה הקיים ולא בהחלפה אוטומטית של כל הציוד. צוות i-feel ממפה את מערכות ה-HVAC, הבקרים, המונים, הפרוטוקולים ונקודות הבקרה, ומגדיר מה צריך למדוד, אילו חריגות חשובות למנהל האחזקה ואילו פעולות ניתן לבצע מקומית.</p>
        <ol>
          <li><strong>מיפוי והערכת מצב:</strong> בדיקת בקרים, DDC, תקשורת, חיישנים, מונים, לוחות זמנים והמערכת המרכזית.</li>
          <li><strong>הגדרת מדדים:</strong> בחירת נתונים שימושיים כגון צריכה לפי מערכת, שעות עבודה, טמפרטורות, תפוסה וסטיות מהיעד.</li>
          <li><strong>איחוד נתונים:</strong> חיבור ציוד ומערכות באמצעות BACnet, Modbus, KNX וממשקים נוספים לפי הארכיטקטורה הקיימת.</li>
          <li><strong>זיהוי חריגות והתראות:</strong> בניית התראות ממוקדות שמסייעות לטפל בסיבה ולא רק בסימפטום.</li>
          <li><strong>אופטימיזציה:</strong> התאמת לוחות זמנים, נקודות עבודה ולוגיקות בקרה, ולאחר מכן בדיקת התוצאה מול קו הייחוס.</li>
          <li><strong>שיפור מתמשך:</strong> שימוש במגמות ובדוחות כדי לזהות הידרדרות, לבחון פעולות ולשפר את התפעול לאורך זמן.</li>
        </ol>

        <h2>כיצד Siemens Desigo תומכת בעקרונות האלה?</h2>
        <p><a href="/siemens-desigo-bms/">Siemens Desigo</a> מספקת שכבת ניהול מרכזית למערכות המבנה. בהתאם לציוד ולתכנון הפרויקט, ניתן לרכז מדידות אנרגיה, מגמות, מצבי ציוד, התראות, לוחות זמנים ופקודות בקרה בממשק אחד. החיבור לבקרי DDC ולפרוטוקולים פתוחים מאפשר לשלב גם ציוד קיים ולבנות מסלול שדרוג בשלבים.</p>
        <p>הערך אינו מגיע מעצם התקנת התוכנה. הוא נוצר כאשר האפיון, נקודות המדידה, לוגיקת הבקרה, סדרי העדיפויות של ההתראות ותהליך העבודה של צוות האחזקה מתוכננים יחד. כאן נכנס הניסיון של i-feel בתכנון, אינטגרציה, תכנות, הפעלה ושירות למערכות BMS.</p>

        <h2>למי זה רלוונטי במיוחד?</h2>
        <p>הגישה מתאימה במיוחד ל<a href="/bms-offices/">בנייני משרדים</a>, <a href="/bms-hotels/">מלונות</a>, מבני ציבור, בתי חולים, קמפוסים ומפעלי תעשייה שבהם מערכות המיזוג והציוד הטכני פועלות שעות רבות. היא רלוונטית גם למבנים קיימים שבהם אין הצדקה להחליף את כל הבקרים, אך יש צורך בשכבת ניהול טובה יותר ובתהליך <a href="/bms-retrofit/">Retrofit למערכת BMS</a>.</p>

        <h2>הצעד הראשון אינו פרויקט ענק</h2>
        <p>אפשר להתחיל בסקר ממוקד ובאזור או מערכת אחת: לבחור צרכן משמעותי, להגדיר מדדים, לאסוף נתונים, לזהות חריגות ולבדוק אם שינוי הבקרה משפר את התוצאה. פיילוט כזה מאפשר לקבל החלטות על בסיס נתונים ולבנות תכנית הרחבה מדורגת.</p>

        <h2>האם צריך להחליף את כל הבקרים כדי לשדרג BMS?</h2>
        <p>לא בהכרח. תחילה בודקים את הבקרים, הפרוטוקולים ונקודות הבקרה הקיימים. בהתאם לתאימות ולצרכי המבנה, אפשר לתכנן <a href="/bms-retrofit/">שדרוג BMS בשלבים</a> ולשלב ציוד קיים, במקום להניח מראש שנדרשת החלפה מלאה.</p>

        <h2>איך בודקים אם שדרוג בקרת המבנה באמת מועיל?</h2>
        <p>מגדירים קו ייחוס ומדדים לפני השינוי: צריכת אנרגיה לפי מערכת, שעות פעילות, טמפרטורות ותפוסה. לאחר שינוי לוחות הזמנים או לוגיקת הבקרה, משווים את המדדים תוך התחשבות בתנאי ההפעלה. אין להסיק חיסכון מובטח מעצם התקנת מערכת ניהול.</p>

        <h2>מה כדאי להכין לפגישת אפיון BMS?</h2>
        <p>כדי למקד את השיחה, כדאי להכין תיאור של המבנה והשימוש בו, רשימת המערכות והבקרים הקיימים, ותיאור הבעיה או מטרת השדרוג. תכניות ורשימת נקודות בקרה, אם קיימות, מסייעות למיפוי. אפשר לראות גם <a href="/structure-control/projects/">פרויקטי בקרת מבנה של i-feel</a> ולפנות דרך <a href="/contactus/">טופס יצירת הקשר</a> לבירור התאמה.</p>
      </div>

      <section class="mt-12 rounded-2xl border border-brand-100 bg-brand-50 p-6 md:p-8">
        <h2 class="text-2xl font-extrabold text-brand-900 mb-4">מקורות רשמיים</h2>
        <div class="flex flex-wrap gap-3">
          <a href={euDirectiveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg bg-accent-600 px-5 py-3 font-bold text-white hover:bg-accent-700">דירקטיבה EU/2024/1275</a>
          <a href={euCommissionUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg bg-white border border-brand-200 px-5 py-3 font-bold text-brand-900 hover:bg-brand-100">הנציבות האירופית: EPBD</a>
        </div>
      </section>

      <section class="mt-10 rounded-2xl bg-brand-900 text-white p-7 md:p-9">
        <h2 class="text-3xl font-extrabold mb-3">יש לכם BMS, אבל אין לכם תמונת ביצועים אמיתית?</h2>
        <p class="text-brand-100 text-lg leading-8 mb-5">i-feel תבדוק את המערכת הקיימת, נקודות המדידה, הבקרים וההתראות, ותציע מסלול מעשי למדידה, איתור חריגות ואופטימיזציה באמצעות Siemens Desigo.</p>
        <div class="flex flex-wrap gap-3">
          <a href="tel:+972-3-508-9553" class="inline-flex items-center rounded-lg bg-accent-600 px-5 py-3 font-bold text-white hover:bg-accent-700">03-508-9553</a>
          <a href="/contactus/" class="inline-flex items-center rounded-lg bg-white px-5 py-3 font-bold text-brand-900 hover:bg-brand-50">בקשת אפיון ושדרוג BMS</a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
