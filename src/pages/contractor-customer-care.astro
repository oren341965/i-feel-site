---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-08.html?raw';

const developerAnswer = `
<section id="developer-smart-home-answer" class="bg-brand-50 border-b border-brand-100" dir="rtl" aria-label="בית חכם ליזמי בנייה בישראל">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <p class="text-sm font-bold text-accent-600 mb-2">תשובה ישירה ליזם</p>
    <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 mb-4">מה כולל פתרון בית חכם ליזמי בנייה בישראל?</h2>
    <p class="text-lg leading-8 text-brand-800"><strong>התשובה הקצרה:</strong> i-feel בונה ליזם מפרט בית חכם אחיד לדירות, מסלולי שדרוג לדיירים, תיאום מול קבלן החשמל ותהליך מסירה ושירות לאחר האכלוס. הטכנולוגיה נבחרת לפי סוג הפרויקט, שלב התכנון, התשתית והתקציב, כך שהמערכת תתאים גם לביצוע בקנה מידה של בנייה רוויה וגם לשדרוגים אישיים בדירות מיוחדות.</p>
    <div class="grid md:grid-cols-2 gap-4 mt-6 text-brand-800">
      <p><strong>בשלב התכנון:</strong> מגדירים חבילת בסיס, נקודות שליטה, ממשקים ותהליך שינויי דיירים לפני תחילת הביצוע.</p>
      <p><strong>בשלב המסירה:</strong> מתקינים, מתכנתים, מדריכים את הדייר ומרכזים את השירות מול גורם אחד גם לאחר האכלוס.</p>
    </div>
    <p class="mt-6 text-brand-700">ראו <a href="/contractor-customer-care/projects/" class="text-accent-600 font-semibold hover:underline">פרויקטי יזמי בנייה שבוצעו</a>, או את <a href="/siemens-desigo-bms/" class="text-accent-600 font-semibold hover:underline">Siemens Desigo BMS</a> כאשר נדרשת גם בקרת מבנה לשטחים המשותפים ולמערכות הבניין.</p>
    <div class="mt-6 space-y-3">
      <details class="bg-white border border-brand-100 rounded-lg p-4"><summary class="font-bold text-brand-900 cursor-pointer">מה כולל פתרון בית חכם ליזמי בנייה?</summary><p class="mt-3 text-brand-700 leading-7">הפתרון כולל מפרט בית חכם אחיד לדירות, מסלולי שדרוג לדיירים, תיאום מול קבלן החשמל, התקנה, תכנות, הדרכת דייר ושירות לאחר האכלוס.</p></details>
      <details class="bg-white border border-brand-100 rounded-lg p-4"><summary class="font-bold text-brand-900 cursor-pointer">איזו מערכת בית חכם מתאימה לפרויקט בנייה רוויה?</summary><p class="mt-3 text-brand-700 leading-7">הטכנולוגיה נקבעת לפי סוג הפרויקט, שלב התכנון, התשתית והתקציב. המטרה היא חבילת דירה שניתנת לביצוע אחיד בקנה מידה של הפרויקט, לצד אפשרות לשדרוגים בדירות מיוחדות.</p></details>
    </div>
  </div>
</section>`;

const pageContent = content
  .replace(
    '<h1 class="text-4xl md:text-5xl font-extrabold mb-4">ליזמי בנייה — <span class="text-accent-500">בית חכם כערך מוסף</span></h1>',
    '<h1 class="text-4xl md:text-5xl font-extrabold mb-4">בית חכם ליזמי בנייה בישראל</h1>'
  )
  .replace(
    'תמ"א 38, פינוי-בינוי, בנייה חדשה. תכנון בית חכם בעלות נמוכה לדירה, ערך מוסף משמעותי לדיירים, ושותפות לטווח ארוך אחרי המסירה.',
    'תמ"א 38, פינוי-בינוי ובנייה חדשה. מפרט אחיד לדירות, מסלולי שדרוג לדיירים, תיאום מול קבלן החשמל ושירות לאחר המסירה.'
  )
  .replace(
    '<section class="market-position not-prose bg-white border-b border-brand-100"',
    `${developerAnswer}\n<section class="market-position not-prose bg-white border-b border-brand-100"`
  )
  .replace(
    'דיירים שאינם משלמים תוספת על דירה רגילה — מסכימים לחתום מהר יותר כשהדירה כוללת תשתית בית חכם.',
    'תשתית בית חכם יכולה להוסיף שכבת בידול טכנולוגית לפרויקט, כאשר המפרט מוגדר מראש ומוסבר לדיירים בצורה ברורה.'
  )
  .replace(
    'דיירים פוטנציאליים חותמים מהר יותר כשהדירה כוללת ערך מוסף ברור — בלי שעלות הבנייה עולה משמעותית.',
    'מפרט בית חכם ברור נותן ליזם רכיב טכנולוגי מוחשי להצגה מול רוכשים, כאשר העלות והיקף המערכת נקבעים לפי מפרט הפרויקט.'
  );

