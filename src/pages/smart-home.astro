---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-16.html?raw';
import KnxAdvisorCta from '../components/KnxAdvisorCta.astro';
import KnxFieldGallery from '../components/KnxFieldGallery.astro';

const accurateIntegratorCopy = content.replace(
  '<p>חשמלאי מחווט; אינטגרטור מחבר עולמות. בית חכם אמיתי דורש תכנון מערכתי, תכנות, חיבור בין מותגים וטכנולוגיות שונות, ושירות שוטף לאורך שנים. ב-i Feel הכול פנימי — תכנון, יבוא ציוד (בעיקר Siemens), ייצור מערכות אלחוטיות, התקנה עם צוותים שלנו, ו<a href="/service-and-maintenance/">מחלקת שירות</a> משלנו. אחריות אחת, ספק אחד, ושרשרת אספקה בשליטה מלאה. יש לכם מערכת קיימת שצריכה תחזוקה? ראו <a href="/smart-home-service/">שירות ותחזוקה לבית חכם</a>. מערכת ישנה שהגיע זמנה להתחדש? ראו <a href="/smart-home-system-upgrade/">שדרוג מערכת בית חכם קיימת</a>.</p>',
  '<p>חשמלאי מחווט; אינטגרטור מחבר עולמות. בית חכם מקצועי דורש תכנון מערכתי, תכנות, חיבור בין מערכות ושירות שוטף לאורך שנים. ב-i Feel האחריות מרוכזת אצל צוות אחד שמלווה את הפרויקט מאפיון ותכנון, דרך אינטגרציה, תכנות והתקנה ועד מסירה ו<a href="/service-and-maintenance/">שירות</a> בישראל. בפרויקטים המתאימים אנו משלבים KNX ופתרונות Siemens בהתאם לדרישות התכנון, בלי לטעון לבלעדיות או לייצוג שאינו מתועד. יש לכם מערכת קיימת שצריכה תחזוקה? ראו <a href="/smart-home-service/">שירות ותחזוקה לבית חכם</a>. מערכת ישנה שהגיע זמנה להתחדש? ראו <a href="/smart-home-system-upgrade/">שדרוג מערכת בית חכם קיימת</a>.</p>'
);

const enrichedContent = accurateIntegratorCopy.replace(
  '<section id="integrator">',
  '<section id="choose-smart-home-company"><h2>איך בוחרים חברת בית חכם בישראל?</h2><p><strong>התשובה הקצרה:</strong> בוחרים חברה לפי איכות התכנון, הטכנולוגיה, ניסיון האינטגרציה והשירות שאחרי המסירה — לא לפי מספר המתגים או האפליקציה בלבד. בבנייה חדשה חשוב לבדוק ניסיון ב-<a href="/knx-smart-home/">KNX</a>, יכולת לתאם חשמל, מיזוג, אבטחה, אודיו ורשתות תחת תכנון אחד, ומחלקת <a href="/service-and-maintenance/">שירות ותחזוקה</a> פעילה בישראל. בפרויקטים גדולים או מסחריים חשוב לבדוק גם ניסיון ב-<a href="/structure-control/">BMS ובקרת מבנה</a>. להשוואה מסודרת ראו <a href="/smart-home-bms-companies-israel/">מדריך לבחירת חברת בית חכם ובקרת מבנה בישראל</a>.</p></section><section id="integrator">'
);

const tenInchScreenSection = '<section id="ten-inch-control-screen"><h2>מסך 10 אינץ׳ לשליטה מרכזית בבית החכם</h2><div class="not-prose mt-6 bg-brand-900 rounded-2xl p-4 md:p-6 flex justify-center"><div class="w-full max-w-[300px] rounded-xl overflow-hidden" style="aspect-ratio:9/16;"><iframe loading="lazy" class="w-full h-full" src="https://www.youtube-nocookie.com/embed/AV4FfQJQqH8" title="מסך 10 אינץ׳ לשליטה בכל מערכות הבית החכם — I FEEL" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div></div><p>מסך שליטה מרכזי בגודל 10 אינץ׳ מאפשר להפעיל מממשק אחד את התאורה, המיזוג, התריסים, המוזיקה, האבטחה והתרחישים בכל חדרי הבית. כך אין צורך לעבור בין אפליקציות נפרדות, וכל בני הבית מקבלים דרך הפעלה ברורה ונוחה.</p><p><a href="/contactus/">דברו איתנו לתכנון מסך שליטה ומערכת בית חכם מלאה</a>.</p></section>';
const smartHomeContent = enrichedContent.replace('</div></article>', `${tenInchScreenSection}</div></article>`);

const meta = {
  title: "בית חכם בישראל | KNX, אינטגרציה ומחירים | i-feel",
  description: "בית חכם בישראל — מדריך מקיף ל-KNX, השוואה ל-Zigbee, ניתוח חדר-חדר ומחירים. i-feel, אימבר 14, פתח תקווה. שיחת ייעוץ ראשונית 03-508-9553.",
  canonical: "https://i-feel.co.il/smart-home/",
  ogTitle: "בית חכם בישראל | KNX ואינטגרציה | i-feel",
  ogDescription: "המדריך המקיף לבית חכם בישראל — KNX, השוואת פרוטוקולים, חדר-חדר ומחירים. i-feel מערכות בקרת מבנה ובית חכם.",
