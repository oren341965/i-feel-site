---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-03.html?raw';

const meta = {
  title: "אודיו, קולנוע ורמקולים לגינה | i-feel",
  description: "אודיו וקולנוע ביתי: multi-room, Dolby Atmos, מקרנים ורמקולים חיצוניים לגינה ולפרגולה. Focal, Origin Acoustics ו-SpeakerCraft — תכנון, התקנה ואינטגרציה של i-feel.",
  canonical: "https://i-feel.co.il/audio-and-sound-systems/",
  ogTitle: "אודיו, קולנוע ורמקולים לגינה | i-feel",
  ogDescription: "מערכות אודיו וקולנוע ביתי בהתאמה אישית: Multi-room, Dolby Atmos, רמקולים חיצוניים לגינה ולפרגולה ומערכות Focal, Origin Acoustics ו-SpeakerCraft.",
  ogUrl: "https://i-feel.co.il/audio-and-sound-systems/",
  ogImage: "https://i-feel.co.il/assets/og-cover.jpg",
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
        '@id': 'https://i-feel.co.il/#business',
        name: 'i-feel',
        url: 'https://i-feel.co.il/',
        telephone: '+972-3-508-9553',
        email: 'sales@i-feel.co.il',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'אימבר 14',
          addressLocality: 'פתח תקווה',
          postalCode: '4951148',
          addressCountry: 'IL'
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 32.09124,
          longitude: 34.88762
        }
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'אודיו', item: 'https://i-feel.co.il/audio-and-sound-systems/' }
        ]
      },
      {
        '@type': 'Service',
        name: 'תכנון והתקנת מערכות אודיו וקולנוע ביתי',
        serviceType: 'Home Audio and Home Theater Integration',
        provider: { '@id': 'https://i-feel.co.il/#business' },
        areaServed: { '@type': 'Country', name: 'Israel' },
        description: 'תכנון והתקנה של מערכות Multi-room, קולנוע ביתי, Dolby Atmos, רמקולים חיצוניים לגינה ולפרגולה, רמקולים שקועים, מקרנים, מנגנוני הרמה וכיול אקוסטי.'
      },
      {
        '@type': 'VideoObject',
        '@id': 'https://i-feel.co.il/audio-and-sound-systems/#v-dual-zone-receiver',
        name: 'איך מפעילים שני אזורים יחד ברסיבר Denon HEOS | I FEEL',
        description: 'מדריך להפעלה משותפת של MAIN ZONE ו-ZONE 2 ברסיבר Denon HEOS, כדי להשמיע אותה מוזיקה בשני החללים בפעולה אחת.',
        uploadDate: '2026-08-23T14:57:11Z',
        thumbnailUrl: 'https://i.ytimg.com/vi/_d_DDG-Ee5Q/hqdefault.jpg',
        contentUrl: 'https://www.youtube.com/watch?v=_d_DDG-Ee5Q',
        embedUrl: 'https://www.youtube-nocookie.com/embed/_d_DDG-Ee5Q',
        inLanguage: 'he-IL',
        publisher: { '@id': 'https://i-feel.co.il/#business' }
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <section dir="rtl" class="bg-brand-50 py-10"><div class="mx-auto max-w-7xl px-4"><p class="font-bold text-accent-700">קטלוג AV</p><h2 class="mt-2 text-3xl font-extrabold text-brand-900">רמקולים וסאבוופרים Gallo Acoustics</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-brand-700">Micro, Micro SE וסאבוופרים משלימים ב־37 גרסאות צבע וגימור. מחירים ליחידה כולל מע״מ, החל מ־1,090 ₪.</p><a href="/av/gallo-acoustics/" class="mt-6 inline-block rounded-lg bg-accent-500 px-6 py-3 font-bold text-white hover:bg-accent-600">לכל הדגמים והמחירים</a></div></section>
  <section dir="rtl" class="bg-white py-12" aria-labelledby="cabasse-alcyone-heading">
    <div class="mx-auto max-w-7xl px-4">
      <p class="font-bold text-accent-700">רמקולים קומפקטיים · CABASSE</p>
      <h2 id="cabasse-alcyone-heading" class="mt-2 text-3xl font-extrabold text-brand-900">Cabasse Alcyone 2 · רמקולים כדוריים בקוטר 9.9 ס״מ</h2>
      <p class="mt-4 max-w-4xl text-lg leading-8 text-brand-700">רמקולים פסיביים לקולנוע ביתי, בהספק 50W נומינלי ו-350W שיא, רגישות 87dB ותחום תדרים 160–20,000Hz. התקנה על קיר, מדף או מעמד ייעודי; מומלץ לשלב סאבוופר להפקת תדרי בס נמוכים.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/av/cabasse-alcyone-2/" class="inline-block rounded-lg bg-accent-500 px-6 py-3 font-bold text-white hover:bg-accent-600">למפרט המלא בעברית</a>
        <a href="https://crazyedi.co.il/wp-content/uploads/2022/12/FT-ALCYONE-2-GB-12-10-12-web_compressed.pdf" target="_blank" rel="noopener noreferrer" class="inline-block rounded-lg border border-brand-300 px-6 py-3 font-bold text-brand-900">מפרט יצרן PDF באנגלית</a>
      </div>
    </div>
  </section>
  <Fragment set:html={content} />
  <nav class="max-w-7xl mx-auto px-4 py-8" aria-label="מדריכי קולנוע ביתי">
    <a href="/projector-lift-installation/" class="text-brand-700 underline">תכנון והתקנת מעלית למקרן בקולנוע הביתי</a>
  </nav>
</BaseLayout>
