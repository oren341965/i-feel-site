---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {glassSocketProducts,getGlassSocketProduct} from '../../data/glass-socket-products';
export function getStaticPaths(){return glassSocketProducts.map((product)=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props;
const canonical=`https://i-feel.co.il/glass-socket-products/${product.slug}/`;
const related=product.related.map((slug)=>getGlassSocketProduct(slug)).filter(Boolean);
const meta={title:`${product.title} | i-feel`,description:product.summary,canonical,ogTitle:product.title,ogDescription:product.summary,ogUrl:canonical,ogImage:`https://i-feel.co.il${product.image}`,jsonLd:JSON.stringify({"@context":"https://schema.org","@type":"Product",name:product.title,description:product.summary,image:`https://i-feel.co.il${product.image}`,category:product.categoryLabel,brand:{"@type":"Brand",name:"i-feel"},url:canonical})};
---
<BaseLayout {...meta}><main id="main-content" class="bg-white text-brand-900">
<nav class="border-b border-brand-100 bg-brand-50" aria-label="פירורי לחם"><div class="mx-auto max-w-7xl px-4 py-3 text-sm"><a href="/" class="text-brand-600">דף הבית</a><span class="mx-2">›</span><a href="/glass-sockets/" class="text-brand-600">שקעי זכוכית</a><span class="mx-2">›</span><a href="/glass-socket-catalog/" class="text-brand-600">קטלוג מוצרים</a><span class="mx-2">›</span>{product.name}</div></nav>
<section class="mx-auto grid max-w-7xl gap-8 px-4 py-8 md:grid-cols-2 md:gap-12 md:py-14"><div class="flex min-h-72 items-center justify-center rounded-2xl border border-brand-100 p-6 md:min-h-[480px]"><img src={product.image} alt={product.alt} width="1000" height="1000" fetchpriority="high" class="max-h-[440px] w-full object-contain"></div><div class="self-center"><p class="mb-3 font-extrabold text-accent-700">{product.categoryLabel} · סדרת שקעי הזכוכית</p><h1 class="mb-4 text-4xl font-extrabold leading-tight md:text-5xl">{product.title}</h1><p class="mb-6 text-lg leading-8 text-brand-700">{product.summary}</p><div class="mb-7 rounded-xl border border-brand-200 bg-brand-50 p-4"><p class="mb-1 text-sm font-bold text-brand-600">פרטי המוצר</p><p class="mb-0 text-lg font-extrabold">{product.family} · {product.finish}</p></div><div class="flex flex-wrap gap-3"><a href="/contactus/" class="rounded-lg bg-accent-500 px-5 py-3 font-bold text-white">בדיקת התאמה ומפרט</a><a href="/glass-socket-frame-builder/" class="rounded-lg border border-brand-300 px-5 py-3 font-bold">הרכבה בסימולטור</a></div></div></section>
<section class="mx-auto max-w-7xl px-4 pb-12"><nav class="mb-8 flex flex-wrap gap-3 border-b border-brand-200 pb-4" aria-label="פרטי מוצר"><a href="#overview" class="rounded-full bg-brand-900 px-4 py-2 font-bold text-white">סקירה כללית</a><a href="#technical" class="rounded-full border border-brand-300 px-4 py-2 font-bold">מידע טכני</a><a href="#related" class="rounded-full border border-brand-300 px-4 py-2 font-bold">מוצרים קשורים</a></nav>
<section id="overview" class="prose-he max-w-4xl pb-8"><h2>סקירה כללית</h2><p>{product.summary}</p><ul>{product.features.map((feature)=><li>{feature}</li>)}</ul></section>
<section id="technical" class="border-t border-brand-100 py-8"><h2 class="mb-5 text-3xl font-extrabold">מידע טכני</h2><div class="overflow-hidden rounded-xl border border-brand-200"><dl class="divide-y divide-brand-100"><div class="grid gap-2 bg-white px-5 py-4 sm:grid-cols-[220px_1fr]"><dt class="font-bold">משפחה</dt><dd class="m-0 text-brand-700">{product.family}</dd></div><div class="grid gap-2 bg-brand-50 px-5 py-4 sm:grid-cols-[220px_1fr]"><dt class="font-bold">גימור</dt><dd class="m-0 text-brand-700">{product.finish}</dd></div><div class="grid gap-2 bg-white px-5 py-4 sm:grid-cols-[220px_1fr]"><dt class="font-bold">מספר מקומות</dt><dd class="m-0 text-brand-700">{product.positions}</dd></div><div class="grid gap-2 bg-brand-50 px-5 py-4 sm:grid-cols-[220px_1fr]"><dt class="font-bold">כיוון התקנה</dt><dd class="m-0 text-brand-700">{product.arrangement}</dd></div><div class="grid gap-2 bg-white px-5 py-4 sm:grid-cols-[220px_1fr]"><dt class="font-bold">תאימות</dt><dd class="m-0 text-brand-700">יש לבדוק קופסה, מנגנון ותשתית מול הדגם לפני הזמנה והתקנה.</dd></div></dl></div><p class="mt-4 text-sm leading-6 text-brand-600">התמונה והמידע מציגים משפחת מוצר ואפשרויות תכנון. המפרט הסופי, המק״ט והתאימות נקבעים לפי הדגם וההצעה.</p></section>
<section id="related" class="border-t border-brand-100 py-8"><h2 class="mb-6 text-3xl font-extrabold">מוצרים קשורים</h2><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{related.map((item)=><a href={`/glass-socket-products/${item.slug}/`} class="overflow-hidden border border-brand-200 bg-white hover:shadow-lg"><div class="flex h-48 items-center justify-center p-4"><img src={item.image} alt={item.alt} width="700" height="700" loading="lazy" class="h-full w-full object-contain"></div><div class="border-t border-brand-100 p-4"><p class="mb-1 font-bold text-accent-700">{item.categoryLabel}</p><h3 class="mb-3 text-lg font-extrabold">{item.name}</h3><span class="font-bold text-accent-700">הצג מוצר ‹</span></div></a>)}</div></section></section>
</main></BaseLayout>