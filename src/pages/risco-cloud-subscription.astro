const faq = [
  { question: 'האם החיוב של RISCO חודשי?', answer: 'לא לפי מודל החיוב הנוכחי שמפרסמת RISCO. מנוי שירותי הענן הוא שנתי, והמחיר תלוי בחבילה שנבחרה ומוצג לפני הרכישה או החידוש.' },
  { question: 'כמה עולה מנוי iRISCO?', answer: 'המחיר נקבע לפי החבילה ומספר האתרים ומוצג בתוך iRISCO או בחנות האפליקציות לפני התשלום. המחיר שמופיע בעת הרכישה הוא המחיר המחייב וכולל מע״מ לפי RISCO.' },
  { question: 'מה קורה אם לא מחדשים את מנוי הענן?', answer: 'האזעקה המקומית אמורה להמשיך לפעול לפי התצורה שלה, כולל לוח המקשים, הגלאים והסירנה. גישה מרחוק, התראות ותכונות iRISCO עלולות להיפסק. חיבור למוקד או ל-SIM הוא שירות נפרד ויש לבדוק אותו מול הספק.' },
  { question: 'האם 50 ₪ לחודש ל-i-feel כוללים את מנוי RISCO?', answer: 'לא. הצעת השירות הפרטית של i-feel לשנת 2026 מציינת ששירותי ענן, דמי מנוי ורישיונות תוכנה אינם כלולים. אלה חיובים נפרדים, אלא אם נכתב אחרת במפורש בהסכם האישי.' },
  { question: 'מי מטפל בבעיה באפליקציה ומי מטפל בחיוב?', answer: 'i-feel יכולה לסייע בהגדרת האתר, המשתמש והתקשורת למערכת שהותקנה או משויכת אליה. בעיית חיוב, ביטול או חשבונית מטופלת אצל הגורם שגבה את התשלום: Apple, Google, RISCO או המשווק.' }
];

