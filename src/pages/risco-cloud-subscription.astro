    { '@type': 'WebPage', '@id': 'https://i-feel.co.il/risco-cloud-subscription/#page', url: 'https://i-feel.co.il/risco-cloud-subscription/', name: 'שירותי ענן RISCO ומנוי iRISCO', description: 'מדריך ללקוחות RISCO: מה כולל מנוי iRISCO, חיוב שנתי, תשלום וחידוש, עבודה מקומית וההבדל מול מוקד והסכם השירות של i-feel.', inLanguage: 'he-IL', about: { '@type': 'SoftwareApplication', name: 'iRISCO', applicationCategory: 'SecurityApplication' }, isPartOf: { '@id': 'https://i-feel.co.il/#website' } },
