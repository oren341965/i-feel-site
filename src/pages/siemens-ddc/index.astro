---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ddcCategoryMeta,
  ddcCategoryOrder,
  getDdcProductsByCategory,
  siemensDdcProducts,
} from '../../data/siemens-ddc-products';

const canonical = 'https://i-feel.co.il/siemens-ddc/';
const title = 'ציוד Siemens Desigo DDC | בקרי PXC, מודולי TX-I/O ו-DXR | i-feel';
const description = 'ספריית מוצרי Siemens Desigo לבקרת מבנה: בקרי DDC ממשפחות PXC4, PXC5 ו-PXC7, מודולי TX-I/O, בקרי חדר DXR2 ומסכי Control Point.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'he-IL',
      isPartOf: { '@id': 'https://i-feel.co.il/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'בקרת מבנה BMS', item: 'https://i-feel.co.il/structure-control/' },
        { '@type': 'ListItem', position: 3, name: 'ציוד Siemens DDC', item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'מוצרי Siemens Desigo DDC',
      numberOfItems: siemensDdcProducts.length,
      itemListElement: siemensDdcProducts.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${product.model} - ${product.name}`,
        url: `https://i-feel.co.il/siemens-ddc/${product.slug}/`,
      })),
    },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  ogImage="https://i-feel.co.il/assets/office-bms.jpeg"
  jsonLd={jsonLd}
>
  <nav class="bg-brand-50 border-b border-brand-100" aria-label="פירורי לחם" dir="rtl">
    <div class="max-w-7xl mx-auto px-4 py-3 text-sm">
      <a href="/" class="text-brand-600 hover:text-accent-600">דף הבית</a>
      <span class="mx-2 text-brand-400">›</span>
      <a href="/structure-control/" class="text-brand-600 hover:text-accent-600">בקרת מבנה BMS</a>
      <span class="mx-2 text-brand-400">›</span>
      <span class="text-brand-900 font-medium">ציוד Siemens DDC</span>
    </div>
  </nav>

  <main dir="rtl">
    <section class="bg-brand-900 text-white py-16 lg:py-20 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 relative">
        <div class="absolute -left-20 -top-20 w-72 h-72 rounded-full bg-accent-500/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-brand-50 mb-6">
              Siemens Desigo · PXC · TX-I/O · DXR2 · Control Point
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
              ספריית ציוד Siemens Desigo DDC
            </h1>
            <p class="text-xl leading-9 text-brand-100 max-w-4xl mb-8">
              דפי מוצר בעברית לבקרי האוטומציה, מודולי הקלט והפלט, בקרי החדר וממשקי התפעול המרכזיים של Siemens. כל דף כולל יישומים, נתונים מרכזיים וקישור למסמך הרשמי.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="/bms-configurator/" class="inline-flex items-center justify-center rounded-lg bg-accent-500 px-7 py-3.5 font-bold text-white shadow-lg transition hover:bg-accent-600">
                בניית קונפיגורציית BMS
              </a>
              <a href="/siemens-desigo-bms/" class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-7 py-3.5 font-bold text-white transition hover:bg-white/20">
                על Siemens Desigo
              </a>
            </div>
          </div>

          <aside class="rounded-3xl border border-white/15 bg-white/10 p-7 backdrop-blur">
            <p class="text-accent-300 font-bold mb-5">הספרייה כוללת</p>
            <div class="grid grid-cols-2 gap-4">
              <div class="rounded-2xl bg-white/10 p-5">
                <div class="text-4xl font-extrabold text-white">{siemensDdcProducts.length}</div>
                <div class="mt-2 text-brand-100">דפי מוצר</div>
              </div>
              <div class="rounded-2xl bg-white/10 p-5">
                <div class="text-4xl font-extrabold text-white">{ddcCategoryOrder.length}</div>
                <div class="mt-2 text-brand-100">משפחות ציוד</div>
              </div>
              <div class="col-span-2 rounded-2xl border border-accent-400/30 bg-accent-500/10 p-5">
                <div class="font-extrabold text-lg mb-1">קונפיגורטור נקודות פעיל</div>
                <p class="text-brand-100 leading-7">הזנת DI, AI, AO, DO, Triac ו-Pt100 לקבלת בקר ורשימת מודולים ראשונית.</p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white border-b border-brand-100 py-8 sticky top-0 z-20 shadow-sm">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-[minmax(280px,0.7fr)_1.3fr] gap-4 items-center">
          <label class="relative block">
            <span class="sr-only">חיפוש מוצר</span>
            <input
              id="ddc-search"
              type="search"
              class="w-full rounded-xl border border-brand-200 bg-white px-5 py-3.5 pr-12 text-brand-900 outline-none transition focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
              placeholder="חיפוש לפי דגם, יישום או פרוטוקול"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-brand-400" aria-hidden="true">⌕</span>
          </label>
          <div class="flex flex-wrap gap-2" id="ddc-filter-buttons">
            <button type="button" data-category="all" class="ddc-filter rounded-full bg-brand-900 px-4 py-2.5 text-sm font-bold text-white">כל המוצרים</button>
            {ddcCategoryOrder.map((category) => (
              <button type="button" data-category={category} class="ddc-filter rounded-full border border-brand-200 bg-white px-4 py-2.5 text-sm font-bold text-brand-700 transition hover:border-accent-500 hover:text-accent-700">
                {ddcCategoryMeta[category].label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-50/40 py-14 lg:py-18">
      <div class="max-w-7xl mx-auto px-4">
        <div id="ddc-products-root" class="space-y-14">
          {ddcCategoryOrder.map((category) => {
            const products = getDdcProductsByCategory(category);
            const meta = ddcCategoryMeta[category];
            return (
              <section class="ddc-category-section" data-category-section={category}>
                <div class="flex flex-wrap items-end justify-between gap-5 mb-7">
                  <div class="max-w-3xl">
                    <div class="inline-flex h-12 min-w-12 items-center justify-center rounded-xl bg-accent-500/10 px-3 font-black text-accent-700 mb-3">{meta.icon}</div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-brand-900 mb-2">{meta.label}</h2>
                    <p class="text-lg leading-8 text-brand-700">{meta.description}</p>
                  </div>
                  <span class="rounded-full bg-white border border-brand-100 px-4 py-2 text-sm font-bold text-brand-600">{products.length} מוצרים</span>
                </div>

                <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
                  {products.map((product) => (
                    <article
                      class="ddc-product-card group flex flex-col rounded-2xl border border-brand-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-accent-400 hover:shadow-lg"
                      data-category={product.category}
                      data-search={`${product.model} ${product.name} ${product.family} ${product.shortDescription} ${product.applications.join(' ')} ${product.protocols.join(' ')}`.toLowerCase()}
                    >
                      <div class="flex items-start justify-between gap-4 mb-5">
                        <div class="flex h-14 min-w-16 items-center justify-center rounded-xl bg-brand-900 px-3 text-sm font-black tracking-wide text-white">{product.icon}</div>
                        {product.featured && <span class="rounded-full bg-accent-500/10 px-3 py-1.5 text-xs font-bold text-accent-700">מוצר מרכזי</span>}
                      </div>
                      <p class="text-sm font-bold text-accent-700 mb-2">{product.family}</p>
                      <h3 class="text-2xl font-extrabold leading-tight text-brand-900 mb-2" dir="ltr">{product.model}</h3>
                      <p class="font-bold text-brand-800 mb-3">{product.name}</p>
                      <p class="text-brand-600 leading-7 mb-5 flex-grow">{product.shortDescription}</p>
                      <div class="flex flex-wrap gap-2 mb-5">
                        {product.protocols.slice(0, 3).map((protocol) => (
                          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{protocol}</span>
                        ))}
                      </div>
                      <a href={`/siemens-ddc/${product.slug}/`} class="inline-flex items-center justify-center rounded-lg bg-brand-700 px-5 py-3 font-bold text-white transition group-hover:bg-accent-600">
                        לדף המוצר המלא
                      </a>
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>

        <div id="ddc-no-results" class="hidden rounded-2xl border border-brand-100 bg-white p-10 text-center shadow-sm">
          <h2 class="text-2xl font-extrabold text-brand-900 mb-2">לא נמצאו מוצרים מתאימים</h2>
          <p class="text-brand-600">נסו לחפש דגם, סוג נקודה, יישום או פרוטוקול אחר.</p>
        </div>
      </div>
    </section>

    <section class="bg-white py-14 lg:py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="rounded-3xl bg-brand-900 p-7 md:p-10 text-white grid lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center">
          <div>
            <p class="text-accent-300 font-bold mb-2">מתכנון נקודות לרשימת ציוד</p>
            <h2 class="text-3xl md:text-4xl font-extrabold mb-4">בנו תצורת BMS ראשונית באתר</h2>
            <p class="text-lg leading-8 text-brand-100">
              הזינו את מספרי הכניסות, היציאות והאינטגרציות. הכלי יציע בקר Siemens מתאים, יחלק את נקודות ה-TX-I/O ויפיק BOM להדפסה, CSV ושליחה לצוות i-feel.
            </p>
          </div>
          <div class="lg:text-left">
            <a href="/bms-configurator/" class="inline-flex items-center justify-center rounded-xl bg-accent-500 px-8 py-4 text-lg font-extrabold text-white shadow-xl transition hover:bg-accent-600">
              פתיחת קונפיגורטור BMS
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-50 py-12 border-t border-brand-100">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold text-brand-900 mb-3">הערה הנדסית חשובה</h2>
        <p class="text-lg leading-8 text-brand-700">
          המידע באתר והקונפיגורטור מיועדים לתכנון ראשוני. בחירת הבקר, הרישוי, אספקת הכוח, רשתות התקשורת, המודולים והגנות השדה חייבת לעבור בדיקה סופית של מהנדס או מתכנת Siemens לפי תכניות הפרויקט והמסמכים העדכניים.
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const searchInput = document.getElementById('ddc-search');
      const filterButtons = Array.from(document.querySelectorAll('.ddc-filter'));
      const cards = Array.from(document.querySelectorAll('.ddc-product-card'));
      const sections = Array.from(document.querySelectorAll('.ddc-category-section'));
      const noResults = document.getElementById('ddc-no-results');
      let activeCategory = 'all';

      const applyFilters = () => {
        const query = (searchInput?.value || '').trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
          const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
          const searchMatch = !query || (card.dataset.search || '').includes(query);
          const visible = categoryMatch && searchMatch;
          card.classList.toggle('hidden', !visible);
          if (visible) visibleCount += 1;
        });

        sections.forEach((section) => {
          const hasVisibleCard = Array.from(section.querySelectorAll('.ddc-product-card')).some((card) => !card.classList.contains('hidden'));
          section.classList.toggle('hidden', !hasVisibleCard);
        });

        noResults?.classList.toggle('hidden', visibleCount > 0);
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeCategory = button.dataset.category || 'all';
          filterButtons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle('bg-brand-900', selected);
            item.classList.toggle('text-white', selected);
            item.classList.toggle('border-brand-200', !selected);
            item.classList.toggle('bg-white', !selected);
            item.classList.toggle('text-brand-700', !selected);
          });
          applyFilters();
        });
      });

      searchInput?.addEventListener('input', applyFilters);
    })();
  </script>
</BaseLayout>
