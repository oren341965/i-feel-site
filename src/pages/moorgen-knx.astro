---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = 'https://i-feel.co.il/moorgen-knx/';
const catalog = '/assets/catalogs/moorgen-knx-catalog.pdf';
const image = '/assets/catalogs/moorgen-knx-panel.webp';
const title = 'Moorgen KNX | מפסקים, תרמוסטטים וקטלוג | I Feel';
const description = 'קטלוג Moorgen למערכות KNX: פאנלים מסדרות Swiss ו-Steve Leung, מפסקים ותרמוסטטים מסדרת Newton Retro, גימורים ואביזרים.';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: canonical,
  description,
  inLanguage: 'he-IL',
  about: { '@type': 'Brand', name: 'Moorgen' },
});
---

<BaseLayout {title} {description} {canonical} ogUrl={canonical} ogImage={new URL(image, canonical).href} {jsonLd}>
  <article dir="rtl" class="max-w-5xl mx-auto px-4 py-12">
    <nav aria-label="פירורי לחם" class="mb-6 text-sm">
      <a class="underline" href="/knx-smart-home/">בית חכם KNX</a>
      <span aria-hidden="true"> / </span>
      <a class="underline" href="/knx-switch-advisor/">בחירת מפסקי KNX</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">Moorgen</span>
    </nav>
    <header class="grid md:grid-cols-2 gap-8 items-center rounded-2xl bg-brand-50 p-6 md:p-10">
      <div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-brand-900 mb-5">מפסקים ופאנלים של <bdi>Moorgen KNX</bdi></h1>
        <p class="text-lg leading-relaxed mb-6">הקטלוג מרכז פאנלים לקיר, תרמוסטטים, גימורים, מק״טים ואביזרים לבחירת ממשקי שליטה בבית חכם.</p>
        <a href={catalog} class="inline-block rounded-lg bg-brand-800 px-5 py-3 font-bold text-white">פתיחת הקטלוג (PDF באנגלית)</a>
      </div>
      <img src={image} alt="פאנל קיר Moorgen מסדרת Swiss" width="480" height="360" class="w-full max-w-sm mx-auto rounded-xl bg-white" />
    </header>
    <section aria-labelledby="moorgen-series" class="mt-10">
      <h2 id="moorgen-series" class="text-2xl font-bold mb-4">סדרות ואביזרים בקטלוג</h2>
      <dl class="grid md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-brand-100 p-5">
          <dt class="font-bold mb-2"><bdi>80 Swiss Series</bdi></dt>
          <dd>פאנלים ותרמוסטטים עם חזית ובסיס KNX, בגימורים כגון לבן, שחור וזהב שמפניה.</dd>
        </div>
        <div class="rounded-xl border border-brand-100 p-5">
          <dt class="font-bold mb-2"><bdi>80 Steve Leung Series</bdi></dt>
          <dd>פאנלים ותרמוסטטים בכמה גימורים, ובהם כסף, שחור וזהב מונקו.</dd>
        </div>
        <div class="rounded-xl border border-brand-100 p-5">
          <dt class="font-bold mb-2"><bdi>86 Newton Retro Series</bdi></dt>
          <dd>מפסקי מנוף, תרמוסטט סיבובי ושילובים במסגרות בגימור ברונזה עתיקה.</dd>
        </div>
      </dl>
      <p class="mt-5">הקטלוג כולל גם שלטים אלחוטיים, אביזרי התקנה ומודול חיבור בין שלטים אלחוטיים למערכת KNX.</p>
    </section>
    <p class="mt-8"><a class="font-bold underline" href="/knx-switch-advisor/#moorgen-knx">לגלריית מפסקי KNX עם ABB PEONIA ו־Eelectron</a></p>
  </article>
</BaseLayout>
