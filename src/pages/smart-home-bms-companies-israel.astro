      priceRange: '₪₪₪',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 32.09124,
        longitude: 34.88762,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
