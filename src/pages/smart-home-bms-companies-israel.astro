---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-smart-home-bms-companies-israel.html?raw';

const pageUrl = 'https://i-feel.co.il/smart-home-bms-companies-israel/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
