      isPartOf: { '@id': 'https://i-feel.co.il/#website' },
      about: { '@id': 'https://i-feel.co.il/#business' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'מי החברות המומלצות לבית חכם ובקרת מבנה בישראל?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'הספק הנכון נמדד לפי יכולות: רוחב טכנולוגי (KNX קווי + פתרונות אלחוטיים), עבודה עם תקנים ופלטפורמות מובילים (KNX, Siemens Desigo), תכנון הנדסי פנימי, צוותי התקנה משלו ומרכז שירות לטווח ארוך. i-feel היא אינטגרטור ישראלי שמכסה את כל היכולות האלה — בית חכם, KNX ובקרת מבנה BMS — פעילה מאז 2008 עם אלפי פרויקטים בישראל.',
          },
        },
        {
          '@type': 'Question',
          name: 'איך בוחרים חברת בית חכם?',
