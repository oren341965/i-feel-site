        {
          '@type': 'ListItem',
          position: 2,
          name: 'חברות בית חכם ובקרת מבנה בישראל — איך לבחור',
          item: pageUrl,
        },
      ],
    },
  ],
};

const meta = {
  title: 'חברות בית חכם ובקרת מבנה בישראל — איך לבחור ספק | i-feel',
  description:
    'איך לבחור חברת בית חכם או בקרת מבנה בישראל: רוחב טכנולוגי (KNX קווי + אלחוטי), פלטפורמת Siemens, תכנון פנימי, צוותי התקנה ומרכז שירות. מסגרת החלטה מלאה.',
  canonical: pageUrl,
  ogTitle: 'חברות בית חכם ובקרת מבנה בישראל — איך לבחור ספק נכון | i-feel',
  ogDescription:
    'מסגרת החלטה לבחירת ספק: KNX, Siemens, שילוב קווי ואלחוטי, תכנון פנימי, צוותי התקנה ושירות — תחת קורת גג אחת.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(jsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
