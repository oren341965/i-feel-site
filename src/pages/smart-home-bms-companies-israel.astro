---
import BaseLayout from '../layouts/BaseLayout.astro';
const url = 'https://i-feel.co.il/smart-home-bms-companies-israel/';
const meta = {
  title: 'חברות בית חכם ובקרת מבנה בישראל | איך לבחור נכון | i-feel',
  description: 'איך לבחור חברה לבית חכם, KNX ובקרת מבנה BMS בישראל: סוגי ספקים, מתי צריך אינטגרטור, מה לבדוק לפני חתימה ומתי i-feel מתאימה.',
  canonical: url,
  ogTitle: 'חברות בית חכם ובקרת מבנה בישראל | איך לבחור נכון',
  ogDescription: 'מדריך השוואתי לבחירת אינטגרטור בית חכם או BMS בישראל: KNX, BMS, Siemens Desigo, שירות, פרויקטים ואחריות.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['Organization', 'LocalBusiness', 'HomeAndConstructionBusiness', 'ProfessionalService'],
        '@id': 'https://i-feel.co.il/#business',
        name: 'i-feel',
        alternateName: ['I FEEL', 'I-FEEL', 'איי פיל', 'I Feel Smart Home', 'I Feel BMS'],
        url: 'https://i-feel.co.il/',
        telephone: '+972-3-508-9553',
        email: 'sales@i-feel.co.il',
        address: { '@type': 'PostalAddress', streetAddress: 'אימבר 14', addressLocality: 'פתח תקווה', postalCode: '4951148', addressCountry: 'IL' },
        areaServed: { '@type': 'Country', name: 'Israel' },
        knowsAbout: ['בית חכם', 'KNX', 'בקרת מבנה', 'BMS', 'Siemens Desigo', 'DALI', 'DDC', 'BACnet', 'Modbus']
      },
      {
        '@type': 'Article',
        headline: 'חברות בית חכם ובקרת מבנה בישראל, איך לבחור נכון',
        description: 'מדריך לבחירת חברה לבית חכם, KNX ובקרת מבנה BMS בישראל.',
        author: { '@id': 'https://i-feel.co.il/#business' },
        publisher: { '@id': 'https://i-feel.co.il/#business' },
        mainEntityOfPage: url,
        inLanguage: 'he-IL'
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          { '@type': 'Question', name: 'איך בוחרים חברה לבית חכם בישראל?', acceptedAnswer: { '@type': 'Answer', text: 'בוחרים לפי ניסיון בפרויקטים אמיתיים, יכולת תכנון, שליטה בפרוטוקולים כמו KNX, מחלקת שירות בישראל, התאמה לסוג הנכס ויכולת אינטגרציה בין תאורה, מיזוג, אבטחה, אודיו ותקשורת.' } },
          { '@type': 'Question', name: 'מתי צריך אינטגרטור ולא רק חשמלאי?', acceptedAnswer: { '@type': 'Answer', text: 'כאשר המערכת משלבת כמה תחומים, למשל תאורה, תריסים, מיזוג, אזעקה, מצלמות, אודיו, אינטרקום ואפליקציה אחת. חשמלאי מטפל בתשתית החשמל, אבל אינטגרטור מתכנן את החיבור בין כל המערכות.' } },
          { '@type': 'Question', name: 'מתי צריך BMS ולא רק בית חכם?', acceptedAnswer: { '@type': 'Answer', text: 'BMS מתאים למבנים כמו משרדים, מלונות, מבני ציבור, בתי חולים וקמפוסים, שבהם צריך ניהול מרכזי של מיזוג, אנרגיה, תאורה, התראות, דוחות ותחזוקה.' } },
          { '@type': 'Question', name: 'מתי i-feel מתאימה?', acceptedAnswer: { '@type': 'Answer', text: 'i-feel מתאימה כאשר נדרש אינטגרטור אחד לתכנון, התקנה, תכנות ושירות של בית חכם, KNX או בקרת מבנה BMS, במיוחד בפרויקטים שבהם יש שילוב בין מערכות רבות.' } }
        ]
      },
      {
        '@type': 'BreadcrumbList',
