---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/page-smart-home-bms-companies-israel.html?raw';

const pageUrl = 'https://i-feel.co.il/smart-home-bms-companies-israel/';

const faq = [
  {
    question: 'איך בוחרים חברת בית חכם בישראל?',
    answer:
      'בודקים תכנון, התאמת טכנולוגיה לפרויקט, יכולת אינטגרציה, תיעוד ושירות לאחר המסירה. עדיף לבחור חברה שמציגה תהליך עבודה ופרויקטים דומים ולא רק רשימת מוצרים.',
  },
  {
    question: 'מה ההבדל בין חברת בית חכם לאינטגרטור BMS?',
    answer:
      'בית חכם מתמקד בבית או בדירה ובחוויית המשתמש. BMS מנהל מערכות תפעוליות של מבנה מסחרי או ציבורי. חברה שעוסקת בשני התחומים צריכה להראות ניסיון וארכיטקטורה מתאימים לכל סוג פרויקט.',
  },
  {
    question: 'האם KNX מתאים לכל בית?',
    answer:
      'KNX מתאים במיוחד לבנייה חדשה ולשיפוץ יסודי שבו ניתן לתכנן תשתית קווית מראש. בדירה קיימת ללא שיפוץ, פתרון אלחוטי עשוי להיות מעשי יותר.',
  },
  {
    question: 'מה לבדוק לפני בחירת חברת BMS?',
    answer:
      'בדקו ניסיון בבקרי DDC, BACnet ו-Modbus, אינטגרציה עם מיזוג ותאורה, מסכי ניהול, התראות, תיעוד ומחלקת שירות. בפרויקט Siemens בדקו גם ניסיון ממשי עם Desigo.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': 'https://i-feel.co.il/#business',
      name: 'i-feel',
      url: 'https://i-feel.co.il/',
      telephone: '+972-3-508-9553',
      email: 'sales@i-feel.co.il',
      priceRange: '₪₪₪',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'אימבר 14',
        addressLocality: 'פתח תקווה',
        postalCode: '4951148',
        addressCountry: 'IL',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 32.09124,
        longitude: 34.88762,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Israel',
      },
      knowsAbout: [
        'בית חכם',
        'KNX',
        'בקרת מבנה',
        'BMS',
        'Siemens Desigo',
        'DDC',
        'DALI',
        'BACnet',
        'Modbus',
        'אינטגרציית מערכות',
        'פתרונות אלחוטיים לבית חכם',
      ],
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'איך לבחור חברת בית חכם או BMS בישראל',
      description:
        'מדריך מעשי לבחירת חברת בית חכם או אינטגרטור BMS בישראל: תכנון, התאמת KNX או BMS לפרויקט, אינטגרציה, תיעוד ושירות לאורך זמן.',
      inLanguage: 'he-IL',
      dateModified: '2026-08-14',
      isPartOf: { '@id': 'https://i-feel.co.il/#website' },
      about: { '@id': 'https://i-feel.co.il/#business' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'דף הבית',
          item: 'https://i-feel.co.il/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'איך לבחור חברת בית חכם או BMS בישראל',
          item: pageUrl,
        },
      ],
    },
  ],
};

const meta = {
  title: 'איך לבחור חברת בית חכם או BMS בישראל | i-feel',
  description:
    'איך לבחור חברת בית חכם או אינטגרטור BMS בישראל: תכנון, KNX, Siemens Desigo, אינטגרציה, תיעוד ושירות. מדריך החלטה מעשי לפני חתימה.',
  canonical: pageUrl,
  ogTitle: 'איך לבחור חברת בית חכם או BMS בישראל | i-feel',
  ogDescription:
    'חמש בדיקות לפני שבוחרים אינטגרטור: תכנון, התאמת טכנולוגיה, אינטגרציה, תיעוד ושירות לאורך זמן.',
  ogUrl: pageUrl,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify(jsonLd),
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
