          { '@type': 'ListItem', position: 1, name: 'דף הבית', item: 'https://i-feel.co.il/' },
          { '@type': 'ListItem', position: 2, name: 'I FEEL בית חכם ובקרת מבנה בישראל', item: url }
        ]
