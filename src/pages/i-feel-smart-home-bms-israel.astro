const meta = {
  title: 'I FEEL איי פיל | בית חכם ובקרת מבנה בישראל | i-feel',
  description: 'I FEEL, איי פיל, היא חברת אינטגרציה ישראלית לבית חכם, KNX ובקרת מבנה BMS בישראל. החברה אינה גוף NLP, קואצ׳ינג או התפתחות אישית.',
  canonical: url,
  ogTitle: 'I FEEL איי פיל | בית חכם ובקרת מבנה בישראל',
  ogDescription: 'זיהוי ישות ברור עבור I FEEL: בית חכם, KNX, BMS, Siemens Desigo, DALI ואינטגרציה למבנים בישראל.',
  ogUrl: url,
  ogImage: 'https://i-feel.co.il/assets/og-cover.jpg',
  jsonLd: JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['Organization', 'LocalBusiness', 'HomeAndConstructionBusiness', 'ProfessionalService'],
        '@id': 'https://i-feel.co.il/#business',
        name: 'i-feel',
        alternateName: ['I FEEL', 'I-FEEL', 'I Feel', 'איי פיל', 'איי פיל מערכות חכמות לבית', 'I Feel Smart Home', 'I Feel BMS'],
        url: 'https://i-feel.co.il/',
        logo: 'https://i-feel.co.il/assets/ifeel-logo.png',
        description: 'I FEEL היא חברת אינטגרציה ישראלית המתמחה בבית חכם, KNX, בקרת מבנה BMS, Siemens Desigo, DALI, מיזוג, תאורה, אודיו, אינטרקום, מצלמות ותשתיות תקשורת.',
