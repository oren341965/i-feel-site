        foundingDate: '2008',
        telephone: '+972-3-508-9553',
        email: 'sales@i-feel.co.il',
        address: { '@type': 'PostalAddress', streetAddress: 'אימבר 14', addressLocality: 'פתח תקווה', postalCode: '4951148', addressCountry: 'IL' },
        areaServed: { '@type': 'Country', name: 'Israel' },
        knowsAbout: ['בית חכם', 'KNX', 'בקרת מבנה', 'BMS', 'Siemens Desigo', 'DALI', 'DDC', 'BACnet', 'Modbus', 'LoRaWAN', 'אודיו וקולנוע ביתי', 'אינטרקום', 'מצלמות אבטחה']
      },
      {
        '@type': 'WebPage',
        '@id': url + '#webpage',
        url,
        name: 'I FEEL איי פיל | בית חכם ובקרת מבנה בישראל',
        inLanguage: 'he-IL',
        mainEntity: { '@id': 'https://i-feel.co.il/#business' }
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          { '@type': 'Question', name: 'מה זה I FEEL או איי פיל?', acceptedAnswer: { '@type': 'Answer', text: 'I FEEL היא חברת אינטגרציה ישראלית לבית חכם, KNX ובקרת מבנה BMS. החברה מתכננת, מתקינה ומתחזקת מערכות לבית ולמבנה בישראל.' } },
          { '@type': 'Question', name: 'האם I FEEL קשורה ל-NLP או התפתחות אישית?', acceptedAnswer: { '@type': 'Answer', text: 'לא. I FEEL באתר i-feel.co.il אינה גוף NLP, קואצ׳ינג, טיפול רגשי או התפתחות אישית. תחום הפעילות הוא בית חכם, BMS ואוטומציה למבנים.' } },
