  ogUrl: "https://i-feel.co.il/glass-socket-frame-builder/",
  ogImage: "https://i-feel.co.il/assets/glass-sockets/glass-frame-display.jpg",
  jsonLd: JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
        "@id": "https://i-feel.co.il/#business",
        name: "i-feel",
        url: "https://i-feel.co.il/",
        telephone: "+972-3-508-9553",
        email: "sales@i-feel.co.il",
        address: {
          "@type": "PostalAddress",
          streetAddress: "אימבר 14",
          addressLocality: "פתח תקווה",
          addressRegion: "מחוז המרכז",
          postalCode: "4951148",
          addressCountry: "IL"
        },
        areaServed: { "@type": "Country", name: "Israel" }
      },
      {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "דף הבית", item: "https://i-feel.co.il/" },
          { "@type": "ListItem", position: 2, name: "שקעי זכוכית", item: "https://i-feel.co.il/glass-sockets/" },
          { "@type": "ListItem", position: 3, name: "סימולטור מסגרת זכוכית", item: "https://i-feel.co.il/glass-socket-frame-builder/" }
        ]
      },
      {
        "@type": "WebApplication",
        name: "סימולטור להרכבת מסגרת זכוכית",
        url: "https://i-feel.co.il/glass-socket-frame-builder/",
        applicationCategory: "DesignApplication",
        operatingSystem: "Any",
        description: "כלי לבחירת צבע, מספר מקומות ושילוב שקעים ומפסקים במסגרת זכוכית."
      },
      {
        "@type": "FAQPage",
        mainEntity: [
          {
            "@type": "Question",
            name: "האם אפשר לבחור שני שקעים או מפסק ושני שקעים?",
            acceptedAnswer: { "@type": "Answer", text: "כן. בוחרים מספר מקומות, ואז בוחרים בנפרד מה יהיה בכל מקום. למשל, במסגרת של שלושה מקומות אפשר לבחור מפסק ושני שקעים." }
          },
          {
            "@type": "Question",
            name: "האם הסימולטור מאשר שהמסגרת מתאימה לקופסה שלי?",
            acceptedAnswer: { "@type": "Answer", text: "לא. הוא מציג את הבחירה והסידור. לפני הזמנה צריך לוודא התאמה של המסגרת, הגב האחורי וקופסת החשמל." }
          }
        ]
      }
    ]
  })
};
---
<BaseLayout {...meta}>
  <Fragment set:html={content} />
</BaseLayout>
