---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../page-html/glass-socket-frame-builder.html?raw';

const meta = {
  title: "סימולטור להרכבת מסגרת זכוכית לשקעים ולמפסקים | i-feel",
  description: "בנו מסגרת זכוכית לשקעים ולמפסקים: בחרו צבע, מספר מקומות ואביזר לכל מקום. לתיאום התאמה: 03-508-9553.",
  canonical: "https://i-feel.co.il/glass-socket-frame-builder/",
  ogTitle: "סימולטור להרכבת מסגרת זכוכית | i-feel",
